# Task #70. A function of five parameters, called twice with the same
# arguments, answers differently the second time: the first argument arrives
# holding the second's value. Five KValues need ten registers and AArch64 has
# eight, so two arguments travel on the stack, and the dev build's `tailcc`
# call gets that wrong. The interpreter answers both calls correctly, and so
# does `--release`, which links with -flto.
fn joined p1 p2 p3 p4 p5
  "{p2} {p1} {p3} {p4} {p5}"

pub play =
  a = joined "1" "2" "3" "4" "5"
  b = joined "1" "2" "3" "4" "5"
  print "[{a}][{b}]"
