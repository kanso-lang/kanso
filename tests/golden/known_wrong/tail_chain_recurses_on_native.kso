# Task #70's remainder. `agreed` takes five parameters, so two of its arguments
# travel on the stack — and it holds a `musttail` call, which only `tailcc`
# permits across an arity, so it keeps that convention where a plain function
# no longer does. The non-tail call into it still corrupts an argument, here a
# literal-cache pointer, so the runtime dereferences 5 and faults. `kanso run`
# calls any fault running out of stack; the backtrace is five frames and the
# call graph has no cycle in it.
type row
  mb
  ms
  name

fn mine r "ms"
  r.ms

fn mine r _
  r.mb

fn agreed _ _ _ _ true
  ""

fn agreed r shown where what false
  "differ {r.name} {where} {shown} {what}\n"

fn claimed _ "" _ _
  ""

fn claimed r shown where what
  agreed r shown where what (mine r what == shown)

fn against board _ shown where what
  claimed board[1]! shown where what

pub play =
  one = row "4.1" "0.78" "kanso"
  board = push [] one
  k = against board "kanso" "9" "p" "ms"
  m = against board "kanso" "9" "p" "mb"
  print "[{k}{m}]"
