# Task #70, wearing a crash. `agreed` takes five parameters, so two of its
# arguments travel on the stack, and the dev build's `tailcc` call corrupts
# one — here it is a literal-cache pointer, so the runtime dereferences 5.
# `kanso run` calls that running out of stack. It is not: the backtrace is
# five frames deep and the call graph has no cycle in it. See
# five_parameters_corrupt_the_second_call.kso for the same defect answering
# quietly instead.
type row
  mb
  ms
  name

fn mine r "ms"
  r.ms

fn mine r _
  r.mb

fn agreed _ _ _ _ true
  ""

fn agreed r shown where what false
  "differ {r.name} {where} {shown} {what}\n"

fn claimed _ "" _ _
  ""

fn claimed r shown where what
  agreed r shown where what (mine r what == shown)

fn against board _ shown where what
  claimed board[1]! shown where what

pub play =
  one = row "4.1" "0.78" "kanso"
  board = push [] one
  k = against board "kanso" "9" "p" "ms"
  m = against board "kanso" "9" "p" "mb"
  print "[{k}{m}]"
