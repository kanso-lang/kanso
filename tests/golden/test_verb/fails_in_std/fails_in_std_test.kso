# `parts?` hands text/split a none, a slice that starts past the end, and the
# split fails inside std/text. The report names std/text's file and line,
# and under it the line of this file that called in.
import "std/list"
import "std/text"

test_positive = list/all? [1 2] (n -> n > 0)

test_parts = list/all? ["ab" "cd"] parts?

fn parts? s
  rest = text/slice s 5 (length s)
  length (text/split rest ", ") > ident 0
