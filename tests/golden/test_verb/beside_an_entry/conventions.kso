import "std/derive"
import "std/list"

# Every pub function of every module the entry imports, keyed by its path,
# and one more arm of `posts/show` written into its module.
pub fn routing p
  rows = list/fold p.modules {} (acc m -> list/fold m.functions acc (row m))
  titled = "pub fn show id:string\n  \"the post titled \{id}\"\n"
  [(derive/declare "routes" "routes" rows) (derive/define "posts" titled)]

fn row m
  (acc f -> put acc "/{m.name}/{f.name}" f.reference)

pub fn handle table path arg
  called table[path] path arg

fn called none path _
  "no route for {path}"

fn called f _ arg
  f arg
