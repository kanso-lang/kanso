# find, all? and any? drive next and stop at the answer. the predicate
# here allocates on every call, so the alloc count pins how far the scan
# went: a fold-the-whole-list implementation adds one alloc per element
# and moves this golden by thousands.
import "std/list"

fn build_up 0 acc
  acc

fn build_up n acc
  build_up (n - 1) (push acc n)

pub play =
  xs = build_up 20000 []
  hit = list/find xs (n -> length "{n}" > 0)
  short = list/all? xs (n -> length "{n}" < 5)
  print "{hit} {short}"
