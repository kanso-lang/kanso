# find_all tries a match at every position of its subject, and a position that
# matches nothing has nothing to keep. Its walk still allocates -- a closure for
# the continuation, a list for the captures -- and until the scan's loop could
# rewind, all of it stayed in the arena until the scan ended, so the peak grew
# with the subject. The loop rewinds at each position now, and the peak this
# golden pins is one block however long the subject is.
import "std/regexp"
import "std/text"

fn grow 0 acc
  acc

fn grow n acc
  grow (n - 1) (text/append acc "abcdefghijklm")

pub play =
  subject = text/utf8 (grow 12 (text/bytes ""))
  hits = regexp/find_all "[a-z]+zzq" subject
  print "found {length hits} in {length subject}"
