import "std/text"

# Groups in one tail cycle that append into a byte builder and read the input
# bytes, and allocate nothing in the arena: an append onto a builder the
# linearity analysis proved unique grows its storage outside the arena, the
# run between two finds is copied a byte at a time, and find2_below answers an
# integer. A rewind here would free nothing, and the entry's push and pop would
# bracket nothing. beat_iters below is zero: the cycle is not a beat, and the
# arena's one block is the input.
fn scan acc bs p len
  found acc bs p len (text/find2_below bs p 120 121 32)

fn found acc bs p len n
  copied acc bs p n len

# A slice past the end answers none (#1890), so the run is copied byte by byte
# rather than sliced and appended.
fn copied acc bs p n len
  return run acc bs n len if n <= p or p < 1 or length bs < p
  copied (text/append acc bs[p]) bs (p + 1) n len

fn run acc bs n len
  if (len < n) acc (mark acc bs n len)

fn mark acc bs n len
  return acc if n < 1 or length bs < n
  scan (text/append (text/append acc 92) bs[n]) bs (n + 1) len

fn escaped bs
  text/utf8 (scan (text/bytes "") bs 1 (length bs))

# the input is built the same way, and that loop is not a beat either
fn grown acc 0
  acc

fn grown acc n
  grown (text/append acc "abxcdy") (n - 1)

pub play = print "{length (escaped (grown (text/bytes "") 20000))}"
