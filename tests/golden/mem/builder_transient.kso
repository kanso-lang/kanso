import "std/text"

fn assemble cs p acc
  return text/utf8 acc if p < 1 or length cs < p
  assemble cs (p + 1) (text/append acc cs[p])

fn once _
  assemble (text/bytes "a builder that dies at the rewind") 1 (text/bytes "")

fn run 0 acc
  acc

fn run n acc
  run (n - 1) (acc + length (once 0))

pub play = print "total {run 40 0}"
