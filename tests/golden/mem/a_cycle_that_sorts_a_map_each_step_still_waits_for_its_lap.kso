# A tail cycle carrying a record round `ev` and `ret`, as mal's evaluator
# does, that builds a map with its keys out of order at each step and asks its
# length, which builds a sorted view at the cycle's own depth. A carried
# rewind waits until the lap has left a quarter megabyte behind, and it used
# to stage at once whenever a registry at its depth held anything, since a
# registry's storage is malloc'd where the drift test cannot see it. A view is
# never larger than its map, and its map is either part of the drift or still
# live, so the view registry no longer forces a stage. When it did, every edge
# staged and this program copied 3,200,304 bytes; `evac_bytes` below pins
# what the lap rule copies instead.
type halt

type k_step
  n
  k

type world
  count
  last

fn ev n k w
  m = put (put (put {} "k{n % 5}" n) "a" 1) "z{n % 3}" 2
  ret (k_step n k) (length m) (world (w.count + 1) "step {n}")

fn ret halt _ w
  w.count

fn ret (k_step n k) v w
  return ret k v w if n == 0
  ev (n - 1) k (world (w.count + v) w.last)

fn run n
  ev n halt (world 0 "")

pub play = print "{run 20000}"
