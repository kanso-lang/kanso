# A loop whose lap enters the same loop again, carrying a binary trie that
# each lap writes one leaf into: lox's statement loop when a constructor
# builds a tree. Every entry is a fresh loop. Each one used to stage its carry
# on its first lap, measuring drift from where the last loop at its depth had
# left the arena, and to wait only a quarter megabyte after that however much
# its stage had copied. So the whole trie was copied about once per write.
type node
  left
  right

type empty

type world
  next
  tree

fn run_from i d w
  return w if 2 < i
  run_from (i + 1) d (exec d w)

fn exec 0 w
  world (w.next + 1) (store w.tree 16 w.next w.next)

fn exec d w
  run_from 1 (d - 1) (exec 0 w)

fn store empty bits id v
  return v if bits == 0
  store (node empty empty) bits id v

fn store (node l r) bits id v
  return v if bits == 0
  return node (store l (bits - 1) (id / 2) v) r if id % 2 == 0
  node l (store r (bits - 1) (id / 2) v)

pub play = print "{(run_from 1 8 (world 0 empty)).next}"
