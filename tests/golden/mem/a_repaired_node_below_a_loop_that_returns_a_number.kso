# A record older than a loop, repaired by a pop in the loop's last lap, where
# the loop's result is a number.
#
# `outer` carries `keep`, so after its first stage the string lives in the
# outer loop's carry storage. Each lap builds `box keep` and hands it to
# `middle`, which starts after the box exists: the box lies below the middle
# loop's mark. Only `middle`'s last arm calls `inner`, which returns the box
# inside a list, and its pop copies the string to the arena's frontier and
# repairs the box to point at the copy. The frontier is in that last lap.
#
# `middle` returns a number. A loop whose result is a scalar rewinds its whole
# lap when it pops, on the reading that nothing older than its mark can point
# into the lap, and the repaired box is the exception. Until 2026-10-23 the
# pop gave back the copy, and the next stage of `outer` walked the box into
# freed memory and the program crashed. Such a pop now keeps its lap and hands
# it up to the enclosing loop, as a pop with a heap result does.
#
# `big` makes each lap allocate a few hundred kilobytes, so the loops stage
# under the lap carry's drift rule as well as at every edge, and `cover` puts
# new bytes over the freed copy before the box is read.
type box
  name

type lap
  k
  text
  prev

# A string of a few hundred kilobytes, so a lap that builds one drifts
# far enough for its loop to stage.
fn big t
  a = "{t}{t}{t}{t}{t}{t}{t}{t}"
  b = "{a}{a}{a}{a}{a}{a}{a}{a}"
  c = "{b}{b}{b}{b}{b}{b}{b}{b}"
  "{c}{c}{c}{c}{c}{c}{c}{c}"

fn inner 0 b acc
  [b acc]

fn inner k b acc
  junk = "{k} overwrote the bytes the box named {k} {k} {k} {k} {k} {k}"
  inner (k - 1) b (lap (k + length (big junk) * 0) junk acc)

fn middle 0 b total
  total + length (inner 2 b 0)

fn middle j b total
  drift = length (big "middle lap {j} drifts the arena past the lap mark")
  middle (j - 1) b (total + 1 + drift * 0)

fn outer 0 _ acc
  acc

fn outer i keep acc
  b = box keep
  r = middle 4 b 0
  cover = length (big "the bytes after the pop go over what it gave back")
  drift = length (big "outer lap {i} drifts the arena past the lap mark")
  line = "{b.name} {r} {cover + drift * 0}\n"
  outer (i - 1) "{keep}." "{acc}{line}"

pub play = print (outer 2 "name" "")
