# A call whose arguments are `keys m` and then `values m` of the same map
# takes both lists from one runtime call, which tests the map and finds its
# sorted view once and allocates the two lists together. A thousand such
# calls allocate a thousand pairs of lists in a thousand allocations, where
# they took two thousand.
import "std/list"

fn row i
  { "a":i "b":i }

fn widths ks vs
  length ks + length vs

fn counted i
  m = row i
  widths (keys m) (values m)

pub play = print "{list/sum (list/map (list/take list/naturals 1000) counted)}"
