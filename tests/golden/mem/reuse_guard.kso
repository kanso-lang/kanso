type pt
  x
  y

fn shifted p
  moved = pt (p.x + 1) p.y
  "orig {p.x},{p.y} moved {moved.x},{moved.y}"

fn kept p
  both = [p (pt (p.x + 9) p.y)]
  "first {both[1].x} second {both[2].x}"

fn narrower p
  "{(pt (p.x + 1) p.y).x}"

pub play =
  a = shifted (pt 1 2)
  b = kept (pt 5 6)
  c = narrower (pt 7 8)
  print "{a} | {b} | {c}"
