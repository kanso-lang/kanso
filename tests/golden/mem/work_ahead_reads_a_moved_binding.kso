# The count is bound before the sleep, so it moves into a constant, and the
# call after the sleep that reads it then names nothing local. The call is
# lifted and forced while the program is parked. The count is a literal and
# runs none of the program's work, so the pool leaves it to be built where the
# call reads it: `ahead_forced` counts one.
import "std/time"

fn spin 0 acc
  acc

fn spin n acc
  spin (n - 1) (acc + n % 7)

n = 1000
sleep 1 .> (_ -> print "made") .> (_ -> print "report: {spin n 0}")
