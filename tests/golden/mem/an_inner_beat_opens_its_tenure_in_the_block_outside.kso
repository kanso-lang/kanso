import "std/io"
import "std/list"

# An inner loop whose result is a heap value hands its tenure block to the
# depth outside at every pop. Run under an outer loop, that was one 256 KiB
# block a lap, each five-sixths empty, and every ask of k_ten_holds walked
# all of them. Since 2026-09-07 an inner beat that has no block yet opens its
# tenure in the outer depth's block instead, while that block has room. Five
# laps here tenure 363,552 bytes over 7,336 requests: a block fills every two
# laps and change, so ten_blocks read 3 where the runtime before read 5, one
# a lap, with every other counter identical. It reads 2 since 2026-09-10: the
# counted fold took four records an element out of `wide`, so each lap drifts
# less, the chain stages less often, and fewer promotions fill fewer blocks.
# A runtime that opened a block a pop would still read 5.
fn wide n
  fat = (i -> "element {i} with enough bytes in it to be worth promoting")
  list/to_list (list/map (list/take list/naturals n) fat)

fn gathered n xs acc
  stepped (n - 1) xs (push acc xs[n]!)

fn stepped 0 _ acc
  acc

# Each step allocates a list it discards. A chain step leaves its value
# where it is while the region has not drifted far since the last stage, so
# without garbage to drift a chain of small steps never stages, never
# carries, and never promotes -- and this fixture's whole subject is what
# the promotion does. `drift` is demanded by the arithmetic, which is what
# makes the list real; `n + 40 - drift` is `n`.
fn stepped n xs acc
  drift = length (wide 40)
  io/write "" . (_ -> gathered (n + 40 - drift) xs acc)

fn loaded acc
  xs = wide 400
  stepped (length xs) xs acc

fn laps 0 acc
  acc

fn laps n acc
  loaded acc . (next -> laps (n - 1) next)

fn read_back out
  io/write "kept {length out}, first {out[1]!}, last {out[2000]!}\n"

fn begin acc0
  io/write "" . (_ -> laps 5 acc0) . read_back

pub play = begin []
