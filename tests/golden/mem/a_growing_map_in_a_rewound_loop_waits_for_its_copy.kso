# The tail-cycle loop of
# `a_loop_entered_from_a_tail_cycle_gives_its_garbage_back`, with a map in
# the state that keeps one entry a pass. Each stage copies the map out of the
# arena and the next put copies it back, so a stage once every quarter
# megabyte of drift copied the whole map on almost every pass: twenty thousand
# passes allocated 9.5 GB and took 3.2 seconds, where main, which never rewound
# this loop, took 0.01. A lap now waits for twice what the last stage copied,
# and the allocation below must stay near the map's own size.
type state
  count
  note
  kept

type repeat
  body
  times

type bump

type block
  first
  rest

fn exec (repeat body times) st
  spin body times st

fn exec (block first rest) st
  exec rest (exec first st)

fn exec bump st
  state (st.count + 1) "pass {st.count}" (put st.kept st.count st.count)

fn exec _ st
  st

fn spin _ 0 st
  st

fn spin body n st
  spin body (n - 1) (exec body st)

program = block (repeat bump 20000) none

start = state 0 "" {}

pub play =
  last = exec program start
  print "{last.count} {length last.kept}"
