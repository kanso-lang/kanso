# cells made in a loop, most of them never demanded. every other .mem case
# holds at most one cell at a time; this one pins what a run that makes many
# of them costs. today none are recycled, because a cell handed onward in a
# tail call outlives the frame whose epilogue would have released it.
fn burn 0 acc
  acc

fn burn n acc
  burn (n - 1) (acc + n)

fn pick false _
  0

fn pick true chosen
  chosen

pub play = print "sum {walk 40 0}"

fn step i
  expensive = burn 20 i
  pick (i - (i / 8 * 8) == 1) expensive

fn walk 0 total
  total

fn walk n total
  walk (n - 1) (total + (step n))
