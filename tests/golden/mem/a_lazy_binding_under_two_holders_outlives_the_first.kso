# One lazy binding under two holders, one of which outlives the other.
#
# Lap 21 makes a list that the next stage finds in the carry, which is what
# starts tenure. Lap 20 binds `a` lazily and hands it back unread, so the
# cell goes into a fresh `[c]` and a fresh `[[c]]`. That lap's copy walk
# meets the cell from `[c]` first, bound for the pair, then starts tenuring
# at the older list, then meets the cell again under `[[c]]`. Lap 19 drops
# `[c]`. Every later walk prunes at the tenured `[[c]]`, so nothing copies
# the cell's argument forward, and each lap carries a longer list, so the
# pair is written past where that argument was.
#
# A cell keeps its identity and its slots are copied in place. The walk left
# them in the pair at the second meeting, and natively the last line read a
# string that had been written over: the program ran out of stack where the
# interpreter printed its answer (#2415). The second meeting now copies the
# slots again, into tenure. Each lap allocates a list it throws away so the
# chain stages every lap; `ten_blocks` and the `evac` counters say it did.
import "std/io"
import "std/list"

type held_by
  first
  old
  nested

fn wide n
  fat = (i -> "element {i} with enough bytes in it to be worth a copy")
  list/to_list (list/map (list/take list/naturals n) fat)

fn built s n
  "kept {s} {n * 23}"

fn held false _
  ""

fn held true words
  words

fn made n
  s = "seed {n} with enough bytes in it to be seen when it is lost"
  a = built s n
  held true a

fn both c st
  held_by [c] st.old [[c]]

fn stepped 21 st
  held_by st.first ["old 21 with enough bytes to be worth a copy"] st.nested

fn stepped 20 st
  both (made 20) st

fn stepped 19 st
  held_by [] st.old st.nested

fn stepped _ st
  st

fn inner_weight t w
  t + length w

fn weight sum inner
  sum + list/fold inner 0 inner_weight

fn spun 0 pad st
  io/write "kept {list/fold st.nested 0 weight} beside {length pad}\n"

fn spun n pad st
  drift = length (wide 6000)
  next = n + 6000 - drift - 1
  io/write "" .> (_ -> spun next (wide (length pad + 1)) (stepped n st))

pub play = spun 30 (wide 12) (held_by [] [] [])
