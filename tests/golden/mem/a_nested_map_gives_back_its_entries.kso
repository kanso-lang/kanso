# The encoder writes each map from its entries in place: position i of
# `key_at` and `value_at` is the pair at position i, and reading them builds
# nothing. A document of 3,000 maps therefore allocates no per-map lists for
# the encoder to give back. Until 2026-10-22 the descent into a map built its
# `keys` and `values` and took a region to return them, and this fixture was
# that region's witness; a_descent_gives_back_the_keys_it_built is now.
import "std/json"
import "std/list"

fn row i
  { "id":i "tags":{ "a":i "b":i "c":i "d":i "e":i "f":i "g":i "h":i } }

doc = list/to_list (list/map (list/take list/naturals 3000) (i -> row i))

pub play = print "{length (json/encode doc)}"
