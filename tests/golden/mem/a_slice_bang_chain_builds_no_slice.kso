import "std/text"

# A `slice!` handed straight to `to_int` reads the digits where they lie, so
# none of the ten numbers below builds a slice or the box between the steps:
# 45 allocations. Written as two steps it took 95.
digits = text/bytes "1234567890"

fn summed 0 total
  effect total

fn summed n total
  text/slice! digits 1 n .> text/to_int .> (k -> summed (n - 1) (total + k))

pub play = summed 10 0 .> print
