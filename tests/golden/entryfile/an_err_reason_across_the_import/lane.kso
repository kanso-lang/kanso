# A record prints its module-qualified name whatever the entry path (RULED
# 2026-08-29, "records print qualified, everywhere"). Reached through an
# import this module is `lane`, and run directly its file is `lane.kso`, so
# the record is `lane/slow_lane 7` both ways — the reason inside the err too.
type slow_lane
  minutes

pub play = told

told = print "trouble: {[(err (slow_lane 7))]} {slow_lane 7}"
