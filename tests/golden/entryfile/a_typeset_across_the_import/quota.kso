import "std/testing"

# A typeset gathers this module's own types into one name an annotation can
# use. Qualifying the module renames the types, so the membership list has to
# name them by the same spelling or the set is empty and the typeset arm never
# fires.
#
# The failures reach that arm the way gavel 24 leaves open: `when_failed` is
# std's, foreign to this module, so it is licensed to separate the reason from
# the failure. What this module then dispatches on is a plain reason record,
# never its own err.
type quota_torn
  limit

type slow_lane
  wait

type lane_err quota_torn slow_lane

fn fetch 1
  err (quota_torn 99)

fn fetch 2
  err (slow_lane 7)

fn fetch n
  "plain {n}"

fn named q:quota_torn
  "quota: limit {q.limit}"

fn named e:lane_err
  "lane trouble: {e}"

pub play =
  print (testing/when_failed (fetch 1) named)
  >> print (testing/when_failed (fetch 2) named)
  >> print "ok: {fetch 3}"
