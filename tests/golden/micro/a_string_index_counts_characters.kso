# `s[i]` counts characters, so a multibyte character is one position however
# many bytes it takes. The walk that finds the ith one remembers where it
# stopped, which is what keeps reading a string forward from being quadratic;
# these read forward, then backward past the remembered place, then off both
# ends, because a cursor left ahead of the question is the way that walk goes
# wrong.
#
# The ascii line is here for the other path. A string whose characters are all
# one byte skips the walk entirely and indexes straight in, so its ends need
# their own asking.
fn glyphs _ 0 acc
  acc

fn glyphs s n acc
  glyphs s (n - 1) "{acc}{s[n]}"

fn shown s
  print "{length s} {s[1]} {s[2]} {s[3]} {s[6]}"
    . (_ -> print (glyphs s (length s) ""))
    . (_ -> print "{s[2]} {s[5]} {s[1]}")
    . (_ -> print "{s[0]} {s[7]} {s[99]}")

fn plain s
  print "{length s} {s[1]} {s[4]} {s[3]} {s[0]} {s[5]} {s[99]}"

pub play = shown "aé😀b€z" . (_ -> plain "wxyz")
