import "std/json"

# RFC 8259 §6 writes a number as an optional minus, then 0 or a digit run not
# starting with 0, then optionally a point and at least one digit, then
# optionally an exponent. Each line decodes one document and prints the
# value, or the reason the decoder gave (#1999).
fn read doc
  json/decode! doc .? (e -> e.reason.reason)

pub play = read "0" .> print
  .> (_ -> read "-0" .> print)
  .> (_ -> read "10" .> print)
  .> (_ -> read "0.5" .> print)
  .> (_ -> read "-1.25e2" .> print)
  .> (_ -> read "1E-2" .> print)
  .> (_ -> read "[1.5, 20]" .> print)
  .> (_ -> read "01" .> print)
  .> (_ -> read "-01" .> print)
  .> (_ -> read "00" .> print)
  .> (_ -> read "0.05e01" .> print)
  .> (_ -> read "1." .> print)
  .> (_ -> read "2.e5" .> print)
  .> (_ -> read "-.5" .> print)
  .> (_ -> read "-e5" .> print)
  .> (_ -> read "[1., 2]" .> print)
  .> (_ -> read "1e" .> print)
  .> (_ -> read "1.5." .> print)
