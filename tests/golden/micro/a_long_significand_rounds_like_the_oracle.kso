import "std/text"

# Nineteen significant digits is all the scan keeps. Past that an integer
# digit is traded for a power of ten and a fraction digit is dropped, and
# either way the significand handed to eisel-lemire is no longer the number
# that was written. A truncated significand can sit on the far side of a
# rounding boundary from the true value, so the fast path cannot claim its
# answer is certain and hands these to strtod instead.
#
# Every line below was a DIVERGENCE before that hand-off existed: native
# returned a double one ULP below the correctly-rounded one and the
# interpreter — the oracle — returned the right one. `micro_corpus_agrees
# _across_engines` is what makes this file an engine differential rather
# than a note, so it is the corpus this belongs in.
#
# The first three are the shapes a differential fuzzer found: 20, 22 and 36
# significant digits, each with a fraction and an exponent, drawn from 221
# disagreements in 1,405,451 cases.
twenty = "{text/to_float "4409065699.4409065699e-2"}"

twenty_two = "{text/to_float "17783292643.17783292643e-195"}"

thirty_six = "{text/to_float "274215876808439403.274215876808439403e280"}"

# A DROPPED ZERO changes nothing, so it does not defer: twenty digits whose
# last is a zero is exactly nineteen digits times ten, and this stays on the
# fast path. Without that distinction every long number would pay strtod and
# the run corpus's 210,177 fast-path parses would not all still be fast.
trailing_zero = "{text/to_float "10000000000000000000"}"

# The short forms the fast path was built for, unmoved.
short = "{text/to_float "0.1"} {text/to_float "-2.5"} {text/to_float "42"}"

edges = "{text/to_float "1.7976931348623157e308"} {text/to_float "5e-324"}"

lines = "{twenty}\n{twenty_two}\n{thirty_six}\n{trailing_zero}"

pub play = print "{lines}\n{short}\n{edges}"
