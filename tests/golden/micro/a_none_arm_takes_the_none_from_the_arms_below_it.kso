# `insisted`'s first arm answers every none, so its second is never handed
# one and answers what it was handed; `shown` has no none arm and the check
# has no none to report. Before, the arms below a catch-all none arm were
# seeded with the none too, and `insisted none` read as able to answer a
# none it cannot produce, so this program was refused.
fn insisted none
  1

fn insisted x
  x

fn shown 1
  "one"

pub play =
  print (shown (insisted none))
  print (shown (insisted 1))
