import "std/regexp"

pub play = print "whole:   {regexp/find chapter "see ch12.html now"}"
  .> (_ -> print "one:     {regexp/groups chapter "see ch12.html"}")
  .> (_ -> print "several: {regexp/groups "([a-z]+)-([0-9]+)" "id abc-42 x"}")
  .> (_ -> print "nested:  {regexp/groups "((a)(b))" "zab"}")
  .> (_ -> print "none:    {regexp/groups "[a-z]+" "abc"}")
  .> (_ -> print "miss:    {regexp/groups "(zz)" "abc"}")

chapter = "(ch[0-9]+)\\.html"
