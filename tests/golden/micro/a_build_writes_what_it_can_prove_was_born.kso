# A build block writes only what it can prove was born in it, and since the
# 2026-08-24 ruling what it writes is a hole: a field the construction left
# as `_`, filled exactly once. The proof reaches a record through the name
# it was bound to, through an alias of that name, and through a field read
# that resolves to one record; each of the three fills a hole here. What the
# proof declines — a field built with a value, a record an `if` chose, an
# element of a list — is refused, and the error corpus pins each refusal.
type node
  id
  up

pub play =
  build
    a = node 1 _
    b = node 2 _
    c = node 3 _
    twin = a
    twin.up = b
    down = a.up
    down.up = c
    c.up = a
  print "{a.id} {b.id} {c.id}"
  >> print "{a.up.id} {b.up.id} {c.up.id}"
