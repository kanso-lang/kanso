# A long string handed to each step of a scan, sliced a character at a time.
# The interpreter shares a long string rather than copying it, and slices an
# all-ASCII one by byte; one with a wider character is sliced by character.
import "std/text"

fn picked s i n acc
  stepped s i n acc (i > n)

fn stepped _ _ _ acc true
  acc

fn stepped s i n acc false
  picked s (i + 2) n "{acc}{text/slice s i i}"

fn edges s
  n = length s
  "{n} {text/slice s n n} {text/slice s 2 4} [{text/slice s (n + 1) n}]"

plain = "the quick brown fox jumps over the lazy dog"
wide = "thé quick brown fox jumps över the lazy dög"
print (picked plain 1 (length plain) "")
  .> (_ -> print (picked wide 1 (length wide) ""))
  .> (_ -> print (edges plain))
  .> (_ -> print (edges wide))
  .> (_ -> print (text/slice wide 3 3))
  .> (_ -> print (text/slice plain 44 44))
