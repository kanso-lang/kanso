import "std/text"

# Both ends, and the cases that are not "a word with spaces around it": a
# string that is all padding, an empty one, and one wearing the newline a
# captured process hands back.
pub play = print "[{text/trim "  hi  "}]"
  .> (_ -> print "[{text/trim "line\n"}]")
  .> (_ -> print "[{text/trim ""}]")
  .> (_ -> print "[{text/trim "   "}]")
  .> (_ -> print "[{text/trim "no padding"}]")
  .> (_ -> print "[{text/trim "\t\n mid dle \r\n"}]")
  .> (_ -> print "[{text/trim "→ arrow ←"}]")
