import "std/text"

# Every occurrence ends a piece and an empty piece is a piece, which is what
# makes split and join inverses. Lines seven and eight are that law both ways.
#
# The last three lines are the separator's first byte where the separator is
# not. Until 2026-09-06 nothing in the corpus had one: the multi-byte cases
# above put the first byte only where the whole separator was, so a scan that
# took a matching first byte for a match passed all ten.
pub play = print "{text/split "a,b,c" ","}"
  .> (_ -> print "{text/split "a,,b" ","}")
  .> (_ -> print "{text/split "abc" ","}")
  .> (_ -> print "{text/split "a::b" "::"}")
  .> (_ -> print "{text/split "" ","}")
  .> (_ -> print "{text/split ",a," ","}")
  .> (_ -> print "{text/join (text/split "a/b/c" "/") "/"}")
  .> (_ -> print "{text/split (text/join ["a" "b"] "-") "-"}")
  .> (_ -> print "{text/split "héllo→wörld" "→"}")
  .> (_ -> print "{text/split "a→→b→→c" "→→"}")
  .> (_ -> print "{text/split "a:b::c" "::"}")
  .> (_ -> print "{text/split "→x→→y" "→→"}")
  .> (_ -> print "{text/split "a→→" "→→"}")
