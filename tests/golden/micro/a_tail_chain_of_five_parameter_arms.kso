# `agreed` takes five parameters, so two of its arguments travel on the stack,
# and it holds a musttail — which only `tailcc` permits across an arity — so it
# keeps that convention where a plain function no longer does. A non-tail call
# into it used to corrupt an argument; here the corrupted one was a
# literal-cache pointer, so the runtime dereferenced 5 and faulted, and `kanso
# run` called that running out of stack.
type row
  mb
  ms
  name

fn mine r "ms"
  r.ms

fn mine r _
  r.mb

fn agreed _ _ _ _ true
  ""

fn agreed r shown where what false
  "differ {r.name} {where} {shown} {what}\n"

fn claimed _ "" _ _
  ""

fn claimed r shown where what
  agreed r shown where what (mine r what == shown)

fn against board _ shown where what
  claimed board[1]! shown where what

pub play =
  one = row "4.1" "0.78" "kanso"
  board = push [] one
  k = against board "kanso" "9" "p" "ms"
  m = against board "kanso" "9" "p" "mb"
  print "[{k}{m}]"
