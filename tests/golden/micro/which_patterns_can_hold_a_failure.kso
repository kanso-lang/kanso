# Three patterns can hold an err — `(err …)`, an `:err` annotation, and a
# typeset with err among its members — and the table says which, for every
# pattern form a parameter can take. It lived in three scattered fixtures
# covering three of its cells before it was one table.
#
# Two divergences were cells of it. `_:some` took a foreign failure on two
# engines and was refused outright at build time on the third (#1052). A
# typeset arm took its own hako's failure on native alone, because the
# typeset branch of `emit_pattern` returned before it asked about the raiser
# (#1056). In both cases the row existed in somebody's head and nowhere in
# the tree.
#
# `took` means the arm fired. `past` means the failure went by as though the
# arm were not written. The table had a second column for a failure this
# module spelled. Since #1884 a spelled err reaches only the three rows that
# admit one; the other seven refuse it at check, bound to a name or not. So
# the failure here is the runtime's, `text/to_int` refusing text it cannot
# read, which is the one that can still reach a pattern unannounced. Adding a
# spelling to the language means adding a row here.
#
# `when_failed` hands the reason to its callback and answers `false` when
# there was no failure, so `outcome` reads that `false` as `took`. It is
# std's arm that reads the err, which keeps the table about the patterns
# rather than about which module wrote them.
import "std/testing"
import "std/text"

type maybe err int

fn slipped _
  "past"

fn outcome false
  "took"

fn outcome v
  v

fn boom what
  text/to_int what

fn wildcard _
  "took"

fn variable v
  "took {v}"

fn annotated _:err
  "took"

fn reason (err r)
  "took {r}"

fn member _:maybe
  "took"

fn anything _:some
  "took"

fn whole _:int
  "took"

fn text _:string
  "took"

fn absent _:none
  "took"

fn exact 1
  "took"

failed = boom "x"

wildcard_seen = outcome (testing/when_failed (wildcard failed) slipped)

variable_seen = outcome (testing/when_failed (variable failed) slipped)

annotated_seen = outcome (testing/when_failed (annotated failed) slipped)

reason_seen = outcome (testing/when_failed (reason failed) slipped)

member_seen = outcome (testing/when_failed (member failed) slipped)

anything_seen = outcome (testing/when_failed (anything failed) slipped)

whole_seen = outcome (testing/when_failed (whole failed) slipped)

text_seen = outcome (testing/when_failed (text failed) slipped)

absent_seen = outcome (testing/when_failed (absent failed) slipped)

exact_seen = outcome (testing/when_failed (exact failed) slipped)

pub play = print "pattern   failure"
  .> (_ -> print "_         {wildcard_seen}")
  .> (_ -> print "v         {variable_seen}")
  .> (_ -> print "v:err     {annotated_seen}")
  .> (_ -> print "(err r)   {reason_seen}")
  .> (_ -> print "v:maybe   {member_seen}")
  .> (_ -> print "v:some    {anything_seen}")
  .> (_ -> print "v:int     {whole_seen}")
  .> (_ -> print "v:string  {text_seen}")
  .> (_ -> print "v:none    {absent_seen}")
  .> (_ -> print "1         {exact_seen}")
