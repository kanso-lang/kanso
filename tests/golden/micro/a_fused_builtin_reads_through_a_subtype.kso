# A builtin reads through a subtype to its base value. The generic call does
# that for every argument, but a few builtins are written out by the compiler
# ahead of it: `bytes` bound to a name, and `utf8`, `append`, `to_int` and
# `to_float` over a `slice`. A native build handed each of them the wrapper.
# `json/encode` of a subtype of string crashed through the first, and every
# slice refused. Found on 2026-09-28 by the generated-program differential.
#
# A slice past the end answers none (#1890), so each slice here is read
# through a function with a `none` arm. The ranges are all inside.
import "std/json"
import "std/os"
import "std/text"

type id int

type word string

fn width s
  bs = text/bytes s
  length bs

fn shown z
  w = word "a{z}bc"
  cut = decoded (text/slice (text/bytes "xyz") (id 2) (id 3))
  n = whole (text/slice (word "12{z}") 1 2)
  x = point (text/slice (word "1.5{z}") (id 1) 3)
  more = onto (text/bytes "<") (text/slice w 1 2)
  "{json/encode w} {width w} {cut} {n} {x} {more}"

fn decoded none
  ""

fn decoded piece
  text/utf8 piece

fn whole none
  0

fn whole piece
  text/to_int piece

fn point none
  0.0

fn point piece
  text/to_float piece

fn onto _ none
  ""

fn onto acc piece
  text/utf8 (text/append acc piece)

pub play = os/args .> (a -> print (shown (length a)))
