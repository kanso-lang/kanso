import "std/text"

tags = ["a" "b"]

counts = { "a":1 "b":2 }

fn found? name group
  name == group[1]!

fn ruled? true _ before after
  after > before

fn ruled? _ true before after
  after < before

fn ruled? _ _ _ _
  false

# The binding becomes a thunk created inside one arm's body. Every return used
# to release every registered cell, including the blocks reached without
# running that body, which is a use LLVM's verifier refuses.
fn worsened? bare before after
  low = found? bare tags
  ruled? low (found? bare tags) before after

fn asked? name
  bare = text/slice name 1 (length name)
  worsened? bare counts[name]! counts["b"]!

pub play = print "{asked? "a"}"
