# A plain read is the element or a `none`, and a group with no `none` arm
# refuses the none where it is provable. The bound written where the read is
# discharges it (ruled 2026-09-16): a guard that returns before the read when
# the index is out of range leaves the element as the only answer, and so
# does a literal index into a list whose length the literal spells out. The
# bang is for the read that can miss; these cannot, and say so without it.
fn shown n
  "n{n}"

fn at xs i
  return "" if i < 1 or length xs < i
  shown xs[i]

fn summed xs i acc
  return acc if i < 1 or length xs < i
  summed xs (i - 1) (acc + xs[i])

fn last_of xs
  return "" if length xs < 1
  shown xs[length xs]

fn tail_of xs k
  return "" if k < 0 or length xs < k + 1
  shown xs[k + 1]

pub play =
  ns = [10 20 30]
  print (at ns 2)
  >> print (at ns 9)
  >> print "{summed ns 3 0}"
  >> print (last_of ns)
  >> print (tail_of ns 2)
  >> print (shown ns[3])
  >> print (shown [4 5 6][1])
