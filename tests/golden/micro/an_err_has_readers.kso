# `.reason`, `.cause` and `.origin` read an err instead of propagating it —
# the second deliberate hole in infectiousness, beside `wrap_err`'s second
# argument. Every other operation on an err still passes it through, which
# is why the readers are applied inside an `:err` arm or a rescue callback:
# `"{e.cause}"` would answer the cause itself, and a bare binder handed the
# err would pass it through.
#
# The arms are this module's and the errs are this module's. A bare err is
# data (ruled 2026-09-15), so an `:err` arm takes one wherever it was raised;
# `rescue` would not do here, because its licence is foreign-only and every
# failure but json's was raised in this file. json's is foreign, and the last
# line reads it through the word to keep that shape in the corpus.
#
# Settled failures only, so every engine including the page runs this one.
# The origin names the file the err was raised in, and the harness stages a
# copy under another path, so only the part before ` at ` is printed; an
# import qualifies the raising function's name, so the part after its
# module's slash. json's
# failure carries a record whose own field is called `reason`, which is the
# case where a reader and a record field share a name.
import "std/json"
import "std/list"
import "std/text"

fn boom n
  err "config missing {n}"

fn wrapped n
  annotate (boom n) (e -> "config: {e.reason}")

fn raised_in origin
  list/last (text/split (list/first (text/split origin " at ")) "/")

fn reason_of e:err
  e.reason

fn cause_of e:err
  e.cause

fn cause_reason_of e:err
  e.cause.reason

fn caused e:err
  "cause: {e.reason}"

fn origin_of e:err
  raised_in e.origin

pub play = print (reason_of (boom 1))
  .> (_ -> print (reason_of (wrapped 2)))
  .> (_ -> print (cause_reason_of (wrapped 3)))
  .> (_ -> print (cause_of (boom 4)))
  .> (_ -> print (caused (cause_of (wrapped 5))))
  .> (_ -> print (origin_of (boom 6)))
  .> (_ -> print (origin_of (wrapped 7)))
  .> (_ -> print (rescue (json/decode "[1, 2") (e -> e.reason.reason)))
