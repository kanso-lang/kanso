# `.reason`, `.cause` and `.origin` read an err instead of propagating it,
# the second deliberate hole in infectiousness beside `wrap_err`'s second
# argument. A failure is a box (ruled 2026-10-26), and the readers apply to
# the unboxed err a rescue hands its callback, here to `:err` arms used as
# callbacks.
#
# A rescue's licence is foreign-only, so the failures are std/text's: a byte
# value too large for `to_bytes`. A cause is read on an err another package
# annotated, which takes two modules: `tests/golden/cause`.
#
# Settled failures only, so every engine including the page runs this one.
# The origin names the file the err was raised in, and the harness stages a
# copy under another path, so only the part before ` at ` is printed; an
# import qualifies the raising function's name, so the part after its
# module's slash. json's failure carries a record whose own field is called
# `reason`, which is the case where a reader and a record field share a name.
import "std/json"
import "std/list"
import "std/text"

fn boom n
  text/to_bytes [(n + 300)]

fn raised_in origin
  list/last (text/split (list/first (text/split origin " at ")) "/")

fn reason_of e:err
  e.reason

fn cause_of e:err
  e.cause

fn origin_of e:err
  raised_in e.origin

pub play = print (boom 1 .? reason_of)
  .> (_ -> print (boom 2 .? cause_of))
  .> (_ -> print (boom 3 .? origin_of))
  .> (_ -> json/decode! "[1, 2" .? (e -> e.reason.reason) .> print)
