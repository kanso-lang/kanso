# std/json imports std/text, so a program wanting both is a diamond — the
# ordinary shape of any program with a dependency. It used to be reported as
# an import cycle, because a module was called a cycle for having been loaded
# rather than for being loaded right now.
import "std/json"
import "std/text"

decoded = json/decode "[1, 2]"

print "{text/slice "abcdef" 2 4}"
>> print "{decoded}"
>> print "{json/encode decoded}"
