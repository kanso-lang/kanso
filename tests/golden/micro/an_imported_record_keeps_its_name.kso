# every pub name an import exports also exists under its short name, as a
# clone that remembers the declaration it came from. The loader prefixed that
# memory with the importing module's name, so `step 1 [5]` built a record
# of a type nothing declared: the interpreter printed `<module>/list/step`
# where std/list's own step prints `list/step`, and native printed `record`
import "std/list"

fn first_of (step e _)
  e

fn first_of _
  none

# A record is built by the module that declares it, so these come from
# std/list's factories: `yield` answers a step and `iter` a cursor.
fn shown one many
  "{one} {many} {first_of (list/yield 7 [])}"

pub play = print (shown (list/yield 1 [5]) (list/iter [3 1]))
