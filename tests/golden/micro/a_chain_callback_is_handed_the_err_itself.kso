# A rescue or annotate callback is handed the err out of its box (#2087), an
# ordinary value, so a group the callback hands it to takes it like any
# other: `lam` reads its reason. The rescue below is written in the package
# that raised the failure, so it hands the failure on without entering its
# callback, and the annotate builds a failure of its own from what `lam`
# answered.
#
# `when_failed` is std's arm, so it reads what came out of each chain, on
# every engine.
import "std/testing"

fn mine _
  err "mine"

fn lam e
  "took {e.reason}"

fn passed r
  "passed lam, reason {r}"

fn outcome false
  "the callback's group took the failure"

fn outcome v
  v

pub play = print (outcome (testing/when_failed (mine 1 .? (e -> lam e)) passed))
  .> (_ -> print (outcome (testing/when_failed annotated passed)))

annotated = mine 1 .! (e -> lam e)
