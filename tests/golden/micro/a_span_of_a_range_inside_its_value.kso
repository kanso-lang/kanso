import "std/text"

# `span_of` answers a span when the range lies inside the value and none
# when it does not, counting the way `slice` counts. An empty range, `to` one
# less than `from`, may sit anywhere from the start to one past the end.
fn shown none
  "none"

fn shown run
  "{run.from}..{run.to} <{text/utf8 (text/slice run)}>"

# A span of a string slices to a string.
fn word none
  "none"

fn word run
  text/slice run

bs = text/bytes "kanso"

pub play = print (shown (text/span_of bs 2 4))
  .> (_ -> print (shown (text/span_of bs 1 5)))
  .> (_ -> print (shown (text/span_of bs 3 2)))
  .> (_ -> print (shown (text/span_of bs 6 5)))
  .> (_ -> print (shown (text/span_of bs 4 6)))
  .> (_ -> print (shown (text/span_of bs 0 2)))
  .> (_ -> print (shown (text/span_of bs 7 6)))
  .> (_ -> print (shown (text/span_of bs 4 2)))
  .> (_ -> print (word (text/span_of "kanso" 2 3)))
