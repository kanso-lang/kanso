# Two bytes appended one after the other to a builder the function owns are
# one call that asks for room once and writes both, in order. `escaped` writes
# a backslash and then a letter for each of its steps, so a pair written the
# wrong way round, or one byte short, shows in the text.
import "std/io"
import "std/text"

fn escaped acc 0
  acc

fn escaped acc n
  escaped (text/append (text/append acc 92) 110) (n - 1)

fn shown (err _)
  "refused"

fn shown s
  s

pub play = io/write "{shown (text/utf8 (escaped (text/bytes "") 3))}\n"
