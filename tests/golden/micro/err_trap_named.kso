# the most specific arm wins and the typeset root catches the rest: a leaf
# reason type outranks a typeset that contains it.
#
# The reasons reach these arms through `std/testing`'s `when_failed`, which is
# foreign to this module and therefore licensed to separate a reason from its
# failure. Under gavel 24 a module cannot match an err it raised itself.
import "std/testing"

type quota_torn
  limit

type slow_lane
  wait

type lane_err quota_torn slow_lane

fn fetch 1
  err (quota_torn 99)

fn fetch 2
  err (slow_lane 7)

fn fetch n
  "plain {n}"

fn named q:quota_torn
  "quota: limit {q.limit}"

fn named e:lane_err
  "lane trouble: {e}"

pub play =
  print (testing/when_failed (fetch 1) named)
  >> print (testing/when_failed (fetch 2) named)
  >> print "ok: {fetch 3}"
