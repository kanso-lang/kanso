# What byte data does now that it is a value rather than a list that happened
# to hold numbers. The gavel of 2026-08-23 took the coercion away; everything
# here is what is left, and every line answers the same on all three engines.
#
# The render is the one place a list and bytes still look alike: brackets and
# numbers, because that is what a reader wants to see. What changed is what a
# function will accept, not what it prints.
import "std/text"

b = text/bytes "hi there"

fn shown (err reason)
  "{reason}"

fn shown other
  "{other}"

pub play = print "made: {b}"
  .> (_ -> print "length: {length b}")
  .> (_ -> print "index: {b[1]} {b[3]} {b[99]}")
  .> (_ -> print "slice: {text/slice b 1 2}")
  .> (_ -> print "utf8: {text/utf8 b}")
  .> (_ -> print "utf8 of a list: {text/utf8 [65 66]}")
  .> (_ -> print "built: {text/to_bytes [104 105]}")
  .> (_ -> print "built and read: {text/utf8 (text/to_bytes [104 105])}")
  .> (_ -> print "append a string: {text/append (text/bytes "a") "bc"}")
  .> (_ -> print "append bytes: {text/append (text/bytes "a") z}")
  .> (_ -> print "append a byte: {text/append (text/bytes "a") 66}")
  .> (_ -> print "find2: {text/find2 (text/bytes "abcd") 1 99 100}")
  .> (_ -> print "find2_below: {text/find2_below abcd 1 99 100 98}")
  .> (_ -> print "to_int: {text/to_int (text/bytes "42")}")
  .> (_ -> print "to_float: {text/to_float (text/bytes "1.5")}")
  .> (_ -> print "equal to its numbers: {b == numbers}")
  .> (_ -> print "equal to itself: {b == text/bytes "hi there"}")

z = text/bytes "z"

abcd = text/bytes "abcd"

numbers = [104 105 32 116 104 101 114 101]
