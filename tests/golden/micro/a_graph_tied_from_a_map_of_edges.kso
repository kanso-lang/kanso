import "std/list"
import "std/text"

# The ruling's second shape: links read from a map of edges. A town's roads
# are a list built from data, `list/to_list (list/map ... ref)`, which makes
# every reference inside the maker. The graph has a cycle (ash, cedar, ash)
# and a town two roads lead to, and `trail` follows every road to a depth, so
# it stops on the cycle.
type town
  name
  roads

edges = { "ash":["birch" "cedar"] "birch":["cedar"] "cedar":["ash"] }

fn roads_of none
  []

fn roads_of names
  names

fn make name ref
  town name (list/to_list (list/map (roads_of edges[name]) ref))

fn trail (town name _) 0
  name

fn trail (town name roads) depth
  "{name} ({ahead roads (depth - 1)} )"

fn ahead roads depth
  said = list/map roads (to -> " {trail to depth}")
  text/join (list/to_list said) ""

fn from none
  "no such town"

fn from t
  trail t 3

pub play =
  towns = list/tie (keys edges) make
  print (from towns["ash"])
