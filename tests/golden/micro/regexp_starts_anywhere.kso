import "std/regexp"

pub play = print "negated:  {regexp/find "[^a]+" "aaabc"}"
  .> (_ -> print "optional: {regexp/find "x?y" "zzy"}")
  .> (_ -> print "star:     {regexp/find "a*b" "zzb"}")
  .> (_ -> print "anchor:   {regexp/match? "^ab" "ab"}")
  .> (_ -> print "alt any:  {regexp/find "(a|.)b" "zb"}")
  .> (_ -> print "blind:    {regexp/find "(?i)cat" "a CAT"}")
