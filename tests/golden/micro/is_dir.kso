import "std/os"

# `exists` answers true for both a file and a directory, so walking a tree
# needs the one that says which: a name to descend into, or a file to read.
pub play =
  os/is_dir "listing" . show
  >> os/is_dir "listing/alpha.txt" . show
  >> os/is_dir "listing/nope" . show
  >> os/exists "listing/alpha.txt" . show

pub fn show v
  print "{v}"
