# `put xs i v` on a list answers the list with element i replaced, 1-based
# as `xs[i]` reads it, and none for a position outside the list. A list the
# caller still holds is copied; one nobody else holds is written where it
# stands, including one that shares its buffer with a shorter list a push
# was made from, and a literal a function writes into on every call.
fn squares xs i n
  return xs if i > n
  squares (put xs i (i * i)) (i + 1) n

fn zeros 0 xs
  xs

fn zeros n xs
  zeros (n - 1) (push xs 0)

fn twice xs i
  return xs if i > 2
  twice (put xs i 0) (i + 1)

fn row n
  put [0 0 0] n 1

fn shared n
  a = push (push (push [] n) 2) 3
  b = push a 4
  c = twice b 1
  e = push a 5
  "{a} {c} {e}"

pub play =
  xs = [1 2 3]
  big = 99999999999999999999
  print "{put xs 2 9} {xs} {put [1 2 3] 3 "c"} {put xs 1 [4 5]}"
  print "{put xs 0 9} {put xs 4 9} {put xs -1 9} {put xs big 9} {put [] 1 9}"
  print "{squares (zeros 6 []) 1 6} {shared 1}"
  print "{row 1} {row 2} {row 3}"
  print "{put { "a":1 } "b" 2}"
