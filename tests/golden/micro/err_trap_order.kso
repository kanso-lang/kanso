# specificity, not declaration order, picks the err arm: the typeset root
# is declared first and the leaf still wins
type quota_torn
  limit

type slow_lane
  wait

type lane_err quota_torn slow_lane

fn fetch _
  err (quota_torn 99)

fn handle (err e:lane_err)
  "root: {e}"

fn handle (err q:quota_torn)
  "leaf: limit {q.limit}"

pub play = print (handle (fetch 0))
