# specificity, not declaration order, picks the arm: the typeset root is
# declared first and the leaf still wins.
#
# The reason reaches these arms through `std/testing`'s `when_failed`, which is
# foreign to this module and therefore licensed to separate a reason from its
# failure. Under gavel 24 a module cannot match an err it raised itself.
import "std/testing"

type quota_torn
  limit

type slow_lane
  wait

type lane_err quota_torn slow_lane

fn fetch _
  err (quota_torn 99)

fn named e:lane_err
  "root: {e}"

fn named q:quota_torn
  "leaf: limit {q.limit}"

pub play = print (testing/when_failed (fetch 0) named)
