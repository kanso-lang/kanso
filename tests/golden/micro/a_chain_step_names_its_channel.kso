# The three chain words have fused spellings in chain position: `.>` is
# `bind`, `.!` is `annotate` and `.?` is `rescue`, the chain dot plus one
# character of channel. Each desugars to its word, so the subjects here are
# settled failures, which is what lets the page run this one: no world has to
# refuse anything for a channel to carry something. `told` is a group handed
# over as a bare right-hand side; the lambdas are the other bare form, and
# `settled` chains two of the words with a group between them.
#
# `settled` ends at its `.!`. The err that step builds is this module's own,
# and a `.?` written here would hand it on rather than enter its callback —
# the rescue licence is foreign-only — so the annotated failure is read the
# way a test reads one, through `std/testing`, which is foreign to this file.
import "std/json"
import "std/testing"

fn told (err r)
  "rescued: {r.reason}"

fn told v
  "decoded {length v} values"

fn add_one x
  x + 1

fn count_of xs
  length xs

fn settled text
  json/decode text .> count_of .! (e -> "settled: {e.reason.reason}")

pub play =
  print (json/decode "[1, 2" .? told)
  >> print (json/decode "[1, 2]" .> told)
  >> print (json/decode "[1, 2]" .? told)
  >> print (3 .> add_one .> (x -> x * 2))
  >> print (settled "[1, 2, 3]")
  >> print (testing/when_failed (settled "[1, 2") (r -> "annotated: {r}"))
