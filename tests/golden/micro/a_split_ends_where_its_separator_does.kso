# The ways a split can end: a separator that matches nothing at all, one that
# stops occurring, one at the very end, and patterns that can match the empty
# string, which split steps past one position at a time.
import "std/regexp"

pub play = print "none:     {regexp/split ",," "abc"}"
  .> (_ -> print "stops:    {regexp/split "," "a,b,cdef"}")
  .> (_ -> print "at end:   {regexp/split "," "a,b,"}")
  .> (_ -> print "star:     {regexp/split "x*" "abc"}")
  .> (_ -> print "star mid: {regexp/split "x*" "axxbc"}")
  .> (_ -> print "optional: {regexp/split "-?" "a-b"}")
  .> (_ -> print "empty in: {regexp/split "" "ab"}")
