import "std/list"

# `tie!` is for links the program wrote itself, so a broken one is a failure
# inside the box it answers: `.>` opens the box on success and `.?` reaches
# the failure.
type node
  id
  next

fn next_of 1
  2

fn next_of _
  1

fn tie_from ids
  list/tie! ids (id ref -> node id (ref (next_of id)))
    .> (nodes -> "tied {length nodes}")
    .? (e -> e.reason)

pub play = tie_from [1 2] .> print .> (_ -> tie_from [1 3] .> print)
