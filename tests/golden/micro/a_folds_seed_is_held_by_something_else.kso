# A fold writes into its seed on the first step, so licensing that write in
# place needs the SEED to be uniquely owned as well as the folder to be
# well shaped. Until 2026-09-09 the licence in src/linear.rs asked only about
# the folder, and a seed something else still held was written through: this
# program printed `first: 2` on native against the interpreter's `first: 1`.
#
# THE SHAPE THAT REACHES IT is an outer fold whose accumulator carries both a
# map and a record of what that map held at each step. On a step with nothing
# to do the inner fold hands the map straight back, so the stored copy IS the
# accumulator, and the next step's write lands in both. Neither fold on its own
# does it: a write outside a loop can be traced to a literal, and a folder
# whose seed is built where it stands owns it.
#
# THE LAST LINE IS THE CASE THAT MUST STAY IN PLACE. A seed born at the call is
# nobody else's and the fold may write through it, which is what the encode
# path's byte builder depends on. Without it this fixture would pass under a
# licence that had simply been switched off.
import "std/list"

fn stepped acc k
  now = list/fold (bump_on k) acc[1]! (m _ -> put m "n" 2)
  [now (put acc[2]! k now)]

fn bump_on "b"
  ["once"]

fn bump_on _
  []

seed = [(put {} "n" 1) {}]

walked = list/fold ["a" "b"] seed stepped

held = walked[2]!

first = held["a"]!

second = held["b"]!

fresh = list/fold ["once"] (put {} "n" 1) (m _ -> put m "n" 2)

pub play =
  print "first: {first["n"]!}"
  print "second: {second["n"]!}"
  print "fresh: {fresh["n"]!}"
