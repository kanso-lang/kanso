# Making a directory that is already there succeeds, the way `mkdir -p` does,
# so a generator that runs twice is the ordinary case rather than an error.
# `.` is always there, which keeps this from leaving anything behind.
import "std/os"

pub play = made

made = os/make_dir "." . (_ -> told)

told = os/is_dir "." . said

fn said yes
  print "{yes}"
