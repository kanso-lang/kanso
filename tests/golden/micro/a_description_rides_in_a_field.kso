# A description held in a record field and read back out is still a
# description: the record is built with it, the field is read after, and the
# read is answered as `play`'s description, which the runner executes.
import "std/io"

type cell
  n

fn opaque v
  v

d = io/write "a\n" .> (_ -> io/write "b\n")

pub play =
  c = cell (opaque d)
  c.n
