# The plain dot is an application: `x . f` is `f x`, and a box handed through
# it stays a box. `held` receives the description itself and hands it back,
# so the interpolation renders `<io>`, `.>` binds what `held` handed on, and
# `.?` opens the failure channel of a read that never found its file. The
# words are the only doors; the dot opens nothing.
import "std/math"
import "std/os"

fn held e
  e

fn shown e
  "held {e}"

pub play =
  print (shown (math/random 6 . held))
  >> math/random 6 . held .> (n -> print "{n < 6}")
  >> os/read_file! "missing.txt" . held .? (_ -> "no file") .> print
