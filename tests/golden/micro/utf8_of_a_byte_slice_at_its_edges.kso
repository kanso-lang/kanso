# `utf8` over a `slice` is fused into one call, and the bytes container is the
# arm the fusion exists for. Since a range past the end answers none (#1890),
# a program dispatches on the slice before it decodes, and the door is reached
# from the standard library's own measured ranges.
#
# Every range the door's clamp refused is below, spelled the way a program
# spells it now, and so is each side of the validity test: a sequence taken
# whole, the same sequence cut in half, and a lone continuation byte.
import "std/text"

b = text/bytes "hi there"

# "hé" — 0x68 0xc3 0xa9, so byte 2 opens a two-byte sequence and byte 3
# finishes it.
w = text/bytes "hé"

fn told none
  "none"

fn told (err _)
  "refused"

fn told s
  "{s}"

fn decoded none
  none

fn decoded piece
  text/utf8 piece

pub play = print "two bytes: {told (decoded (text/slice b 1 2))}"
  .> (_ -> print "one byte: {told (decoded (text/slice b 3 3))}")
  .> (_ -> print "the whole of it: {told (decoded (text/slice b 1 8))}")
  .> (_ -> print "the last byte: {told (decoded (text/slice b 8 8))}")
  .> (_ -> print "from below one: {told (decoded (text/slice b 0 2))}")
  .> (_ -> print "backwards: {told (decoded (text/slice b 4 2))}")
  .> (_ -> print "past the end: {told (decoded (text/slice b 7 9))}")
  .> (_ -> print "wholly past the end: {told (decoded (text/slice b 12 14))}")
  .> (_ -> print "a sequence whole: {told (decoded (text/slice w 1 3))}")
  .> (_ -> print "a sequence cut: {told (decoded (text/slice w 1 2))}")
  .> (_ -> print "its tail alone: {told (decoded (text/slice w 3 3))}")
  .> (_ -> print "a list falls through: {told (decoded listed)}")

listed = text/slice [104 105] 1 2
