type spot
  from
  to

# A dot after `]` reads a field of the element. `]` answers a box, and the
# box takes `.>`: the element reaches the function on the other side, and a
# dot after that function reads a field of what it answered.
pub play =
  xs = [(spot 1 2) (spot 3 4)]
  print "field {xs[1].from} {xs[2].to}"
  >> xs[1] .> shown .> (s -> print "still a pipe {s}")
  >> print "chained {xs[2].from + xs[1].to}"

fn shown s
  "({s.from},{s.to})"
