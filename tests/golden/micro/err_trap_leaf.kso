# an arm naming the reason type reads its fields; a plain value takes the
# value path untouched.
#
# The reason reaches that arm through `std/testing`'s `when_failed`, which is
# foreign to this module and therefore licensed to separate a reason from its
# failure. Under gavel 24 a module cannot match an err it raised itself, so
# the ladder this pins is over reason TYPES, which is the half that survives
# inside one package.
import "std/testing"

type quota_torn
  limit

fn fetch 1
  err (quota_torn 99)

fn fetch n
  "plain {n}"

fn named q:quota_torn
  "quota: limit {q.limit}"

pub play =
  print (testing/when_failed (fetch 1) named)
  >> print "ok: {fetch 3}"
