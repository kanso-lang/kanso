# The bytes gavel's second rider: the constructor ships with the coercion's
# removal, so byte data stays writable, and it refuses loudly outside 0-255
# rather than keeping the low byte the way `append` does for a single number.
#
# The err is born in std/text, where the builtin is called, so under gavel 24
# this module may match it. `when_failed` reads the reason out.
import "std/testing"
import "std/text"

fn as_text reason
  "{reason}"

fn shown v
  "{v}"

over = text/to_bytes [104 300]

under = text/to_bytes [-1]

wrong = text/to_bytes ["a"]

pub play = print "in range: {shown (text/to_bytes [104 105])}"
  .> (_ -> print "out of range: {testing/when_failed over as_text}")
  .> (_ -> print "negative: {testing/when_failed under as_text}")
  .> (_ -> print "not a number: {testing/when_failed wrong as_text}")
