# A bare err is data, and an `(err _)` arm matches it anywhere — in the
# module that raised it as in any other. Ruled 2026-09-15 ("the box is
# explicit, an err is a value"), which retired the 2026-08-24 rule this
# fixture used to pin: until then an err skipped every arm its own hako
# wrote, at match time, on all three engines.
#
# Three lines, one rule.
#
#   1. the arm still works, on a value
#   2. a foreign rescuer still reads the reason — `when_failed` is std's, so
#      this module's failures are not its own and it never needed a licence
#   3. the module's own arm fires on the module's own err: `mine own` answers
#      "rescued 99", and the foreign rescuer, handed a string, has nothing to
#      rescue and answers false
#
# If line 3 ever read "foreign reads 99" the arm would have been skipped and
# the err would have bubbled past its own module's dispatch, which is the
# behaviour the ruling retired.
import "std/testing"

type torn
  limit

fn fetch 1
  err (torn 99)

fn fetch n
  "plain {n}"

fn mine (err t:torn)
  "rescued {t.limit}"

fn mine v
  "value {v}"

fn limit_of r
  "foreign reads {r.limit}"

own = fetch 1

pub play =
  print "own arm on a value: {mine (fetch 2)}"
  >> print "foreign rescue: {testing/when_failed own limit_of}"
  >> print "past the own arm: {testing/when_failed (mine own) limit_of}"
