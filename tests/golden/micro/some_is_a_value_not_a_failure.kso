# `some` means a value that is not none. It used to mean "not none", full
# stop, which let an arm that names no err at all take a foreign failure and
# answer whatever it liked — an unmarked rescue, reachable without writing
# `err` anywhere and without the destructuring form that hands out a reason.
#
# The three engines disagreed about it too. The interpreter took the
# annotation and swallowed the failure; wasm took it and swallowed it; native
# refused the annotation outright with `unknown type `some``, at build time,
# in a message about a backend — the declare for its check sat in the preamble
# with nothing behind it.
#
# So: a failure never reaches the `some` arm. A value still does, which is
# what the annotation is for. A failure passes every arm (#2087), and the
# `some` arm is the one this pins.
import "std/testing"
import "std/text"

fn as_text reason
  "{reason}"

fn taken _:some
  "the some arm took it"

fn taken v
  "a value: {v}"

fn bytes_of n
  text/to_bytes [(n + 300)]

refused = bytes_of 1

broken = taken refused

fine = taken 7

pub play = print "failure: {testing/when_failed broken as_text}"
  .> (_ -> print "value: {fine}")
