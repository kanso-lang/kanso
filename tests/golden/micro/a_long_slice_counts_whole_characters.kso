import "std/text"

# A slice that starts or ends far into multibyte text counts its way there in
# blocks of sixty-four bytes. A block can end partway through a character, and
# the count steps back to that character's first byte rather than counting it
# twice or losing it. Each text below puts a block's end inside a character:
# one ascii byte and then two-byte characters, three-byte characters from the
# start, and four-byte characters after three ascii bytes.
fn shown none
  "none"

fn shown s
  "{length s} [{s}]"

# the whole of a string is inside it, so a none here is a bug
fn whole none
  err "the whole of a string answered none"

fn whole s
  length s

fn grown _ 0 acc
  text/join acc ""

fn grown s n acc
  grown s (n - 1) (push acc s)

fn repeated s n
  grown s n []

two = text/join ["a" (repeated "é" 100) "z"] ""

three = text/join [(repeated "€" 100) "abc"] ""

four = text/join ["abc" (repeated "😀" 100) "z"] ""

lines = [
  "two, the whole: {whole (text/slice two 1 102)}"
  "two, the tail: {shown (text/slice two 99 102)}"
  "two, a middle: {shown (text/slice two 66 67)}"
  "three, the whole: {whole (text/slice three 1 103)}"
  "three, the tail: {shown (text/slice three 99 103)}"
  "three, past the end: {shown (text/slice three 99 104)}"
  "four, the tail: {shown (text/slice four 101 104)}"
  "four, one character: {shown (text/slice four 68 68)}"
]

pub play = print (text/join lines "\n")
