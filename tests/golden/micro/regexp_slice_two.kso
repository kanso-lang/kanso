import "std/regexp"

pub play = print "class:     {regexp/find "[a-z]+" "xabcde 12"}"
  .> (_ -> print "bounded:   {regexp/find "[a-z]\{3,5}" "xabcde 12"}")
  .> (_ -> print "exact:     {regexp/find "[0-9]\{4}" "12 3456"}")
  .> (_ -> print "at least:  {regexp/find "a\{2,}" "baaad"}")
  .> (_ -> print "noncap:    {regexp/find "(?:ab)+" "xababy"}")
  .> (_ -> print "ahead yes: {regexp/find "foo(?=bar)" "foobar foobaz"}")
  .> (_ -> print "ahead no:  {regexp/find "foo(?!bar)" "foobar foobaz"}")
