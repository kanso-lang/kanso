import "std/regexp"

pub play = print "literal:     {regexp/match? "cat" "a cat sat"}"
  .> (_ -> print "miss:        {regexp/match? "dog" "a cat sat"}")
  .> (_ -> print "dot star:    {regexp/find "c.t" "a cat sat"}")
  .> (_ -> print "class:       {regexp/find "[0-9]+" "abc 4711 xyz"}")
  .> (_ -> print "negated:     {regexp/find "<[^>]+>" "hi <b>there</b>"}")
  .> (_ -> print "alternation: {regexp/find "cat|dog" "a dog sat"}")
  .> (_ -> print "anchor:      {regexp/match? "^a" "a cat"}")
  .> (_ -> print "boundary:    {regexp/find "\\bsat\\b" "a cat sat"}")
  .> (_ -> print "lazy:        {regexp/find "<.*?>" "<b>x</b>"}")
  .> (_ -> print "greedy:      {regexp/find "<.*>" "<b>x</b>"}")
  .> (_ -> print "all:         {regexp/find_all "[a-z]+" "one two three"}")
  .> (_ -> print "replace:     {regexp/replace_all "[0-9]" "a1b2c3" "#"}")
  .> (_ -> print "split:       {regexp/split "\\s+" "one  two   three"}")
