# The door the executor did not have. A failure born at the edge — a file that
# is not there — used to ride past every continuation to the endpoint, and
# ch05 taught that as the design: an arm waiting downstream never heard about
# it. `rescue` is the one step that does hear, so this program answers instead
# of dying.
import "std/os"

fn orders (err _)
  "no orders yet"

fn orders text
  "yesterday: {text}"

pub play = rescue (os/read_file "no-such-file.txt") orders . print
