# A deep recursion that enters a second recursion at every level runs out of
# stack inside whichever one is on top when the stack ends, and the engines
# end at different depths. The outermost cycle still running is the same on
# both, so the report names it: `big`, by its call to itself (kanso#1991).
fn small 0
  0

fn small k
  1 + small (k - 1)

fn big n
  1 + big (n + small 3)

pub play = print (big 0)
