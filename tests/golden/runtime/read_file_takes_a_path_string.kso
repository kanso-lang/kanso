# A literal is refused at compile time now, naming the argument and where
# it is, so this hands the builtin a value through a binding the check
# cannot see through. That is the shape a real program has when a value
# turns out to be the wrong kind at run time, and it is the only route
# left to the builtin's own refusal.
import "std/io"

pub play =
  n = 5
  io/read_file n
