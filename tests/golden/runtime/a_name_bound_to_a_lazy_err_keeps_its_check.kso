# `grown` is a lazy binding that forces to an err. The `125` arm binds it to
# `xs`, which a match may do, since the match sees the thunk and not the err,
# and `size_of` forces it. The err has to come out of that read on every
# engine. Native used to drop the FAIL bit from any name a pattern bound, so
# `size_of` forced the thunk and read the err's payload as a list's length,
# and the program printed `size 6`.
#
# The err is the runtime's: `text/to_int` refusing text it cannot read. A
# raised one handed to `pick`, which has no arm for it, does not compile,
# bound to a name or not (#1884).
import "std/text"

fn checked xs n
  return text/to_int "{n}x" if n > 2
  push xs n

fn pick 125 xs
  "size {size_of xs}"

fn pick _ _
  "other"

fn size_of xs
  length xs

pub play =
  grown = checked [] 5
  print (pick 125 grown)
