# A stack the program walks off the end of is reported, not died in silently.
# The leftover work is a float on purpose: the accumulator rewrite turns an
# integer operand into a loop, and a shape it reaches reports nothing at all,
# which would leave this diagnostic with no fixture and nobody the wiser.
fn weigh 0
  0.0

fn weigh n
  n * 1.5 + weigh (n - 1)

pub play = print "sum {weigh 1000000}"
