# The index POSITION, not the base — a description used as a key reaches the
# same check and owes the same sentence.
# The check refuses a provable box here now (the errors corpus pins that
# sentence), so the box travels through a list, where nothing can prove it.
import "std/io"

pub fn opaque v
  (push [] v)[1]!

d = io/write "a\n" >> io/write "b\n"

xs = [1 2 3]

pub play = print "{xs[(opaque d)]}"
