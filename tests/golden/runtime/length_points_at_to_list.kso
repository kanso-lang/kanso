# A lazy sequence is not a list, and refusing it is right — `list/naturals`
# has no length to count. But the reader who wrote `length (list/map …)` is
# one call away from what they wanted, and the message used to stop at what
# it would not accept. The check refuses the call written out; a sequence
# held by name reaches the run.
import "std/list"

pub play =
  seq = list/map [1 2 3] (n -> n)
  print "{length seq}"
