# The knot ties: `ring` sits in a constructor's slot, so the cell completes at
# the constructor and `ring.v` answers the record. What `plus` then reaches is
# an operator with a record on its left, and that is what it says. Gavel 20
# chose these semantics over the blackhole the two compiled engines used to
# report — the browser had them right all along.
#
# Beside it, a_guarded_shape_that_is_not_a_knot keeps the blackhole: there the
# name is demanded to BUILD the thing rather than stored in its slot.
type cell
  v

ring = cell ring

fn plus x
  x + 1

pub play = print "{plus ring.v}"
