# wrap_err adds a reason and keeps what it was told, so the endpoint prints
# both links of the chain.
#
# The err it wraps is std/text's, not this module's. A rescue may open only a
# failure another package raised, and wrap_err takes the err its callback is
# handed, out of its box (#2087); what it answers is a box again, with the
# original as its cause.
import "std/text"

type config_bad
  file

fn low_read _
  text/utf8 [255]

fn relabel e:err
  wrap_err (config_bad "app.conf") e

pub play = low_read 0 .? relabel
