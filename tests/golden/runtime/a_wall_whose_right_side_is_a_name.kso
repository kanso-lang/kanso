import "std/io"

# `never_describes` in check.rs refuses a literal, a list, a map, a lambda or
# a direct call on either side of `>>`. A bare NAME is none of those, so this
# reaches the run, and every engine has to name the same fault when it does —
# the page reaches it by a different path, because GAVEL 15 defers the right
# side and nothing knows what it answers until the wall gets there.
x = 2

pub play = io/write "one" >> x
