# the cohort fires through a bound, branch-chosen pipe: inference tracks
# a desc-valued binding's yield through the if and the binding, so the
# decode call still proves its argument a string and the construction
# garbage dies at the pop. cohort_frees pins the license firing.
import "std/io"
import "std/json"
import "std/os"

fn pick n
  source = if (n > 0) (os/read_file! "escapes.json") io/stdin
  source .> report

fn report text
  doc = json/decode text
  print "held {size_of doc}"

# escapes.json is this repository's own document
fn size_of none
  err "escapes.json is not json"

fn size_of v
  length v

pick 1
