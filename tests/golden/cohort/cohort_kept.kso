import "std/text"

fn grow acc 0
  acc

fn grow acc n
  grow (text/append acc "0123456789abcdef") (n - 1)

# the slice ends exactly at the end of `bulk`, so it is never none
fn stamp none
  0

fn stamp bs
  length (text/utf8 bs)

fn trimmed _
  bulk = grow (text/bytes "") 150000
  text/slice bulk 1 2400000

print "chars {stamp (trimmed 0)}"
