import "./lib"

# A raised err handed to a group with no arm for it does not compile, bound to
# a name or not (#1884), so `joined` names the failure and hands it on. Its
# dispatch is what this fixture pins: the two words of a register-returned
# answer can hold a failure, and the arm that destructures a `pair` must not
# take one.
made = lib/make 0

print (lib/joined made)
