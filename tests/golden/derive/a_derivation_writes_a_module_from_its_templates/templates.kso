import "std/derive"
import "std/list"
import "std/text"

# Each `.tpl` file in a module becomes a function of that module, named after
# the file, that answers the file's text with `name` filled in. The module's
# directory holds no kanso source of its own (#2280).
pub fn views p
  list/fold p.modules [] (acc m -> list/concat acc (written m))

fn written m
  list/fold (keys m.files) [] (acc f -> added acc m.name f m.files[f])

fn added acc _ _ none
  acc

fn added acc m f body
  return acc if not text/ends_with? f ".tpl"
  stem = text/join (text/split f ".tpl") ""
  push acc (derive/define m "pub fn {stem} name\n  \"{text/trim body}\"\n")
