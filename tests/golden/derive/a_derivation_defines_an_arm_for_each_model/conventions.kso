import "std/derive"
import "std/list"

# A record type in a module with a `show` action gets a `path_to` arm, written
# into the module that declares the type, so `path_to post` finds its route by
# dispatch on the record.
pub fn path_to _
  "no route"

pub fn routed p
  list/fold p.modules [] (acc m -> list/concat acc (arms m))

fn arms m
  return [] if not list/any? m.functions (f -> f.name == "show")
  list/to_list (list/map m.records (r -> arm m.name r.name))

fn arm m t
  body = "\"/{m}/\{x.id}\""
  derive/define "{m}/{t}" "fn conventions/path_to x:{t}\n  {body}\n"
