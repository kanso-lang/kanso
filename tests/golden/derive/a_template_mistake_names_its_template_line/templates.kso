import "std/derive"
import "std/list"
import "std/text"

# Each `.tpl` file becomes a function of its module. The line above its
# string names the template line it was written from, so a mistake in the
# template is reported there as well as in the derived source.
pub fn views p
  list/fold p.modules [] (acc m -> list/concat acc (written m))

fn written m
  list/fold (keys m.files) [] (acc f -> added acc m.name f m.files[f])

fn added acc _ _ none
  acc

fn added acc m f body
  return acc if not text/ends_with? f ".tpl"
  stem = text/join (text/split f ".tpl") ""
  text = "pub fn {stem} name\n  # from {f}:1\n  \"{text/trim body}\"\n"
  push acc (derive/define m text)
