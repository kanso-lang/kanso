import "std/derive"
import "std/list"

# An arm for a module the derivation was not shown has nowhere to go: std/list
# is not one of the app's modules.
pub fn path_to _
  "no route"

pub fn routed p
  list/fold p.modules [] (acc m -> list/concat acc (arms m))

fn arms m
  return [] if not list/any? m.functions (f -> f.name == "show")
  list/to_list (list/map m.records (r -> arm m.name r.name))

fn arm m t
  body = "\"/{m}/\{x.id}\""
  derive/define "list/{t}" "fn conventions/path_to x:{t}\n  {body}\n"
