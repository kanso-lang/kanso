# A slice is `[]T`, and `T[]` compiled too — two spellings for one type, in a
# language whose whole position is that the canonical form IS the grammar.
# design/type-syntax.md rules the postfix out for a reason it states: `[]T`
# reads left to right and composes without backtracking, where `T[]` reads
# inside-out the moment anything nests.
fn take xs:int[]
  length xs

fn count m:map[string int]
  length (entries m)

pub play = print "{take [1 2 3]} {count { "a":1 }}"
