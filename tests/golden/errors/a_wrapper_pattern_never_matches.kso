# A wrapper has no fields of its own, so a pattern that takes one apart can
# never match. `(id n)` for `type id int` and `(tag p)` for a wrapper of a
# record were passed over in silence on every engine, and the value fell to
# the next arm. Found on 2026-09-28 while teaching the generated-program
# differential subtypes; `n:id` is the arm that takes one.
type id int

type pt
  n

type tag pt

fn size (id n)
  "id {n}"

fn size (tag p)
  "tag {p.n}"

fn size _
  "other"

pub play = print "{size (id 3)} {size (tag (pt 4))}"
