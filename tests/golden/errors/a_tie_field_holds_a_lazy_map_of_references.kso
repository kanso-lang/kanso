import "std/list"

# Ruled 2026-10-11: a field may hold a list of references built from data, as
# `list/to_list (list/map xs ref)`, which calls `ref` for every element inside
# the maker. A bare `list/map` is lazy: the field would hold a record that
# still has `ref` inside it, and every call would come after `list/tie` has
# returned. The check names `list/to_list` instead of letting it run.
type town
  name
  roads

fn make "ash" ref
  town "ash" (list/map ["birch"] ref)

fn make name ref
  town name (list/map ["ash"] ref)

pub play =
  towns = list/tie ["ash" "birch"] make
  print "{length towns}"
