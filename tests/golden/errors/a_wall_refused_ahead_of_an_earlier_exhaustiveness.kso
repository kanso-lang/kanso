import "std/io"

# Both refusals are asked on the second fused descent, and where each one's
# answers are spliced back in is what a reader sees. The wall's answers go in
# where `check_wall_operands` used to push, ahead of the rotation; the
# exhaustiveness answers go in after it. So the wall is reported FIRST even
# though it is the later line, and the order flips if either splice moves.
# Nothing else in the corpus holds one of each.
fn double x
  x * 2

xs = [1 2 3]

fn shout n
  print (double xs[n])

pub play =
  shout 9
  io/write "steeping" >> 2
