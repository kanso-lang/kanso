import "std/math"
import "std/os"

type cell
  n

fn told 0
  "zero"

fn told 1
  "one"

fn held e
  e

pub play =
  print (length os/args)
  >> print (math/random 6 + 1)
  >> print (told (math/random 2))
  >> print (if os/args 1 2)
  >> print os/args[1]
  >> print (math/random 6 == 3)
  >> print (held os/args)
  >> print "{os/args}"
