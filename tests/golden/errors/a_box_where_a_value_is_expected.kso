import "std/math"
import "std/os"

type cell
  n

fn told 0
  "zero"

fn told 1
  "one"

fn held e
  e

# a library function whose tail is a `.>` step answers a box, and so does
# anything that ends in a call of one: its set carries the callback's answer
# beside the description bit, so the tail is what says box
fn load path
  os/read_file path

loaded = load "flavors.txt"

pub play =
  print (length os/args)
  >> print (math/random 6 + 1)
  >> print (told (math/random 2))
  >> print (if os/args 1 2)
  >> print os/args[1]
  >> print (math/random 6 == 3)
  >> print (held os/args)
  >> print "{os/args}"
  >> print (length (os/read_file "flavors.txt"))
  >> print (length (load "flavors.txt"))
  >> print (length loaded)
