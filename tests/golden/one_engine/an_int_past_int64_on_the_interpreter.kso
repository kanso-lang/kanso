# kanso's integers are arbitrary precision. The interpreter holds one in a
# machine word and promotes it to a bignum when an operation would leave the
# word; the native build is int64 and refuses there instead, which the
# differential law allows (directive of 2026-09-30). The micro corpus cannot
# hold this program, because it requires every engine to answer the same.
#
# Each line below lands exactly one step past the int64 boundary, so a
# promotion that came one step late would print a wrapped number here rather
# than raising. That is the one defect the small-integer change can
# introduce, and this is the fixture that watches it.
import "std/list"

big = 9223372036854775807
low = 0 - big - 1
print "one past the largest: {big + 1}"
print "one below the least: {low - 1}"
print "the largest doubled: {big * 2}"
print "the largest added to itself: {big + big}"
print "a square just past: {3037000500 * 3037000500}"
print "the least negated: {0 - low}"
print "the least over minus one: {low / (0 - 1)}"
print "the least squared: {low * low}"
print "a sum that crosses: {list/sum [big 1]}"
print "and back inside: {big + 1 - 1 == big}"
print "ordered past the edge: {big + 1 > big}"
