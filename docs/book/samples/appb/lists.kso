import "std/list"
import "std/text"

xs = [3 1 2]
print "map {list/to_list (list/map xs (n -> n * 10))}"
  .> (_ -> print "select {list/to_list (list/select xs (n -> n > 1))}")
  .> (_ -> print "sort {list/sort xs}")
  .> (_ -> print "sum {list/sum xs}")
  .> (_ -> print "fold {list/fold xs 10 (acc n -> acc * n)}")
  .> (_ -> print "take {list/to_list (list/take list/naturals 4)}")
  .> (_ -> print "zip {list/to_list (list/zip xs ["a" "b" "c"])}")
  .> (_ -> print "tally {list/tally ["oat" "oat" "soy"]}")
  .> (_ -> print "group_by {list/group_by [1 2 3 4] (n -> n - n / 2 * 2)}")
  .> (_ -> print "spread {list/spread xs}")
  .> (_ -> print "push {push xs 4}")
  .> (_ -> print "at {xs[2]}")
  .> (_ -> print "length {length xs}")
  .> (_ -> print "slice {text/slice xs 1 2}")
  .> (_ -> print "concat {text/concat xs [9]}")
