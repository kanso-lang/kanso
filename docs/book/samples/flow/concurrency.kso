import "std/math"
import "std/time"

brew = print "brew: steeping"
  .> (_ -> time/sleep 60)
  .> (_ -> print "brew: poured")

pub play =
  brew
  rolls

fn roll i
  math/random 6 .> (n -> print "roll {i}: a {n + 1}")

rolls = roll 1
  .> (_ -> roll 2)
  .> (_ -> roll 3)
  .> (_ -> roll 4)
  .> (_ -> roll 5)
