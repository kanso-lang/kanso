import "std/math"
import "std/time"

brew = print "brew: steeping"
  .> (_ -> time/sleep 60)
  .> (_ -> print "brew: poured")

pub play = brew
  .> (_ -> roll 1)  # brew runs first now, and every roll
  .> (_ -> roll 2)  # is bound after it, so each one
  .> (_ -> roll 3)  # waits for the steep to finish
  .> (_ -> roll 4)
  .> (_ -> roll 5)

fn roll i
  math/random 6 .> (n -> print "roll {i}: a {n + 1}")
