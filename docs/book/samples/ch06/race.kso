import "std/time"

gyoza = print "gyoza: in the pan"
  .> (_ -> time/sleep 20)
  .> (_ -> print "gyoza: flip")
  .> (_ -> time/sleep 20)
  .> (_ -> print "gyoza: plated")

pub play =
  gyoza
  ramen

ramen = print "ramen: boiling"
  .> (_ -> time/sleep 30)
  .> (_ -> print "ramen: noodles in")
  .> (_ -> time/sleep 30)
  .> (_ -> print "ramen: bowled")
