type joined
  who

type left
  who

type renamed
  after
  before

print (render (joined "clay"))
  .> (_ -> print (render (renamed "kanso" "kai")))
  .> (_ -> print (render (left "mugi")))

fn render (joined who)
  "{who} joined"

fn render (left who)
  "{who} left"

fn render (renamed after before)
  "{before} is now {after}"
