import "../lit"

# The reporting lives here rather than beside the decoder, because the
# decoder refuses a document and says nothing about what a caller does with
# that. A foreign type is named, never destructured (membership crosses an
# import where structure does not), so its fields are read by name.
pub fn show r:lit/parse_failure
  "err at {r.position}: {r.reason}"

pub fn show v
  "ok: {v}"
