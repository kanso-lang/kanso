import "std/text"

pub type parse_failure
  position
  reason

# The first byte chose the arm, so what is left to check is the tail of one
# known keyword, compared where it sits. Reading past the end answers `none`,
# which equals no byte, so a truncated literal needs no length test.
fn alse? cs p
  cs[p + 1] == 97 and cs[p + 2] == 108 and cs[p + 3] == 115 and cs[p + 4] == 101

pub fn decode_literal s
  cs = text/bytes s
  value_for cs[1] cs 1

fn fail p reason
  err (parse_failure p reason)

fn rue? cs p
  cs[p + 1] == 114 and cs[p + 2] == 117 and cs[p + 3] == 101

fn ull? cs p
  cs[p + 1] == 117 and cs[p + 2] == 108 and cs[p + 3] == 108

fn value_for 102 cs p
  matched = alse? cs p
  word matched p false

fn value_for 110 cs p
  matched = ull? cs p
  word matched p "null"

fn value_for 116 cs p
  matched = rue? cs p
  word matched p true

fn value_for none _ p
  fail p "unexpected end of input"

fn value_for c _ p
  fail p "unexpected character `{text/utf8 [c]}`"

fn word true _ v
  v

fn word false p _
  fail p "invalid literal"
