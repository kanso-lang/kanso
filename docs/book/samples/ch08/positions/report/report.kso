import "../pos"

# The err arm lives here rather than beside the decoder, because the decoder
# refuses a document and says nothing about what a caller does with that; the
# reporting sits one package over from the raising. A foreign reason is
# named, never destructured — membership crosses an import where structure
# does not — so its fields are read by name.
pub fn show (err r:pos/parse_failure)
  "err at {r.position}: {r.reason}"

pub fn show v
  "ok: {v}"
