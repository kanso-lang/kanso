import "std/text"

fn lox_num written
  number_text (text/to_float written)

test_number_integral = lox_num "100" == "100" and lox_num "-3" == "-3"

test_number_fraction = lox_num "0.1" == "0.1" and lox_num "-2.5" == "-2.5"

test_number_sum = number_text (0.1 + 0.2) == "0.30000000000000004"

test_number_small = lox_num "0.001" == "0.001" and lox_num "0.00015" == "1.5E-4"

test_number_large =
  below = lox_num "1234567.5"
  below == "1234567.5" and lox_num "12345678.9" == "1.23456789E7"

test_number_powers = lox_num "1e7" == "1.0E7" and lox_num "1e21" == "1.0E21"

test_number_zero = lox_num "0" == "0" and lox_num "-0.0" == "-0"

test_number_special =
  inf = text/to_float "inf"
  number_text inf == "Infinity" and number_text (inf - inf) == "NaN"

test_divide_by_zero =
  negative = divide (0.0 - 1.0) 0.0
  "{divide 1.0 0.0} {negative} {divide 0.0 0.0}" == "inf -inf nan"

test_truthy = not truthy? nil and truthy? 0.0 and truthy? ""

test_equal_java_doubles =
  nan = divide 0.0 0.0
  equal? nan nan and not equal? 0.0 (0.0 * (0.0 - 1.0)) and equal? 2.0 2.0
