import "std/list"
import "std/text"

fn spelled source
  words (lex source)

fn words (err e)
  "error at {e.line}:{e.col}: {e.reason}"

fn words tokens
  text/join (list/to_list (list/map tokens (t -> t.text))) " "

test_lexes_a_rule = spelled "p(X, _) :- q(X)." == "p ( X , _ ) :- q ( X ) . "

test_lexes_numbers = spelled "f(-12, 7)." == "f ( -12 , 7 ) . "

test_lexes_strings = spelled "f(\"a b\")." == "f ( a b ) . "

test_lexes_directives =
  lexed = spelled ".decl e(a)\n.output e"
  lexed == "decl e ( a ) output e "

test_dot_between_facts_is_punctuation =
  lexed = spelled "e(a).e(b)."
  lexed == "e ( a ) . e ( b ) . "

test_skips_comments = spelled "% one\n// two\n/* three\n */ p." == "p . "

test_reports_where_a_string_opened =
  lexed = spelled "p(\"abc"
  lexed == "error at 1:3: a string is never closed"

fn first_line (err _)
  0

fn first_line tokens
  line_of tokens[1]

fn line_of none
  0

fn line_of t
  t.line

test_tracks_lines = first_line (lex "\n\n  p.") == 3
