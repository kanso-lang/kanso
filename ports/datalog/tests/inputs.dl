% Facts read from tab-separated files beside the program, as Soufflé's
% `.input` does, from the files they name.
.decl edge(from: symbol, to: symbol)
.input score "inputs/score.facts"
.input edge "inputs/edge.facts"

path(X, Y) :- edge(X, Y).
path(X, Z) :- path(X, Y), edge(Y, Z).

?- path(a, X).
?- score(X, Y).
.printsize path
.printsize edge
