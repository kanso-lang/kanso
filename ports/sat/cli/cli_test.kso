import "../solver"
import "std/list"
import "std/text"

fn literal_count lines
  words = list/fold lines [] (acc l -> list/concat acc (text/split l " "))
  length (list/to_list (list/reject words (w -> w == "v" or w == "0")))

fn widest lines
  list/max (list/to_list (list/map lines (l -> length l)))

fn shape (options path strategy)
  [path strategy]

fn shape (unusable reason)
  reason

many = list/to_list (list/map (list/take list/naturals 300) (n -> 0 - n))

second_file = "sat: a second file `g.cnf`"

test_option_flags = shape (parsed_options ["--geometric"]) == geometric_set

geometric_set = ["" solver/geometric]

test_option_one_file = shape (parsed_options ["f.cnf"]) == one_file

one_file = ["f.cnf" solver/luby]

test_option_second_file = shape (parsed_options two_files) == second_file

two_files = ["f.cnf" "g.cnf"]

test_option_unknown = shape (parsed_options ["--fast"]) == unknown_option

test_value_lines_end_in_zero = value_lines [1 -2] 1 "v" [] == ["v 1 -2 0"]

test_value_lines_fit = widest wrapped <= 80

test_value_lines_keep_every_literal = literal_count wrapped == 300

unknown_option = "sat: no option `--fast`"

wrapped = value_lines many 1 "v" []
