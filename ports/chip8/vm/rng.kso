import "std/bits"

# CXNN needs random bytes, and a run must be repeatable on every engine, so
# the generator is a plain function of a seed: the 31-bit linear
# congruential generator of the C standard's example `rand`, taking bits 16
# to 23 as the byte.
pub fn next_state s
  s * 1103515245 + 12345 & 2147483647

pub fn byte_from s
  bits/shr s 16 & 255
