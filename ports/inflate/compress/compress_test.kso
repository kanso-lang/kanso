import "../deflate"
import "std/list"
import "std/text"

test_reversed = reversed 6 3 == 3 and reversed 1 8 == 128

test_sink_packs_low_bits_first =
  s = emit (emit empty_sink 5 3) 1 1
  finish s == text/to_bytes [13]

test_sink_spills_whole_bytes =
  s = emit empty_sink 513 10
  s.acc == text/to_bytes [1] and s.bits == 2 and s.count == 2

test_length_slots = length_slot[3] == 1 and length_slot[11] == 9

test_length_slot_258 = length_slot[257] == 28 and length_slot[258] == 29

test_dist_slots = dist_slot 1 30 == 1 and dist_slot 24577 30 == 30

test_links_point_back =
  links = links_of (text/bytes "abcxabcyabc")
  links[1] == 0 and links[5] == 1 and links[9] == 5

test_empty_is_one_fixed_block = deflate_bytes (text/bytes "") == empty_block

empty_block = text/to_bytes [3 0]

test_round_trip_text =
  src = text/bytes "to be or not to be, that is the question: to be"
  (deflate/inflate (deflate_bytes src) 0).data == src

test_round_trip_runs =
  src = text/bytes "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  packed = deflate_bytes src
  (deflate/inflate packed 0).data == src and length packed < 10

# Bytes from 144 up cost nine bits in the fixed code, so forty different
# ones come out larger than storing them.
test_high_bytes_are_stored =
  high = list/take (list/drop list/naturals 149) 40
  src = text/to_bytes (list/to_list high)
  packed = deflate_bytes src
  packed[1] == 1 and (deflate/inflate packed 0).data == src

test_gzip_header =
  packed = gzip_bytes (text/bytes "x")
  text/slice packed 1 3 == text/to_bytes [31 139 8]

test_zlib_header =
  packed = zlib_bytes (text/bytes "x")
  text/slice packed 1 2 == text/to_bytes [120 1]
