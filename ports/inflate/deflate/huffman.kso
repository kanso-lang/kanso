# Canonical Huffman codes, the way puff.c builds and reads them.
#
# A DEFLATE code is sent as one number per symbol: the length of its code in
# bits, zero for a symbol that does not occur. From the lengths alone both
# ends can rebuild the same code, because the codes of one length are
# consecutive integers handed out in symbol order, and each length starts
# where the previous one left off, shifted left by a bit.
#
# So two lists are enough to decode. `counts` holds, for each length from 1
# to 15, how many codes have that length. `symbols` holds the symbols in code
# order: every length-1 symbol, then every length-2 symbol, and so on, each
# group in symbol order.
import "std/bits"
import "std/list"
import "std/text"

# The decoder's answer: the bit offset after the code, and the symbol.
# The running state while codes are handed out: the next code, the table
# cells made so far, and the length of the last code.
type assigning
  code
  table
  width

pub type got
  after
  symbol

pub type huffman
  counts
  fast
  symbols

# What `construct` makes of a list of lengths. `left` is puff's verdict on the
# code: 0 when every bit pattern is used, positive when some are left over
# (an incomplete code), negative when more codes were asked for than the
# lengths allow (over-subscribed).
pub type built
  code
  left
  zeros

maxbits = 15

pub fn construct lengths
  counts = list/take list/naturals maxbits
    . list/map (len -> list/count lengths (l -> l == len))
    . list/to_list
  zeros = list/count lengths (l -> l == 0)
  ordered = sorted_keys lengths
  symbols = list/to_list (list/map ordered (k -> k % 1024))
  code = huffman counts (fast_table ordered) symbols
  built code (spare counts 1 1) zeros

# Symbols sorted by (length, symbol), leaving out the unused ones. A key that
# puts the length above the symbol sorts both at once.
fn sorted_keys lengths
  n = length lengths
  keyed = list/zip lengths (list/take list/naturals n)
    . list/select (p -> p[1] > 0)
    . list/map (p -> sort_key p)
    . list/to_list
  list/sort keyed

fn sort_key pair
  len = nth pair 1
  sym = nth pair 2
  len * 1024 + sym - 1

# How many bit patterns are left unused after every length has taken its
# share: double what was left at the previous length, then subtract the codes
# of this one. Below zero is an over-subscribed set, and puff stops there.
fn spare counts len left
  return left if left < 0 or len > maxbits
  spare counts (len + 1) (left * 2 - nth counts len)

# The fast path, which puff leaves out and zlib's inflate is built on: a
# table indexed by the next nine bits of input, giving the symbol and its
# length for every code of nine bits or fewer. A code of length L fills
# 2^(9-L) slots, one for each value the bits after it might take. Slots
# that begin a longer code hold 0, and those codes are read a bit at a time.
#
# Codes go into the stream most significant bit first, so a slot's index is
# its code with the bits reversed. And with no array to write at an index,
# the table is built as (slot, entry) numbers that are sorted and then
# walked, filling the gaps with zeros.
fast_bits = 9

fn fast_table ordered
  coded = list/fold ordered (assigning 0 [] 0) assign_code
  slots = list/sort coded.table
  fill slots 1 0 []

# Canonical codes: consecutive within a length, and shifted left by one
# for each step up in length.
fn assign_code (assigning code table width) key
  len = key / 1024
  sym = key % 1024
  here = bits/shl code (len - width)
  spread = if (len > fast_bits) table (spread_code table here len sym)
  assigning (here + 1) spread len

fn spread_code table code len sym
  rev = reverse_bits code len 0
  step = bits/shl 1 len
  count = bits/shl 1 (fast_bits - len)
  more = list/take list/naturals count
    . list/map (k -> (rev + (k - 1) * step) * 65536 + sym * 16 + len)
  text/concat table (list/to_list more)

fn reverse_bits _ 0 acc
  acc

fn reverse_bits code n acc
  reverse_bits (bits/shr code 1) (n - 1) (bits/shl acc 1 | (code & 1))

# Walk the sorted slots, writing 0 for any slot no short code reached.
fn fill slots i slot out
  return out if slot == 512
  cell = nth slots i
  here = cell > 0 and cell / 65536 == slot
  return fill slots (i + 1) (slot + 1) (push out (cell % 65536)) if here
  fill slots i (slot + 1) (push out 0)

# One symbol: from the table when its code is short, else a bit at a time.
pub fn decode src bp h
  e = nth h.fast (peek src bp fast_bits + 1)
  return walk src bp h 1 0 0 0 if e == 0
  got (bp + (e & 15)) (bits/shr e 4)

# One symbol, read a bit at a time, puff's `decode`. `code` is the bits read so
# far, `first` the first code of the current length and `index` where that
# length's symbols start in `symbols`. A code shorter than the current length
# would already have been returned, so if `code` falls below `first + count`
# it belongs to this length.
fn walk src bp h len code first index
  return broken bp "no such Huffman code" if len > maxbits
  here = code | peek src bp 1
  count = nth h.counts len
  slot = index + here - first + 1
  return got (bp + 1) (nth h.symbols slot) if here - count < first
  next_first = bits/shl (first + count) 1
  walk src (bp + 1) h (len + 1) (bits/shl here 1) next_first (index + count)
