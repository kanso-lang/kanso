test_put_keeps_spaces = command_of ["put" "k" "a" "b"] == put_cmd "k" "a b"

test_put_empty_value = command_of ["put" "k" ""] == put_cmd "k" ""

test_put_needs_value =
  got = command_of ["put" "k"]
  got == bad_cmd "put takes a key and a value"

test_get = command_of ["get" "k"] == get_cmd "k"

test_get_one_key = command_of ["get" "a" "b"] == bad_cmd "get takes one key"

test_bare_verbs =
  verbs = [(command_of ["list"]) (command_of ["merge"]) (command_of ["dump"])]
  verbs == [list_cmd merge_cmd dump_cmd]

test_unknown = command_of ["frob"] == bad_cmd "unknown command `frob`"

test_script_skips_blanks_and_comments =
  cmds = script_of "# header\n\nput a 1\n  get a  \n"
  cmds == [(numbered (put_cmd "a" "1") 3) (numbered (get_cmd "a") 4)]

test_script_finds_first_bad =
  cmds = script_of "list\nget\nput\n"
  bad = first_bad cmds
  bad.line == 2
