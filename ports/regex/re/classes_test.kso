gapped = normalize [(span_from 7 8) (span_from 1 3)]

merged_sample = normalize [(span_from 5 9) (span_from 1 3) (span_from 4 4)]

test_negate_round_trips = negate (negate gapped) == gapped

test_negate_fills_gaps = negate gapped == [
  (span_from 0 0)
  (span_from 4 6)
  (span_from 9 top)
]

top = max_cp

test_normalize_keeps_gaps = gapped == [(span_from 1 3) (span_from 7 8)]

test_normalize_merges = merged_sample == [(span_from 1 9)]

test_contains = contains? gapped 2 and not contains? gapped 5

test_fold_ascii =
  ascii = [(span_from 65 67) (span_from 97 99)]
  fold_spans [(span_from 97 99)] == ascii

kelvin = [(span_from 75 75) (span_from 107 107) (span_from 8490 8490)]

test_fold_kelvin = fold_orbit 107 == kelvin

test_fold_sigma = fold_orbit 962 == [(span_from 931 931) (span_from 962 963)]

test_fold_digits_alone = fold_spans digits == digits
