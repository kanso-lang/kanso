import "std/text"

# A local environment: the names one call or let* bound, and the environment
# around it. The outermost environment is the marker `top`, whose names live
# in the world's `globals` map, because def! at the top level must be seen by
# every closure that was made before it.
type frame
  outer
  vars

type knot

# The atoms' values, keyed by id. A kanso map would do, except that natively a
# `put` on a map that lives inside the world record copies the whole map, and
# a program with a few thousand atoms (mal-in-mal makes one per environment)
# then spends its time copying. This trie copies only the path to one id:
# the id's bits below its leading 1, lowest first, choose the branches.
type cell
  one
  value
  zero

type no_cell

type top

fn extend env name value
  frame env.outer (put env.vars name value)

fn new_frame outer
  frame outer {}

# Looking a name up answers its value, or none when no frame has it.
fn find_name name top w
  w.globals[name]

fn find_name name (frame outer vars) w
  found_in vars[name] name (frame outer vars) w

fn found_in none name (frame outer _) w
  find_name name outer w

# A closure bound by let* or a local def! carries `knot` for its environment;
# the frame that holds it is the one it closes over, so it gets that frame now.
fn found_in (closure body knot macro meta params rest) _ here _
  closure body here macro meta params rest

fn found_in v _ _ _
  v

# def! at the top level writes the global map; anywhere else it extends the
# frame, and the caller carries the new frame forward.
fn define top name value w
  world w.atoms (put w.globals name value) w.next_id w.out

# --- the world --------------------------------------------------------------
fn emit w line
  world w.atoms w.globals w.next_id (push w.out line)

fn without_output w
  world w.atoms w.globals w.next_id []

fn new_atom value w
  id = w.next_id
  world (cell_put w.atoms id value) w.globals (id + 1) w.out

fn set_atom id value w
  world (cell_put w.atoms id value) w.globals w.next_id w.out

fn deref_atom id w
  cell_get w.atoms id

fn cell_get no_cell _
  nil

fn cell_get (cell one value zero) id
  return value if id == 1
  return cell_get one (id / 2) if id % 2 == 1
  cell_get zero (id / 2)

fn cell_put no_cell id value
  cell_put (cell no_cell nil no_cell) id value

fn cell_put (cell one old zero) id value
  return cell one value zero if id == 1
  return cell (cell_put one (id / 2) value) old zero if id % 2 == 1
  cell one old (cell_put zero (id / 2) value)

fn next_id w
  world w.atoms w.globals (w.next_id + 1) w.out

# --- hash-map keys ----------------------------------------------------------
fn encode_key s:string
  "s{s}"

fn encode_key (kw name)
  "k{name}"

fn encode_key _
  none

fn decode_key key
  rest = text/slice key 2 (length key)
  if (text/slice key 1 1 == "k") (kw rest) rest
