(def! count-down (fn* [n] (if (= n 0) :done (count-down (- n 1)))))
(count-down 20000)
(def! sum-to (fn* [n acc] (if (= n 0) acc (sum-to (- n 1) (+ acc n)))))
(sum-to 20000 0)
(def! ping (fn* [n] (if (= n 0) :ping (pong (- n 1)))))
(def! pong (fn* [n] (if (= n 0) :pong (ping (- n 1)))))
(ping 15001)
(def! deep (fn* [n] (if (= n 0) 0 (+ 1 (deep (- n 1))))))
(deep 5000)
(def! loop-let (fn* [n] (let* [m (- n 1)] (if (< m 0) :out (loop-let m)))))
(loop-let 10000)
(def! loop-try (fn* [n] (if (= n 0) :caught (try* (loop-try (- n 1)) (catch* e e)))))
(loop-try 500)
