(defmacro! unless (fn* [pred a b] `(if ~pred ~b ~a)))
(unless false :yes :no)
(macroexpand (unless x y z))
(defmacro! -> (fn* [x & forms] (if (empty? forms) x (let* [form (first forms) more (rest forms)] (if (list? form) `(-> (~(first form) ~x ~@(rest form)) ~@more) `(-> (~form ~x) ~@more))))))
(-> 5 (+ 3) (* 2) str)
(macroexpand (-> a (b c) d))
(defmacro! when (fn* [test & body] `(if ~test (do ~@body) nil)))
(when true (println "inside when") :result)
(when false (println "never"))
(cond (= 1 2) :a (= 1 1) :b "else" :c)
(cond)
(def! xs '(1 2 3))
`(head ~@xs tail)
`[~@xs ~(count xs)]
(quasiquoteexpand (a ~b ~@c))
(defmacro! swap-args (fn* [f a b] (list f b a)))
(swap-args - 1 10)
(macro? unless)
(fn? unless)
