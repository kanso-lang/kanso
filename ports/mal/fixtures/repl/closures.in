(def! make-counter (fn* [] (let* [n (atom 0)] (fn* [] (swap! n + 1)))))
(def! c1 (make-counter))
(def! c2 (make-counter))
(c1)
(c1)
(c2)
(c1)
(def! adder (fn* [x] (fn* [y] (+ x y))))
((adder 10) 5)
(map (adder 100) [1 2 3])
(let* [even? (fn* [n] (if (= n 0) true (odd? (- n 1)))) odd? (fn* [n] (if (= n 0) false (even? (- n 1))))] [(even? 10) (odd? 7) (even? 3)])
(def! compose (fn* [f g] (fn* [x] (f (g x)))))
((compose (adder 1) (fn* [x] (* x x))) 5)
(def! f (fn* [] (do (def! helper (fn* [n] (if (= n 0) :bottom (helper (- n 1))))) (helper 5))))
(f)
(let* [a 1] (do (def! b (+ a 1)) (+ a b)))
