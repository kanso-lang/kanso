(throw "plain")
(throw {:code 42 :msg "structured"})
(try* (throw {:code 42}) (catch* e (get e :code)))
(try* (nosuch) (catch* e (str "caught: " e)))
(try* (+ 1 "x") (catch* e e))
(try* (throw (list 1 2)) (catch* e (count e)))
(try* (try* (throw "inner") (catch* e (throw (str e " rethrown")))) (catch* e e))
(try* 42)
(try* (/ 1 0) (catch* e e))
(try* (read-string "(oops") (catch* e (str "reader: " e)))
(def! safe-div (fn* [a b] (try* (if (= b 0) (throw :div-zero) (/ a b)) (catch* e e))))
(safe-div 10 2)
(safe-div 1 0)
(nth (list) 0)
(try* (nth (list) 0) (catch* e :out-of-range))
