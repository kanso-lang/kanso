;; Environments for mal written in mal. An environment is an atom holding a
;; hash-map from symbol names to values, with the enclosing environment under
;; the key :outer.

(def! bind-env (fn* [data binds exprs]
  (if (empty? binds)
    data
    (if (= '& (first binds))
      (assoc data (str (nth binds 1)) (apply list exprs))
      (bind-env (assoc data (str (first binds)) (first exprs))
                (rest binds)
                (rest exprs))))))

(def! new-env (fn* [& args]
  (if (<= (count args) 1)
    (atom {:outer (first args)})
    (atom (bind-env {:outer (first args)} (nth args 1) (nth args 2))))))

(def! env-find (fn* [env ks]
  (if env
    (if (contains? @env ks)
      env
      (env-find (get @env :outer) ks)))))

(def! env-get (fn* [env sym]
  (let* [ks (str sym)
         e (env-find env ks)]
    (if e
      (get @e ks)
      (throw (str "'" ks "' not found"))))))

(def! env-set (fn* [env sym value]
  (do
    (swap! env assoc (str sym) value)
    value)))
