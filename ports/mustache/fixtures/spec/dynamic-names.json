{
  "overview": "A partial tag whose name starts with * looks the name up in the context, then renders the partial of that name.",
  "tests": [
    {
      "name": "Basic Behavior - Partial",
      "data": {
        "dynamic": "content"
      },
      "template": "\"{{>*dynamic}}\"",
      "partials": {
        "content": "Hello, world!"
      },
      "expected": "\"Hello, world!\""
    },
    {
      "name": "Basic Behavior - Name Resolution",
      "data": {
        "dynamic": "content",
        "*dynamic": "wrong"
      },
      "template": "\"{{>*dynamic}}\"",
      "partials": {
        "content": "Hello, world!",
        "wrong": "Invisible"
      },
      "expected": "\"Hello, world!\""
    },
    {
      "name": "Context Misses - Partial",
      "data": {},
      "template": "\"{{>*missing}}\"",
      "partials": {
        "missing": "Hello, world!"
      },
      "expected": "\"\""
    },
    {
      "name": "Failed Lookup - Partial",
      "data": {
        "dynamic": "content"
      },
      "template": "\"{{>*dynamic}}\"",
      "partials": {
        "foobar": "Hello, world!"
      },
      "expected": "\"\""
    },
    {
      "name": "Context",
      "data": {
        "text": "content",
        "dynamic": "partial"
      },
      "template": "\"{{>*dynamic}}\"",
      "partials": {
        "partial": "*{{text}}*"
      },
      "expected": "\"*content*\""
    },
    {
      "name": "Dotted Names",
      "data": {
        "text": "Hello, world!",
        "a": {
          "b": "partial"
        }
      },
      "template": "\"{{>*a.b}}\"",
      "partials": {
        "partial": "*{{text}}*"
      },
      "expected": "\"*Hello, world!*\""
    },
    {
      "name": "Dotted Names - Operator Precedence",
      "data": {
        "text": "Hello, world!",
        "a": {
          "b": "partial"
        },
        "b": "partial2"
      },
      "template": "\"{{>*a.b}}\"",
      "partials": {
        "partial": "",
        "partial2": "*{{text}}*"
      },
      "expected": "\"\""
    },
    {
      "name": "Dotted Names - Failed Lookup",
      "data": {
        "a": {
          "b": "partial"
        }
      },
      "template": "\"{{>*a.b}}\"",
      "partials": {
        "partial": ""
      },
      "expected": "\"\""
    },
    {
      "name": "Dotted names - Context Stacking",
      "data": {
        "a": {
          "c": {
            "d": "partial"
          }
        },
        "c": {
          "d": "wrong"
        },
        "text": "hello world"
      },
      "template": "{{#a}}{{>*c.d}}{{/a}}",
      "partials": {
        "partial": "\"{{text}}\""
      },
      "expected": "\"hello world\""
    },
    {
      "name": "Dotted names - Context Stacking Under Repetition",
      "data": {
        "a": [
          {
            "b": "partial"
          },
          {
            "b": "partial"
          }
        ],
        "text": "hello world"
      },
      "template": "{{#a}}{{>*b}}{{/a}}",
      "partials": {
        "partial": "\"{{text}}\""
      },
      "expected": "\"hello world\"\"hello world\""
    },
    {
      "name": "Recursion",
      "data": {
        "template": "node",
        "content": "X",
        "nodes": [
          {
            "content": "Y",
            "nodes": []
          }
        ]
      },
      "template": "{{>*template}}",
      "partials": {
        "node": "{{content}}<{{#nodes}}{{>*template}}{{/nodes}}>"
      },
      "expected": "X<Y<>>"
    },
    {
      "name": "Surrounding Whitespace",
      "data": {
        "partial": "partial"
      },
      "template": "| {{>*partial}} |",
      "partials": {
        "partial": "\t|\t"
      },
      "expected": "| \t|\t |"
    },
    {
      "name": "Inline Indentation",
      "data": {
        "dynamic": "partial",
        "data": "|"
      },
      "template": "  {{data}}  {{>*dynamic}}\n",
      "partials": {
        "partial": ">\n>"
      },
      "expected": "  |  >\n>\n"
    },
    {
      "name": "Standalone Line Endings",
      "data": {
        "dynamic": "partial"
      },
      "template": "|\r\n{{>*dynamic}}\r\n|",
      "partials": {
        "partial": ">"
      },
      "expected": "|\r\n>|"
    },
    {
      "name": "Standalone Without Previous Line",
      "data": {
        "dynamic": "partial"
      },
      "template": "  {{>*dynamic}}\n>",
      "partials": {
        "partial": ">\n>"
      },
      "expected": "  >\n  >>"
    },
    {
      "name": "Standalone Without Newline",
      "data": {
        "dynamic": "partial"
      },
      "template": ">\n  {{>*dynamic}}",
      "partials": {
        "partial": ">\n>"
      },
      "expected": ">\n  >\n  >"
    },
    {
      "name": "Standalone Indentation",
      "data": {
        "dynamic": "partial",
        "content": "<\n->"
      },
      "template": "\\\n {{>*dynamic}}\n/\n",
      "partials": {
        "partial": "|\n{{{content}}}\n|\n"
      },
      "expected": "\\\n |\n <\n->\n |\n/\n"
    },
    {
      "name": "Padding Whitespace",
      "data": {
        "dynamic": "partial",
        "boolean": true
      },
      "template": "|{{>* dynamic }}|",
      "partials": {
        "partial": "[]"
      },
      "expected": "|[]|"
    }
  ]
}
