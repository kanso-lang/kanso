# Requests the parser refuses. Each gets a status that says why, and the
# server closes the connection after answering, since it cannot know where
# the next request would begin.
note a request line with four words
conn
send GET / extra HTTP/1.1
send Host: localhost
send
note a version this server does not speak
conn
send GET / HTTP/2.0
send Host: localhost
send
note something that is not HTTP at all
conn
send HELLO THERE
send
note an HTTP/1.1 request with no Host
conn
send GET /todos HTTP/1.1
send
note a lower-case method
conn
send get /todos HTTP/1.1
send Host: localhost
send
note an absolute-form target
conn
send GET http://localhost/todos HTTP/1.1
send Host: localhost
send
note whitespace between a header name and its colon
conn
send GET /todos HTTP/1.1
send Host : localhost
send
note an obsolete folded header
conn
send GET /todos HTTP/1.1
send Host: localhost
send X-Long: one
send   two
send
note both content-length and transfer-encoding
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Length: 3
send Transfer-Encoding: chunked
send
send 0
send
note two content-lengths that disagree
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Length: 3
send Content-Length: 4
send
data abc
note a content-length that is not a number
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Length: -1
send
note a body larger than the server accepts
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Length: 99999999
send
note a head larger than the server reads
conn
send GET /todos HTTP/1.1
send Host: localhost
send X-Padding: 
send
note a body that is not JSON's media type
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Type: text/plain
send Content-Length: 14
send
data {"title":"no"}
note a client that hangs up halfway through a body gets no answer
conn
send POST /todos HTTP/1.1
send Host: localhost
send Content-Length: 50
send
data {"title":
note unknown paths and methods
conn
request POST /nowhere {"title":"x"}
request DELETE /todos/1/extra
