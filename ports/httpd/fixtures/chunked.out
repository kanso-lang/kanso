-- chunk sizes are hex, extensions are ignored, trailers are read past
== connection 2: 213 bytes in 13 pieces
[server] POST /todos 201
[server] GET /todos/2 200
< HTTP/1.1 201 Created
< content-type: application/json
< location: http://localhost/todos/2
< access-control-allow-origin: *
< date: Fri, 10 Oct 2025 01:20:00 GMT
< content-length: 83
<
{"completed":false,"id":2,"title":"hex sizes, ok","url":"http://localhost/todos/2"}
< HTTP/1.1 200 OK
< content-type: application/json
< access-control-allow-origin: *
< date: Fri, 10 Oct 2025 01:20:00 GMT
< content-length: 83
<
{"completed":false,"id":2,"title":"hex sizes, ok","url":"http://localhost/todos/2"}
(the server closed the connection)
-- a large file goes out chunked to an HTTP/1.1 client
== connection 3: 47 bytes in 1 pieces
[server] GET /docs/big.txt 200
< HTTP/1.1 200 OK
< content-type: text/plain; charset=utf-8
< etag: "310e342b82df7189"
< access-control-allow-origin: *
< date: Fri, 10 Oct 2025 01:20:00 GMT
< transfer-encoding: chunked
(3 chunks)
<
(10600 bytes, sha256 310e342b82df7189)
(the server closed the connection)
-- and with a content-length to an HTTP/1.0 client, which cannot read chunks
== connection 4: 30 bytes in 2 pieces
