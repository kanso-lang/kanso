# Binding the result of `put` to a name before a tail call makes the native
# engines superlinear; writing the same `put` inline in the argument does not.
#
# Run from this directory: sh run.sh (release timings); kanso run main.kso
#  --interp is fast
#
# Expected: both loops linear on every engine, as they are on the interpreter.
# Actual, in this container, n = 1000 / 2000 / 4000:
#   release inline_put   0.005s / 0.011s / 0.016s
#   release named_put    0.13s  / 1.5s   / over 30s
#   dev build named_put at 2000: 1.4s; interpreter named_put at 2000: 0.015s
#
# The two functions differ only in whether the new map gets a name. Naming an
# intermediate value is the ordinary way to keep a line under 80 columns or to
# make a step readable, so the cliff is easy to walk off without noticing.
fn inline_put m i n
  return m if n < i
  inline_put (put m "k{i}" i) (i + 1) n

fn named_put m i n
  return m if n < i
  next = put m "k{i}" i
  named_put next (i + 1) n

pub fn inline_n n
  length (inline_put {} 1 n)

pub fn named_n n
  length (named_put {} 1 n)
