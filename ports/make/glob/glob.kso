# Shell-style wildcards for $(wildcard) and for rule lines: `*`, `?` and
# `[...]` classes, matched against the names in one directory. Wildcards in
# a directory part are not expanded; GNU make expands those too.
import "../words"
import "std/list"
import "std/os"
import "std/text"

pub fn wild? s
  words/contains? s "*" or words/contains? s "?" or words/contains? s "["

# The names `pattern` matches, sorted, with the directory part kept. A word
# with no wildcard in it names itself when that file exists.
pub fn expand_one pattern
  return named pattern if not wild? pattern
  slash = words/find_last pattern "/"
  dir = if (slash == 0) "" (text/slice pattern 1 slash)
  base = text/slice pattern (slash + 1) (length pattern)
  listing (if (dir == "") "." dir) .> (names -> effect (chosen dir base names))

fn named path
  os/exists path .> (here -> effect (if here [path] []))

fn listing dir
  os/is_dir dir .> (here -> if here (os/list_dir dir) (effect []))

fn chosen dir base names
  hidden_ok = words/starts_with? base "."
  keep = (n -> (hidden_ok or not words/starts_with? n ".") and matches? base n)
  list/to_list (list/map (list/select names keep) (n -> "{dir}{n}"))

# Every pattern in turn, each one's matches sorted, the lists run together:
# GNU make sorts within a pattern and keeps the patterns in order.
pub fn expand_all patterns
  gather patterns 1 []

fn gather patterns i acc
  return effect acc if i < 1 or length patterns < i
  next = (found -> gather patterns (i + 1) (text/concat acc found))
  expand_one patterns[i] .> next

pub fn matches? pattern name
  walk? (text/chars pattern) 1 (text/chars name) 1

fn walk? ps i ns j
  return j > length ns if i < 1 or length ps < i
  at? ps i ns j ps[i]

fn at? ps i ns j "*"
  star? ps (i + 1) ns j

fn at? ps i ns j "?"
  j <= length ns and walk? ps (i + 1) ns (j + 1)

fn at? ps i ns j "["
  close = class_end ps (i + 1)
  return literal? ps i ns j "[" if close == 0
  in_class? ps (i + 1) close ns j

fn at? ps i ns j c
  literal? ps i ns j c

fn literal? ps i ns j c
  j <= length ns and ns[j] == c and walk? ps (i + 1) ns (j + 1)

fn star? ps i ns j
  return false if j > length ns + 1
  walk? ps i ns j or star? ps i ns (j + 1)

# The index of the `]` closing a class that opens just before `i`, or 0.
fn class_end ps i
  return 0 if i > length ps
  if (ps[i] == "]" and i > 1 and ps[i - 1] != "[") i (class_end ps (i + 1))

fn in_class? ps from close ns j
  return false if j < 1 or length ns < j
  negated = ps[from] == "!" or ps[from] == "^"
  start = if negated (from + 1) from
  hit = class_hit? ps start close ns[j]
  if (hit != negated) (walk? ps (close + 1) ns (j + 1)) false

fn class_hit? ps i close c
  return false if i >= close
  ranged = ps[i + 1] == "-" and i + 2 < close
  return in_range? ps i close c if ranged
  ps[i] == c or class_hit? ps (i + 1) close c

fn in_range? ps i close c
  inside = ps[i] <= c and c <= ps[i + 2]
  inside or class_hit? ps (i + 3) close c
