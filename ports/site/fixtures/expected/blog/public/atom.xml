    <entry>
        <title>Second post: markdown</title>
        <published>2024-02-01T00:00:00+00:00</published>
        <link href="https://example.com/blog/second-post/" type="text/html"/>
        <id>https://example.com/blog/second-post/</id>
        <content type="html">&lt;p&gt;Some of the markdown this port understands.&lt;/p&gt;
&lt;h2 id=&quot;lists&quot;&gt;Lists&lt;/h2&gt;
&lt;ul&gt;
&lt;li&gt;one&lt;/li&gt;
&lt;li&gt;two
&lt;ul&gt;
&lt;li&gt;two and a half&lt;/li&gt;
&lt;/ul&gt;&lt;/li&gt;
&lt;li&gt;three&lt;/li&gt;
&lt;/ul&gt;
&lt;ol&gt;
&lt;li&gt;first&lt;/li&gt;
&lt;li&gt;second&lt;/li&gt;
&lt;/ol&gt;
&lt;h2 id=&quot;quotes&quot;&gt;Quotes&lt;/h2&gt;
&lt;blockquote&gt;
&lt;p&gt;A quoted line,
and another.&lt;/p&gt;
&lt;/blockquote&gt;
&lt;h2 id=&quot;tables&quot;&gt;Tables&lt;/h2&gt;
&lt;table&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th style=&quot;text-align: left&quot;&gt;Name&lt;/th&gt;
&lt;th style=&quot;text-align: right&quot;&gt;Count&lt;/th&gt;
&lt;th style=&quot;text-align: center&quot;&gt;Note&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style=&quot;text-align: left&quot;&gt;apples&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;3&lt;/td&gt;
&lt;td style=&quot;text-align: center&quot;&gt;&lt;code&gt;fresh&lt;/code&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot;text-align: left&quot;&gt;pears&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;12&lt;/td&gt;
&lt;td style=&quot;text-align: center&quot;&gt;&lt;del&gt;old&lt;/del&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;hr /&gt;
&lt;p&gt;An image: &lt;img src=&quot;/img/logo.svg&quot; alt=&quot;a diagram&quot; title=&quot;Logo&quot; /&gt;, and a line&lt;br /&gt;
break.&lt;/p&gt;
&lt;aside class=&quot;note note-warning&quot;&gt;&lt;p&gt;A body shortcode keeps &lt;strong&gt;its markdown&lt;/strong&gt;.&lt;/p&gt;
&lt;/aside&gt;
</content>
