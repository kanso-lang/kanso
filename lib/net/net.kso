# Sockets, in the shape Go's net package has: something you listen with,
# something a connection is, and four things you do to one. What a program
# holds is a record; the number inside it is the operating system's and
# belongs to this module.
pub type listener
  handle

pub type conn
  handle

# Port 0 asks the operating system for a free one, and `port` reads back
# what it gave — a program that pinned a number would collide with whatever
# else the machine is running.
pub fn listen at
  builtin_listen at .> held

fn held h
  listener h

pub fn port l
  builtin_net_port l.handle

pub fn accept l
  builtin_accept l.handle .> taken

fn taken h
  conn h

# A connection out, as Go's net.Dial makes one. The host is a name or an
# address, and a refusal names the host and port it could not reach.
pub fn dial host at
  builtin_dial host at .> taken

pub fn read c
  builtin_net_read c.handle

# The same read as `read`, handing back the bytes as they arrived. A protocol
# that frames its messages in binary, as Postgres does, reads with this.
pub fn read_bytes c
  builtin_net_read_bytes c.handle

pub fn write c text
  builtin_net_write c.handle text

pub fn close_conn c
  builtin_net_close c.handle

pub fn close_listener l
  builtin_net_close l.handle

# The connection's traffic through TLS from here on, after a handshake that
# checks the server's certificate for `host` against the machine's trusted
# roots (`SSL_CERT_FILE` names others). It upgrades a connection already open
# because Postgres asks for TLS inside a plain one; a dial straight into TLS
# is a dial and then this. A refusal names the host.
pub fn secured c host
  builtin_net_secure c.handle host .> taken

# A connection out that speaks TLS from its first byte, as HTTPS does.
pub fn dial_tls host at
  dial host at .> (c -> secured c host)
