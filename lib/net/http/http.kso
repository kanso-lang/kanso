import "std/net"
import "std/text"

# HTTP in the shape Go's net/http has, with one difference that matters: a
# handler is a plain function from a request to a response. There is no writer
# to hand it and no recorder to fake, so a test calls it and reads the value it
# answers — and injecting a different handler is passing a different function,
# because a function is already a value.
pub type request
  method
  path
  body

pub type turn
  answer
  carried

pub type done
  value

pub type response
  status
  reason
  headers
  body

pub fn ok body
  response 200 "OK" [] body

pub fn text_page body
  response 200 "OK" ["content-type: text/plain; charset=utf-8"] body

# A browser runs no script in a plain-text document, so a page served as text
# is a page that never reports back.
pub fn html_page body
  response 200 "OK" ["content-type: text/html; charset=utf-8"] body

# A 200 whose headers the caller chooses — serving an asset means saying what
# kind of thing it is, and the three pages above each fix that for you.
pub fn page headers body
  response 200 "OK" headers body

pub not_found = response 404 "Not Found" [] "not found\n"

# What a handler answers: this response, and what to carry to the next
# request. `stop` in the carried slot ends the fold and what it holds is what
# `serve_until` answers.
pub fn reply answer carried
  turn answer carried

pub fn stop value
  done value

# Parsing stops at the head because that is all a request line and its headers
# are; the body is whatever the read brought with it.
pub fn parsed raw
  head = text/split raw "\r\n\r\n"
  lines = text/split head[1]! "\r\n"
  start = text/split lines[1]! " "
  request start[1]! start[2]! (body_of head)

fn body_of head
  present head[2]! (length head > 1)

fn present body true
  body

fn present _ false
  ""

pub fn rendered r
  "HTTP/1.1 {r.status} {r.reason}\r\n{header_block r}\r\n{r.body}"

fn header_block r
  sized = text/concat r.headers ["content-length: {length (text/bytes r.body)}"]
  "{text/join sized "\r\n"}\r\n"

# One request, answered by the handler it is given. `serve_once` is the whole
# of what a harness needs: a server that answers and stops.
pub fn serve_once port handler
  net/listen port . (l -> taken l handler)

fn taken l handler
  net/accept l . (c -> answered c handler) . (_ -> net/close_listener l)

fn answered c handler
  net/read c . (raw -> replied c handler raw) . (_ -> net/close_conn c)

fn replied c handler raw
  net/write c (rendered (handler (parsed raw)))

# Many requests, folded. The handler answers a `turn`: the response, and what
# to carry to the next request. Carrying a `done` closes the door, and what it
# holds is what `serve_until` answers — a harness decides pass or fail from the
# report the page posts back, so the value has to survive the stop. That is the
# whole of what one needs: serve the page, serve its assets, and answer the
# report.
pub fn serve_until port handler seed
  net/listen port . (l -> serving l handler seed)

# The same server, handed a listener rather than a number. A caller that binds
# port 0 and reads back what it was given never has to drop the listener and
# name the port again, which is the gap anything else can bind into.
pub fn serving l handler seed
  served l handler seed

fn served l handler carried
  net/accept l . (c -> asked c handler carried) . (next -> more l handler next)

fn asked c handler carried
  net/read c . (raw -> gathering c handler carried raw)

# A browser opens connections it may never use, and sends nothing down them
# until it does. Such a connection is not a request and gets no answer: the
# door closes and the next one is accepted.
fn gathering c _ carried ""
  net/close_conn c . (_ -> carried)

fn gathering c handler carried raw
  heard c handler carried raw (whole? raw)

fn heard c handler carried raw true
  answered_with c handler carried raw

# A read is a segment, not a request. Both the head and the body arrive in as
# many pieces as the network chose, so a short one is read again rather than
# dropped; a client with nothing more to say sends an empty read and the door
# closes on it, which is what stops this waiting forever.
fn heard c handler carried raw false
  net/read c . (nxt -> joined c handler carried raw nxt)

fn joined c _ carried _ ""
  net/close_conn c . (_ -> carried)

fn joined c handler carried raw nxt
  gathering c handler carried "{raw}{nxt}"

# Whole means the head has landed AND as many body bytes as the client
# promised. Measuring the body by subtraction rather than by taking a split's
# second part keeps a body that itself contains a blank line intact.
fn whole? raw
  parts = text/split raw "\r\n\r\n"
  complete? raw parts[1]! (length parts > 1)

fn complete? _ _ false
  false

fn complete? raw head true
  arrived = length (text/bytes raw) - length (text/bytes head) - 4
  arrived >= promised head

# No content-length is no body to wait for, which is every GET a browser makes.
# Header names are case-insensitive, and a browser writes Content-Length where
# a program writes content-length: splitting on one spelling and joining with
# the other folds them into one before the search.
fn promised head
  folded = text/join (text/split head "Content-Length:") "content-length:"
  parts = text/split folded "content-length:"
  counted parts (length parts > 1)

fn counted _ false
  0

fn counted parts true
  digits = text/split parts[2]! "\r\n"
  text/to_int (text/trim digits[1]!)

fn answered_with c handler carried raw
  took = handler (parsed raw) carried
  net/write c (rendered took.answer)
    . (_ -> net/close_conn c)
    . (_ -> took.carried)

fn more l _ (done value)
  net/close_listener l . (_ -> value)

fn more l handler carried
  served l handler carried
