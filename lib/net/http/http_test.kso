import "std/text"

# A program's own record with a `body` that may be none is a different field
# from a response's body. A program with one checks, and its pages render.
type note
  body

# content-length counts bytes, and a page whose body is not plain ascii has
# more bytes than characters. A client takes the number at its word, so a
# count of characters hands back a truncated page.
yen = ok "650 円"

asked = parsed "POST /report HTTP/1.1\r\nhost: x\r\n\r\nthe body"

test_content_length_counts_bytes = contains? (rendered yen) "content-length: 7"

abc = ok "abc"

test_content_length_of_ascii = contains? (rendered abc) "content-length: 3"

test_status_line = contains? (rendered not_found) "HTTP/1.1 404 Not Found"

refused = respond 422 [] "we do not sell that\n"

unprocessable = "HTTP/1.1 422 Unprocessable Content\r\n"

test_any_status = contains? (rendered refused) unprocessable

created = respond 201 ["location: /orders/7"] ""

test_a_created_order_says_where = contains? (rendered created) "/orders/7"

odd = respond 299 [] ""

test_a_code_without_a_phrase = contains? (rendered odd) "HTTP/1.1 299 \r\n"

page = html_page "<script>report()</script>"

test_html_page_is_html = contains? (rendered page) "content-type: text/html"

test_parsed_reads_the_method = asked.method == "POST"

test_parsed_reads_the_path = asked.path == "/report"

test_parsed_keeps_the_body = asked.body == "the body"

# A blank line ends the head and nothing else: a body may hold one, as a text
# file posted whole does.
spaced = parsed "POST /notes HTTP/1.1\r\nhost: x\r\n\r\none\r\n\r\ntwo"

test_parsed_keeps_a_blank_line_in_the_body = spaced.body == "one\r\n\r\ntwo"

unread = note (text/to_int "not a number")

test_a_note_without_a_body = unread.body == none

test_a_page_beside_such_a_note = contains? (rendered abc) "content-length: 3"

fn contains? haystack needle
  length (text/split haystack needle) > 1

# A header's name arrives in whatever case the client chose and is read in
# lowercase; its value keeps its case and loses the spaces around it, and a
# colon inside the value is part of the value.
headed = parsed "GET / HTTP/1.1\r\nHost: x\r\nCookie:  s=a:b \r\n\r\n"

test_a_header_name_is_lowercased = headed.headers["cookie"] == "s=a:b"

test_parsed_reads_the_host_header = headed.headers["host"] == "x"

test_a_request_without_headers_has_none = asked.headers["cookie"] == none
