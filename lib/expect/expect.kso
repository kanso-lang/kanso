import "std/list"
import "std/text"

# What a failing test is allowed to tell you.
#
# A test is a constant and `==` is the assertion, which is enough to decide
# pass or fail and nothing else: `test_decode_int = decode "42" == 43` fails
# with `FAILED (returned false)`. The name, and no sign of what it got. The
# operands are gone by the time the runner has the boolean, so the runner
# cannot recover them — whatever is going to carry them has to be the
# assertion itself.
#
# The runner already prints the value a test returned. So a matcher that
# answers a RECORD instead of `false` reports its own diff with no change to
# the runner at all:
#
#     test_decode_int = expect (decode "42") . to (equal 43)
#     test_decode_int ... FAILED (returned mismatch 43 42)
#
# That is why this is a package rather than a second spelling of `==`. It adds
# no way to write a test that could not be written; it adds what a test says
# when it fails.
#
#     expect x . to (equal y)
#     expect x . to be_true
#
# `expect` is the identity. It reads as the subject of the sentence and costs
# nothing, which is the point: the chain is the surface, not a wrapper type.
pub type mismatch
  wanted
  got

pub type not_true
  got

# What a matcher other than `equal` answers when it does not match: what it
# wanted, in words, and what it got.
pub type unmet
  wanted
  got

pub fn expect none
  none

pub fn expect v
  v

# A value that may be none is a value like any other here: `be_none` is a
# matcher, so `to` takes none and hands it on.
pub fn to none m
  m none

pub fn to v m
  m v

pub fn equal want
  (got -> equal_answer want got (want == got))

pub be_true = (got -> true_answer got got)

fn equal_answer _ _ true
  true

fn equal_answer want got false
  mismatch want got

fn true_answer _ true
  true

fn true_answer got false
  not_true got

pub be_false = (got -> met (false? got) "to be false" got)

pub be_none = (got -> met (got == none) "to be none" got)

# A text that holds `part`, or a list that holds it as an element.
pub fn contain part
  (got -> met (holds? got part) "to contain {shown part}" got)

pub fn have_length n
  (got -> met (length got == n) "to have length {n}" got)

pub fn start_with prefix
  (got -> met (text/starts_with? got prefix) "to start with {shown prefix}" got)

pub fn end_with suffix
  (got -> met (text/ends_with? got suffix) "to end with {shown suffix}" got)

# Whatever `fits?` says of the value, for the check no matcher here makes.
pub fn satisfy fits?
  (got -> met (fits? got) "to satisfy the check" got)

# The other way round: `expect x . not_to (equal 3)` passes when the matcher
# does not.
pub fn not_to none m
  met (not true? (m none)) "not to match" none

pub fn not_to v m
  met (not true? (m v)) "not to match" v

fn met false wanted none
  unmet wanted none

fn met true _ _
  true

fn met false wanted got
  unmet wanted got

# A matcher answers true or a record, and a test may answer anything, so
# these ask by arm what `==` would ask of a boolean.
fn true? true
  true

fn true? _
  false

fn false? false
  true

fn false? _
  false

fn holds? got:string part
  length (text/split got part) > 1

fn holds? got part
  list/any? got (e -> e == part)

fn shown s:string
  "\"{s}\""

fn shown v
  "{v}"
