import { join:joined } "std/text"

pub fn basename p
  text/slice p (past_separator p (length p)) (length p)

pub fn dirname p
  cut_at p (past_separator p (length p))

# A name that begins with a dot is a name, not an extension: `.gitignore` is
# the file, and reporting `gitignore` would be a lie about both.
pub fn extension p
  after_dot (basename p)

# Exactly one separator between the two, and a side that is empty
# contributes nothing. A leading separator on the right is redundant here
# rather than absolute, so `join base name` cannot leave base however `name`
# was spelled — which is what a caller joining a name it did not choose
# wants. Rust and Python let an absolute right-hand side win outright; go
# does not, and neither does this.
# Both empty matches the two arms below equally, so the pair needs the arm
# that is most specific in both positions or a call could take either.
pub fn join "" ""
  ""

pub fn join "" right
  right

pub fn join left ""
  left

pub fn join left right
  "{without_trailing_slash left}/{without_leading_slash right}"

pub fn stem p
  before_dot (basename p)

fn after_dot b
  from_dot b (past_dot b (length b))

fn before_dot b
  upto_dot b (past_dot b (length b))

fn cut_at _ 1
  "."

fn cut_at _ 2
  "/"

fn cut_at p past
  text/slice p 1 (past - 2)

fn from_dot _ 0
  ""

fn from_dot _ 1
  ""

fn from_dot b at
  text/slice b (at + 1) (length b)

fn past_dot _ 0
  0

fn past_dot b i
  if (text/slice b i i == ".") i (past_dot b (i - 1))

fn past_separator _ 0
  1

fn past_separator p i
  if (text/slice p i i == "/") (i + 1) (past_separator p (i - 1))

fn upto_dot b 0
  b

fn upto_dot b 1
  b

fn upto_dot b at
  text/slice b 1 (at - 1)

fn without_leading_slash ""
  ""

fn without_leading_slash s
  rest = text/slice s 2 (length s)
  if (text/slice s 1 1 == "/") (without_leading_slash rest) s

fn without_trailing_slash ""
  ""

fn without_trailing_slash s
  rest = text/slice s 1 (length s - 1)
  if (text/slice s (length s) (length s) == "/") (without_trailing_slash rest) s
