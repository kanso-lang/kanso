test_basename_is_the_last_segment = basename "a/b/c.html" == "c.html"

test_basename_of_a_bare_name = basename "c.html" == "c.html"

test_basename_absolute = basename "/a/b/c" == "c"

test_dirname_drops_the_segment = dirname "a/b/c.html" == "a/b"

test_dirname_of_a_bare_name = dirname "c.html" == "."

test_dirname_of_a_root_child = dirname "/etc" == "/"

test_extension_is_the_last = extension "a.tar.gz" == "gz"

test_extension_of_a_dotfile = extension ".gitignore" == ""

test_extension_when_absent = extension "README" == ""

test_stem_drops_the_extension = stem "a/b/c.html" == "c"

test_stem_of_a_dotfile = stem ".gitignore" == ".gitignore"

# The harness may read a failure; a package may not. This is the only place
# in the shipped library that needs it, and it is here to keep the surface
# exercised rather than only asserted about.
test_a_plain_value_has_not_failed = failed? "a/b" == false
