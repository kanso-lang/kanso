import "std/bits"
import "std/list"
import "std/text"

# SHA-256, FIPS 180-4, in kanso rather than as a builtin. A digest is
# arithmetic on thirty-two bit words and the bitwise surface covers it, so a
# builtin would only buy speed on a path that runs once per built file.
#
# kanso integers do not wrap, so every word operation ends by masking back to
# thirty-two bits — `whole` is that mask, and it appears wherever a sum or a
# shift could have carried past the top.
#
# `pads` is the state HMAC's two key blocks leave, kept so every HMAC under one
# key starts from there.
type pads
  inner
  outer

whole = 4294967295

hexits = "0123456789abcdef"

k0 = [1116352408 1899447441 3049323471 3921009573 961987163 1508970993]

k1 = [2453635748 2870763221 3624381080 310598401 607225278 1426881987]

k2 = [1925078388 2162078206 2614888103 3248222580 3835390401 4022224774]

k3 = [264347078 604807628 770255983 1249150122 1555081692 1996064986]

k4 = [2554220882 2821834349 2952996808 3210313671 3336571891 3584528711]

k5 = [113926993 338241895 666307205 773529912 1294757372 1396182291]

k6 = [1695183700 1986661051 2177026350 2456956037 2730485921 2820302411]

k7 = [3259730800 3345764771 3516065817 3600352804 4094571909 275423344]

k8 = [430227734 506948616 659060556 883997877 958139571 1322822218]

k9 = [1537002063 1747873779 1955562222 2024104815 2227730452 2361852424]

k10 = [2428436474 2756734187 3204031479 3329325298]

front = list/concat (list/concat k0 k1) (list/concat k2 k3)

back = list/concat (list/concat k4 k5) (list/concat k6 k7)

tail = list/concat (list/concat k8 k9) k10

rounds = list/to_list (list/concat (list/concat front back) tail)

# One 512-bit block's sixty-four message words. The first sixteen are the
# block's own big-endian words; each of the rest folds two earlier ones
# through the small mixers. The two words the mixers read are masked for the
# reason `words_from` gives.
fn schedule w _ true
  w

fn schedule w at false
  return w if at - 16 < 1 or length w < at - 2
  s0 = small_sigma0 (w[at - 15] & whole)
  s1 = small_sigma1 (w[at - 2] & whole)
  next = w[at - 16] + s0 + w[at - 7] + s1 & whole
  rolled (push w next) (at + 1)

fn rolled w at
  schedule w at (at > 64)

fn small_sigma0 x
  bits/xor (bits/xor (spun x 7) (spun x 18)) (bits/shr x 3)

fn small_sigma1 x
  bits/xor (bits/xor (spun x 17) (spun x 19)) (bits/shr x 10)

fn big_sigma0 x
  bits/xor (bits/xor (spun x 2) (spun x 13)) (spun x 22)

fn big_sigma1 x
  bits/xor (bits/xor (spun x 6) (spun x 11)) (spun x 25)

# A rotate is the two halves of a shift laid side by side, and the left half
# is masked because it can carry past the top.
fn spun x places
  (bits/shl x (32 - places) & whole) | bits/shr x places

fn choice x y z
  (x & y) ^ (bits/complement x & whole & z)

fn majority x y z
  (x & y) ^ (x & z) ^ (y & z)

# The first thirty-two bits of the fractional parts of the square roots of the
# first eight primes, which is where the standard's starting words come from.
h0 = 1779033703

h1 = 3144134277

h2 = 1013904242

h3 = 2773480762

h4 = 1359893119

h5 = 2600822924

h6 = 528734635

h7 = 1541459225

# The eight working words, in the standard's order, as eight arguments: a b c
# d e f g h. Each round computes two of them and passes the other six along,
# so a round allocates nothing, and the answer is a list only once, when the
# sixty-four rounds are done. Held as a list, the words were a fresh list
# every round, the one value that crossed from round to round, and the loop
# could not hand its arena back between rounds or between blocks.
#
# The round constants arrive as the argument `ks` rather than being read from
# `rounds` directly. `rounds` is built by library calls, and inference gives a
# library function one answer for every caller, so a read of it may be a
# failure as far as the compiler knows. An argument never holds a failure,
# because a call with a failing argument passes the failure on without running
# the body. With the failure ruled out, every word the round computes is a
# plain int, the eight words cross from round to round as raw machine words,
# and the tag tests on each bit operation fold away (kanso#2304).
fn compress a b c d e f g h w ks at
  rounding a b c d e f g h w ks at (at > 64)

fn rounding a b c d e f g h _ _ _ true
  [a b c d e f g h]

fn rounding a b c d e f g h w ks at false
  return [a b c d e f g h] if at < 1 or length w < at or length ks < at
  mixed = big_sigma1 e + choice e f g
  fed = ks[at] + w[at]
  t1 = h + mixed + fed & whole
  t2 = big_sigma0 a + majority a b c & whole
  compress (t1 + t2 & whole) a b c (d + t1 & whole) e f g w ks (at + 1)

# The padded message, block by block. `at` is a one-based byte offset into it.
# The running hash is eight words, carried the way the rounds carry theirs.
fn digested _ a b c d e f g h _ true
  [a b c d e f g h]

fn digested padded a b c d e f g h at false
  w = schedule (first_sixteen padded at 0 []) 17 false
  r = compress a b c d e f g h w rounds 1
  return [a b c d e f g h] if length r < 8
  na = a + r[1] & whole
  nb = b + r[2] & whole
  nc = c + r[3] & whole
  nd = d + r[4] & whole
  ne = e + r[5] & whole
  nf = f + r[6] & whole
  ng = g + r[7] & whole
  nh = h + r[8] & whole
  blocked padded na nb nc nd ne nf ng nh (at + 64)

fn blocked padded a b c d e f g h at
  digested padded a b c d e f g h at (at > length padded)

fn first_sixteen padded at i w
  gathered padded at i w (i > 15)

fn gathered _ _ _ w true
  w

fn gathered padded at i w false
  base = at + i * 4
  return w if base < 1 or length padded < base + 3
  high = padded[base] * 16777216 + padded[base + 1] * 65536
  low = padded[base + 2] * 256 + padded[base + 3]
  word = high + low
  first_sixteen padded at (i + 1) (push w word)

# The message with its terminator, its zero fill, and its length in bits as a
# big-endian sixty-four bit number — the padding the standard names.
fn padded_bytes b
  padded_after b 0

# The padding for a message that follows `before` bytes already hashed. The
# fill depends on the message alone, since `before` is whole blocks, and the
# length in bits counts both.
fn padded_after b before
  n = length b
  zeros = 63 - (n + 8 & 63)
  filled (push (list/to_list b) 128) zeros (n + before)

fn filled acc 0 n
  eight_bytes acc (n * 8) 7

fn filled acc zeros n
  filled (push acc 0) (zeros - 1) n

# The length in bits, most significant byte first. `/` answers a float, so the
# shift is the one that keeps whole numbers whole.
fn eight_bytes acc total at
  laid acc total at (at < 0)

fn laid acc _ _ true
  acc

fn laid acc total at false
  byte = bits/shr total (at * 8) & 255
  eight_bytes (push acc byte) total (at - 1)

# The digest, big-endian, as sixty-four lowercase hex characters.
pub fn hex b
  final = blocked (padded_bytes b) h0 h1 h2 h3 h4 h5 h6 h7 1
  spelled final 1 ""

fn spelled words at acc
  spelling words at acc (at > length words)

fn spelling _ _ acc true
  acc

fn spelling words at acc false
  return acc if at < 1 or length words < at
  spelled words (at + 1) "{acc}{eight_hexits words[at] 7 ""}"

fn eight_hexits x at acc
  hexed x at acc (at < 0)

fn hexed _ _ acc true
  acc

fn hexed x at acc false
  place = bits/shr x (at * 4) & 15
  eight_hexits x (at - 1) "{acc}{text/slice hexits (place + 1) (place + 1)}"

# The digest as its thirty-two bytes, big-endian, for a caller that hashes
# the hash again, as HMAC does.
pub fn digest b
  bytes_of (blocked (padded_bytes b) h0 h1 h2 h3 h4 h5 h6 h7 1)

# The words as bytes, four to a word, most significant first. A loop of its
# own rather than a fold, because `list/fold` is shared by every caller in a
# program and so answers anything at all, and a digest that answers anything
# cannot be carried round a caller's loop (kanso#2299).
fn bytes_of words
  laid_out words 1 []

fn laid_out words at acc
  return acc if at < 1 or at > length words
  w = words[at]
  high = push (push acc (bits/shr w 24 & 255)) (bits/shr w 16 & 255)
  laid_out words (at + 1) (push (push high (bits/shr w 8 & 255)) (w & 255))

fn word_bytes w
  [(bits/shr w 24 & 255) (bits/shr w 16 & 255) (bits/shr w 8 & 255) (w & 255)]

# HMAC-SHA-256, RFC 2104. A key longer than a block is hashed first; a shorter
# one is filled out to the block's sixty-four bytes with zeros. The key is
# mixed into both hashes, once with each pad.
pub fn hmac key message
  mac (keyed_pads key) message

# Each pad is one whole block, so the state it leaves can be kept and every
# HMAC under the same key starts from there: two compressions instead of
# four for a short message, which is most of what PBKDF2 does.
fn keyed_pads key
  k = keyed (list/to_list key)
  pads (state_after (xored k 54)) (state_after (xored k 92))

fn state_after block
  blocked block h0 h1 h2 h3 h4 h5 h6 h7 1

fn mac p message
  bytes_of (mac_words p message)

fn mac_words p message
  words_from p.outer (bytes_of (words_from p.inner message))

# The eight words a message leaves, hashed on from the state `s` that whole
# blocks already left. Each word read out of `s` is masked, though it is
# already thirty-two bits, because an item of a list could be anything and the
# mask is what tells the compiler it is an int.
fn words_from s message
  return [] if length s < 8
  padded = padded_after message 64
  a = s[1] & whole
  b = s[2] & whole
  c = s[3] & whole
  d = s[4] & whole
  e = s[5] & whole
  f = s[6] & whole
  g = s[7] & whole
  h = s[8] & whole
  blocked padded a b c d e f g h 1

fn keyed k
  return keyed (digest k) if length k > 64
  zeros = list/to_list (list/take (list/repeat 0) (64 - length k))
  list/to_list (list/concat k zeros)

fn xored k pad
  list/to_list (list/map k (b -> bits/xor b pad))

# PBKDF2 with HMAC-SHA-256, RFC 8018: `size` bytes stretched from a password
# and a salt by `times` applications of HMAC. Each thirty-two byte block is
# the XOR of a chain of HMACs, and the blocks are joined and cut to size.
pub fn pbkdf2 password salt times size
  blocks = all_blocks password salt times 1 ((size + 31) / 32) []
  list/to_list (list/take blocks size)

fn all_blocks password salt times i last acc
  return acc if i > last
  more = list/concat acc (stretched password salt times i)
  all_blocks password salt times (i + 1) last more

# The chain carries its words as arguments: the latest HMAC's eight and the
# running XOR's eight. Nothing heap-shaped crosses from one iteration to the
# next, so the loop hands its arena back each time round, the way `compress`
# does between rounds. Carried as two lists, every HMAC's padding, schedule
# and bytes stayed in the arena until the block was done (kanso#2299).
#
# A word read out of a list is masked with `whole` though it is already
# thirty-two bits. The mask changes nothing, and it is what tells the compiler
# the argument is a number: an item of a list could be anything, and an
# argument that could be anything keeps the loop from rewinding.
fn stretched password salt times i
  p = keyed_pads password
  u = mac_words p (list/concat salt (word_bytes i))
  return [] if length u < 8
  words = chained p
    u[1] & whole
    u[2] & whole
    u[3] & whole
    u[4] & whole
    u[5] & whole
    u[6] & whole
    u[7] & whole
    u[8] & whole
    u[1] & whole
    u[2] & whole
    u[3] & whole
    u[4] & whole
    u[5] & whole
    u[6] & whole
    u[7] & whole
    u[8] & whole
    times - 1
  bytes_of words

fn chained _ _ _ _ _ _ _ _ _ s t u v w x y z 0
  [s t u v w x y z]

fn chained p a b c d e f g h s t u v w x y z left
  n = mac_words p (bytes_of [a b c d e f g h])
  return [s t u v w x y z] if length n < 8
  chained p
    n[1] & whole
    n[2] & whole
    n[3] & whole
    n[4] & whole
    n[5] & whole
    n[6] & whole
    n[7] & whole
    n[8] & whole
    s ^ n[1]
    t ^ n[2]
    u ^ n[3]
    v ^ n[4]
    w ^ n[5]
    x ^ n[6]
    y ^ n[7]
    z ^ n[8]
    left - 1
