import "std/text"

# Base64, RFC 4648: three bytes become four characters from a sixty-four
# letter alphabet, and `=` fills out a final group of one or two bytes. The
# runtime does the spelling and the reading. `encode` takes bytes or a list
# of byte values.
pub fn encode bs
  builtin_base64_spell bs

# Text comes in groups of four characters. The first two of a group are
# letters of the alphabet, and the last two are letters or `=`. `decode`
# answers the bytes as a list, or none for anything else, as json/decode
# does; `decode!` answers the failure, which says why.
pub fn decode s
  builtin_base64_read s

pub fn decode! s
  told (builtin_base64_read s) s

fn told none s
  err (why (length (text/bytes s) % 4 != 0))

fn told bs _
  effect bs

fn why true
  "base64 comes in groups of four characters"

fn why false
  "that is not base64"
