evens = [2 4 6 8 10 12]

fn high? v
  7 < v

test_bisect_agrees = (find (sorted evens) high?) == (find evens high?)

test_bisect_empty = (find (sorted []) (v -> 0 < v)) == none

test_bisect_finds_first = (find (sorted evens) (v -> 3 < v)) == 4

test_bisect_misses = (find (sorted evens) (v -> 20 < v)) == none

test_bisect_takes_head = (find (sorted evens) (v -> 0 < v)) == 2

test_bisect_takes_last = (find (sorted evens) (v -> 11 < v)) == 12

test_argmax_empty = (argmax [] (x -> x)) == none

test_argmax_keys = (argmax [31 17 58 42] (x -> 0 - x)) == 17

test_argmin_keys = (argmin [31 17 58 42] (x -> 0 - x)) == 58

test_group_by_buckets =
  parity = (x -> if ((x / 2) * 2 == x) "even" "odd")
  buckets = group_by [1 2 3 4 5 6] parity
  buckets["even"]! == [2 4 6] && buckets["odd"]! == [1 3 5]

test_transform_values_keys_untouched =
  doubled = transform_values (put (put {:} "a" 2) "b" 3) (v -> v * 2)
  doubled["a"]! == 4 && doubled["b"]! == 6

test_zip_pulls_lazily = (to_list (zip naturals ["x" "y"])) == [[1 "x"] [2 "y"]]

test_zip_stops_short = (to_list (zip [1 2 3] ["a" "b"])) == [[1 "a"] [2 "b"]]

test_index_by_last_wins =
  tags = index_by ["ash" "oak" "ivy"] (w -> w[1]!)
  words = index_by ["ash" "oak" "elm"] (w -> length w)
  tags["a"]! == "ash" && words[3]! == "elm"

test_range_empty = (range []) == none

test_range_spread = (range [31 17 58 42]) == 41

test_to_h_last_wins =
  built = to_h [["a" 1] ["b" 5] ["a" 9]]
  built == (put (put {:} "a" 9) "b" 5)

test_transform_keys_collide =
  folded = transform_keys (put (put {:} "Ash" 1) "ash" 2) (_ -> "ash")
  folded["ash"]! == 2 && (length folded) == 1
