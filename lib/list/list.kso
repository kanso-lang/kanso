  burn
  source

pub type sorted
  items

pub type step
  elem
  rest

pub fn all? coll pred
  holds_all? (next (iter coll)) pred

fn holds_all? (done _) _
  true

fn holds_all? (step e rest) pred
  if (pred e) (holds_all? (next rest) pred) false

pub fn any? coll pred
  holds_any? (next (iter coll)) pred

fn holds_any? (done _) _
  false

fn holds_any? (step e rest) pred
  if (pred e) true (holds_any? (next rest) pred)

pub fn argmax coll key
  unwrap_found (fold coll (missing true) (m x -> outrank_by m x key))

pub fn argmin coll key
  unwrap_found (fold coll (missing true) (m x -> underrank_by m x key))

# the predicate must be monotonic over the order — false for a prefix,
# true for the rest — which is what lets the range halve instead of walk
fn bisect xs p lo hi best
  return best if hi < lo
  mid = lo + (hi - lo) / 2
  here = xs[mid]!
  if (p here) (bisect xs p lo (mid - 1) here) (bisect xs p (mid + 1) hi best)

fn bump none
  1

fn bump n
  n + 1

pub fn count coll pred
  fold coll 0 (c x -> if (pred x) (c + 1) c)

pub fn cycle coll
  cycled 1 (to_list coll)

pub fn drop coll n
  skipped n (iter coll)

pub fn find (sorted items) pred
  bisect items pred 1 (length items) none

pub fn find coll pred
  found_in (next (iter coll)) pred

fn found_in (done _) _
  none

fn found_in (step e rest) pred
  if (pred e) e (found_in (next rest) pred)

pub fn first coll
  first_of (next (iter coll))

fn first_of (done _)
  none

fn first_of (step e _)
  e

# A window over an array is walked by index, the way a bare list is. Pulling
# it through `next` builds a step and a fresh window every element, and both
# are read once and dropped — the same two records the window already saved by
# not being a cap around a cursor.
# A cap around a cursor is a window over an array, and a window is walked by
# index the way a bare list is. Pulling it through `next` builds a step and a
# fresh window every element, both read once and dropped.
pub fn fold (capped left (cursor at source)) init f
  bounded_flat source init f at (at + left - 1)

pub fn fold (bounded at stop source) init f
  bounded_flat source init f at stop

fn bounded_flat source acc f i stop
  if (stop < i) acc (bounded_more source acc f i stop)

fn bounded_more source acc f i stop
  if (length source < i) acc (bounded_step source acc f i stop)

fn bounded_step source acc f i stop
  bounded_flat source (f acc source[i]!) f (i + 1) stop

pub fn fold (capped left source) init f
  fold_go (next (capped left source)) init f

pub fn fold (counting at) init f
  fold_go (next (counting at)) init f

pub fn fold (cursor at source) init f
  fold_go (next (cursor at source)) init f

pub fn fold (cycled at source) init f
  fold_go (next (cycled at source)) init f

pub fn fold (grown seed stretch) init f
  fold_go (next (grown seed stretch)) init f

pub fn fold (mapped shape source) init f
  fold_go (next (mapped shape source)) init f

pub fn fold (paired left right) init f
  fold_go (next (paired left right)) init f

pub fn fold (repeated value) init f
  fold_go (next (repeated value)) init f

pub fn fold (sifted keep source test) init f
  fold_go (next (sifted keep source test)) init f

pub fn fold (skipped burn source) init f
  fold_go (next (skipped burn source)) init f

pub fn fold coll init f
  fold_flat coll init f 1

fn fold_flat coll acc f i
  if (length coll < i) acc (fold_flat coll (f acc coll[i]!) f (i + 1))

fn fold_go (done _) acc _
  acc

fn fold_go (step e rest) acc f
  fold_go (next rest) (f acc e) f

fn bucket none
  []

fn bucket xs
  xs

pub fn group_by coll key
  fold coll {} (acc x -> file_under acc (key x) x)

fn file_under acc k x
  put acc k (push (bucket acc[k]) x)

# last key wins on collision, as put itself does
pub fn index_by coll key
  fold coll {} (acc x -> put acc (key x) x)

fn iter (bounded at stop source)
  bounded at stop source

fn iter (capped left source)
  capped left source

fn iter (counting at)
  counting at

fn iter (cycled at source)
  cycled at source

fn iter (grown seed stretch)
  grown seed stretch

fn iter (paired left right)
  paired left right

fn iter (repeated value)
  repeated value

fn iter (cursor at source)
  cursor at source

fn iter (mapped shape source)
  mapped shape source

fn iter (sifted keep source test)
  sifted keep source test

fn iter (skipped burn source)
  skipped burn source

fn iter source
  cursor 1 source

pub fn iterate seed stretch
  grown seed stretch

fn join_parts before x after
  fold after (push before x) (acc y -> push acc y)

pub fn last coll
  unwrap_found (fold coll (missing true) (_ x -> x))

pub fn map coll f
  mapped f (iter coll)

pub fn max coll
  unwrap_found (fold coll (missing true) (m x -> outrank m x))

pub fn mean coll
  total = fold coll 0.0 (a x -> a + x)
  total / fold coll 0 (n _ -> n + 1)

pub fn min coll
  unwrap_found (fold coll (missing true) (m x -> underrank m x))

pub naturals = counting 1

# Taking from a cursor is a window, and a window is one record. The general
# arm below wraps a cursor in a cap and rebuilds both every element — an
# advanced cursor, a step, a fresh cap and another step, four records where
# two will do.
pub fn next (capped left (cursor at source))
  next (bounded at (at + left - 1) source)

pub fn next (bounded at stop source)
  if (stop < at) (done true) (next_bounded at stop source)

# the window says when to stop asking; the source says when it has run out,
# and taking more than there is has to end on the second one
fn next_bounded at stop source
  onward = bounded (at + 1) stop source
  if (length source < at) (done true) (step source[at]! onward)

pub fn next (capped left source)
  if (left < 1) (done true) (next_capped left (next source))

pub fn next (counting at)
  step at (counting (at + 1))

pub fn next (cursor at source)
  onward = cursor (at + 1) source
  if (length source < at) (done true) (step source[at]! onward)

pub fn next (cycled at source)
  onward = cycled (at + 1) source
  if (length source < at) (next (cycled 1 source)) (step source[at]! onward)

pub fn next (grown seed stretch)
  step seed (grown (stretch seed) stretch)

pub fn next (mapped shape source)
  next_mapped shape (next source)

pub fn next (paired left right)
  next_paired (next left) right

pub fn next (repeated value)
  step value (repeated value)

pub fn next (sifted keep source test)
  next_sifted keep test (next source)

pub fn next (skipped burn source)
  next_skipped burn source

fn next_capped _ (done d)
  done d

fn next_capped left (step e rest)
  step e (capped (left - 1) rest)

fn next_mapped _ (done d)
  done d

fn next_mapped shape (step e rest)
  step (shape e) (mapped shape rest)

fn next_paired (done d) _
  done d

fn next_paired (step x lrest) right
  next_zip x lrest (next right)

fn next_sifted _ _ (done d)
  done d

fn next_sifted keep test (step e rest)
  onward = sifted keep rest test
  if (test e == keep) (step e onward) (next onward)

# Skipping over a cursor is index arithmetic, not walking. The general arm
# below pulls one element at a time and throws each away, which costs a step
# record and an advanced cursor per element skipped — dropping 3,990 of 4,000
# allocated 8,029 times to reach ten values.
fn next_skipped burn (cursor at source)
  next (cursor (at + burn) source)

fn next_skipped burn source
  if (burn < 1) (next source) (next_skipped (burn - 1) (skip_one (next source)))

fn outrank (missing _) x
  x

fn outrank m x
  if (m < x) x m

fn outrank_by (missing _) x _
  x

fn outrank_by m x key
  if (key m < key x) x m

# the statistical spread; a bounded integer generator is naturals . take n
pub fn range coll
  spread (min coll) (max coll)

fn spread none _
  none

fn spread lo hi
  hi - lo

pub fn reject coll pred
  sifted false (iter coll) pred

pub fn repeat value
  repeated value

pub fn select coll pred
  sifted true (iter coll) pred

fn skip_one (done d)
  done d

fn skip_one (step _ rest)
  rest

pub fn sort coll
  msort (to_list coll)

# Merging halves rather than placing each element into a sorted run: placing
# walked the whole run twice and built two lists for every element, so a
# four-thousand element sort allocated sixty-four million times and peaked at
# 4.4 GB. Merging touches each element once per level.
fn msort xs
  whole xs (length xs)

fn whole xs 0
  xs

fn whole xs n
  span xs 1 n (n - 1)

# The halves are index ranges, not lists. Splitting by `take` and `drop` walked
# each half element by element to build a list that was read once and thrown
# away, at every level of the descent; a range costs nothing to make and the
# only lists built are the merged ones, which the sort owes anyway.
fn span xs lo _ 0
  [xs[lo]!]

fn span xs lo hi n
  mid = lo + n / 2
  left = span xs lo mid (mid - lo)
  right = span xs (mid + 1) hi (hi - mid - 1)
  merge [] left right 1 1

fn merge out left right i j
  if (i > length left) (drain out right j) (merge_on out left right i j)

fn merge_on out left right i j
  if (j > length right) (drain out left i) (pick out left right i j)

fn pick out left right i j
  advance (left[i] < right[j]) out left right i j

fn advance true out left right i j
  merge (push out left[i]) left right (i + 1) j

fn advance false out left right i j
  merge (push out right[j]) left right i (j + 1)

fn drain out xs i
  if (i > length xs) out (drain (push out xs[i]) xs (i + 1))

pub fn sum coll
  fold coll 0 (acc x -> acc + x)

pub fn take coll n
  capped n (iter coll)

pub fn tally coll
  fold coll {} (m x -> put m x (bump m[x]))

pub fn to_list coll
  fold coll [] (acc x -> push acc x)

fn underrank (missing _) x
  x

fn underrank m x
  if (x < m) x m

fn underrank_by (missing _) x _
  x

fn underrank_by m x key
  if (key x < key m) x m

fn unwrap_found none
  none

fn unwrap_found (missing _)
  none

fn unwrap_found found
  found

# both build through put, so a colliding key keeps its last value
pub fn to_h pairs
  fold pairs {} (acc kv -> put acc kv[1]! kv[2]!)

pub fn transform_keys m f
  fold (entries m) {} (acc e -> put_renamed acc e f)

fn put_renamed acc (entry k v) f
  put acc (f k) v

pub fn transform_values m f
  fold (entries m) {} (acc e -> put_shaped acc e f)

fn put_shaped acc (entry k v) f
  put acc k (f v)

pub fn zip a b
  paired (iter a) (iter b)

fn next_zip _ _ (done d)
  done d

fn next_zip x lrest (step y rrest)
  step [x y] (paired lrest rrest)
