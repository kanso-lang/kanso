pub type bounded
  at
  stop
  source

pub type capped
  left
  source

pub type counting
  at

pub type cursor
  at
  source

pub type cycled
  at
  source

pub type done
  drained

pub type grown
  seed
  stretch

pub type mapped
  shape
  source

type missing
  unfound

pub type paired
  left
  right

pub type repeated
  value

pub type sifted
  keep
  source
  test

