# Reading and writing, and nothing else.
#
# The filesystem, the environment, the arguments and the processes moved to
# `std/os` when the library took Go's split. What is left is what Go leaves in
# `io`: the surface a program reads through and writes through. kanso has no
# reader or writer type to abstract over yet, so the surface is three names —
# the two ends of the standard streams, and the input the process was handed.
pub stdin = builtin_stdin

pub fn write content
  builtin_write content

# Diagnostics, so a tool's chatter stays out of what it is piped into.
pub fn write_err content
  builtin_write_err content
