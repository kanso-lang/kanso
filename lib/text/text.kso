pub fn append acc x
  builtin_append acc x

pub fn bytes s
  builtin_bytes s

pub fn char_code c
  builtin_char_code c

pub fn chars s
  builtin_chars s

pub fn concat a b
  builtin_concat a b

pub fn find2 cs p a b
  builtin_find2 cs p a b

pub fn find2_below cs p a b lim
  builtin_find2_below cs p a b lim

pub fn from_code n
  builtin_from_code n

pub fn join parts sep
  builtin_join parts sep

pub fn slice s from to
  builtin_slice s from to

# An empty separator occurs everywhere, so the rule below gives no answer for
# it — it is a mistake rather than a case, and `chars` is what it was reaching
# for. Saying so beats scanning a string that never advances.
pub fn split _ ""
  err "split needs a separator; text/chars answers the characters"

# Every occurrence of `sep` ends a piece, and an empty piece is a piece:
# splitting "a,,b" answers three parts, and splitting "" answers one empty
# one. That is what makes split and join inverses of each other.
pub fn split s sep
  builtin_split s sep

# What a captured line arrives wearing: a process hands back its newline, a
# file its trailing blank line, and every caller wanted the sentence. The set
# is written here rather than held as a constant, because a constant is built
# whether or not a program ever trims anything. The builtin is called direct:
# `split` raises on an empty separator, and an answer that can be a raised err
# may not reach `step_in`, which has no arm for one. The separator here is a
# character, never empty, and the builtin answers a list and nothing else.
fn padding? c
  length (builtin_split " \t\n\r" c) > 1

# Both ends, by index: shedding one character at a time copies what is left on
# every step, which on a long string is the difference between a scan and a
# quadratic.
pub fn trim s
  from_front s 1 (length s)

fn from_front s at n
  past_the_end s at n (at > n)

fn past_the_end _ _ _ true
  ""

fn past_the_end s at n false
  step_in s at n (padding? (slice s at at))

fn step_in s at n true
  from_front s (at + 1) n

fn step_in s at n false
  from_back s at n

fn from_back s from at
  step_back s from at (padding? (slice s at at))

fn step_back s from at true
  from_back s from (at - 1)

fn step_back s from at false
  slice s from at

# `bytes` covers strings; this covers numbers. It refuses loudly outside 0-255
# rather than truncating, because a number that is not a byte is a mistake.
pub fn to_bytes xs
  builtin_to_bytes xs

pub fn to_float x
  builtin_to_float x

pub fn to_int s
  builtin_to_int s

pub fn utf8 codes
  builtin_utf8 codes

# The first position at or after p whose byte cannot be part of a JSON
# number, negated when a `.`, `e` or `E` went past; p itself when it lies
# outside the bytes.
pub fn number_span cs p
  builtin_number_span cs p

# Whether `s` begins with `prefix`. Every string begins with the empty one.
pub fn starts_with? s prefix
  n = length prefix
  n <= length s and slice s 1 n == prefix

# Whether `s` ends with `suffix`. Every string ends with the empty one.
pub fn ends_with? s suffix
  n = length s
  m = length suffix
  m <= n and slice s (n - m + 1) n == suffix

# The letters a to z become A to Z. Every other character, accented letters
# among them, passes through unchanged.
pub fn uppercase s
  recased (chars s) [] 1 97 "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

# The letters A to Z become a to z, and nothing else changes.
pub fn lowercase s
  recased (chars s) [] 1 65 "abcdefghijklmnopqrstuvwxyz"

fn recased cs out i lo to
  return join out "" if i > length cs
  recased cs (push out (recase cs[i] lo to)) (i + 1) lo to

# The walk stops before it reads past the end, so the none arm is never taken.
# The checker cannot see the bound and wants it written.
fn recase none _ _
  ""

fn recase c lo to
  at = char_code c - lo + 1
  letter c to at (at < 1 or 26 < at)

fn letter c _ _ true
  c

fn letter _ to at false
  slice to at at

# `s` with copies of `fill` in front until it is `width` characters long. The
# last copy is cut short when it would overrun, and a string already that long,
# or an empty fill, comes back as it was.
pub fn pad_start s width fill
  "{padding (width - length s) fill}{s}"

# `s` with copies of `fill` after it, by the same rule as `pad_start`.
pub fn pad_end s width fill
  "{s}{padding (width - length s) fill}"

fn padding n fill
  return "" if n < 1 or fill == ""
  slice (filled fill fill n) 1 n

fn filled acc fill n
  return acc if length acc >= n
  filled "{acc}{fill}" fill n
