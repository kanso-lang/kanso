pub fn append acc x
  builtin_append acc x

pub fn bytes s
  builtin_bytes s

pub fn char_code c
  builtin_char_code c

pub fn chars s
  builtin_chars s

pub fn concat a b
  builtin_concat a b

pub fn find2 cs p a b
  builtin_find2 cs p a b

pub fn find2_below cs p a b lim
  builtin_find2_below cs p a b lim

pub fn from_code n
  builtin_from_code n

pub fn join parts sep
  builtin_join parts sep

pub fn slice s from to
  builtin_slice s from to

# Every occurrence of `sep` ends a piece, and an empty piece is a piece:
# splitting "a,,b" answers three parts, and splitting "" answers one empty
# one. That is what makes split and join inverses of each other.
pub fn split s sep
  scan s sep 1 1 []

pub fn to_float x
  builtin_to_float x

pub fn to_int s
  builtin_to_int s

pub fn utf8 codes
  builtin_utf8 codes

fn scan s sep from at acc
  last = at + length sep - 1
  return push acc (slice s from (length s)) if last > length s
  scan_on s sep from at acc (slice s at last == sep)

fn scan_on s sep from at acc true
  after = at + length sep
  scan s sep after after (push acc (slice s from (at - 1)))

fn scan_on s sep from at acc false
  scan s sep from (at + 1) acc
