pub fn append acc x
  builtin_append acc x

pub fn bytes s
  builtin_bytes s

pub fn char_code c
  builtin_char_code c

pub fn chars s
  builtin_chars s

pub fn concat a b
  builtin_concat a b

pub fn find2 cs p a b
  builtin_find2 cs p a b

pub fn find2_below cs p a b lim
  builtin_find2_below cs p a b lim

pub fn from_code n
  builtin_from_code n

pub fn join parts sep
  builtin_join parts sep

pub fn slice s from to
  builtin_slice s from to

# An empty separator occurs everywhere, so the rule below gives no answer for
# it — it is a mistake rather than a case, and `chars` is what it was reaching
# for. Saying so beats scanning a string that never advances.
pub fn split _ ""
  err "split needs a separator; text/chars answers the characters"

# Every occurrence of `sep` ends a piece, and an empty piece is a piece:
# splitting "a,,b" answers three parts, and splitting "" answers one empty
# one. That is what makes split and join inverses of each other.
pub fn split s sep
  builtin_split s sep

# What a captured line arrives wearing: a process hands back its newline, a
# file its trailing blank line, and every caller wanted the sentence. The set
# is written here rather than held as a constant, because a constant is built
# whether or not a program ever trims anything.
fn padding? c
  length (split " \t\n\r" c) > 1

# Both ends, by index: shedding one character at a time copies what is left on
# every step, which on a long string is the difference between a scan and a
# quadratic.
pub fn trim s
  from_front s 1 (length s)

fn from_front s at n
  past_the_end s at n (at > n)

fn past_the_end _ _ _ true
  ""

fn past_the_end s at n false
  step_in s at n (padding? (slice s at at))

fn step_in s at n true
  from_front s (at + 1) n

fn step_in s at n false
  from_back s at n

fn from_back s from at
  step_back s from at (padding? (slice s at at))

fn step_back s from at true
  from_back s from (at - 1)

fn step_back s from at false
  slice s from at

# `bytes` covers strings; this covers numbers. It refuses loudly outside 0-255
# rather than truncating, because a number that is not a byte is a mistake.
pub fn to_bytes xs
  builtin_to_bytes xs

pub fn to_float x
  builtin_to_float x

pub fn to_int s
  builtin_to_int s

pub fn utf8 codes
  builtin_utf8 codes
