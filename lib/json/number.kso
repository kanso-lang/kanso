import "std/text"

# The scan and the float test used to be two walks over the same bytes: one
# asking where the number ends, one asking whether a `.`, `e` or `E` went
# past. The mark rides along with the scan now, so each number's bytes are
# read once. It rides as a boolean argument rather than in a record beside
# the end position, because a record here is an allocation per number.
fn scan cs start p marked
  scan_at cs cs[p] start p marked

# float marks: . E e
fn scan_at cs 46 start p _
  scan cs start (p + 1) true

fn scan_at cs 69 start p _
  scan cs start (p + 1) true

fn scan_at cs 101 start p _
  scan cs start (p + 1) true

# the signs a number may carry, which say nothing about its kind
fn scan_at cs 43 start p marked
  scan cs start (p + 1) marked

fn scan_at cs 45 start p marked
  scan cs start (p + 1) marked

fn scan_at cs none start p marked
  number_done cs start p marked

fn scan_at cs c start p marked
  digit_step cs start p marked (47 < c and c < 58)

fn digit_step cs start p marked true
  scan cs start (p + 1) marked

fn digit_step cs start p marked false
  number_done cs start p marked

fn number_done cs start p true
  parsed p (number_ok start (text/to_float (text/slice cs start (p - 1))))

fn number_done cs start p false
  parsed p (number_ok start (text/to_int (text/slice cs start (p - 1))))

fn number_ok p (err _)
  fail p "invalid number"

fn number_ok _ n
  n

fn number_start? 45
  true

fn number_start? none
  false

fn number_start? c
  47 < c and c < 58
