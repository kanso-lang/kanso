import "std/text"

fn array_delim cs 44 p acc
  array_items cs (p + 1) acc

fn array_delim _ 93 p acc
  parsed (p + 1) acc

fn array_delim _ none p _
  fail p "unexpected end of input"

# Whitespace is the arm before the error rather than a scan the caller runs
# first. `skip_ws` used to walk to the next non-blank byte and hand back only
# the position, so the caller loaded that byte a second time to dispatch on
# it. One dispatch on one loaded byte does both jobs.
fn array_delim cs c p acc
  blank = ws? c
  if blank (array_delim cs cs[p + 1] (p + 1) acc) (array_bad c p)

fn array_bad c p
  fail p "expected `,` or `]`, found `{text/utf8 [c]}`"

# No skip here: `parse_value` opens with its own `skip_ws`, and this one ran
# on the same position first, so the second walk always found the byte the
# first had stopped on. jsonbench's arrays paid it once an element.
fn array_items cs p acc
  array_step cs (parse_value cs p) acc

fn array_open _ 93 p
  parsed (p + 1) []

fn array_open _ none p
  fail p "unexpected end of input"

fn array_open cs c p
  blank = ws? c
  if blank (array_open cs cs[p + 1] (p + 1)) (array_items cs p [])

fn array_step cs (parsed p v) acc
  array_delim cs cs[p] p (push acc v)

fn bad_value_char c p
  fail p "unexpected character `{text/utf8 [c]}`"

fn obj_colon cs p k acc
  obj_value cs (parse_value cs p) k acc

fn obj_delim cs 44 p acc
  obj_items cs (p + 1) acc

fn obj_delim _ 125 p acc
  parsed (p + 1) acc

fn obj_delim _ none p _
  fail p "unexpected end of input"

fn obj_delim cs c p acc
  blank = ws? c
  if blank (obj_delim cs cs[p + 1] (p + 1) acc) (obj_bad c p)

fn obj_bad c p
  fail p "expected `,` or `}`, found `{text/utf8 [c]}`"

fn obj_items cs p acc
  obj_key_start cs cs[p] p acc

# The colon is the arm before the error rather than a scan the caller runs
# first, the shape `array_delim` and `obj_delim` already take: `skip_ws` walked
# to the colon and handed back only its position, so `expect_char` loaded the
# same byte a second time to compare it.
fn obj_key cs (parsed p k) acc
  obj_key_end cs cs[p] p k acc

fn obj_key_end cs 58 p k acc
  obj_colon cs (p + 1) k acc

fn obj_key_end _ none p _ _
  fail p "expected `:`"

fn obj_key_end cs c p k acc
  blank = ws? c
  if blank (obj_key_end cs cs[p + 1] (p + 1) k acc) (fail p "expected `:`")

fn obj_key_start cs 34 p acc
  obj_key cs (parse_string cs (p + 1)) acc

fn obj_key_start _ none p _
  fail p "unexpected end of input"

fn obj_key_start cs c p acc
  blank = ws? c
  if blank (obj_key_start cs cs[p + 1] (p + 1) acc) (key_bad p)

fn key_bad p
  fail p "expected a string key"

fn obj_open _ 125 p
  parsed (p + 1) {}

fn obj_open _ none p
  fail p "unexpected end of input"

fn obj_open cs c p
  blank = ws? c
  if blank (obj_open cs cs[p + 1] (p + 1)) (obj_items cs p {})

fn obj_value cs (parsed p v) k acc
  obj_delim cs cs[p] p (put acc k v)

fn parse_array cs p
  array_open cs cs[p] p

fn parse_number cs p
  scan cs p p false

fn parse_object cs p
  obj_open cs cs[p] p

fn parse_value cs p
  value_for cs[p] cs p

# value starts by byte: 34 quote, 91 bracket, 102 f, 110 n, 116 t, 123 brace
fn value_for 34 cs p
  parse_string cs (p + 1)

fn value_for 91 cs p
  parse_array cs (p + 1)

fn value_for 102 cs p
  matched = alse? cs p
  word matched p 5 false

fn value_for 110 cs p
  matched = ull? cs p
  word matched p 4 json_null

fn value_for 116 cs p
  matched = rue? cs p
  word matched p 4 true

fn value_for 123 cs p
  parse_object cs (p + 1)

fn value_for none _ p
  fail p "unexpected end of input"

fn value_for c cs p
  numeric = number_start? c
  if numeric (parse_number cs p) (value_blank c cs p)

fn value_blank c cs p
  blank = ws? c
  if blank (value_for cs[p + 1] cs (p + 1)) (bad_value_char c p)

# The first byte chose the arm, so what is left is the tail of one known
# keyword, compared where it sits. Slicing it out built a byte string to throw
# away, and comparing that to a list of codes walked both element by element
# with a tag check on each. Reading past the end answers none, which matches
# nothing, so a truncated literal needs no length test of its own.
fn alse? cs p
  cs[p + 1] == 97 and cs[p + 2] == 108 and cs[p + 3] == 115 and cs[p + 4] == 101

fn ull? cs p
  cs[p + 1] == 117 and cs[p + 2] == 108 and cs[p + 3] == 108

fn rue? cs p
  cs[p + 1] == 114 and cs[p + 2] == 117 and cs[p + 3] == 101

fn word true p n v
  parsed (p + n) v

fn word false p _ _
  fail p "invalid literal"
