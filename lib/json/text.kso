import "std/text"

# escape appends onto the byte builder: int arms compile to a jump
# table and each byte lands in the accumulator once
# the seven escapes share one body, so the lambda that folds `esc_byte` over a
# string carries one expansion of it rather than seven. Seven copies is what put
# six callee-saved registers in the wrapper's prologue, and the hot arm -- a
# plain byte, appended in place -- paid for all of them on every byte.
fn esc_pair acc b
  text/append (text/append acc 92) b

fn esc_byte acc 8
  esc_pair acc 98

fn esc_byte acc 9
  esc_pair acc 116

fn esc_byte acc 10
  esc_pair acc 110

fn esc_byte acc 12
  esc_pair acc 102

fn esc_byte acc 13
  esc_pair acc 114

fn esc_byte acc 34
  esc_pair acc 34

fn esc_byte acc 92
  esc_pair acc 92

fn esc_byte acc b
  if (b < 32) (u_bytes acc b) (text/append acc b)

# when the scan did find something, every byte in front of it is proved clean
# too: that run leaves in one copy, the found byte escapes, and the scan
# resumes behind it. no byte is ever walked one at a time
fn escape_rest acc bs n len
  escape_at (escape_run acc bs 1 n) bs n len

# the clean run from p up to the found position, appended in one copy
fn escape_run acc bs p n
  if (p < n) (text/append acc (builtin_slice_in bs p (n - 1))) acc

fn escape_at acc bs n len
  return acc if n < 1 or length bs < n
  escape_next (esc_byte acc bs[n]) bs (n + 1) len

fn escape_next acc bs p len
  escape_found acc bs p len (text/find2_below bs p 34 92 32)

fn escape_found acc bs p len m
  escape_more (escape_run acc bs p m) bs m len

fn escape_more acc bs m len
  if (len < m) acc (escape_at acc bs m len)

fn escape_split acc s bs n len
  if (len < n) (text/append acc s) (escape_rest acc bs n len)

fn escape_clean acc s bs n
  escape_split acc s bs n (length bs)

pub fn escape_onto acc s
  bs = text/bytes s
  escape_clean acc s bs (text/find2_below bs 1 34 92 32)

fn escape_str s
  text/utf8 (escape_onto (text/bytes "") s)

fn hex_alpha c
  if (96 < c and c < 103) (c - 87) (hex_upper c)

hex_byte_table = text/bytes "0123456789abcdef"

fn hex_code n
  hex_byte_table[n + 1]

fn hex_digit none
  err "unexpected end of input"

fn hex_digit c
  if (47 < c and c < 58) (c - 48) (hex_alpha c)

fn hex_upper c
  if (64 < c and c < 71) (c - 55) (err "invalid hex digit")

# The run up to the first quote or backslash is a span the scan proved
# inside cs, so slicing it cannot miss. A string ending in its last byte
# reaches one past the end, where span_to answers the empty run.
# A string with no escape in it is read by one call, which finds the closing
# quote and answers the text before it. One with an escape, or with bytes that
# are not utf-8, answers none there and is read the long way, which is where an
# escape is undone and a bad byte is named.
fn parse_string cs p
  plain_at cs p (builtin_plain_string cs p)

fn plain_at cs p none
  string_at cs (text/span_to cs p 34 92)

fn plain_at cs p q:int
  fresh = text/bytes ""
  str_chars cs q (text/append fresh (builtin_slice_in cs p (q - 1)))

fn plain_at _ p s
  parsed (p + 1 + length (text/bytes s)) s

# string bytes: 34 quote, 92 backslash; escapes name their targets
fn str_char _ 34 p acc
  parsed (p + 1) (string_ok p (builtin_built_text acc))

fn str_char cs 92 p acc
  str_escape cs (cs[p + 1]) p acc

fn str_char _ none p _
  fail p "unterminated string"

fn str_char cs c p acc
  str_chars cs (p + 1) (text/append acc c)

# The run between two escapes is one slice. A string with an escape used to
# walk to the closing quote a character at a time, appending each, so a `\n`
# near the front of a long value cost a byte-by-byte copy of everything after
# it. find2 already knows how to skip to the next quote or backslash — it is
# the call the escape-free path makes — and the emitter fuses the append of a
# slice into one copy, so the run costs no view header.
fn str_chars cs p acc
  str_run cs (text/span_to cs p 34 92) acc

# a backslash in the last byte leaves the next run starting past the end
fn str_run cs none _
  fail (length cs + 1) "unterminated string"

fn str_run cs run acc
  n = run.to + 1
  str_char cs cs[n] n (text/append acc (text/slice run))

fn str_escape cs 34 p acc
  str_chars cs (p + 2) (text/append acc 34)

fn str_escape cs 47 p acc
  str_chars cs (p + 2) (text/append acc 47)

fn str_escape cs 92 p acc
  str_chars cs (p + 2) (text/append acc 92)

fn str_escape cs 98 p acc
  str_chars cs (p + 2) (text/append acc 8)

fn str_escape cs 102 p acc
  str_chars cs (p + 2) (text/append acc 12)

fn str_escape cs 110 p acc
  str_chars cs (p + 2) (text/append acc 10)

fn str_escape cs 114 p acc
  str_chars cs (p + 2) (text/append acc 13)

fn str_escape cs 116 p acc
  str_chars cs (p + 2) (text/append acc 9)

fn str_escape cs 117 p acc
  str_unicode cs p acc

fn str_escape _ none p _
  fail p "unterminated string"

fn str_escape _ c p _
  fail p "invalid escape `\\{text/utf8 [c]}`"

# four hex digits: each is dispatched on before it is added, because an err
# is not a number, and the first bad digit is the failure handed on
fn str_hex4 cs p
  hex_on (hex_three cs p) (hex_digit cs[p + 3])

fn hex_three cs p
  hex_on (hex_on (hex_digit cs[p]) (hex_digit cs[p + 1])) (hex_digit cs[p + 2])

fn hex_on e@(err _) (err _)
  e

fn hex_on e@(err _) _
  e

fn hex_on _ e@(err _)
  e

fn hex_on n d
  n * 16 + d

fn str_low _ _ _ _ e@(err _)
  e

fn str_low cs p acc high low
  scalar = 65536 + (high - 55296) * 1024 + (low - 56320)
  if (56319 < low and low < 57344)
    str_chars cs (p + 12) (text/append acc (text/from_code scalar))
    fail p "a high surrogate needs a low surrogate beside it"

# the low half is only read once `\u` is seen: past the string's end there
# are no hex digits to force
fn str_pair cs p acc high
  if (cs[p + 6] == 92 and cs[p + 7] == 117)
    str_low cs p acc high (str_hex4 cs (p + 8))
    fail p "a high surrogate needs a low surrogate beside it"

# a surrogate is half a character: the high half joins the `\u` low half
# written beside it, and either half alone is a failure
fn str_surrogate cs p acc high
  if (56319 < high)
    fail p "a low surrogate arrived without its high half"
    str_pair cs p acc high

fn str_unicode cs p acc
  unicode_at cs p acc (str_hex4 cs (p + 2))

fn unicode_at _ _ _ e@(err _)
  e

fn unicode_at cs p acc code
  if (code < 55296 or 57343 < code)
    str_chars cs (p + 6) (text/append acc (text/from_code code))
    str_surrogate cs p acc code

fn string_at cs none
  fail (length cs + 1) "unterminated string"

fn string_at cs run
  string_end cs cs[run.to + 1] run

fn string_end _ 34 run
  p = run.to + 1
  parsed (p + 1) (string_ok p (text/utf8 (text/slice run)))

fn string_end cs 92 run
  fresh = text/bytes ""
  str_chars cs (run.to + 1) (text/append fresh (text/slice run))

fn string_end _ none run
  fail (run.to + 1) "unterminated string"

fn string_ok p (err _)
  err (parse_failure p "invalid utf-8 in string")

fn string_ok _ v
  v

fn u_bytes acc b
  lo = hex_code (b % 16)
  hi = hex_code (b / 16)
  text/append (text/append (text/append acc "\\u00") hi) lo
