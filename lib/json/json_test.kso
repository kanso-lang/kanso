import "std/testing"
import "std/text"

# `when_failed` hands back the bare reason, so this names a reason type and
# never an err — json cannot rescue what json raised.
fn a_defect? (defect _)
  true

fn a_defect? _
  false

test_decode_array = decode "[1, 2, 3]" == [1 2 3]

test_decode_bool = decode "true"

test_decode_escapes = decode "\"a\\n\\\"b\\\"\"" == "a\n\"b\""

test_decode_float = decode "3.25" == 3.25

test_decode_int = decode "42" == 42

test_decode_nested =
  decoded = decode "\{\"a\": [1, \{\"b\": null}]}"
  decoded == { "a":[1 { "b":json_null }] }

test_decode_object = decode "\{\"a\": 1, \"b\": 2}" == { "a":1 "b":2 }

test_decode_string = decode "\"hello\"" == "hello"

test_decode_surrogate_pair = decode "\"\\ud83c\\udf8c\"" == "🎌"

test_decode_unicode = decode "\"\\u00e9\"" == "é"

test_decode_whitespace = decode "  [ 1 , 2 ]  " == [1 2]

test_encode_empty_list = encode [] == "[]"

test_encode_empty_map = encode {} == "\{}"

test_encode_escapes = encode "a\"b\nc" == "\"a\\\"b\\nc\""

test_encode_shorthands =
  raw = text/utf8 [120 8 121 12 122]
  encode raw == "\"x\\by\\fz\""

test_encode_nested =
  value = { "a":true "b":[1 2] }
  encode value == "\{\"a\":true,\"b\":[1,2]}"

test_error_position =
  decoded = decode "[1, nope]"
  testing/when_failed decoded (r -> r.position == 5)

test_error_trailing =
  decoded = decode "1 x"
  testing/when_failed decoded (r -> r.position == 3)

test_must_wraps_defect = testing/when_failed (must (decode "nope")) a_defect?

test_roundtrip =
  text = "\{\"a\":[1,2.5,\"x\"],\"b\":null}"
  encode (decode text) == text
