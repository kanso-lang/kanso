import "std/testing"
import "std/text"

# `when_failed` hands back the bare reason, so this names a reason type and
# never an err — json cannot rescue what json raised.
test_decode_array = decodes? "[1, 2, 3]" [1 2 3]

test_decode_bool = decode "true"

test_decode_escapes = decodes? "\"a\\n\\\"b\\\"\"" "a\n\"b\""

test_decode_float = decodes? "3.25" 3.25

test_decode_exponent = decodes? "1e3" 1000.0

test_decode_exponent_upper = decodes? "2E2" 200.0

# the mark is a `.` here and an `e` further on: a scan that forgot the first
# one on reaching the second would hand these digits to the integer reader
test_decode_exponent_signed = decodes? "1.5e2" 150.0

test_decode_int = decodes? "42" 42

test_decode_negative = decodes? "-7" (0 - 7)

test_decode_nested =
  decoded = decode "\{\"a\": [1, \{\"b\": null}]}"
  decoded == { "a":[1 { "b":json_null }] }

test_decode_object = decodes? "\{\"a\": 1, \"b\": 2}" { "a":1 "b":2 }

test_decode_string = decodes? "\"hello\"" "hello"

test_decode_surrogate_pair = decodes? "\"\\ud83c\\udf8c\"" "🎌"

test_decode_unicode = decodes? "\"\\u00e9\"" "é"

test_decode_whitespace = decodes? "  [ 1 , 2 ]  " [1 2]

test_encode_empty_list = encode [] == "[]"

test_encode_empty_map = encode {} == "\{}"

test_encode_escapes = encode "a\"b\nc" == "\"a\\\"b\\nc\""

test_encode_shorthands =
  raw = text/utf8 [120 8 121 12 122]
  encode raw == "\"x\\by\\fz\""

test_encode_nested =
  value = { "a":true "b":[1 2] }
  encode value == "\{\"a\":true,\"b\":[1,2]}"

test_error_position =
  decoded = decode "[1, nope]"
  testing/when_failed decoded (r -> r.position == 5)

test_error_trailing =
  decoded = decode "1 x"
  testing/when_failed decoded (r -> r.position == 3)

test_roundtrip =
  text = "\{\"a\":[1,2.5,\"x\"],\"b\":null}"
  encodes_back? (decode text) text

# `decode` answers an err for bad input and `==` wants a value, so a test
# dispatches on what it decoded before comparing it.
fn decodes? text want
  same? (decode text) want

fn same? (err _) _
  false

fn same? got want
  got == want

fn encodes_back? (err _) _
  false

fn encodes_back? v text
  encode v == text
