import "std/io"
import "std/list"
import "std/os"
import "std/text"

# hako's first verb, in the language hako manages. Reading the lock needs no
# network; saying whether a pin has fallen behind does, so the remote is
# asked once per pin and a remote that does not answer says so.
pub fn listing dir
  os/read_file! "{dir}/hako.lock" . shown

fn shown text
  described (parse text)

fn described pins
  empty = io/write "hako.lock pins nothing — run `kanso install`\n"
  if (length pins == 0) empty (against_remotes pins)

fn against_remotes pins
  os/env "KANSO_HAKO_REMOTE" . (set -> walked pins set "")

fn walked pins set acc
  rest = list/to_list (list/drop pins 1)
  grown = (mark -> walked rest set "{acc}{line pins[1]! mark}")
  more = marked pins[1]! set . grown
  if (length pins == 0) (io/write acc) more

# An interim pin is not on the tag series staleness is measured along, so the
# only thing worth saying about it is that it is interim.
fn marked p set
  interim = settled " (interim pin: not a release)"
  if (release? p.tag) (against p set) interim

fn against p set
  newest set p.name . (latest -> settled (compared latest p.tag))

fn compared latest tag
  if (latest == none) " (unreachable)" (behind latest[1]! tag)

fn behind latest tag
  if (latest == tag) "" " (stale: {latest} is out)"

fn settled mark
  io/write "" . (_ -> mark)

fn line p mark
  short = text/slice p.sha 1 12
  "{text/join [p.name p.tag short p.protocol] " "}{mark}\n"

# The verb and its arguments arrive the way any program's do. `kanso list`
# and `kanso update` hand them in; there is no third caller.
pub fn ran argv
  verb = argv[1]!
  dir = argv[2]!
  rest = list/to_list (list/drop argv 2)
  only = if (length rest == 0) none rest[1]!
  pinned = installing dir (overrides rest)
  if (verb == "install") pinned (walked_or_listed verb dir only)

fn walked_or_listed verb dir only
  if (verb == "list") (listing dir) (updating dir only)

# `--from owner/repo@branch`, one for each hako being pinned to a branch. The
# lock is the only home an override has: an import names identity and nothing
# more, so the branch cannot live there.
fn overrides rest
  list/to_list (list/map rest split_at)

fn split_at spec
  halves = text/split spec "@"
  [halves[1]! halves[2]!]

pub play = os/args . ran
