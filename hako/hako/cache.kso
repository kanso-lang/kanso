import "std/io"
import "std/os"
import "std/path"

# Where fetched trees live. The cache is keyed by name and sha, so two
# versions of one hako coexist and a fetched tree is never mistaken for a
# different one.
pub fn cache_root set home
  if (set == none) (path/join home ".hako") set

pub fn at root name sha
  path/join root "{name}@{sha}"

# A tree already in the cache is the tree that sha names, so fetching again
# would answer the same bytes at the cost of a network round trip.
pub fn fetched root name tag sha from
  into = at root name sha
  os/exists into . (there -> if there (nothing 0) (cloned into tag from))

fn nothing _
  io/write ""

fn cloned into tag from
  argv = ["clone" "--quiet" "--depth" "1" "--branch" tag from into]
  os/run "git" argv . (p -> settled p into)

fn settled p into
  if (p.status == 0) (stripped into) (unreachable p)

# The cache holds source, not history: a shallow clone's .git is the largest
# thing in it and nothing downstream reads it.
fn stripped into
  os/run "rm" ["-rf" (path/join into ".git")] . (_ -> io/write "")

fn unreachable p
  err "cannot fetch: {p.stderr}"
