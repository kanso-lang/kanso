import "std/io"
import "std/list"
import "std/text"

# Where a name is fetched from. The tests point this at a directory of
# repositories, which is what lets them run without a network.
pub fn base set
  if (set == none) "https://github.com/" set

pub fn url set name
  parts = text/split name "/"
  "{base set}{parts[1]!}/{parts[2]!}"

# The highest release the remote publishes, as `[tag sha]` — update needs
# both, and a tag without the commit it named is not something to lock. A
# remote that cannot be reached and one that publishes no release both answer
# none: neither says anything about whether the pin in the lock is behind.
pub fn newest set name
  io/run "git" ["ls-remote" "--tags" (url set name)] . picked

fn picked p
  rows = text/split p.stdout "\n"
  tags = list/to_list (list/map (list/reject rows blank?) tagged)
  if (p.status != 0) none (highest tags)

fn blank? row
  row == ""

# `<sha>\trefs/tags/<tag>`, and a tag an annotated object points at repeats
# with a `^{}` suffix that names the same release.
# `<sha>\trefs/tags/<tag>`
fn tagged row
  fields = text/split row "refs/tags/"
  columns = text/split row "\t"
  [(bare (fields[length fields]!)) columns[1]!]

fn bare tag
  parts = text/split tag "^"
  parts[1]!

fn highest tags
  releases = list/reject tags unreleased?
  list/fold releases none later

fn unreleased? pair
  release? pair[1]! == false

fn later seen pair
  if (seen == none) pair (further seen pair)

fn further seen pair
  if (after? pair[1]! seen[1]!) pair seen

# Lexicographic on the three numbers, which is why a release is exactly three.
pub fn after? tag seen
  a = version tag
  b = version seen
  ahead? (a[1]! - b[1]!) (a[2]! - b[2]!) (a[3]! - b[3]!)

fn ahead? major minor patch
  if (major != 0) (major > 0) (ahead_rest? minor patch)

fn ahead_rest? minor patch
  if (minor != 0) (minor > 0) (patch > 0)

fn version tag
  parts = text/split (text/slice tag 2 (length tag)) "."
  list/to_list (list/map parts text/to_int)

# A branch's head. Interim by construction: a branch moves, so the sha beside
# it in the lock is what makes the build reproducible.
pub fn head_of set name branch
  argv = ["ls-remote" "--heads" (url set name) branch]
  io/run "git" argv . only_head

fn only_head p
  rows = list/to_list (list/reject (text/split p.stdout "\n") blank?)
  if (p.status != 0) none (first_column rows)

fn first_column rows
  if (length rows == 0) none (text/split rows[1]! "\t")[1]!
