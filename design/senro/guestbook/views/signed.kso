# written by kata from signed.slim: edit the template, not this file

pub fn signed signatures
  joined [
    "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>"
    "Guestbook</title></head><body><h1>Guestbook</h1><form method=\"post\" "
    "action=\"/entries\"><input name=\"name\" placeholder=\"your name\">"
    "<input name=\"message\" placeholder=\"say something\"><button>"
    # signed.slim:14
    "Sign</button></form><ul>{each signatures (e -> signed_14 e)}</ul></body>"
    "</html>"
  ]

fn signed_14 e
  # signed.slim:16, 17
  "<li><strong>{escape e.name}</strong> wrote {escape e.message}</li>"
