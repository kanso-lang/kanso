import "../pg"
import "../routes"
import "../web"
import "./entries"
import "./home"

derive routes/rest

made = "create table if not exists entries (id serial, name text, message text)"

pg/connect "127.0.0.1" 54329 "postgres" "postgres" ""
  .> (db -> pg/run db made .> (_ -> web/serve 3000 routes db))
