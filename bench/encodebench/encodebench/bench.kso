# A document that did not decode is handed on as it is, so the run halts on
# the reason instead of encoding nothing 400 times.
pub fn rounds e@(err _) 0 _
  e

pub fn rounds e@(err _) _ _
  e

pub fn rounds _ 0 acc
  print "done: {acc}"

pub fn rounds v n acc
  rounds v (n - 1) (acc + length (encode v))
