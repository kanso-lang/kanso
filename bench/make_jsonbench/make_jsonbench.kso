import "std/io"
import "std/os"

# Rebuild bench/jsonbench: a main that reads bench/large.json AT RUNTIME and
# decodes it 150 times with std/json, accumulating a checksum so the loop
# provably runs (no hoisting / dead-code elimination). Runtime read keeps the
# input opaque to the optimizer — an embedded compile-time fixture would let
# LLVM fold the decode and flatter the number. Run the built ./jsonbench from
# the repo root; divide its wall time by 150.
#
# The decoder is imported rather than copied into the benchmark. lib/json names
# builtins only the standard library may call, and a copy is a user module.
out = "bench/jsonbench"

module_dir = "bench/jsonbench/jsonbench"

# The read insists, because a benchmark whose input is missing has nothing to
# measure. It used to be written out into a `fed` pair here — `os/read_file`
# and a `file_not_found` arm — because inference read a chain's yield off the
# head's bare name and `os/read_file!` fell to the top set. The document then
# had no type where the loop analysis reads one, and jsonbench decoded with a
# grow-only arena: blocks 2 to 248, peak 2 MB to 260 MB, on the same bytes and
# the same decoder. The yield is now carried per declaration, so the bang
# costs the loop nothing and the pair is gone.
bench_text = """
  import "std/json"

  pub fn go cs
    print "decoded 150 times, checksum \{loop cs 150 0}"

  fn loop _ 0 acc
    acc

  fn loop cs n acc
    loop cs (n - 1) (acc + length (json/decode cs))
"""

main_text = """
  import "./jsonbench"
  import "std/os"

  os/read_file! "bench/large.json" .> go
"""

ready = "{out} ready (150x runtime-read; run ./jsonbench from repo root)\n"

pub play = built

built = os/make_dir out .> (_ -> os/make_dir module_dir) .> (_ -> written)

written = os/write_file "{module_dir}/jsonbench.kso" bench_text
  .> (_ -> os/write_file "{out}/main.kso" main_text)
  .> (_ -> io/write ready)
