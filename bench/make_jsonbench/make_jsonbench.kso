import "std/io"
import "std/list"
import "std/os"
import "std/text"

# Rebuild bench/jsonbench: the json module plus a main that reads
# bench/large.json AT RUNTIME and decodes it 150 times, accumulating a
# checksum so the loop provably runs (no hoisting / dead-code elimination).
# Runtime read keeps the input opaque to the optimizer — an embedded
# compile-time fixture would let LLVM fold the decode and flatter the number.
# Run the built ./jsonbench from the repo root; divide its wall time by 150.
out = "bench/jsonbench"

module_dir = "bench/jsonbench/jsonbench"

# `failure_position` rescues an err this program raises, and a benchmark that
# only decodes has no use for it.
dropped = "fn failure_position"

# `fed` is `os/read_file!` written at the call site, and it is written out
# because the bang costs the loop its beat. Inference reads a chain's yield
# by the head's bare name: `os/read_file` is typed because its name collides
# with the builtin's, and `os/read_file!` — same body, one character more —
# falls to the top set. The document then has no type where the loop analysis
# reads one, and jsonbench decodes with a grow-only arena: blocks 2 to 248,
# peak 2 MB to 260 MB, on the same bytes and the same decoder.
#
# Both spellings mean the same thing: the file must be there, and a missing
# one is a failure. When the yield of a kanso function is inferred, this
# becomes `os/read_file! "bench/large.json" . go` again.
bench_text = """
  pub fn go cs
    print "decoded 150 times, checksum \{loop cs 150 0}"

  fn loop _ 0 acc
    acc

  fn loop cs n acc
    loop cs (n - 1) (acc + length (decode cs))

  pub fn fed (file_not_found f)
    err "cannot read \{f}: no such file"

  pub fn fed cs
    go cs
"""

main_text = """
  import "./jsonbench"
  import "std/os"

  os/read_file "bench/large.json" . fed
"""

ready = "{out} ready (150x runtime-read; run ./jsonbench from repo root)\n"

pub play = built

built = os/make_dir out . (_ -> os/make_dir module_dir) . (_ -> copied)

copied = plain "number" . (_ -> plain "scan") . (_ -> plain "text")
  . (_ -> plain "value") . (_ -> trimmed) . (_ -> written)

fn plain name
  os/read_file! "lib/json/{name}.kso"
    . (s -> os/write_file "{module_dir}/{name}.kso" s)

trimmed = os/read_file! "lib/json/json.kso" . stripped

fn stripped source
  os/write_file "{module_dir}/json.kso" (kept source)

# Blocks are separated by a blank line, which is what makes the one function
# this benchmark does not want addressable without parsing the file.
fn kept source
  blocks = text/split (text/trim source) "\n\n"
  staying = list/to_list (list/reject blocks starts_dropped?)
  "{text/join staying "\n\n"}\n"

fn starts_dropped? block
  text/slice block 1 (length dropped) == dropped

written = os/write_file "{module_dir}/bench.kso" bench_text
  . (_ -> os/write_file "{out}/main.kso" main_text)
  . (_ -> io/write ready)
