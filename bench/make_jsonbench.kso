import "std/io"
import "std/list"
import "std/text"

# Rebuild bench/jsonbench: the json module plus a main that reads
# bench/large.json AT RUNTIME and decodes it 150 times, accumulating a
# checksum so the loop provably runs (no hoisting / dead-code elimination).
# Runtime read keeps the input opaque to the optimizer — an embedded
# compile-time fixture would let LLVM fold the decode and flatter the number.
# Run the built ./jsonbench from the repo root; divide its wall time by 150.
out = "bench/jsonbench"

# `failure_position` rescues an err this program raises, and a benchmark that
# only decodes has no use for it.
dropped = "fn failure_position"

bench_text = """
  fn go cs
    print "decoded 150 times, checksum \{loop cs 150 0}"

  fn loop _ 0 acc
    acc

  fn loop cs n acc
    loop cs (n - 1) (acc + length (decode cs))
"""

main_text = """
  import "std/io"

  io/read_file "bench/large.json" . go
"""

ready = "{out} ready (150x runtime-read; run ./jsonbench from repo root)\n"

pub play = built

built = io/make_dir out . (_ -> copied)

copied = plain "number" . (_ -> plain "scan") . (_ -> plain "text")
  . (_ -> plain "value") . (_ -> trimmed) . (_ -> written)

fn plain name
  io/read_file "lib/json/{name}.kso" . (s -> io/write_file "{out}/{name}.kso" s)

trimmed = io/read_file "lib/json/json.kso" . stripped

fn stripped source
  io/write_file "{out}/json.kso" (kept source)

# Blocks are separated by a blank line, which is what makes the one function
# this benchmark does not want addressable without parsing the file.
fn kept source
  blocks = text/split (text/trim source) "\n\n"
  staying = list/to_list (list/reject blocks starts_dropped?)
  "{text/join staying "\n\n"}\n"

fn starts_dropped? block
  text/slice block 1 (length dropped) == dropped

written = io/write_file "{out}/bench.kso" bench_text
  . (_ -> io/write_file "{out}/main.kso" main_text)
  . (_ -> io/write ready)
