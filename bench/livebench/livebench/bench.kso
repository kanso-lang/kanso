import "std/json"

pub fn hold text
  json/decode text

# A document that did not decode says so once, instead of encoding nothing
# 400 times.
pub fn rounds none 0 _
  print "not json"

pub fn rounds none _ _
  print "not json"

pub fn rounds _ 0 tally
  print "wrote {tally}"

pub fn rounds doc n tally
  rounds doc (n - 1) (tally + length (json/encode doc))
