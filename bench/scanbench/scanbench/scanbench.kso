import "std/regexp"
import "std/text"

# A scan whose PEAK would grow with the subject if a position's scratch were
# kept. escapebench measures storage the arena never held; this measures
# storage the arena holds, and whether it gives it back.
#
# The shape is prose_check's, which is the real workload behind it: walk a
# subject once, matching at every position, keeping nothing. Peak should be
# flat in the subject length, because a position that matched nothing has no
# result to hold.
#
# It is flat. The loop in std/regexp that tries each start position rewinds the
# arena at every step, so what one position's walk allocated is gone before the
# next begins. Until 2026-09-23 it did not: the loop handed the walk's answer to
# the next position as an argument, and read its position out of a hit's field,
# which inference cannot type. Either one kept the loop from rewinding, and
# 1,000 characters here held 161,480,704 bytes over 154 blocks. They hold one
# block now, and `tests/golden/mem/a_scan_that_finds_nothing_keeps_nothing.kso`
# pins the same shape at a size the mem corpus can afford.
#
# The pattern retains nothing on purpose. A pattern that matched would make
# peak grow for an honest reason — the matches are real data — and the row
# would then move whenever the generator changed rather than when the compiler
# did. `zzq` never appears in the alphabet the subject is built from.
pattern = "[a-z]+zzq"

alphabet = "abcdefghijklm"

# Doubling, so building an n-byte subject costs a logarithmic number of
# allocations and about 2n bytes at peak. A per-character loop would hold n
# pieces at once and put an honest O(n) term in the row this benchmark exists
# to keep free of them.
fn doubled s n
  wider s n (length s < n)

fn wider s _ false
  s

fn wider s n true
  doubled (text/join [s s] "") n

pub fn total n
  subject = text/slice (doubled alphabet n) 1 n
  hits = regexp/find_all pattern subject
  length hits
