import "std/json"
import "std/list"
import "std/text"

# A list held in a record and pushed onto from one arm of an `if`, which
# `branched` runs; the record is the list and its count.
type bag
  items
  n

pub play =
  maps = "{counted 1000} {drained 600} {admitted 500}"
  print "interp {rounds 6} {branched 680} {padded 18 0} {maps}"

fn rounds n
  source = document 220
  total source n 0

fn total _ 0 acc
  acc

fn total source n acc
  doc = json/decode source
  summed source n acc (doc .> (d -> length (json/encode d)))

fn summed _ _ _ e@(err _)
  e

fn summed source n acc size
  total source (n - 1) (acc + size)

fn document n
  "[{text/join (list/to_list (list/map (span n) row)) ","}]"

fn row i
  "\{\"key\":\"row-{i}\",\"n\":{i},\"on\":true,\"half\":{i / 2}}"

fn span n
  climbed 1 n []

fn climbed i stop acc
  reached i stop acc (i > stop)

fn reached _ _ acc true
  acc

fn reached i stop acc false
  climbed (i + 1) stop (push acc i)

fn fill b k
  if (k == 0) b (fill (bag (push b.items k) (b.n + 1)) (k - 1))

fn branched k
  length (fill (bag [] 0) k).items

# A column padded to a widening width, as a report lays one out.
fn padded 0 acc
  acc

fn padded n acc
  padded (n - 1) (acc + length (text/pad_start "{n}" (n * 37) "-+"))

# A word count whose words each come round twice, in no order.
fn counted n
  words = list/map (list/take list/naturals n) (i -> "w{i * 7919 % (n / 2)}")
  length (list/tally (list/to_list words))

# A map filled and then drained of half its keys by `delete`, in no order.
fn filled m 0
  m

fn filled m i
  filled (put m i i) (i - 1)

fn emptied m _ 0
  m

fn emptied m n i
  emptied (delete m (i * 7919 % n + 1)) n (i - 1)

fn drained n
  length (emptied (filled {} n) n (n / 2))

# A set kept as a map, admitting a key only when it does not hold it yet.
fn let_in m _ 0
  m

fn let_in m n i
  k = i * 7919 % n
  let_in (if (m[k] == none) (put m k true) m) n (i - 1)

fn admitted n
  length (let_in {} n n)
