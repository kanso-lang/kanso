# The shape of a tree-walking interpreter's loop statement, which is how the
# bc port runs `for`. `loop_for` and `for_next` are one tail cycle. Each lap
# runs the body through `exec`, a plain call, and the `nested` arm of `exec`
# enters the cycle by a tail call, so a loop inside the body is the same
# cycle again. Until kanso#1920 that entry kept the cycle from rewinding,
# because the cycle reaches `exec` under the plain call's frame, and every
# lap's records stayed in the arena: bc's 300,000-lap `for` held 548 MB.
type machine
  n
  total

type ran
  m

type broke
  m

type step
  by

type nested
  limit

fn exec (step by) m
  ran (machine (m.n + by) (m.total + m.n))

fn exec (nested limit) m
  loop_for (step 1) limit m

fn loop_for body limit m
  return ran m if m.n >= limit
  r = exec body m
  for_next r body limit

fn for_next (ran m) body limit
  loop_for body limit m

fn for_next (broke m) _ _
  ran m

pub fn total n
  (exec (nested n) (machine 0 0)).m.n
