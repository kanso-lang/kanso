# A count kept per pair of keys, as a map of maps: the outer key picks an
# inner map and the inner key's count goes up by one. Natively both puts
# copy: the outer one because the inner map's binding feeds another write,
# the inner one because the outer map still holds what it came from. The
# copied inner map sorts itself again on its next read. 20,000 counts over
# 50 inner maps took 2.28 billion instructions natively.
fn or_zero none
  0

fn or_zero c
  c

fn or_map none
  {}

fn or_map m
  m

fn count m _ 0
  m

fn count m n i
  a = i % 50
  b = i * 7919 % n
  inner = or_map m[a]
  count (put m a (put inner b (or_zero inner[b] + 1))) n (i - 1)

pub fn total n
  length (count {} n n)
