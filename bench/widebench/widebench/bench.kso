import "std/io"
import "std/text"

# The bytes are text the printer wrote, so `utf8` never answers none here;
# the arm says what an absent chunk would be.
fn elem_chunk v lead
  written (text/utf8 (pretty_onto (text/append (text/bytes lead) "  ") v 1))

fn written none
  ""

fn written s
  s

fn sep 1
  ""

fn sep _
  ",\n"

fn stream_elems xs i
  return io/write "\n]\n" if i < 1 or length xs < i
  io/write (elem_chunk xs[i] (sep i)) .> (_ -> stream_elems xs (i + 1))

pub fn stream_list xs
  io/write "[\n" .> (_ -> stream_elems xs 1)
