# the enumerable role: a type joins by arming `next` for a state it owns and
# answering `list/yield` of an element and the state after it. std/list arms
# `next` for its own states, and `list/iter` starts a cursor over a list. A
# consumer drives either one until `done`.
import "std/list"

type countdown
  n

fn next (countdown 0)
  done

fn next (countdown n)
  list/yield n (countdown (n - 1))

fn drain done acc
  acc

fn drain (step elem rest) acc
  drain (next rest) (push acc elem)

print "drained: {drain (next (list/iter [10 20 30])) []}"
print "counted: {drain (next (countdown 3)) []}"
