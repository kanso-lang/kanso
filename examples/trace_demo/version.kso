import "std/os"
import "std/text"

fn banner e@(err _)
  e

fn banner line
  "== {line} =="

fn check text
  version = major_of text
  summary = describe version
  print (banner summary)

fn chosen argv
  if (length argv == 0) "examples/trace_demo/VERSION" argv[1]

fn describe e@(err _)
  e

fn describe v
  "major version {v} detected"

fn dot_check "." _ i
  i

fn dot_check none _ _
  err "no dot in version text"

fn dot_check _ cs i
  dot_hunt cs (i + 1)

fn dot_hunt cs i
  dot_check cs[i] cs i

fn major_of text
  cs = text/chars text
  digits = dot_hunt cs 1 .> (dot -> text/join (leading cs (dot - 1)) "")
  text/to_int digits

# The dot was found inside `cs`, so the slice before it is never none; the arm
# is there because the checker cannot see that.
fn leading cs n
  or_empty (text/slice cs 1 n)

fn or_empty none
  []

fn or_empty chars
  chars

pub fn announce argv
  os/read_file! (chosen argv) .> check
