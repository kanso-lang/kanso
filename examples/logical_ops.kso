# and and or are spelling for the deferred if family: `a and b` is
# `if a b false`, `a or b` is `if a true b`. the right side defers
# exactly as an if branch does, so short-circuit is the semantics, not
# a special case — the untaken side never runs.
fn brewable? temp
  60 < temp and temp < 85

pub play =
  print "{brewable? 72} {brewable? 95}"
  >> print "{2 < 1 or 1 < 2}"
  >> print "{2 < 1 and 1 / 0 < 9}"
