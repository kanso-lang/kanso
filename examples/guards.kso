# a return is a value, not a jump: the compiler folds everything below a
# guard into the untaken branch, so a fired guard makes the rest of the
# body unreachable -- flat to read, nested in the tree.
fn describe n
  return "below zero" if (n < 0)
  return "past a thousand" if (1000 < n)
  "ordinary {n}"

main =
  print (describe (0 - 5))
  >> print (describe 4200)
  >> print (describe 7)
