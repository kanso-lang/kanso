import "std/math"
import "std/time"

# in go, doing two things at once and waiting for both is a goroutine, a
# channel or a WaitGroup, and a select to fan the results back. in kanso
# bare lines already run as independent green threads: the scheduler
# overlaps them and `.>` is the only sync you write -- no channels, the
# data flow is the channel. `brew` blocks on a slow steep while `rolls`
# chains the dice beside it, so every roll lands *during* the steep.
brew = print "brew: steeping"
  .> (_ -> time/sleep 60)
  .> (_ -> print "brew: poured")

fn roll i
  math/random 6 .> (n -> print "roll {i}: a {n + 1}")

rolls = roll 1
  .> (_ -> roll 2)
  .> (_ -> roll 3)
  .> (_ -> roll 4)
  .> (_ -> roll 5)

brew
rolls
