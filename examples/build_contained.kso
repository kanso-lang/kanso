type node
  name
  peer

fn tie label
  build
    here = node label _
    there = node "pong" _
    here.peer = there
    there.peer = here
  here

fn round_trip n
  n.peer.peer.name

fn spin 0 acc
  acc

fn spin n acc
  spin (n - 1) (acc + length (round_trip (tie "ping")))

knot = tie "ping"
print "one hop: {knot.peer.name}"
  .> (_ -> print "back home: {round_trip knot}")
  .> (_ -> print "two thousand more, all discarded: {spin 2000 0}")
