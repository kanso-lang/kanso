import "std/io"
import "std/list"
import "std/text"

# One commit's four numbers, for the long view on the compiler page. Measures
# one commit per invocation; the walk across the history lives in the caller.
#
# WHAT IS MEASURED, and why these four:
#
#   compile memory  peak resident bytes while this commit's compiler checks
#                   this commit's json library
#   compile speed   instructions retired for the same
#   run memory      peak footprint running the seven example programs
#   run speed       instructions retired for the same
#
# The examples are the workload because they are the only body of kanso that
# spans the whole history — dispatch, effects, errors, lists, pipes, records
# and hello, present at the first commit and at the last. The oldest compiler
# has only `run` and `check`, so `run` is what run-side means here: compile and
# execute, which is the job a person actually waits for.
#
# Peak resident size and cpu seconds rather than wall time: a competing process
# changes when a run happens, not how much memory it needs nor how many cycles
# it burns.
type cost
  cpu
  peak

rounds = 5

examples = ["dispatch" "effects" "errors" "hello" "lists" "pipes" "records"]

zero = cost 0 0

pub play = io/args . started

fn started argv
  begun argv (length argv < 2)

fn begun _ true
  io/write_err "backfill: <worktree> <sha>\n" >> (_ -> io/exit 1)

fn begun argv false
  measured argv[1]! argv[2]!

fn measured tree sha
  built tree sha . (_ -> checked tree sha)

fn built tree sha
  manifest = "{tree}/Cargo.toml"
  io/run "git" ["-C" tree "checkout" "-q" "--detach" sha]
    >> io/run "cargo" ["build" "--release" "--manifest-path" manifest]

fn checked tree sha
  timed tree "check" "{tree}/lib/json" . (front -> ran tree sha front)

fn ran tree sha front
  timed_examples tree 1 zero . (back -> reported sha front back)

fn reported sha front back
  said = "{sha}\t{front.peak}\t{front.cpu}\t{back.peak}\t{back.cpu}\n"
  io/write said

# Each example is its own process, so the peak is the worst of them and the
# cost is the sum — one big program and seven small ones are not the same
# shape, and the worst is what a machine has to hold.
fn timed_examples tree at acc
  walking tree at acc (at > length examples)

fn walking _ _ acc true
  acc

fn walking tree at acc false
  file = "{tree}/examples/{examples[at]!}.kso"
  timed tree "run" file . (c -> merged tree at acc c)

fn merged tree at acc c
  timed_examples tree (at + 1) (cost (acc.cpu + c.cpu) (bigger acc.peak c.peak))

fn bigger a b
  larger a b (a > b)

fn larger a _ true
  a

fn larger _ b false
  b

# `rounds` runs under one `time`, so the reported cpu covers all of them and
# the clock's coarse resolution is divided down rather than rounding to zero.
fn timed tree verb file
  kanso = "{tree}/target/release/kanso"
  io/run "/usr/bin/time" ["-l" kanso verb file] . (r -> read_cost r.stderr)

# Every figure in the report is one line with the number first, so a term is
# found by the words beside it.
fn read_cost report
  lines = text/split report "\n"
  work = figure lines "instructions retired"
  held = figure lines "peak memory footprint"
  cost work held

fn figure lines words
  found = list/to_list (list/select lines (l -> names? l words))
  first_of found (length found)

fn names? line words
  length (text/split line words) == 2

fn first_of _ 0
  0

fn first_of lines _
  text/to_int (text/split (text/trim lines[1]!) " ")[1]!
