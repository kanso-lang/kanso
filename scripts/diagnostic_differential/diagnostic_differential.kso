import "std/io"
import "std/list"
import "std/text"

# The interpreter is the oracle for values, and it is the oracle for
# diagnostics too — a program that fails has to fail the same way on every
# engine, or the reader's experience depends on which one ran. Nothing was
# checking that: the golden corpus pins the diagnostics it happens to contain,
# and no golden asked a std function for the wrong type until one was written
# by hand and turned up `length` saying half as much on native as on the
# interpreter.
#
# So this asks every exported std function for the wrong thing and requires
# both engines to answer identically. A record is the wrong thing for nearly
# everything and is never a literal, so it slips past the compile-time literal
# check and reaches the runtime path where the messages are written separately
# for each engine.
#
# One probe per function, with the record in every argument position at once.
# That reaches whichever type check the function makes first, which is the one
# whose wording can drift; making each position wrong on its own would need a
# valid filler for the others, and a valid filler differs per function.
#
# Agreement is the requirement. A disagreement is a finding, and so is a crash
# with no message at all.
type report
  finding
  native_ok
  interp_ok

kanso = "target/release/kanso"

probe = "target/diagnostic_probe.kso"

name_chars = "abcdefghijklmnopqrstuvwxyz0123456789_?!+*/%<>=-"

param_chars = "abcdefghijklmnopqrstuvwxyz0123456789_()?"

# What a wrong argument is made of. A record is wrong for every std function
# and cannot be written as a literal, so the literal checker lets it through.
prelude = """
  type wrong
    a
    b

"""

fn in? set c
  length (text/split set c) > 1

fn all_in? set s
  list/all? (text/chars s) (c -> in? set c)

fn signature? l
  text/slice l 1 7 == "pub fn "

fn tokens l
  rest = text/slice l 8 (length l)
  list/to_list (list/reject (text/split rest " ") (t -> t == ""))

# A destructuring parameter means the arm takes a shape rather than a value,
# and the group's other arms cover the same name. A parameter with a character
# outside the set is not a plain name either — `pub fn split _ ""` names a
# literal, and its group answers elsewhere.
fn plain? parts
  well_named = all_in? name_chars parts[1]!
  args = list/to_list (list/drop parts 1)
  plain_args? = list/all? args (p -> all_in? param_chars p)
  well_named and plain_args? and not_shaped? args

fn not_shaped? args
  list/all? args (p -> length (text/split p "(") == 1)

fn entry_for module l
  parts = tokens l
  kept module parts (plain? parts)

fn kept _ _ false
  ""

fn kept module parts true
  "{module} {parts[1]!} {length parts - 1}"

fn entries_in module src
  lines = list/to_list (list/select (text/split src "\n") signature?)
  found = list/to_list (list/map lines (l -> entry_for module l))
  list/to_list (list/reject found (e -> e == ""))

fn source? name
  ext = text/slice name (length name - 3) (length name)
  ext == ".kso" and length (text/split name "_test.kso") == 1

# One entry per name and arity: an overload group answers once.
fn deduped sorted
  list/to_list (list/fold sorted [] once)

fn once acc e
  fresh acc e (length acc == 0 or acc[length acc]! != e)

fn fresh acc e true
  push acc e

fn fresh acc _ false
  acc

fn walked_files module names found
  onward_file module names found (length names == 0)

fn onward_file _ _ found true
  found

fn onward_file module names found false
  rest = list/to_list (list/drop names 1)
  name = names[1]!
  io/read_file "lib/{module}/{name}" . (src -> gathered module rest found src)

fn gathered module rest found src
  walked_files module rest (text/concat found (entries_in module src))

fn in_module module found
  io/list_dir "lib/{module}" . (names -> only_sources module names found)

fn only_sources module names found
  walked_files module (list/to_list (list/select names source?)) found

fn walked_modules mods found
  onward_module mods found (length mods == 0)

fn onward_module _ found true
  found

fn onward_module mods found false
  rest = list/to_list (list/drop mods 1)
  in_module mods[1]! found . (grown -> walked_modules rest grown)

surface = io/list_dir "lib" . (mods -> walked_modules (list/to_list mods) [])

fn args_for 0
  ""

fn args_for n
  "{args_for (n - 1)} bad"

fn program_for line
  parts = text/split line " "
  module = parts[1]!
  name = parts[2]!
  arity = text/to_int parts[3]!
  call = "{module}/{name}{args_for arity}"
  """
    import "std/{module}"

    {prelude}bad = wrong 1 2
    print "\{{call}}"
  """

# What the LANGUAGE says: arity, indexing, dispatch, arithmetic,
# construction. Each engine writes these separately too.
langa_says = "too many arguments"

langa_src = """
  fn one a
    a

  print "\{one 1 2}"
"""

langa = [langa_says langa_src]

langb_says = "too few arguments"

langb_src = """
  fn two a b
    a

  print "\{two 1}"
"""

langb = [langb_says langb_src]

langc_says = "a field the record lacks"

langc_src = """
  type point
    x

  p = point 1
  print "\{p.y}"
"""

langc = [langc_says langc_src]

langd_says = "a field of a non-record"

langd_src = """
  n = 5
  print "\{n.x}"
"""

langd = [langd_says langd_src]

lange_says = "a strict index past the end"

lange_src = """
  xs = [1 2]
  print "\{xs[9]!}"
"""

lange = [lange_says lange_src]

langf_says = "a strict index at zero"

langf_src = """
  xs = [1 2]
  print "\{xs[0]!}"
"""

langf = [langf_says langf_src]

langg_says = "division by zero"

langg_src = """
  n = 0
  print "\{1 / n}"
"""

langg = [langg_says langg_src]

langh_says = "remainder by zero"

langh_src = """
  n = 0
  print "\{1 % n}"
"""

langh = [langh_says langh_src]

langi_says = "adding a string to a number"

langi_src = """
  s = "a"
  print "\{1 + s}"
"""

langi = [langi_says langi_src]

langj_says = "comparing a record to a number"

langj_src = """
  type point
    x

  p = point 1
  print "\{p < 2}"
"""

langj = [langj_says langj_src]

langk_says = "an if condition that is not a bool"

langk_src = """
  n = 5
  print "\{if n 1 2}"
"""

langk = [langk_says langk_src]

langl_says = "constructing with the wrong count"

langl_src = """
  type point
    x
    y

  print "\{point 1}"
"""

langl = [langl_says langl_src]

langm_says = "no arm matches"

langm_src = """
  fn only 0
    "zero"

  n = 7
  print "\{only n}"
"""

langm = [langm_says langm_src]

# A float where a map wants a key. The record probe cannot reach this: it
# puts a wrong value in EVERY position, so `put` answers about its first
# argument and never looks at the key. Native accepted one and built a map
# holding 1 and 1.0 as separate keys, which the oracle had always refused.
lango_says = "a float as a map key"

lango_src = """
  m = put \{ 1:"a" } 2.5 "b"
  print "\{m}"
"""

lango = [lango_says lango_src]

langn_says = "indexing something that is not a collection"

langn_src = """
  n = 5
  print "\{n[1]!}"
"""

langn = [langn_says langn_src]

lang_all0 = text/concat [langa] [langb]

lang_all1 = text/concat lang_all0 [langc]

lang_all2 = text/concat lang_all1 [langd]

lang_all3 = text/concat lang_all2 [lange]

lang_all4 = text/concat lang_all3 [langf]

lang_all5 = text/concat lang_all4 [langg]

lang_all6 = text/concat lang_all5 [langh]

lang_all7 = text/concat lang_all6 [langi]

lang_all8 = text/concat lang_all7 [langj]

lang_all9 = text/concat lang_all8 [langk]

lang_all10 = text/concat lang_all9 [langl]

lang_all11 = text/concat lang_all10 [langm]

lang_all12 = text/concat lang_all11 [langn]

language = text/concat lang_all12 [lango]

# Every probe here is meant to fail, so two engines failing identically is the
# expected reading and an engine that cannot run at all is indistinguishable
# from one that agrees. The python this replaced reported "0 disagree" for a
# week after `play` stopped being a verb, having compared nothing. So a program
# that works has to work first.
sound_src = "print \"ok\"\n"

fn sound? r
  r.status == 0 and r.stdout == "ok\n"

fn asked argv
  io/run kanso argv

fn ran source
  io/write_file probe source . (_ -> both)

both = asked ["play" probe] . against

fn against native
  asked ["play" probe "--interp"] . (i -> verdict native i)

fn verdict n i
  same = n.status == i.status and n.stdout == i.stdout
  report (agreed n i (same and n.stderr == i.stderr)) (sound? n) (sound? i)

fn agreed _ _ true
  ""

fn agreed n i false
  mine = "    native: code={n.status} err={clipped n.stderr}\n"
  "{mine}    interp: code={i.status} err={clipped i.stderr}\n"

# A diagnostic can run long, and twenty of them at full length buries the
# count they were printed to explain.
fn clipped s
  one_line = trimmed s
  shortened one_line (length one_line > 150)

# std/text has no trim, and a diagnostic arrives with its newline attached.
fn trimmed ""
  ""

fn trimmed s
  dropped s (text/slice s (length s) (length s))

fn dropped s "\n"
  trimmed (text/slice s 1 (length s - 1))

fn dropped s " "
  trimmed (text/slice s 1 (length s - 1))

fn dropped s _
  s

fn shortened s false
  s

fn shortened s true
  "{text/slice s 1 150}..."

fn swept sources found
  onward sources found (length sources == 0)

fn onward _ found true
  found

fn onward sources found false
  rest = list/to_list (list/drop sources 1)
  s = sources[1]!
  ran s[2]! . (v -> reported rest found s[1]! v.finding)

fn reported rest found label v
  swept rest (kept found (named label v))

fn kept found ""
  found

fn kept found line
  push found line

fn named _ ""
  ""

fn named label line
  "  {label}\n{line}"

fn labelled line
  parts = text/split line " "
  name = "{parts[1]!}/{parts[2]!}"
  [name (program_for line)]

fn std_probes found
  ordered = deduped (list/to_list (list/sort found))
  list/to_list (list/map ordered labelled)

fn worth? p
  length (text/split p[2]! " bad") > 1

fn sound_enough v
  ok = v.native_ok and v.interp_ok
  proceed ok

fn proceed true
  surface . (found -> started found)

fn proceed false
  io/write "the harness cannot run a working program; nothing compared\n"
    . (_ -> io/exit 1)

fn started found
  probes = std_probes found
  useful = list/to_list (list/select probes worth?)
  all_probes = text/concat useful language
  counts = "{length all_probes} probes ({length probes} std functions"
  head = "{counts} and {length language} language paths)"
  swept all_probes [] . (found -> finished head found)

fn finished head found
  io/write "{head}, {length found} disagree\n"
    . (_ -> listed found (length found))

fn listed _ 0
  io/write ""

fn listed found _
  oracle = "\nthe interpreter is the oracle: these are native's to match.\n"
  io/write "{text/join found ""}{oracle}" . (_ -> io/exit 1)

pub play = ran sound_src . (v -> sound_enough v)
