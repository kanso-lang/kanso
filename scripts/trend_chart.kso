import "std/io"
import "std/json"
import "std/list"
import "std/text"

# The long view. Every merge to main appends a row of counters to the
# perf-history branch, and four hundred of them had accumulated with nothing
# drawing them. This reads that file and writes one svg into the compiler
# page, between two markers, so the chart is regenerated rather than edited.
#
# Each series is scaled against its own range, because the units have nothing
# to do with each other — eight million allocations and fifteen hundred
# emitted lines cannot share an axis and stay readable. What the chart shows
# is shape: which way a number went and when it stepped.
type series
  key
  label
  colour

width = 1200

height = 520

pad = 56

pub play = io/read_file "target/history.jsonl" . drawn

fn drawn text
  rows = list/to_list (list/select (text/split text "\n") full?)
  charted rows (length rows)

fn full? l
  length l > 2

fn charted _ 0
  io/write_err "no history rows — fetch the perf-history branch first\n"
    . (_ -> io/exit 1)

fn charted rows n
  points = list/to_list (list/map rows json/decode)
  io/read_file "docs/compiler.html" . (page -> spliced page points n)

# Only a key every row carries can be drawn: a counter added part way
# through would otherwise plot as a cliff from zero on the day it appeared.
fn tracked points
  all = [(plotted "allocs" "decode allocations" "#4fd1ff")]
  more = [(plotted "emitted_lines" "emitted lines" "#ffd166")]
  third = [(plotted "arena_blocks" "arena blocks" "#a78bfa")]
  fourth = [(plotted "encode_allocs" "encode allocations" "#f472b6")]
  wanted = text/concat (text/concat all more) (text/concat third fourth)
  list/to_list (list/select wanted (s -> everywhere? points s.key))

fn plotted key label colour
  series key label colour

fn everywhere? points key
  length (list/to_list (list/select points (p -> has? p key))) == length points

fn has? p key
  p[key] != none

fn spliced page points n
  drawn_series = tracked points
  body = svg drawn_series points n
  before = (text/split page "<!--trend-chart-->")[1]!
  rest = (text/split page "<!--/trend-chart-->")[2]!
  io/write_file "docs/compiler.html"
    "{before}<!--trend-chart-->\n{body}\n<!--/trend-chart-->{rest}"
  >> io/write "trend chart: {length drawn_series} series over {n} commits\n"

fn svg all points n
  lines = text/join (list/to_list (list/map all (s -> path s points n))) "\n"
  keys = text/join (list/to_list (list/map all legend)) "\n"
  frame lines keys n

fn frame lines keys n
  open = "<svg class=\"trend\" viewBox=\"0 0 {width} {height}\" role=\"img\""
  titled = "{open} aria-label=\"counter trend over {n} commits\">"
  "{titled}\n{grid}\n{lines}\n{keys}\n</svg>"

grid = "<rect x=\"0\" y=\"0\" width=\"1200\" height=\"520\" fill=\"none\"/>"

fn legend s
  at = 1 + index_of s
  x = pad + (at - 1) * 260
  y = height - 14
  swatch = "<rect x=\"{x}\" y=\"{y - 9}\" width=\"22\" height=\"3\""
  dot = "{swatch} fill=\"{s.colour}\"/>"
  text = "<text x=\"{x + 30}\" y=\"{y}\" class=\"trend-key\">{s.label}</text>"
  "{dot}{text}"

# The legend needs each series' position and a series does not carry one, so
# the order is fixed here rather than threaded through every call.
fn index_of s
  order = ["allocs" "emitted_lines" "arena_blocks" "encode_allocs"]
  found order s.key 1

fn found _ _ 5
  4

fn found order key at
  matching order key at (order[at]! == key)

fn matching _ _ at true
  at

fn matching order key at false
  found order key (at + 1)

fn path s points n
  values = list/to_list (list/map points (p -> p[s.key]!))
  low = list/min values
  high = list/max values
  coords = drawn_points values low high n 1 ""
  open = "<polyline fill=\"none\" stroke=\"{s.colour}\""
  "{open} stroke-width=\"2\" points=\"{coords}\"/>"

fn drawn_points values low high n at acc
  stepping values low high n at acc (at > length values)

fn stepping _ _ _ _ _ acc true
  acc

fn stepping values low high n at acc false
  x = pad + (at - 1) * (width - 2 * pad) / (n - 1)
  y = scaled values[at]! low high
  drawn_points values low high n (at + 1) "{acc} {x},{y}"

# A flat series would divide by zero, so it draws along the middle.
fn scaled v low high
  placed v low (high - low)

fn placed _ _ 0
  height / 2

fn placed v low span
  top = pad / 2
  usable = height - pad - top
  top + usable - (v - low) * usable / span
