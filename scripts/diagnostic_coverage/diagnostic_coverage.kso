import "std/io"
import "std/list"
import "std/text"

# Every diagnostic the compiler can raise, against the ones a golden pins.
#
# A message with no golden is a message that can be reworded, weakened or lost
# without anything going red. The error corpus is the only place a diagnostic's
# exact text is checked, and it grew by whoever remembered — which is how
# forty-one of them ended up unpinned at once.
#
# So this is a ratchet rather than a report. The messages already unpinned are
# listed in tests/golden/unpinned_diagnostics.txt and excused; a message that
# is not on that list and has no golden fails. Adding a diagnostic means adding
# a golden, and the list only shrinks.
#
# Only literal text is checked. A message assembled entirely from runtime
# values has nothing stable to match, and pretending otherwise would pin a
# format string rather than a sentence.
# Where a split-on-quote has got to, and the runs it has kept.
type scan
  at
  runs

opener = "Diagnostic::new("

listed_path = "tests/golden/unpinned_diagnostics.txt"

lower = "abcdefghijklmnopqrstuvwxyz"

blank = " \t\n\r"

fn in? set c
  length (text/split set c) > 1

fn all_in? set s
  list/all? (text/chars s) (c -> in? set c)

fn first_char s
  text/slice s 1 1

fn without_leading ""
  ""

fn without_leading s
  shed s (in? blank (first_char s))

fn shed s false
  s

fn shed s true
  without_leading (text/slice s 2 (length s))

fn without_trailing ""
  ""

fn without_trailing s
  shed_end s (in? blank (text/slice s (length s) (length s)))

fn shed_end s false
  s

fn shed_end s true
  without_trailing (text/slice s 1 (length s - 1))

fn squeezed s
  without_trailing (without_leading s)

fn after_first parts sep
  text/join (list/to_list (list/drop parts 1)) sep

fn upto parts n sep
  text/join (list/to_list (list/take parts n)) sep

# A parameter name follows the message, so the message ends at the first comma
# that a lowercase word comes after. A comma inside the message ends it too,
# and then the quote never closes and the site is passed over — which is what
# the pattern this replaces did, and what keeps a format string from being
# mistaken for a sentence.
# A segment here is the whole rest of the file, so this walks to the first
# non-blank character rather than shedding one at a time: shedding copies what
# is left on every step, which on a hundred kilobytes is the difference
# between a second and never.
fn starts_word? seg
  c = leading_char seg 1 (length seg)
  in? lower c or c == "_"

fn leading_char s i n
  looked s i n (i > n)

fn looked _ _ _ true
  ""

fn looked s i n false
  c = text/slice s i i
  stepped s i n c (in? blank c)

fn stepped s i n _ true
  leading_char s (i + 1) n

fn stepped _ _ _ c false
  c

fn cut segs i
  stop segs i (i > length segs or starts_word? segs[i]!)

fn stop segs i true
  upto segs (i - 1) ","

fn stop segs i false
  cut segs (i + 1)

# The leading literal run of a diagnostic's message: everything before the
# first interpolation or escape, which is the part a golden can match on.
fn units s
  length s - length (list/to_list (list/select (text/chars s) (c -> c == "\\")))

fn long_enough? s
  units s >= 8

# Quoted runs sit at the even positions of a split on the quote, and a run is
# only a literal if its quote closed: an even number of pieces means the last
# one runs to the end of what was handed over, which happens whenever the
# message itself holds a comma that a lowercase word follows.
fn quoted_runs pieces
  usable = list/to_list (list/take pieces (closed pieces))
  walked = list/fold usable (scan 1 []) inside_quote
  walked.runs

fn closed pieces
  n = length pieces
  whole n (n % 2 == 0)

fn whole n true
  n - 1

fn whole n false
  n

fn inside_quote s piece
  keeping s piece (s.at % 2 == 0)

fn keeping s _ false
  scan (s.at + 1) s.runs

fn keeping s piece true
  scan (s.at + 1) (push s.runs piece)

fn head_of lit
  before_brace = (text/split lit "\{")[1]!
  squeezed (text/split before_brace "\\")[1]!

fn message_in group
  pieces = text/split group "\""
  wanted = list/to_list (list/select (quoted_runs pieces) long_enough?)
  chosen wanted (length wanted == 0)

fn chosen _ true
  ""

fn chosen wanted false
  head_of wanted[1]!

# A site the pattern reaches: an open paren, whitespace, then a bare kind.
fn site_of chunk
  q = text/split chunk "\""
  shaped chunk q (length q < 3)

fn shaped _ _ true
  ""

fn shaped chunk q false
  kinded chunk q[2]! (length (squeezed q[1]!) == 0 and all_in? lower q[2]!)

fn kinded _ _ false
  ""

fn kinded chunk kind true
  rest = after_first (text/split chunk "\"") "\""
  rest_after_kind = after_first (text/split rest "\"") "\""
  bodied kind rest_after_kind

fn bodied kind rest
  segs = text/split rest ","
  headed kind (cut segs 3) (length (squeezed segs[1]!) == 0)

fn headed _ _ _ false
  ""

fn headed kind group true
  told kind (message_in group)

fn told _ ""
  ""

fn told kind msg
  worth kind msg (length msg >= 12)

fn worth _ _ false
  ""

fn worth kind msg true
  "{kind}\n{msg}"

fn raised_in src
  chunks = list/to_list (list/drop (text/split src opener) 1)
  found = list/to_list (list/map chunks site_of)
  list/to_list (list/reject found (s -> s == ""))

fn deduped sorted
  list/to_list (list/fold sorted [] once)

fn once acc e
  fresh acc e (length acc == 0 or acc[length acc]! != e)

fn fresh acc e true
  push acc e

fn fresh acc _ false
  acc

fn source? name
  text/slice name (length name - 2) (length name) == ".rs"

fn pinned_file? name
  text/slice name (length name - 6) (length name) == ".stderr"

fn kind_of pair
  (text/split pair "\n")[1]!

fn message_of pair
  (text/split pair "\n")[2]!

fn clipped s n
  shorter s n (length s > n)

fn shorter s _ false
  s

fn shorter s n true
  text/slice s 1 n

fn over_sources names found
  onward_src names found (length names == 0)

fn onward_src _ found true
  gathered found

fn onward_src names found false
  rest = list/to_list (list/drop names 1)
  name = names[1]!
  read_src name (source? name) rest found

fn read_src _ false rest found
  over_sources rest found

fn read_src name true rest found
  io/read_file "src/{name}" . (src -> more_sources rest found src)

fn more_sources rest found src
  over_sources rest (text/concat found (raised_in src))

fn gathered found
  every = deduped (list/to_list (list/sort found))
  corpus_of "tests/golden" [] . (parts -> with_tests every parts)

fn with_tests every parts
  io/list_dir "tests" . (names -> test_sources (list/to_list names) parts)
    . (all -> with_corpus every (text/join all ""))

fn test_sources names parts
  onward_test names parts (length names == 0)

fn onward_test _ parts true
  parts

fn onward_test names parts false
  rest = list/to_list (list/drop names 1)
  name = names[1]!
  read_test name (source? name) rest parts

fn read_test _ false rest parts
  test_sources rest parts

fn read_test name true rest parts
  io/read_file "tests/{name}" . (t -> test_sources rest (push parts t))

fn corpus_of dir parts
  io/list_dir dir . (names -> in_dir dir (list/to_list names) parts)

fn in_dir dir names parts
  onward_corpus dir names parts (length names == 0)

fn onward_corpus _ _ parts true
  parts

fn onward_corpus dir names parts false
  rest = list/to_list (list/drop names 1)
  here = "{dir}/{names[1]!}"
  io/is_dir here . (d -> descend here d dir rest parts)

fn descend here true dir rest parts
  corpus_of here parts . (grown -> in_dir dir rest grown)

fn descend here false dir rest parts
  take_stderr here (pinned_file? here) dir rest parts

fn take_stderr _ false dir rest parts
  in_dir dir rest parts

fn take_stderr here true dir rest parts
  io/read_file here . (t -> in_dir dir rest (push parts t))

fn with_corpus every corpus
  io/read_file listed_path . (t -> judged every corpus (allowances t))

fn allowances t
  lines = list/to_list (list/map (text/split t "\n") squeezed)
  kept = list/to_list (list/reject lines (l -> l == "" or first_char l == "#"))
  list/to_list kept

fn in_corpus? corpus msg
  length (text/split corpus msg) > 1

fn judged every corpus excused
  pinned = list/to_list (list/select every (e -> known? corpus e))
  loose = list/to_list (list/reject every (e -> known? corpus e))
  healed = list/to_list (list/select pinned (e -> listed? excused e))
  missing = list/to_list (list/reject loose (e -> listed? excused e))
  reported every excused missing healed

fn known? corpus e
  in_corpus? corpus (message_of e)

fn listed? excused e
  list/any? excused (l -> l == message_of e)

fn reported every excused missing healed
  counts = "{length every} literal diagnostics, {length excused} listed"
  gap = "{length missing} newly unpinned"
  tail = "as unpinned, {gap}, {length healed} now pinned"
  io/write "{counts} {tail}\n" . (_ -> io/write (lines_for missing healed))
    . (_ -> advice missing healed)

fn lines_for missing healed
  no_golden = list/to_list (list/map missing (e -> gap_line e))
  now_pinned = list/to_list (list/map healed (e -> healed_line e))
  text/join (text/concat no_golden now_pinned) ""

fn gap_line e
  "  no golden: [{kind_of e}] {clipped (message_of e) 88}\n"

fn healed_line e
  said = "  now pinned, delete its line:"
  "{said} [{kind_of e}] {clipped (message_of e) 70}\n"

fn advice missing healed
  io/write (missing_note (length missing == 0))
    . (_ -> io/write (healed_note (length healed == 0)))
    . (_ -> settled (length missing + length healed))

fn missing_note true
  ""

fn missing_note false
  head = "\na diagnostic ships with a golden. add one to tests/golden/errors,\n"
  "{head}or say why it cannot be reached and list it.\n"

fn healed_note true
  ""

fn healed_note false
  "\nthe list only shrinks: remove what a golden now covers.\n"

fn settled 0
  io/write ""

fn settled _
  io/exit 1

pub play = io/list_dir "src" . (names -> over_sources (list/to_list names) [])
