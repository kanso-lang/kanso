import "std/io"
import "std/list"
import "std/text"

# One number, claimed twice, must be claimed the same.
#
# A sitting's figures land on several pages: the decode board on the compiler
# page, the same four rows as a code panel on the landing page, the same
# kanso-versus-serde pair again in the landing prose. Each is edited by hand,
# and the log records what happens when the sweep runs on memory — figure sets
# that disagree across pages for a day at a time.
#
# This does not know what the numbers should be. It knows which claims are the
# same claim, and refuses to let two of them differ.
#
# One decoder's row, as the compiler page states it.
type row
  mb
  ms
  name

digit = "0123456789."

fn in? set c
  length (text/split set c) > 1

# The number that follows a marker, read to the first character that is not
# part of one. A marker that has moved answers "", which every caller treats
# as a claim this can no longer see rather than as agreement.
fn number_after page marker
  parts = text/split page marker
  taken parts (length parts < 2)

fn taken _ true
  ""

fn taken parts false
  leading parts[2]! 1 ""

fn leading src at acc
  reading src at acc (at > length src)

fn reading _ _ acc true
  acc

fn reading src at acc false
  c = text/slice src at at
  kept src at acc c (in? digit c)

fn kept src at acc c true
  leading src (at + 1) "{acc}{c}"

fn kept _ _ acc _ false
  acc

# Tags carry no claim, and the decoder's name is what is left when they go.
fn without_tags s
  pieces = text/split s "<"
  text/join (list/to_list (list/map pieces after_tag)) ""

fn after_tag piece
  parts = text/split piece ">"
  rest parts (length parts < 2)

fn rest parts true
  parts[1]!

fn rest parts false
  text/join (list/to_list (list/drop parts 1)) ">"

fn squeezed s
  without_trailing (without_leading s)

fn without_leading s
  shedding s (length s == 0)

fn shedding s true
  s

fn shedding s false
  shed s (text/slice s 1 1 == " ")

fn shed s false
  s

fn shed s true
  without_leading (text/slice s 2 (length s))

fn without_trailing s
  ending s (length s == 0)

fn ending s true
  s

fn ending s false
  shed_end s (text/slice s (length s) (length s) == " ")

fn shed_end s false
  s

fn shed_end s true
  without_trailing (text/slice s 1 (length s - 1))

fn first_word s
  (text/split (squeezed s) " ")[1]!

# The table's rows, each `<td>name</td> … <td class="num">ms</td><td
# class="num">mb mb</td>`.
fn board_of page
  after = (text/split page "<table class=\"bench-table\">")[2]!
  table = (text/split after "</table>")[1]!
  cells = list/to_list (list/drop (text/split table "<tr") 1)
  found = list/to_list (list/map cells row_of)
  list/to_list (list/reject found (r -> r.name == ""))

fn row_of chunk
  parts = text/split chunk "<td>"
  named chunk parts (length parts < 2)

fn named _ _ true
  row "" "" ""

fn named chunk parts false
  label = (text/split parts[2]! "</td>")[1]!
  nums = list/to_list (list/drop (text/split chunk "<td class=\"num\">") 1)
  measured chunk (first_word (without_tags label)) nums (length nums < 2)

fn measured _ _ _ true
  row "" "" ""

fn measured _ name nums false
  ms = (text/split nums[1]! "</td>")[1]!
  mb = (text/split (squeezed nums[2]!) " ")[1]!
  row mb ms name

fn row_named board name
  hit = list/to_list (list/select board (r -> r.name == name))
  sole hit (length hit == 0)

fn sole _ true
  row "" "" ""

fn sole hit false
  hit[1]!

# The landing panel's four hand-typed lines, `# kanso   0.78`.
fn panel_ms page name
  number_after page "# {name}"

fn disagreement key here there what
  said = "disagree: {key}: compiler board says {here} {what}"
  "{said}, {there} {what}\n"

fn checked board page about
  panel = panel_lines board page
  prose = prose_lines board page
  written = about_lines board about
  "{panel}{prose}{written}"

fn against board name shown where what
  claimed (row_named board name) shown where what

fn claimed _ "" _ _
  ""

fn claimed r shown where what
  agreed r shown where what (mine r what == shown || mine r what == "")

fn mine r "ms"
  r.ms

fn mine r _
  r.mb

fn agreed _ _ _ _ true
  ""

fn agreed r shown where what false
  disagreement r.name (mine r what) "{where} says {shown}" what

fn panel_lines board page
  k = against board "kanso" (panel_ms page "kanso") "landing panel" "ms"
  shown = panel_ms page "serde_json"
  s = against board "serde_json" shown "landing panel" "ms"
  g = against board "go" (panel_ms page "go") "landing panel" "ms"
  "{k}{s}{g}"

fn prose_lines board page
  k = against board "kanso" (number_after page "<strong>~") "landing prose" "ms"
  serde = number_after page "serde_json</code> at ~"
  s = against board "serde_json" serde "landing prose" "ms"
  m = against board "kanso" (number_after page "flat ~") "landing prose" "mb"
  "{k}{s}{m}"

fn about_lines board page
  ours = number_after page "decodes in about "
  k = against board "kanso" ours "about page" "ms"
  serde = number_after page "takes about "
  s = against board "serde_json" serde "about page" "ms"
  "{k}{s}"

pub play = io/read_file "docs/compiler.html" . (c -> with_landing (board_of c))

fn with_landing board
  io/read_file "docs/index.html" . (i -> with_about board i)

fn with_about board landing
  io/read_file "docs/about.html" . (a -> settled board landing a)

fn settled board landing about
  found = checked board landing about
  reported board found (length board == 0)

fn reported _ _ true
  io/write "no board found — the pattern this reads has moved\n"
    . (_ -> io/exit 1)

fn reported board found false
  io/write found . (_ -> closed board found (length found == 0))

fn closed board _ true
  io/write "{length board} board rows agree with the landing panel and prose\n"

fn closed _ _ false
  head = "\nthe same sitting is published in more than one place; move them\n"
  io/write "{head}together or the pages contradict each other.\n"
    . (_ -> io/exit 1)
