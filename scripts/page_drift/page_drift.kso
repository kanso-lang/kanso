import "std/io"
import "std/list"
import "std/os"
import "std/text"

# design/compiler-log.md is append-only chronology and docs/compiler.html is
# the settled design presented to a reader. The rule has always been that the
# second follows the first, and the rule was kept by memory — which failed the
# way memory fails: ten shipped optimisations landed in the log across one day,
# each with its numbers, and the page went the whole day without an edit.
#
# So this is a budget rather than a mandate. An entry recording a diagnosis, a
# revert or a handoff has no business on the page, and demanding one per commit
# would teach people to write the sentence and mean nothing by it. Several
# entries with no page edit at all is a different thing.
budget = 3

fn asked argv
  os/run "git" argv

fn heading? l
  text/slice l 1 4 == "+## "

fn title l
  text/slice l 5 (length l)

# A ruling is not a change, and the page presents changes. Clay, 2026-09-08:
# "there is no specific correlation between a number of log entries and
# specific changes to the HTML." The whole-float gavel is the worked example
# of why. It was ruled on 2026-09-06 and filed as one entry; the behaviour it
# decided shipped in kanso#1285 as a second; the page sentence it falsified
# was corrected in kanso#1315 as a third. One page edit was owed across the
# three, and the ruling was not the entry that owed it — a decision documents
# a page only once something implements it. So the rulings come out of the
# count, and the entries recording what shipped stay in, which is where the
# debt this gate was built to catch actually comes from.
#
# The marker is the heading's own convention rather than a new one: a ruling
# reads `## <date> — gavel: ...` or `## <date> — directive: ...`. An entry
# that merely mentions a gavel keeps its place in the count, because the
# colon and the dash are what the convention writes and a sentence about a
# gavel is not a ruling.
fn ruling? t
  has? t "— gavel:" or has? t "— directive:"

fn has? t marker
  length (text/split t marker) > 1

fn indented e
  "  {e}\n"

fn headings diff
  lines = text/split diff "\n"
  kept = list/select lines heading?
  list/to_list (list/map kept title)

# A truncated history answers every question with a lie this gate cannot
# see through: the boundary commit looks like the one that created every
# file, so the page always appears to have moved with the tip and the count
# is always zero. That is not a green, and it is how this check spent days
# reporting `0/3` while the page fell twenty-two entries behind — the
# workflow ran `git fetch origin main --depth 1` in the step above and
# collapsed the clone to one commit.
fn depth r
  full (text/trim r.stdout == "false")

fn full true
  asked ["log" "-1" "--format=%H" "--" "docs/compiler.html"] . measured

fn full false
  io/write_err "page drift: this clone is shallow, so the page's last\n"
  >> io/write_err "commit cannot be found and the count would read zero\n"
  >> io/write_err "whatever the log did. Fetch the history before asking.\n"
  >> os/exit 1

fn measured r
  parts = text/split r.stdout "\n"
  against (list/first parts)

fn against ""
  io/write "no commit has touched docs/compiler.html — nothing to compare\n"

fn against sha
  asked ["diff" "{sha}..HEAD" "--" "design/compiler-log.md"] . counted

# Both numbers are printed, always. A gate that silently drops entries is one
# nobody can check, and the skipped count is how a reader sees that the
# exemption did what it claims rather than swallowing the diff.
fn counted d
  all = headings d.stdout
  owed = list/to_list (list/reject all ruling?)
  count = length owed
  skipped = length all - count
  verdict owed count skipped (count <= budget)

fn verdict _ count skipped true
  io/write "page drift {count}/{budget} log entries since the page moved"
  >> io/write "{aside skipped}\n"

fn verdict owed count skipped false
  told owed count skipped . (_ -> os/exit 1)

fn aside 0
  ""

fn aside 1
  " (one ruling not counted)"

fn aside n
  " ({n} rulings not counted)"

fn told owed count skipped
  io/write "the log is {count} entries ahead, and the budget is {budget}"
  >> io/write "{aside skipped}:\n"
  >> named owed
  >> owes 0

fn named owed
  io/write (text/join (list/to_list (list/map owed indented)) "")

# What the reader is told when the budget is spent: which file is the
# chronology, which one they are shown, and that one entry per campaign is
# enough — the failure being caught is a page nobody edited all day.
fn owes _
  io/write "\ndesign/compiler-log.md is the chronology and\n"
  >> io/write "docs/compiler.html is what a reader is shown. Several\n"
  >> io/write "entries with no page edit means the presented design has\n"
  >> io/write "fallen behind what the compiler does. Write the entry the\n"
  >> io/write "page owes — one for a campaign is fine, not one per commit.\n"

pub play = asked ["rev-parse" "--is-shallow-repository"] . depth
