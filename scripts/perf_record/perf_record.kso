import "std/io"
import "std/json"
import "std/list"
import "std/os"
import "std/text"

# One line of the performance history the compiler page charts.
#
# Only machine-invariant numbers go in. The counters are algorithm-level events
# and the compile golden counts fixpoint rounds and expression visits, so a
# noisy runner cannot move them — a change here is somebody's deliberate edit,
# which is exactly the trend worth publishing. Wall-clock belongs on the board
# Clay measures by hand, not here.
#
# Three veins feed it: what decoding costs, what encoding costs, and what
# deciding and emitting cost the compiler.
#
# Decode: the flat-memory guarantee, the rewind count, and each kernel's
# presence. A kernel silently dropped in a merge turns one of these to zero.
decode_a = ["allocs" "alloc_bytes" "arena_blocks" "perm_allocs" "beat_iters"]

decode_b = ["el_parses" "utf8_bytes" "find2_calls" "held_peak_bytes"]

decode_watched = text/concat decode_a decode_b

# Encode: the write path, where the builder and the float renderer live.
encode_a = ["allocs" "arena_blocks" "ryu_renders" "append_fast"]

encode_b = ["append_grow" "utf8_zerocopy" "held_peak_bytes"]

encode_watched = text/concat encode_a encode_b

# One shot: decode, hold, print — the peak the rewinds cannot hide.
oneshot_watched = ["allocs" "arena_blocks" "arena_peak_bytes" "held_peak_bytes"]

# The basket: the wide workload welfare's run terms read. Recorded so the
# history row carries every counter the objective consults — its absence is
# why no chart line could ever include the basket without a step.
basket_watched = ["allocs" "arena_blocks" "arena_peak_bytes" "held_peak_bytes"]

basket_more = ["beat_iters" "utf8_bytes"]

basket_all = text/concat basket_watched basket_more

unwatched = """
  perf_record watches a counter the compiler no longer emits, so the row it
  writes would quietly lose a dimension and the chart would plot a shorter
  line without anything going red. Either restore the counter, or rename it
  here in the same change that renamed it there.
"""

# What deciding cost, and what got written.
work_keys = ["rounds" "visits" "lines" "calls" "branches" "defines"]

work_names = ["compile_rounds" "compile_visits" "emitted_lines"]

work_more = ["emitted_calls" "emitted_branches" "emitted_defines"]

work_out = text/concat work_names work_more

compiler_a = ["compile_alloc_bytes" "compile_allocs" "compile_peak_bytes"]

compiler_b = ["compile_passes"]

compiler_watched = text/concat compiler_a compiler_b

fn watched? group name
  list/any? group (g -> g == name)

fn pair? l
  length (text/split l "=") == 2

fn kept prefix l
  parts = text/split l "="
  tally = text/to_int parts[2]!
  ["{prefix}{parts[1]!}" tally]

fn named l
  (text/split l "=")[1]!

# The cost goldens are one `name=value` to a line, so a line is a pair.
# A watched name with no line used to drop out of the row in silence, so a
# counter that was renamed simply stopped being plotted and the chart lost a
# dimension without anything going red. Renaming `bytes_peak` did exactly that.
fn counters text group prefix
  lines = list/select (text/split text "\n") pair?
  mine = list/to_list (list/select lines (l -> watched? group (named l)))
  list/to_list (list/map mine (l -> kept prefix l))

fn missing? found g
  seen = list/any? found (f -> f == g)
  not seen

# The completeness check is separate from the extraction because extraction is
# pure and this one refuses. A name here that the compiler stopped emitting
# would otherwise drop out of the row in silence.
fn absent_in text group
  lines = list/select (text/split text "\n") pair?
  found = list/to_list (list/map (list/to_list lines) named)
  list/to_list (list/select group (g -> missing? found g))

fn every_watched d e o bk
  a = absent_in d decode_watched
  b = absent_in e encode_watched
  c = absent_in o oneshot_watched
  d2 = absent_in bk basket_all
  gone = text/concat (text/concat a d2) (text/concat b c)
  all_there gone (length gone == 0)

fn all_there _ true
  io/write ""

fn all_there gone false
  listed = text/join gone " "
  io/write_err "{unwatched}  not emitted: {listed}\n" . (_ -> os/exit 2)

fn body? l
  text/slice l 1 1 != "#" and length l > 0

fn fields_of l
  list/to_list (list/select (text/split l " ") pair?)

fn value_in fields key
  found = list/select fields (f -> named f == key)
  first_or_zero (list/to_list found)

fn first_or_zero fs
  amount fs (length fs == 0)

fn amount _ true
  0

fn amount fs false
  text/to_int (text/split fs[1]! "=")[2]!

# The instructions golden is one benchmark to a line, `name count`. It is the
# only vein here counting the work a process did rather than what it
# allocated, which is the dimension the other four are blind to: a decode that
# allocates identically and executes eight per cent more instructions moves
# nothing else on this row, and for eleven days nothing did.
fn ir_line text name
  wanted = list/select (text/split text "\n") (l -> ir_starts? l name)
  ir_count_in (list/to_list wanted)

fn ir_starts? line name
  (text/split line " ")[1]! == name

fn ir_count_in ls
  ir_amount ls (length ls == 0)

fn ir_amount _ true
  0

fn ir_amount ls false
  text/to_int (text/split ls[1]! " ")[2]!

ir_benches = ["jsonbench" "encodebench" "oneshot" "basket"]

ir_tail = ["oneshot_instructions" "basket_instructions"]

ir_fields = text/concat ["instructions" "encode_instructions"] ir_tail

fn instructions text
  counts = list/map ir_benches (n -> ir_line text n)
  list/to_list (list/zip ir_fields (list/to_list counts))

# The text golden is `name text=count`: the machine code each benchmark
# carries. Only the decoder's is charted — every binary links the same runtime,
# so summing them would count it four times.
fn size_of text
  wanted = list/select (text/split text "\n") (l -> ir_starts? l "jsonbench")
  size_in (list/to_list wanted)

fn size_in ls
  size_amount ls (length ls == 0)

fn size_amount _ true
  0

fn size_amount ls false
  text/to_int (text/split (text/split ls[1]! " ")[2]! "=")[2]!

# The compile golden is many fields to a line, one line per sample, and the
# published number is the total across them.
fn total_for lines key
  amounts = list/map lines (l -> value_in (fields_of l) key)
  list/sum (list/to_list amounts)

fn compile_work text
  lines = list/to_list (list/select (text/split text "\n") body?)
  totals = list/map work_keys (k -> total_for lines k)
  list/to_list (list/zip work_out (list/to_list totals))

fn asked argv
  os/run "git" argv

fn head_line r
  (text/split r.stdout "\n")[1]!

fn described line
  parts = text/split line " "
  rest = list/to_list (list/drop parts 2)
  subject = text/join rest " "
  [["commit" parts[1]!] ["date" parts[2]!] ["subject" subject]]

# What the compiler costs itself, on a real module rather than a sample small
# enough that the number never moves. env carries the flag because os/run
# takes a command and arguments, not an environment.
fn compiler_cost _
  argv = ["KANSO_COUNTERS=1" "./target/release/kanso" "check" "lib/json"]
  os/run "/usr/bin/env" argv

fn welfare_score _
  os/run "./target/release/kanso" ["run" "scripts/welfare"]

# `welfare 65.56   floor 65.56  (...)` — the second field is the score.
fn score_in text
  parts = text/split (text/split text "\n")[1]! " "
  parts[2]!

fn stamped r
  os/read_file "bench/cost_golden.txt" . (d -> with_decode (head_line r) d)

fn with_decode line d
  os/read_file "bench/cost_golden_encode.txt" . (e -> with_encode line d e)

fn with_encode line d e
  os/read_file "bench/cost_golden_oneshot.txt" . (o -> with_oneshot line d e o)

fn with_oneshot line d e o
  os/read_file "bench/cost_golden_basket.txt"
    . (bk -> with_basket line d e o bk)

fn with_basket line d e o bk
  os/read_file "bench/compile_golden.txt" . (c -> recorded line d e o bk c)

fn recorded line d e o bk c
  every_watched d e o bk . (_ -> costed line d e o bk c)

fn costed line d e o bk c
  compiler_cost 0 . (cc -> with_cost line d e o bk c cc)

fn with_cost line d e o bk c cc
  welfare_score 0 . (w -> assembled line d e o bk c cc w)

fn assembled line d e o bk c cc w
  decode = counters d decode_watched ""
  encode = counters e encode_watched "encode_"
  oneshot = counters o oneshot_watched "oneshot_"
  basket = counters bk basket_all "basket_"
  veins = text/concat decode encode
  own = counters cc.stderr compiler_watched ""
  scored = [["welfare" (score_in w.stdout)]]
  rest = text/concat (text/concat oneshot basket) (compile_work c)
  measured = text/concat own scored
  tail = text/concat rest measured
  rows = text/concat (described line) (text/concat veins tail)
  os/read_file "bench/instructions_golden.txt" . (w -> with_work rows w)

fn with_work rows w
  os/read_file "bench/text_golden.txt" . (t -> written rows w t)

fn written pairs w t
  sized = [["text_bytes" (size_of t)]]
  worked = text/concat (instructions w) sized
  io/write "{json/encode (list/to_h (text/concat pairs worked))}\n"

pub play = asked ["log" "-1" "--format=%h %cI %s"] . stamped
