# A death names its place through an id the stamp stored, read back through
# the program's site table. The mutation has the runtime read only the
# address a stamp used to store, and a death behind an id stamp loses its
# `failed in` line.
site_by_id = row
  "a death's place read only from the address a stamp used to store"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_site_named_by_its_address_alone")
  no_setup

rows_cq33 = list/concat rows_cq32 [site_by_id]

# The escape writer and the undo walk answer every escape a sixteen-byte block
# holds from the block's one mask. Each mutation puts back a block load at
# every escape; the output is the same and the work rows rise.
escape_block_once = row
  "an escaped block classified again at every escape"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_escaped_block_classified_at_every_escape")
  benchmarks

undo_block_once = row
  "an undone block classified again at every escape"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_undone_block_classified_at_every_escape")
  benchmarks

rows_cq34 = list/concat rows_cq33 [escape_block_once undo_block_once]

# A mention of a constant whose one arm is an integer literal is that
# literal. The mutation sends every mention back through the constant's cell;
# the output is the same and the work rows rise.
literal_constant = row
  "a literal constant read through its cell"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_literal_constant_read_through_its_cell")
  benchmarks

rows_cq35 = list/concat rows_cq34 [literal_constant]

# A template whose first piece is a field of a record the arm is finished with
# joins into that string in place, and a parameter an arm only reads into
# templates can still be an accumulator. Each mutation takes one away, and the
# mem fixture `a_record_field_joined_in_place` copies its string every pass.
field_join = row
  "a record field joined by copying"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_record_field_joined_by_copying")
  no_setup

template_hold = row
  "a template read counted as a hold"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_template_read_counted_as_a_hold")
  no_setup

rows_cq36 = list/concat rows_cq35 [field_join template_hold]

# The browser rows count the wasm instructions a module executes rather than
# wasmi's fuel, which charges a loop for every arm of a dispatch on every pass
# (2026-10-23). The mutation lets a counted run go on through a `br_table`, and
# the hand-counted loop in tests/browser_cost.rs is the witness.
hand_count = "the_count_is_every_instruction_control_reached"

run_through_dispatch = row
  "a counted run that goes on through a br_table"
  true
  "cargo test --release --test browser_cost {hand_count}"
  "specs (unit, golden, differential)"
  (breaking "a_counted_run_that_goes_on_through_a_br_table")
  no_setup

rows_cq37 = list/concat rows_cq36 [run_through_dispatch]

# The tab's compiler exports a memcmp that compares eight bytes a pass
# (2026-10-23). The mutation renames it, so the wasm build links
# compiler-builtins' byte loop again and the browser compile row is the
# witness.
word_compare = row
  "a byte loop compares in the tab"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_byte_loop_compares_in_the_tab")
  release

rows_cq38 = list/concat rows_cq37 [word_compare]

# The tab's translator finds a switch line by its `=` rather than by a
# substring searcher built for every line (2026-10-23). The mutation builds
# the searcher again, and the browser compile row is the witness.
switch_line = row
  "a searcher built for every line the tab translates"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_searcher_built_for_every_line_the_tab_translates")
  release

rows_cq39 = list/concat rows_cq38 [switch_line]

# The narrowing reads whether the module defines the closure-jump twin off
# the define lines it walks (2026-10-23). One mutation searches the whole
# module for it again, and the browser compile row is the witness; the other
# stops collecting lambdas, and the narrowing's own spec is.
twin_search = row
  "the whole module searched for the closure jump"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_whole_module_searched_for_the_closure_jump")
  release

lambda_test = "a_lambda_keeps_the_convention_where_a_closure_jump_can_reach_it"

lambda_narrowed = row
  "a lambda narrowed beside a closure jump"
  true
  "cargo test --release --lib {lambda_test}"
  "specs (unit, golden, differential)"
  (breaking "a_lambda_narrowed_beside_a_closure_jump")
  no_setup

rows_cq40 = list/concat rows_cq39 [twin_search lambda_narrowed]

# The tab's compiler finds `@sN` by memchr on `@` and ends each IR line eight
# bytes a pass (2026-10-23); each mutation brings a searcher back, and the
# browser compile row is the witness. The word compare and the byte search
# share a fuzzer, and each has a mutation that the fuzzer catches.
string_names = row
  "a string name found by a two-byte searcher"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_string_name_found_by_a_two_byte_searcher")
  release

line_search = row
  "a line found by a searcher in the tab"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_line_found_by_a_searcher_in_the_tab")
  release

compare_fuzz = "the_word_compare_agrees_with_bytes"

wrong_end = row
  "a word compare that reads the wrong end"
  true
  "cargo test --release --test {compare_fuzz}"
  "specs (unit, golden, differential)"
  (breaking "a_word_compare_that_reads_the_wrong_end")
  no_setup

borrow = row
  "a byte search that trusts a borrow"
  true
  "cargo test --release --test {compare_fuzz}"
  "specs (unit, golden, differential)"
  (breaking "a_byte_search_that_trusts_a_borrow")
  no_setup

rows_cq41a = list/concat rows_cq40 [string_names line_search]

rows_cq41 = list/concat rows_cq41a [wrong_end borrow]

# The emitter asks of every line it writes whether it is a stack slot, and
# finds the line's first space with a byte loop (2026-10-23). The mutation
# puts `find` back, and the browser compile row is the witness.
stack_slot = row
  "a stack slot found by a searcher"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_stack_slot_found_by_a_searcher")
  release

rows_cq42 = list/concat rows_cq41 [stack_slot]

# The wasm build keeps no allocation tally the tab never reads (2026-10-23).
