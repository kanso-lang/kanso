rows_c1zzzzzzyd = list/concat rows_c1zzzzzzy2 [err_shown]

# A native build emits only the groups its entry reaches, the walk the tab
# has made since 2026-10-08 (2026-10-09). The mutation empties the walk's
# answer, every imported group is emitted and pruned afterwards, and the emit
# row is the witness.
native_reached = row
  "a native build emitting every group"
  true
  emit_gate
  "cost goldens (deterministic ratchet, no clocks)"
