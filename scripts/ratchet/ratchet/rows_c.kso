  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_interpolated_err_handed_to_the_group")
  release

rows_c1zzl = list/concat rows_c1zzk [interp_err_hop]

# The same at `print`: told its argument cannot be an err, the site hands one to
