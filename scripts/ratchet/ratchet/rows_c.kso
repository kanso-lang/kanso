import "std/list"

rows_c1 = [welfare_floor grammar book_outputs book_quotes error_corpus trend]

rows_c1a = list/concat rows_c1 [perf_row trend_runtime trend_joined]

rows_c1t = list/concat rows_c1a [trend_adrift trend_rebased trend_read]

rows_c1p = list/concat rows_c1t [published_numbers]

rows_c1b = list/concat rows_c1p [diagnostics accumulator]

# The `goldens` row above covers the micro differential generically, through a
# golden that drifts. This one covers the direction the corpus could not see
# until 2026-09-14: the two engines PARSING a decimal differently. Rendering
# has had rows since kanso#1256; reading one back had none, and native sat one
# ULP off the oracle on every number longer than nineteen significant digits.
# A drifted golden and a diverged engine are different defects and a mutation
# that moves a `.out` file cannot produce the second.
truncated_significand = row
  "a truncated significand the fast path calls certain"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_truncated_significand_taken_as_certain")
  release

rows_c1c0a = list/concat rows_c1b [rendering negative_sign small_record]

rows_c1c0 = list/concat rows_c1c0a [truncated_significand]

rows_c1c1 = list/concat rows_c1c0 [short_append beat_mark every_edge pure_cycle]

rows_c1c = list/concat rows_c1c1 [behaviour]

rows_c1d = list/concat rows_c1c [numeric effects]

rows_c1e = list/concat rows_c1d [modules coverage]

rows_c1f0 = list/concat rows_c1e [coverage_floor decoder]

rows_c1f = list/concat rows_c1f0 [validator validator_tail]

rows_c1g = list/concat rows_c1f [landing in_the_page page_route shop_window]

# kq is a real program with its own JSON, and its own text goes through
# `text/append` seventy times, so a runtime that corrupts an in-place append
# reaches it. That is the row's mutation, and the shape ci.yml names as the
# reason this job gates at all.
#
# The gate clones kq the way the job does rather than expecting one beside the
# checkout, which is what the excuse this replaces claimed it needed. The clone
# directory must be named `kq`: `kanso build <dir>` names the binary for the
# directory and spec.sh invokes `./kq`.
asset_digests = row
  "a page that keeps its undigested reference while every asset is digested"
  true
  "{ag_gate}"
  "asset digests (every reference rewritten, site still runs)"
  (breaking "a_page_keeps_its_undigested_reference")
  release

kq_specs = row
  "a byte builder that writes the right length and the wrong bytes"
  true
  "{kq_gate}"
  "kq specs (a real program, gating)"
  (breaking "a_string_the_builder_corrupted_in_place")
  release

coverage_printed = row
  "an `error[kind]:` refusal printed as plain text, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_printed_error_kind_arrives_without_a_golden")
  release

rows_c1h = list/concat rows_c1g [dispatch coverage_driver]

# A FOURTH opener, and the file the scan could not see. `source?` took `.rs`
# only, so src/runtime.c — where a compiled binary gets its runtime messages —
# had never been read. Thirty-three of its sixty-six k_die texts were pinned by
# nothing.
coverage_native = row
  "a refusal the native runtime dies with, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_native_runtime_refusal_arrives_without_a_golden")
  release

# A FIFTH opener, on the engine the differential law calls the truth. eval.rs
# raises `RuntimeError { message: ... }` — a bare struct field none of the four
# above match — so all 97 of the oracle's refusals were rewordable in silence.
#
# Two rows because the extraction differs: `message: "` carries its own opening
# quote and the literal is the first piece of a split on it, where
# `message: format!(` may put the string on the next line and the literal is
# the second. One mutation would leave the other path untested.
coverage_oracle = row
  "a refusal the interpreter raises, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_refusal_arrives_without_a_golden")
  release

coverage_oracle_format = row
  "a refusal the interpreter formats, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_format_refusal_arrives_without_a_golden")
  release

rows_c1i = list/concat rows_c1h [coverage_printed kq_specs asset_digests]

rows_c1j = list/concat rows_c1i [coverage_native]

rows_c1k = list/concat rows_c1j [coverage_oracle coverage_oracle_format]

rows_c1l = list/concat rows_c1k [named_err]

rows_c1m0 = list/concat rows_c1l [beat_cursor rescue_licence raised_err]

rows_c1m = list/concat rows_c1m0 [clay_send_filed]

rows_c1m2 = list/concat rows_c1m [carry_failure repaired_mark]

rows_c1n = list/concat rows_c1m2 [err_as_pattern force_chain]

rows_c1o = list/concat rows_c1n [hand_box callback_err]

rows_c1w = list/concat rows_c1o [bang_box guard_bound literal_bound]

rows_c1x = list/concat rows_c1w [guard_bind_linear guard_bind_chain]

rows_c1y = list/concat rows_c1x [bytes_acc_position guard_tail_oracle]

rows_c1ya = list/concat rows_c1y [qualified_yield]

# THE COMPILER'S ALLOCATOR. glibc's malloc and free were 12.7% of
# `kanso check compile_corpus` — 5.27 million of 41.5 million instructions,
# larger than any kanso function on the profile. mimalloc sits UNDER the
# counting wrapper in src/main.rs, so the compiler's demand is unchanged and
# every counter the objective reads is byte-identical: compile_allocs 27,395,
# compile_alloc_bytes 4,612,036, compile_peak_bytes 787,956. The emitted IR is
# byte-identical too. So nothing in the tree can see this swap except the three
# instruction veins, and if a merge or a revert ever put the system allocator
# back, every counter would agree and only the goldens would object. That is
# what this row watches. Host-bound like the other compile rows: the gate
# refuses on a toolchain the golden does not name, so it is proved where the
# gate is green.
compiler_allocator = row
  "the compiler back on the system allocator, rows still pinned to mimalloc"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_compiler_on_the_system_allocator")
  release

# The number the compiler hands mi_option_set is read out of a vendored C
# header, so a crate bump can move the option out from under it in silence.
allocator_option = row
  "the allocator option named one past the one that matters"
  true
  "cargo test --release --test the_allocator_option_is_the_one_the_header_names"
  "specs (unit, golden, differential)"
  (breaking "an_allocator_option_off_by_one")
  no_setup

rows_c1za = list/concat rows_c1ya [compiler_allocator]

rows_c1zb = list/concat rows_c1za [allocator_option]

# And the second option the same constructor sets, for the same reason. This
# one stops mimalloc reading the clock: its purge timer calls clock_gettime,
# whose instruction count belongs to the host's clocksource rather than to
# this program, and CI read the three compile rows 13 apart on two runs of one
# commit before it came off.
purge_delay_option = row
  "the purge delay named one past the option that disables the timer"
  true
  "cargo test --release --test the_allocator_option_is_the_one_the_header_names"
  "specs (unit, golden, differential)"
  (breaking "a_purge_delay_that_is_not_the_purge_delay")
  no_setup

rows_c1zc = list/concat rows_c1zb [purge_delay_option]

rows_c1zd = list/concat rows_c1zc [codegen_one_process]

# The nightly proves the table in eight shards, and its matrix has to run every
# shard its run line divides by.
nightly_shards = row
  "a nightly that drops its last shard"
  true
  "cargo test --release --test the_nightly_proves_every_row_once"
  "specs (unit, golden, differential)"
  (breaking "a_nightly_that_drops_its_last_shard")
  no_setup

rows_c1ze = list/concat rows_c1zd [nightly_shards]

# The per-PR ratchet proves a branch's handful in shards, and the spec asks
# each shard what it would prove. It lists rather than proves, so it runs in
# a worktree of its own and none of `prove`'s fixed directories.
branch_shards = row
  "a branch shard that skips a row in every stretch"
  true
  "cargo test --release --test a_branch_proves_its_rows_in_shards"
  "specs (unit, golden, differential)"
  (breaking "a_branch_shard_that_skips_rows")
  no_setup

rows_c1zf = list/concat rows_c1ze [branch_shards]

# The utf-8 wide pass counts continuation bytes in a register, and the count is
# the string's length. One row for the count, one for what it costs.
lane_count = row
  "a continuation counted from the wrong byte"
  true
  "./target/release/kanso run scripts/utf8_differential"
  "utf-8 validator (differential vs an independent reference)"
  (breaking "a_continuation_counted_from_the_wrong_byte")
  release

lane_count_cost = row
  "a continuation count that pays a popcount"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_continuation_count_that_pays_a_popcount")
  benches

rows_c1zl = list/concat rows_c1zf [lane_count lane_count_cost]

# The slice walk counts a word's character starts by multiply rather than by a
# popcount the ssse3 build writes out longhand.
skip_by_multiply = row
  "a slice skip that pays a popcount"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_slice_skip_that_pays_a_popcount")
  benches

rows_c1zh = list/concat rows_c1zl [skip_by_multiply]

# A run of up to eight digits is read as one word, and a short decimal as two,
# each loaded from the eight bytes that end at its last digit. Both specs lift
# the word helpers out of the runtime and sweep every byte at every position.
digit_word = row
  "a digit word that reads a colon as ten"
  false
  "cargo test --release --test the_int_fast_path_agrees_with_libc"
  "specs (unit, golden, differential)"
  (breaking "a_digit_word_that_reads_a_colon_as_ten")
  release

float_word = row
  "a float word that never looks for its dot"
  false
  "cargo test --release --test every_float_literal_parses_like_strtod"
  "specs (unit, golden, differential)"
  (breaking "a_float_word_that_never_looks_for_its_dot")
  release

rows_c1zg = list/concat rows_c1zh [digit_word float_word]

# A loop that only grows the list it was handed keeps its bracket and drops the
# rewind, which found the arena where the mark left it on every lap.
grows_itself = row
  "a pushing loop that rewinds every lap"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_pushing_loop_that_rewinds_every_lap")
  benches

rows_c1zm = list/concat rows_c1zg [grows_itself]

# `keys` and `values` are the two columns of `entries`, in its order; a
# program that indexes both pairs a key with the wrong value when one column
# is read in another order, with nothing failing.
columns_line_up = row
  "a values column read in insertion order"
  false
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_values_column_read_in_insertion_order")
  release

rows_c1zn = list/concat rows_c1zm [columns_line_up]

# A map handed back to its loop unchanged threads the way a list does, so the
# carry no longer walks its keys and values on every lap.
map_threaded = row
  "a map carried that could have threaded"
  false
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_map_carried_that_could_have_threaded")
  release

rows_c1zo = list/concat rows_c1zn [map_threaded]

# The ratchet naming each row as it starts has no row here. The spec that
# watches it, a_clean_head_still_proves_its_row, runs `prove` itself, and
# `prove` works in fixed directories -- /tmp/kanso-ratchet-base, one
# /tmp/kanso-ratchet-N per row, the shared target -- so the ratchet running
# that spec as a gate removes its own baseline worktree from under itself. On
# kanso#1675 the baseline read the gate red before any mutation. The other
# specs in tests/ that run `prove` carry no row for the same reason.
# mimalloc counts the host's NUMA nodes the first time a thread allocates, and
# the interpreter's thread is the first, so the count's probe landed inside
# the frame the interpreter row counts. The compiler now tells it there is one.
numa_count = row
  "the NUMA node count left to the host"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_numa_count_left_to_the_host")
  release

# The same option by position in the vendored header, pinned like the two
# beside it.
numa_option = row
  "the NUMA option named one past the one that matters"
  true
  "cargo test --release --test the_allocator_option_is_the_one_the_header_names"
  "specs (unit, golden, differential)"
  (breaking "a_numa_option_off_by_one")
  no_setup

rows_c1zp = list/concat rows_c1zo [numa_count numa_option]

# A call whose arguments are `keys m` and `values m` of one map builds both
# lists in one runtime call and one allocation.
columns_together = row
  "a map's two columns asked for one at a time"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "the_two_columns_asked_apart")
  release

rows_c1zq = list/concat rows_c1zp [columns_together]

# The cost-goldens job copies the profile of every gate that reads itself
# twice, so a row that reads apart between runs can be diffed afterwards.
interp_profile = row
  "the interpreter's profiles left on the runner"
  true
  "cargo test --release --test every_second_reading_leaves_the_job"
  "specs (unit, golden, differential)"
  (breaking "the_interp_profile_left_behind")
  no_setup

rows_c1zr = list/concat rows_c1zq [interp_profile]

# A shared token's escape scan is decided once, when its slot fills. Marking
# every token clean writes a quote raw into the micro fixture; scanning a
# clean one anyway puts the scans back into `find2_calls`.
token_clean = row
  "every short token counted clean"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "every_short_token_counted_clean")
  release

token_skip = row
  "a clean token scanned anyway"
  true
  (gating "encode_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_clean_token_scanned_anyway")
  benchmarks

rows_c1zs = list/concat rows_c1zr [token_clean token_skip]

# The token's clean flag is three bit tests on one padded word; the spec lifts
# them and sweeps every byte at every position against a byte walk.
token_word = row
  "a token flag one byte short of the control range"
  false
  "cargo test --release --test a_token_flag_agrees_with_the_byte_walk"
  "specs (unit, golden, differential)"
  (breaking "a_token_flag_one_byte_short")
  no_setup

rows_c1zt = list/concat rows_c1zs [token_word]

# A lazy binding read once, past a `return ... if`, inlines into its reader.
# Stopping the rewrite at the guard leaves the reader naming nothing, and the
# micro fixture fails on both engines.
chain_guard = row
  "a return hides the chain's reader"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_return_hides_the_chain_reader")
  release

rows_c1zu = list/concat rows_c1zt [chain_guard]

# An accumulator whose seed the caller still reads is copied on the first lap
# and extended in place after it. Asking the holder count nothing leaves every
# lap copying, and the spec's allocation difference returns to 161,356.
seed_once = row
  "a shared seed copied every lap"
  true
  "cargo test --release --test a_shared_seed_is_copied_once"
  "specs (unit, golden, differential)"
  (breaking "a_shared_seed_copied_every_lap")
  no_setup

rows_c1zv = list/concat rows_c1zu [seed_once]

# Builds that compile the runtime at once each write its source under their own
# name and rename it onto the shared one. Writing the shared path in place
# truncates it under another build's clang, and the cold-runtime race answers
# with clang's crash.
runtime_source = row
  "the runtime source written in place"
  true
  "cargo test --release --test concurrent_build builds_that_compile"
  "specs (unit, golden, differential)"
  (breaking "the_runtime_source_written_in_place")
  no_setup

rows_c1zw = list/concat rows_c1zv [runtime_source]

# A finite float rounds to the integer it is, however large, on the
# interpreter; a compiled build refuses one past int64. Restoring the
# saturating cast answers int64's edge interpreted, and restoring llround
# answers LLONG_MIN compiled, for 1e30 and for infinity alike.
round_exact = row
  "a large float rounds to int64's edge"
  true
  "cargo test --release --test a_float_past_int64_rounds_exactly"
  "specs (unit, golden, differential)"
  (breaking "a_large_float_rounds_to_int64s_edge")
  no_setup

round_native = row
  "a large float rounds through llround"
  true
  "cargo test --release --test a_float_past_int64_rounds_exactly"
  "specs (unit, golden, differential)"
  (breaking "a_large_float_rounds_through_llround")
  no_setup

rows_c1zx = list/concat rows_c1zw [round_exact round_native]

# Pushing an err answers the err on every engine. Without the C push's item
# test, a push the analysis does not own stores it, and the micro fixture
# prints a list holding an err.
push_err = row
  "a pushed err kept as an element"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_pushed_err_kept_as_an_element")
  release

# A builtin's failing arguments merge. Answering the first alone is what the
# C did, and the second micro fixture prints one reason where it wants two.
two_errs = row
  "two failures answer the first"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "two_failures_answer_the_first")
  release

rows_c1zy = list/concat rows_c1zx [push_err two_errs]

# A list renders in one pass into one buffer. Copying its text so far after
# each element, as joining each element onto the rest did, turns the mem
# fixture's allocation back into the square of the list's length.
render_pass = row
  "a list rendered by joining each element"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_list_rendered_by_joining_each_element")
  release

rows_c1zz = list/concat rows_c1zy [render_pass]

# A lazy cell's site that tail-calls a group returning its record in two
# registers boxes the pair. Forgetting the pair came back as two words
# returns it as a tagged value, and clang refuses the micro fixture.
thunk_box = row
  "a thunk site returns a record unboxed"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_thunk_site_returns_a_record_unboxed")
  release

rows_c1zza = list/concat rows_c1zz [thunk_box]

# A double halfway between two shortest decimals prints the even last digit on
# every engine. Keeping Rust's upper candidate in the interpreter makes the
# micro fixture disagree across engines.
float_tie = row
  "a float tie rounded up"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_float_tie_rounded_up")
  release

rows_c1zzb = list/concat rows_c1zza [float_tie]

# The render group is called by every interpolation, so its parameter holds
# any value. Typed from the explicit calls alone, an int-only program passes
# it a raw word, and the micro fixture prints a record as its tag.
render_group = row
  "the render group typed from its calls"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "the_render_group_typed_from_its_calls")
  release

rows_c1zzc = list/concat rows_c1zzb [render_group]

# An integer written as text past int64 is read whole by a compiled build.
# Answering an err value again lets a program catch it, and std/json turns it
# into "invalid number".
int_whole = "an_integer_past_int64_reads_whole_on_every_engine"

int_refused = row
  "an overflowing integer answered as an err"
  true
  "cargo test --release --test {int_whole}"
  "specs (unit, golden, differential)"
  (breaking "an_overflowing_integer_answered_as_an_err")
  no_setup

rows_c1zzd = list/concat rows_c1zzc [int_refused]

# A cycle of an empty list ends at once. Without its guard the cycle wraps
# and asks again forever, and the spec finds no answer inside its deadline.
empty_cycle = row
  "an empty cycle that wraps forever"
  true
  "cargo test --release --test an_empty_cycle_ends"
  "specs (unit, golden, differential)"
  (breaking "an_empty_cycle_that_wraps_forever")
  release

rows_c1zze = list/concat rows_c1zzd [empty_cycle]

# An unhandled err's reason is written by its length. Printed as a C string,
# a reason holding a NUL stops there, and the runtime corpus reads it cut.
nul_reason = row
  "an err reason printed as a C string"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_err_reason_printed_as_a_c_string")
  release

rows_c1zzf = list/concat rows_c1zze [nul_reason]

# A list literal keeps a failing item, so an element read can answer an err.
# Typed as never failing, the read lets a compiled build call on with no test
# of the err, and the runtime corpus reads a trace with a hop missing.
element_err = row
  "an element read that never fails"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_element_read_that_never_fails")
  release

rows_c1zzg = list/concat rows_c1zzf [element_err]

# A zero divisor answers a value. Typed as an err, it lets a compiled build
# compute on the string as though it were a number, and the runtime corpus
# reads a number where the refusal of `*` belongs, in the `%` fixture: a
# remainder by a word is a word, where a quotient may be a bignum whose
# arithmetic tests the tag.
zero_divisor = row
  "a zero divisor answered as an err"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_zero_divisor_answered_as_an_err")
  release

rows_c1zzh = list/concat rows_c1zzg [zero_divisor]

# A release link runs LLVM 19's pipeline without dead-argument elimination.
# With the pass back, a program declaring a subtype beside std/regexp fails to
# link, and the micro corpus's release build reports it.
link_dae = row
  "a release link that runs deadargelim"
  true
  "cargo test --release --test golden micro_corpus_survives_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "a_release_link_that_runs_deadargelim")
  release

rows_c1zzi = list/concat rows_c1zzh [link_dae]

# A none is a value. Hopped out of a dispatcher that matched no arm, as though
# it were an err, it becomes the call's answer, and the runtime corpus reads
# nothing where the refusal belongs.
none_hop = row
  "a none hopped as a failure"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_none_hopped_as_a_failure")
  release

rows_c1zzj = list/concat rows_c1zzi [none_hop]

# A curried application hands a group on to be called from somewhere no call
# site describes. Unseen as a value, it lets a parameter qualify as a string
# builder, and the micro corpus dies natively converting an int.
curried_unseen = row
  "a curried group unseen as a value"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_curried_group_unseen_as_a_value")
  release

rows_c1zzk = list/concat rows_c1zzj [curried_unseen]

# An err interpolated into a string is handed on as it is. Handed to a program's
