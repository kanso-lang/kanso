  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_insisted_round_answering_zero")
  release

rounds_a = [nonfinite_native nonfinite_oracle nonfinite_typed]

rounds_b = [nonfinite_per_call nonfinite_insisted]

rows_c1zzzzm = list/concat rows_c1zzzzj (list/concat rounds_a rounds_b)

