nonfinite_oracle = row
  "a non-finite float rounded to zero"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_non_finite_float_rounded_to_zero")
