print_err_hop = row
  "a printed err handed to the group"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_printed_err_handed_to_the_group")
  release

rows_c1zzm = list/concat rows_c1zzl [print_err_hop]

# `text/join` answers the first item that fails, and a list literal can keep
