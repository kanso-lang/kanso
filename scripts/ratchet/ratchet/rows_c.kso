  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_operator_kind_left_to_the_run")
  no_setup

rows_cq15 = list/concat rows_cq14 [operator_kind_unchecked]

# A run-time failure names the line it happened on, on every engine (#1975).
# Each half dropped turns the runtime corpus red where the engines disagree.
death_unplaced = row
  "a native death that names no place"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_runtime_death_with_no_place")
  release

oracle_unplaced = row
  "an interpreted failure left unplaced"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_interpreted_failure_left_unplaced")
  release

insisted_native = row
  "an insisting form that names the library's line"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_insisting_form_that_names_the_library")
  release

insisted_oracle = row
  "an interpreted insisting form that names the library's line"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_interpreted_insisting_form_that_names_the_library")
  release

failure_places = [death_unplaced oracle_unplaced]

insisted_places = [insisted_native insisted_oracle]

rows_cq16 = list/concat rows_cq15 failure_places

rows_cq17 = list/concat rows_cq16 insisted_places

# A byte handed on beside the position it was read at bounds that position in
# an arm that takes the byte as a byte, and the fact holds only when every
# call passes such a pair. One mutation keeps a link a call broke, which a
# program built for release can see (the dev tier never acts on the assume);
# the other drops every link, which the emitted code shows.
read_link_kept = row
  "a read position assumed where a call passed a literal"
  true
  "cargo test --release --test golden micro_corpus_survives_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "a_read_position_assumed_past_a_literal")
  release

read_link_lost = row
  "a read position left unbounded"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_read_position_left_unbounded")
  benchmarks

length_bound = row
  "an inline length left unbounded"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_inline_length_left_unbounded")
  benchmarks

read_positions = [read_link_kept read_link_lost length_bound]

rows_cq18 = list/concat rows_cq17 read_positions

