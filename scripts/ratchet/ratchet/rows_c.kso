# A partial over a group of more than four parameters is held over the group's
# value on both native and the browser, native's dispatcher calls a group value
# with five or more arguments, a native partial holding more than four is a
# partial over a partial, and a group of more than eight is a value whose
# wrapper takes its arguments as one array. Each row puts one of the five back.
hop_wide = row
  "a wide partial held in a closure"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_wide_partial_held_in_a_closure")
  release

wide_call = row
  "a wide group value left uncalled"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_wide_group_value_left_uncalled")
  release

wide_held = row
  "a partial holding five refused"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_partial_holding_five_refused")
  release

nine_value = row
  "a nine-wide group refused as a value"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_nine_wide_group_refused_as_a_value")
  release

wides = [hop_wide wide_call wide_held nine_value]

rows_c1zzzzg = list/concat rows_c1zzzzh wides

# The playground builds its views on the engine's memory from pointers the
# engine answers as wasm i32s. Past two gibibytes those read negative unless the
# page turns them unsigned, and the answer a program produced cannot be read.
high_pointers = row
  "a playground reading a pointer past two gibibytes as negative"
  true
  "./target/release/kanso run scripts/site_smoke"
  "site (landing sample and playground run in a browser)"
  (breaking "a_playground_reading_high_pointers_as_negative")
  with_blob

rows_c1zzzzn = list/concat rows_c1zzzzg [high_pointers]

# A string builder may be seeded with any value, since a join renders what it
# joins onto. Native used to refuse the seed, and the first join adopts it.
seed_refused = row
  "a builder seed refusing what is not a string"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_builder_seed_refusing_what_is_not_a_string")
  release

# The first join into a builder finds no room in a seed that is not a builder
# yet, whether the seed was not a string, was bound lazily, or was a fold's
# literal, and makes the builder there. The fold fixture dies without it.
seed_unbuilt = row
  "a first join that never makes its builder"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_first_join_that_never_makes_its_builder")
  release

rows_c1zzzzs = list/concat rows_c1zzzzn [seed_refused seed_unbuilt]

# A builtin in a program that declares a subtype unwraps its arguments, and
# a lazy one is forced before the unwrap looks at it.
lazy_sub = row
  "a lazy subtype unwrapped before it is forced"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_lazy_subtype_unwrapped_before_it_is_forced")
  release

rows_c1zzzzv = list/concat rows_c1zzzzs [lazy_sub]

# A group handed out as a function value keeps its record boxed, because the
# wrapper a function value is called through answers one boxed word.
fn_value_boxed = row
  "a function value returned in registers"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_function_value_returned_in_registers")
  release

rows_c1zzzzy = list/concat rows_c1zzzzv [fn_value_boxed]

# An operator arm a module declares may build that module's records once the
# module is imported, as any of its named functions may.
arm_builds_own = row
  "an imported operator arm read as the importer's"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_imported_operator_arm_read_as_the_importers")
  release

rows_c1zzzzz = list/concat rows_c1zzzzy [arm_builds_own]

# A subtype of int meets `&`, `|` and `^` as the int it wraps, on native as on
# the interpreter and the page.
bits_unwrap = row
  "a subtype refused at a bitwise operator"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_subtype_refused_at_a_bitwise_operator")
  release

rows_c1zzzzzz = list/concat rows_c1zzzzz [bits_unwrap]

# A held `if` takes the condition and both branches, so three arguments call
# it on the interpreter instead of growing the partial.
held_if = row
  "a held if counted as nothing"
  true
  "cargo test --release --test a_held_if_picks_its_branch"
  "specs (unit, golden, differential)"
  (breaking "a_held_if_counted_as_nothing")
  release

rows_c1zzzzzzz = list/concat rows_c1zzzzzz [held_if]

# An operator's arms take records boxed, because the operator hands them the
# boxed values it holds.
arm_boxed = row
  "an operator arm handed words"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_operator_arm_handed_words")
  release

rows_c1zzzzzzzz = list/concat rows_c1zzzzzzz [arm_boxed]

# A sibling argument that stores the container still holds it, so the write
# copies instead of extending the list the sibling just stored.
push_keeps = row
  "a stored sibling read as finished"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_stored_sibling_read_as_finished")
  release

rows_c1zzzzzzzza = list/concat rows_c1zzzzzzzz [push_keeps]

# An import's type twin keeps the declaration it came from when the module
# holding it is imported in turn, so an ascription two imports away matches.
# This row read the micro corpus until short-name construction was refused
# (kanso#1762), after which no micro fixture reached the renamed twin.
origin_once = row
  "an imported origin prefixed twice"
  true
  "cargo test --release --test a_twin_named_from_two_imports_away"
  "specs (unit, golden, differential)"
  (breaking "an_imported_origin_prefixed_twice")
  release

rows_c1zzzzzzzv = list/concat rows_c1zzzzzzzza [origin_once]

# A function a module declares keeps its name beside an import's type of the
# same name, and a call reaches the function.
fn_beats_twin = row
  "an imported type twin beside a function"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_imported_type_twin_beside_a_function")
  release

rows_c1zzzzzzzx = list/concat rows_c1zzzzzzzv [fn_beats_twin]

# A zero divisor's answer reaches an operator's arms exactly where the
# program declared the type that wraps it, on both engines.
math_bare = row
  "an undeclared math failure sent to the arms"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "an_undeclared_math_failure_sent_to_the_arms")
  release

math_named = row
  "a named math failure kept from the arms"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_named_math_failure_kept_from_the_arms")
  release

rows_c1zzzzzzzw = list/concat rows_c1zzzzzzzx [math_bare math_named]

# A group that writes `int` at its counter enters the accumulator loop, as a
# group that writes a bare name does.
int_counter = row
  "an int counter left beside the loop"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_int_counter_left_beside_the_loop")
  release

# A group reached through a function value is entered with its failing
# arguments, as a direct call is, so its err arm answers on every engine.
value_err_arm = row
  "a group value skipping its err arm"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_group_value_skipping_its_err_arm")
  release

# A lambda merges every failing argument, the third as well as the first two.
lambda_third = row
  "a lambda dropping its third err"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_lambda_dropping_its_third_err")
  release

rows_c1zzzzzzzs = list/concat rows_c1zzzzzzzw [int_counter value_err_arm]

rows_c1zzzzzzzt = list/concat rows_c1zzzzzzzs [lambda_third]

# A pattern the parse did not read to its end answers an err, so an open
# group or a stray `)` is refused rather than matched as a shorter pattern.
unclosed_pattern = row
  "an unclosed pattern matching what it read"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_unclosed_pattern_matching_what_it_read")
  release

rows_c1zzzzzzzr = list/concat rows_c1zzzzzzzt [unclosed_pattern]

# A cell an arm binds keeps its failures in inference, so the group it
# reaches next keeps the guard that answers its err.
bound_cell = row
  "a bound cell losing its errs"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_bound_cell_losing_its_errs")
  release

# A position an arm read before the unbuilt-arm prune dropped it still forces
# the cell handed there, as the interpreter's dispatcher does.
pruned_read = row
  "a pruned arm leaving its cell unforced"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_pruned_arm_leaving_its_cell_unforced")
  release

rows_c1zzzzzzzq = list/concat rows_c1zzzzzzzr [bound_cell pruned_read]

# The prune names the positions a dropped arm read and no kept arm reads, from
# the same walk that counts each group's live arms.
pruned_mask = row
  "a prune forgetting what it dropped"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_prune_forgetting_what_it_dropped")
  release

rows_c1zzzzzzzp = list/concat rows_c1zzzzzzzq [pruned_mask]

# Every NaN equals every NaN and ranks last, and -0.0 ranks with 0.0, on every
# engine (ruled 2026-09-30). One row per engine, since each could slip alone.
nan_level = row
  "a NaN ranked level with everything"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_nan_ranked_level_with_everything")
  release

float_bits = row
  "a float ranked by its bits"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_float_ranked_by_its_bits")
  release

rows_c1zzzzzzzo = list/concat rows_c1zzzzzzzp [nan_level float_bits]

# The interpreter promotes an int past int64 rather than wrapping it, and
# every engine answers the same since the 2026-10-07 gavel, so the micro
# corpus pins the answer one step past the edge.
int_widens = row
  "an int that wraps where it should widen"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_int_that_wraps_where_it_should_widen")
  release

rows_c1zzzzzzzn = list/concat rows_c1zzzzzzzo [int_widens]

# A box handed to a parameter is a box inside the body, and the refusal fires
# at the call there that takes a value.
held_box = row
  "a box handed to a parameter forgotten inside the body"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_box_lost_at_the_parameter")
  release

rows_c1zzzzzzzm = list/concat rows_c1zzzzzzzn [held_box]

# The interpreter's caches take their slots from an object's place inside its
# allocator slice. Taking the frame slot from the whole address again makes
# the row read one number with the heap where valgrind puts it and another
# with the heap started at 48 MiB, and the gate compares the two.
slice_slot = row
  "a frame slot read off its address"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_frame_slot_read_off_its_address")
  release

rows_c1zzzzzzzk = list/concat rows_c1zzzzzzzm [slice_slot]

# `print` answers a box the same as `effect`, and the check counts it before
# the short circuit that skips a program where no group answers one.
printed_box = row
  "print forgotten as a box"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "print_answers_no_box")
  release

rows_c1zzzzzzzj = list/concat rows_c1zzzzzzzk [printed_box]

# Spacing decides a minus sign: a `-` touching a digit with a space before it
# is part of the number, so a negative literal is an argument or an element.
spaced_minus = row
  "a spaced minus read as binary"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_spaced_minus_stays_binary")
  release

# `10 -4` is a subtraction missing a space, and the refusal names `10 - 4`.
number_heads_minus = row
  "a number applied to a negative number let through"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_number_applied_to_a_negative_number_passes")
  release

rows_c1zzzzzzzi = list/concat rows_c1zzzzzzzj [spaced_minus number_heads_minus]

# An arm whose answer can be any value is counted as raising, so a raise handed
# on through a field of an entry is refused where it arrives (ruled 2026-09-30).
any_value_raises = row
  "a raise hidden behind any value"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_raise_hidden_behind_any_value")
  release

rows_c1zzzzzzzh = list/concat rows_c1zzzzzzzi [any_value_raises]

# An import's record built by its short name is refused like the qualified
# spelling, and a local binding of that name is still the binding (ruled
# 2026-09-30).
short_record = row
  "an import's record built by its short name"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_record_built_by_its_short_name_passes")
  release

short_record_local = row
  "a local named for an import's record"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_local_named_for_an_imported_record_is_refused")
  release

rows_c1zzzzzzzg = list/concat rows_c1zzzzzzzh [short_record short_record_local]

# Every workflow installs the rustc its goldens were measured under, named
# once at the top of the file, rather than whatever is stable that day.
# Unpinned, the runner moved to 1.99.0 after 2026-10-01 and every gate that
# names rustc refused (2026-10-04).
toolchain_pinned = row
  "a job that installs whatever rustc is stable"
  true
  "cargo test --release --test the_toolchain_is_pinned_to_the_rows"
  "specs (unit, golden, differential)"
  (breaking "a_job_takes_whatever_rustc_is_stable")
  no_setup

# A checkout builds with that same rustc, so a reading taken by hand is a
# reading of CI's toolchain. Two playground sizes were published from a
# container's default 1.94.1 before rust-toolchain.toml existed (2026-10-06).
checkout_pinned = row
  "a checkout that builds with whatever rustc the host has"
  true
  "cargo test --release --test the_toolchain_is_pinned_to_the_rows"
  "specs (unit, golden, differential)"
  (breaking "the_checkout_builds_with_its_own_rustc")
  no_setup

rows_c1zzzzzzzf = list/concat rows_c1zzzzzzzg [toolchain_pinned checkout_pinned]

# `list/tie` fills each key's cell with its node once every node is made,
# which is what turns the references the maker stored into a cycle
# (2026-10-04).
tie_fills = row
  "a tie that never fills its cells"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_that_never_fills_its_cells")
  release

rows_c1zzzzzzze = list/concat rows_c1zzzzzzzf [tie_fills]

# A tie's reference goes into a constructor's field and nowhere else, and a
# literal link to an id the list does not hold is refused (2026-10-04).
tie_check = row
  "a tie reference read anywhere"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_tie_reference_read_anywhere")
  release

# A list or map literal written as a field may hold a tie's references
# (2026-10-10).
tie_list = row
  "a tie list read as a reference"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_list_read_as_a_reference")
  release

# A field may hold a list of references built from data, written
# `list/to_list (list/map xs ref)`, and `push` stores a cell still being made
# on both engines (2026-10-11).
tie_mapped = row
  "a tie map of references refused"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_map_of_references_refused")
  release

tie_push_interp = row
  "an interpreted push that forces a tie cell"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_interpreted_push_forces_a_tie_cell")
  release

tie_push_native = row
  "a native push that forces a tie cell"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_push_forces_a_tie_cell")
  release

tie_rows = [tie_check tie_list tie_mapped tie_push_interp tie_push_native]

rows_c1zzzzzzzd = list/concat rows_c1zzzzzzze tie_rows

# A record constructor handed over as a function lowers to the lambda that
# calls it on native, as the interpreter treats it (2026-10-10, lox F20).
ctor_value = row
  "a constructor refused as a value"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_constructor_refused_as_a_value")
  release

# Native `tie` rewrites every field holding one of its cells to hold the node
# before the cells go back to the free list (2026-10-05).
tie_resolves = row
  "a native tie that frees cells still in its graph"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_that_frees_cells_still_in_its_graph")
  release

rows_c1zzzzzzzc = list/concat rows_c1zzzzzzzd [tie_resolves ctor_value]

# The interpreter rewrites the fields holding a tie's cells to hold the nodes,
# as native does; a `ref` names its tie by serial, so one called after its tie
# returned is refused on both engines; and native's stack of open ties grows
# rather than stopping at 256 (2026-10-05).
tie_interp_resolves = row
  "an interpreter tie that leaves cells in its graph"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_interpreter_tie_that_leaves_cells_in_its_graph")
  release

tie_serial = row
  "a tie ref that answers any open tie"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_tie_ref_that_answers_any_open_tie")
  release

tie_native_serial = row
  "a native tie ref that answers any open tie"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_ref_that_answers_any_open_tie")
  release

tie_native_depth = row
  "a native tie stack that stops at 256"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_stack_that_stops_at_256")
  release

tie_fixes = [tie_interp_resolves tie_serial tie_native_serial tie_native_depth]

rows_c1zzzzzzza = list/concat rows_c1zzzzzzzc tie_fixes

# The release link unswitches a loop on a test of a value the loop does not
# change, such as the overflow flag of `k * 31` in the escape loop
# (2026-10-07). The mutation takes the pass out of the link's pipeline.
loop_unswitch = row
  "a release link that tests an invariant inside its loop"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_that_tests_an_invariant_inside_its_loop")
  benchmarks

rows_c1zzzzzzz9 = list/concat rows_c1zzzzzzza [loop_unswitch]

# The release link runs correlated propagation after each jump-threading and
# early-cse<memssa> before the first (2026-10-07). Each mutation takes its pass
# out of the link's pipeline.
link_correlated = row
  "a release link without correlated propagation"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_without_correlated_propagation")
  benchmarks

link_early_cse = row
  "a release link without early-cse"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_without_early_cse")
  benchmarks

rows_c1zzzzzzz8 = list/concat rows_c1zzzzzzz9 [link_correlated link_early_cse]

# A local reference keeps the frame and slot its binding sat in, and reads
# that place on every later run (2026-10-07). The mutation keeps plain local,
# so every reference walks the frames again.
local_place = row
  "a local found by walking the frames"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_local_found_by_walking")
  release

rows_c1zzzzzzz7 = list/concat rows_c1zzzzzzz8 [local_place]

# The tab's compiler keeps a free list for each size of small block and hands
# blocks out again before dlmalloc is asked (2026-10-08). The mutation sends
# every block to dlmalloc, so the browser compile row is the witness.
small_blocks = row
  "small blocks left to dlmalloc"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "small_blocks_left_to_dlmalloc")
  release

rows_c1zzzzzzz6 = list/concat rows_c1zzzzzzz7 [small_blocks]

# The emitter writes each body line with three pushes rather than through
# `writeln!` (2026-10-08). The mutation sends the line through the formatter
# again, so the emit row is the witness.
emitted_lines = row
  "emitted lines written through the formatter"
  true
  emit_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "emitted_lines_through_fmt")
  release

rows_c1zzzzzzz5 = list/concat rows_c1zzzzzzz6 [emitted_lines]

# A dispatch lets go of what is left in its argument vector through
# `release`, which skips `Value`'s drop for the variants that own nothing
# (2026-10-08). The mutation drops every one again, so the interpreted row is
# the witness.
arguments_released = row
  "argument placeholders dropped one by one"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "arguments_dropped_one_by_one")
  release

rows_c1zzzzzzz4 = list/concat rows_c1zzzzzzz5 [arguments_released]

# The tab emits only the groups its entry reaches, by the names the bodies
# mention, and emits again with nothing skipped when the module names a group
# it left out (2026-10-08). The mutation emits every group, so the browser
# compile row is the witness.
reached_groups = row
  "the tab emitting every group"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_tab_emits_every_group")
  release

# The tab's walk leaves groups out of the program before any analysis reads
# it, and the emitter asks about some groups by name rather than calling them.
# A question about a left-out group has to send the program back whole. The
# mutation stops noting the question, and the unit spec that leaves a `+` arm
# out says nothing saw it.
left_out_asked = row
  "a question about a group the tab left out, answered unseen"
  true
  "cargo test --release --lib a_question_about_a_left_out_operator_is_noticed"
  "specs (unit, golden, differential)"
  (breaking "a_question_about_a_left_out_group_goes_unseen")
  no_setup

rows_c1zzzzzzz2 = list/concat rows_c1zzzzzzz3 [left_out_asked]

# A dispatch ranks its candidates into two `Score`s held on the stack, twelve
# ranks inline each (2026-10-08). The mutation gives each a heap buffer at the
# start of every dispatch again, and the interpreted row is the witness.
scores_inline = row
  "a dispatch that allocates its score"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_dispatch_allocates_its_score")
  release

rows_c1zzzzzzz1 = list/concat rows_c1zzzzzzz2 [scores_inline]

# A dispatch that tries a second candidate keeps the losers' bindings buffer
# for the next dispatch instead of freeing it. The mutation frees it again, and
# the interpreted row counts the allocations that come back.
spare_binds = row
  "a dispatch that frees its losers' bindings"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_dispatch_frees_its_spare_binds")
  release

rows_c1zzzzzzz0 = list/concat rows_c1zzzzzzz1 [spare_binds]

# A string value of up to fifteen bytes is held inside the value, which stays
# 32 bytes. The mutation sends every string to the heap again, and the
# interpreted row counts the allocations and copies that come back.
short_strings = row
  "a short string that allocates"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_string_allocates")
  release

rows_c1zzzzzzy9 = list/concat rows_c1zzzzzzz0 [short_strings]

# A local whose place is kept is answered before the interpreter builds the
# frame every other expression needs (2026-10-08). The mutation sends every
# name through that frame again, and the interpreted row is the witness.
front_door = row
  "a name read through the whole node"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_name_read_through_the_whole_node")
  release

rows_c1zzzzzzy8 = list/concat rows_c1zzzzzzy9 [front_door]

# A global name whose slot holds a function reference is answered from a table
# of fixed values before `eval_node` builds its frame (2026-10-08). The
# mutation leaves the table without its function references, and the
# interpreted row is the witness.
fixed_globals = row
  "a fixed global read through the whole node"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_fixed_global_read_through_the_whole_node")
  release

rows_c1zzzzzzy7 = list/concat rows_c1zzzzzzy8 [fixed_globals]

rows_c1zzzzzzz3 = list/concat rows_c1zzzzzzz4 [reached_groups]

# A line's tokens are moved into a vector of their exact length, from a
# buffer kept between lines (2026-10-08). The mutation hands the buffer itself
# over, so every line grows from empty by doubling; the allocation vein is the
# witness.
line_exact = row
  "a line of tokens grown by doubling"
  false
  "sh scripts/gates/compile_allocs.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_line_of_tokens_grown_by_doubling")
  release

# The alias pass indexes only the sites a synthetic declaration stands at
# (2026-10-08). The mutation indexes every declaration again, which changes no
# alias. The witness is the allocation count: once the syntax tree shrank, the
# front end's peak is set where the index is no longer alive, and a shard on
# CI found the peak blind to it.
alias_sites = row
  "every declaration indexed for its alias"
  false
  "sh scripts/gates/compile_allocs.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "every_declaration_indexed_for_its_alias")
  release

# A guard's statements sit behind a box, so `Guard` is no longer the variant
# that sets the size of every `Expr` (2026-10-08). The mutation holds them
# inline again; every expression grows by eight bytes and the front end's peak
# is the witness.
guard_rest = row
  "a guard's statements held in every expression"
  false
  "sh scripts/gates/compile_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_guards_statements_held_in_every_expression")
  release

rows_c1zzzzzzy5 = list/concat rows_c1zzzzzzy7 [line_exact alias_sites]

# On a 64-bit target `Expr` keeps its tag in a byte of its own (2026-10-08).
# The mutation leaves the tag to the compiler, which hides it in a field of a
# 48-byte enum; every walk over the program decodes it, and the entry row is
# the witness.
expr_tag = row
  "an expression's tag hidden in its fields"
  false
  "sh scripts/gates/entry_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_expressions_tag_hidden_in_its_fields")
  release

rows_c1zzzzzzy6 = list/concat rows_c1zzzzzzy5 [guard_rest expr_tag]

# The interpreter's callee and frame tables hold 256 slots each, sized by the
# run's peak as well as its speed (2026-10-08). The mutation gives the callees
# 1,024 again, and the interpreted run's peak is the witness.
callee_slots = row
  "the callee cache sized for speed"
  false
  "sh scripts/gates/interp_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_callee_cache_sized_for_speed")
  release

rows_c1zzzzzzy4 = list/concat rows_c1zzzzzzy6 [callee_slots]

# A group of one arm whose parameters are bare names is bound without a
# candidate loop: it wins whenever no argument is a failure, and nothing reads
# its score (2026-10-09). The mutation scores it like a crowd again, and the
# interpreted run's instruction count is the witness.
lone_arm = row
  "a lone arm scored like its rivals"
  false
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_lone_arm_scored_like_its_rivals")
  release

# A candidate that takes the lead swaps two fixed slots of buffers, where it
# used to move an 80-byte tuple through an `Option` (2026-10-09). The
# mutation chooses the score's slot at run time, which is what an index
# between the slots cost, and the same witness counts it.
leader_slots = row
  "a leader's slot chosen at run time"
  false
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_leaders_slot_chosen_at_run_time")
  release

rows_c1zzzzzzy3 = list/concat rows_c1zzzzzzye [lone_arm leader_slots]

# A built binary run directly reports a recursion deeper than its stack the
