# overflow aborts the run.
test_stack = row
  "a test run on the main stack"
  true
  "cargo test --release --test test_verb"
  "specs (unit, golden, differential)"
  (breaking "a_test_run_on_the_main_stack")
  no_setup

rows_c1zzzzzzy0 = list/concat rows_c1zzzzzzy1 [test_stack]

# A record goes back to its caller in two words only when every arm of its
