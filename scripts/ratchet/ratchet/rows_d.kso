  no_setup

rows_dq36 = list/concat rows_dq35 [field_join template_hold]

# The browser rows count the wasm instructions a module executes rather than
# wasmi's fuel, which charges a loop for every arm of a dispatch on every pass
# (2026-10-23). The mutation lets a counted run go on through a `br_table`, and
# the hand-counted loop in tests/browser_cost.rs is the witness.
hand_count = "the_count_is_every_instruction_control_reached"

run_through_dispatch = row
  "a counted run that goes on through a br_table"
  true
  "cargo test --release --test browser_cost {hand_count}"
  "specs (unit, golden, differential)"
  (breaking "a_counted_run_that_goes_on_through_a_br_table")
  no_setup

rows_dq37 = list/concat rows_dq36 [run_through_dispatch]

# The tab's compiler exports a memcmp that compares eight bytes a pass
# (2026-10-23). The mutation renames it, so the wasm build links
# compiler-builtins' byte loop again and the browser compile row is the
# witness.
word_compare = row
  "a byte loop compares in the tab"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_byte_loop_compares_in_the_tab")
  release

rows_dq38 = list/concat rows_dq37 [word_compare]

# The tab's translator finds a switch line by its `=` rather than by a
# substring searcher built for every line (2026-10-23). The mutation builds
# the searcher again, and the browser compile row is the witness.
switch_line = row
  "a searcher built for every line the tab translates"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_searcher_built_for_every_line_the_tab_translates")
  release

rows_dq39 = list/concat rows_dq38 [switch_line]

# The narrowing reads whether the module defines the closure-jump twin off
# the define lines it walks (2026-10-23). One mutation searches the whole
# module for it again, and the browser compile row is the witness; the other
# stops collecting lambdas, and the narrowing's own spec is.
twin_search = row
  "the whole module searched for the closure jump"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_whole_module_searched_for_the_closure_jump")
  release

lambda_test = "a_lambda_keeps_the_convention_where_a_closure_jump_can_reach_it"

lambda_narrowed = row
  "a lambda narrowed beside a closure jump"
  true
  "cargo test --release --lib {lambda_test}"
  "specs (unit, golden, differential)"
  (breaking "a_lambda_narrowed_beside_a_closure_jump")
  no_setup

rows_dq40 = list/concat rows_dq39 [twin_search lambda_narrowed]

# The tab's compiler finds `@sN` by memchr on `@` and ends each IR line eight
# bytes a pass (2026-10-23); each mutation brings a searcher back, and the
# browser compile row is the witness. The word compare and the byte search
# share a fuzzer, and each has a mutation that the fuzzer catches.
string_names = row
  "a string name found by a two-byte searcher"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_string_name_found_by_a_two_byte_searcher")
  release

line_search = row
  "a line found by a searcher in the tab"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_line_found_by_a_searcher_in_the_tab")
  release

compare_fuzz = "the_word_compare_agrees_with_bytes"

wrong_end = row
  "a word compare that reads the wrong end"
  true
  "cargo test --release --test {compare_fuzz}"
  "specs (unit, golden, differential)"
  (breaking "a_word_compare_that_reads_the_wrong_end")
  no_setup

borrow = row
  "a byte search that trusts a borrow"
  true
  "cargo test --release --test {compare_fuzz}"
  "specs (unit, golden, differential)"
  (breaking "a_byte_search_that_trusts_a_borrow")
  no_setup

rows_dq41a = list/concat rows_dq40 [string_names line_search]

rows_dq41 = list/concat rows_dq41a [wrong_end borrow]

# The emitter asks of every line it writes whether it is a stack slot, and
# finds the line's first space with a byte loop (2026-10-23). The mutation
# puts `find` back, and the browser compile row is the witness.
stack_slot = row
  "a stack slot found by a searcher"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_stack_slot_found_by_a_searcher")
  release

rows_dq42 = list/concat rows_dq41 [stack_slot]

# The wasm build keeps no allocation tally the tab never reads (2026-10-23).
# The mutation keeps it again, and the browser compile row is the witness.
tab_tally = row
  "a tally the tab never reads"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_tally_the_tab_never_reads")
  release

rows_dq43 = list/concat rows_dq42 [tab_tally]

# The tab's compile, second round (2026-10-23): a numbered name read without
# checking it, a rewritten body not validated again, each `@` found eight bytes
# a pass, the module handed over in pieces and what the walk left out let go
# before emitting. Each mutation undoes one, and the browser compile rows are
# the witness.
checked_name = row
  "a numbered name checked on every read"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_numbered_name_checked_on_every_read")
  release

validated_body = row
  "a rewritten body validated again"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_rewritten_body_validated_again")
  release

at_searcher = row
  "an at sign found by a searcher"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_at_sign_found_by_a_searcher")
  release

joined_module = row
  "a module joined for the tab"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_module_joined_for_the_tab")
  release

held_left_out = row
  "what the tab left out held while it emits"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "what_the_tab_left_out_held_while_it_emits")
  release

pieces_test = "the_interp_corpus_answers_through_the_translator"

early_piece = row
  "a piece let go before its functions"
  true
  "cargo test --release --test ir_to_wasm {pieces_test}"
  "specs (unit, golden, differential)"
  (breaking "a_piece_let_go_before_its_functions")
  no_setup

rows_dq44a = list/concat rows_dq43 [checked_name validated_body at_searcher]

rows_dq44b = list/concat rows_dq44a [joined_module held_left_out]

kept_room = row
  "the tab's syntax kept with its room"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_tabs_syntax_kept_with_its_room")
  release

narrowing_word = row
  "a narrowing that searches by the word"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_narrowing_that_searches_by_the_word")
  release

anchored_test = "a_line_found_by_one_byte_is_a_line_found_by_the_word"

late_line = row
  "a line found one byte late"
  true
  "cargo test --release --lib {anchored_test}"
  "specs (unit, golden, differential)"
  (breaking "a_line_found_one_byte_late")
  no_setup

rows_dq44c = list/concat rows_dq44b [early_piece kept_room]

two_byte_borrow = row
  "a two-byte search that trusts a borrow"
  true
  "cargo test --release --test {compare_fuzz}"
  "specs (unit, golden, differential)"
  (breaking "a_two_byte_search_that_trusts_a_borrow")
  no_setup

rows_dq44d = list/concat rows_dq44c [narrowing_word late_line]

rows_dq44 = list/concat rows_dq44d [two_byte_borrow]

# A float that passes at the guessed place count takes the zeros off its scaled
# decimal to reach the fewest places, instead of trying each place below. The
# mutation puts the tries back, and the work vein reads runbench heavier.
float_walk = row
  "a float walked down by tries"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_float_walked_down_by_tries")
  benches

rows_dq45 = list/concat rows_dq44 [float_walk]

# welfare_rescore weighs each phase by the share the run program's header
# measured for it (2026-10-24). The mutation gives every phase one share, and
# the uneven fixture in the reconstruction spec rebuilds to the wrong count.
splice_test = "the_reconstruction_refuses_a_splice_that_moved"

one_share = row
  "every phase weighted by one share"
  true
  "cargo test --release --test {splice_test}"
  "specs (unit, golden, differential)"
  (breaking "every_phase_weighted_by_one_share")
  no_setup

rows_dq46 = list/concat rows_dq45 [one_share]

# A body built for the dev tier or the tab writes no `llvm.assume` and no
# compare feeding one, since neither build is optimized (2026-10-24). The
# mutation writes them for every body, and the browser compile row reads
# heavier.
no_optimizer = row
  "an assume written for no optimizer"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_assume_written_for_no_optimizer")
  release

rows_dq47 = list/concat rows_dq46 [no_optimizer]

# The tab's module keeps its tail calls as written, since its translator
# reads no calling convention (2026-10-24). The mutation narrows them as a
# native module is narrowed, and the browser compile row reads heavier.
tab_narrowing = row
  "the tab narrowing its tail calls"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_tab_narrowing_its_tail_calls")
  release

rows_dq48 = list/concat rows_dq47 [tab_narrowing]

# A short float's text is written right to left in one pass over its scaled
# decimal, the point placed on the way (2026-10-24). The mutation splits the
# whole part off by a division again, and the work vein reads runbench
# heavier.
float_one_pass = row
  "a short float written in two parts"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_float_written_in_two_parts")
  benches

rows_dq49 = list/concat rows_dq48 [float_one_pass]

# The module writer reads every piece's calls and line-ending symbols in one
# pass over its ats (2026-10-24). The mutation scans each piece again for the
# endings, and the browser compile row reads heavier.
one_scan = row
  "the module scanned twice for its symbols"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_module_scanned_twice_for_its_symbols")
  release

rows_dq50 = list/concat rows_dq49 [one_scan]

# The strings the body names are marked in the same pass, and only the type
# tables are scanned for them after (2026-10-24). The mutation scans the body
# for them again, and the browser compile row reads heavier.
strings_in_scan = row
  "the strings found by a scan of their own"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_strings_found_by_a_scan_of_their_own")
  release

rows_dq51 = list/concat rows_dq50 [strings_in_scan]

# The translator answers a pair of scalar leaves, every %KValue, without a
# vector (2026-10-24). The mutation lists them in one again, and the browser
# compile row reads heavier.
pair_leaves = row
  "a pair of leaves listed in a vector"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_pair_of_leaves_listed_in_a_vector")
  release

rows_dq52 = list/concat rows_dq51 [pair_leaves]

# The tab's bcmp answers equality alone, from a body of its own (2026-10-24).
# The mutation makes it the ordering compare again, and the browser compile row
# reads heavier.
equal_bcmp = row
  "a bcmp that orders its bytes"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_bcmp_that_orders_its_bytes")
  release

rows_dq53 = list/concat rows_dq52 [equal_bcmp]

# queries_named passes over a name no query starts like before hashing it
# (2026-10-24). The mutation admits every byte, and the browser compile row
# reads heavier.
query_leads = row
  "every name hashed whatever it starts with"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "every_name_hashed_whatever_it_starts_with")
  release

rows_dq54 = list/concat rows_dq53 [query_leads]

# The string arm of an index lives in the release build's LTO unit and is
# inlined into the program's walks over text (2026-10-24). The mutation takes
# its always_inline away, and the work vein reads runbench heavier.
index_inline = row
  "a string index called out of line"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_string_index_called_out_of_line")
  benches

rows_dq55 = list/concat rows_dq54 [index_inline]

# The word-at-a-time number span joins the string index in the LTO unit, so
# the decoder's walk scans a number without a call (2026-10-24). The mutation
# takes its always_inline away.
number_span_inline = row
  "a number span called out of line"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_number_span_called_out_of_line")
  benches

rows_dq56 = list/concat rows_dq55 [number_span_inline]

# The int and float slice parsers join them, so the decoder reads a number
# without a call (2026-10-24). The mutation takes both always_inlines away.
slice_parsers_inline = row
  "the slice parsers called out of line"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_slice_parsers_called_out_of_line")
  benches

rows_dq57 = list/concat rows_dq56 [slice_parsers_inline]

# The empty list and map join them, so the decoder opens an array or an
# object without a call (2026-10-24). The mutation puts noinline in place of
# both always_inlines.
empty_inline = row
  "the empty collections called out of line"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_empty_collections_called_out_of_line")
  benches

rows_dq58 = list/concat rows_dq57 [empty_inline]

# The in-place byte append asks for room before it reads the buffer's header,
# and the separate test for a borrowed view is gone (2026-10-24). The mutation
# puts that test back in the twin the json encoder's separators go through.
room_first = row
  "a byte append that asks ownership first"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_byte_append_asks_ownership_first")
  benches

rows_dq59 = list/concat rows_dq58 [room_first]

# The prune finds each line of the emitted IR a word at a time (2026-10-24).
# The mutation puts the per-line `str::find` back, a memchr call a line.
prune_lines = row
  "the prune splits its lines with memchr"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_prune_splits_its_lines_with_memchr")
  release

# The tab's translator trims its lines as ASCII (2026-10-24). The mutation
# puts `str::trim` back on both per-line trims.
ascii_trim = row
  "the translator trims unicode whitespace"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_translator_trims_unicode_whitespace")
  release

rows_dq60 = list/concat rows_dq59 [prune_lines ascii_trim]

# The lexer finds each line of a source a word at a time (2026-10-24). The
# mutation puts `str::lines` back, a memchr call a line.
lex_lines = row
  "the lexer splits its lines with str::lines"
  true
  (gating "compile_instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_lexer_splits_its_lines_with_str_lines")
  release

# The lexer answers both openers for a line with no quote and no `#` from one
# scan a word at a time (2026-10-24). The mutation sends every line through
# the two byte-at-a-time scans.
lex_openers = row
  "the lexer scans every line for its openers byte by byte"
  true
  (gating "compile_instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_lexer_scans_every_line_for_its_openers")
  release

rows_dq61 = list/concat rows_dq60 [lex_lines lex_openers]

rows_d = list/concat rows_dq61 [itself]
