own_group_interp = row
  "an imported type over a declared group"
  true
  "cargo test --release --test play_verb"
  "specs (unit, golden, differential)"
  (breaking "an_imported_type_over_a_declared_group")
  no_setup

rows_dq5 = list/concat rows_dq4 [own_group_interp]

# `&`, `|` and `^` mixed without parentheses are refused. The mutation lets the
