import "std/list"

# Every workflow installs the rustc its goldens were measured under, named
# once at the top of the file, rather than whatever is stable that day.
# Unpinned, the runner moved to 1.99.0 after 2026-10-01 and every gate that
# names rustc refused (2026-10-04).
toolchain_pinned = row
  "a job that installs whatever rustc is stable"
  true
  "cargo test --release --test the_toolchain_is_pinned_to_the_rows"
  "specs (unit, golden, differential)"
  (breaking "a_job_takes_whatever_rustc_is_stable")
  no_setup

# A checkout builds with that same rustc, so a reading taken by hand is a
# reading of CI's toolchain. Two playground sizes were published from a
# container's default 1.94.1 before rust-toolchain.toml existed (2026-10-06).
checkout_pinned = row
  "a checkout that builds with whatever rustc the host has"
  true
  "cargo test --release --test the_toolchain_is_pinned_to_the_rows"
  "specs (unit, golden, differential)"
  (breaking "the_checkout_builds_with_its_own_rustc")
  no_setup

rows_d1zzzzzzzf = [toolchain_pinned checkout_pinned]

# `list/tie` fills each key's cell with its node once every node is made,
# which is what turns the references the maker stored into a cycle
# (2026-10-04).
tie_fills = row
  "a tie that never fills its cells"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_that_never_fills_its_cells")
  release

rows_d1zzzzzzze = list/concat rows_d1zzzzzzzf [tie_fills]

# A tie's reference goes into a constructor's field and nowhere else, and a
# literal link to an id the list does not hold is refused (2026-10-04).
tie_check = row
  "a tie reference read anywhere"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_tie_reference_read_anywhere")
  release

# A list or map literal written as a field may hold a tie's references
# (2026-10-10).
tie_list = row
  "a tie list read as a reference"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_list_read_as_a_reference")
  release

# A field may hold a list of references built from data, written
# `list/to_list (list/map xs ref)`, and `push` stores a cell still being made
# on both engines (2026-10-11).
tie_mapped = row
  "a tie map of references refused"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_tie_map_of_references_refused")
  release

tie_push_interp = row
  "an interpreted push that forces a tie cell"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_interpreted_push_forces_a_tie_cell")
  release

tie_push_native = row
  "a native push that forces a tie cell"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_push_forces_a_tie_cell")
  release

tie_rows = [tie_check tie_list tie_mapped tie_push_interp tie_push_native]

rows_d1zzzzzzzd = list/concat rows_d1zzzzzzze tie_rows

# A record constructor handed over as a function lowers to the lambda that
# calls it on native, as the interpreter treats it (2026-10-10, lox F20).
ctor_value = row
  "a constructor refused as a value"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_constructor_refused_as_a_value")
  release

# Native `tie` rewrites every field holding one of its cells to hold the node
# before the cells go back to the free list (2026-10-05).
tie_resolves = row
  "a native tie that frees cells still in its graph"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_that_frees_cells_still_in_its_graph")
  release

rows_d1zzzzzzzc = list/concat rows_d1zzzzzzzd [tie_resolves ctor_value]

# The interpreter rewrites the fields holding a tie's cells to hold the nodes,
# as native does; a `ref` names its tie by serial, so one called after its tie
# returned is refused on both engines; and native's stack of open ties grows
# rather than stopping at 256 (2026-10-05).
tie_interp_resolves = row
  "an interpreter tie that leaves cells in its graph"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "an_interpreter_tie_that_leaves_cells_in_its_graph")
  release

tie_serial = row
  "a tie ref that answers any open tie"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_tie_ref_that_answers_any_open_tie")
  release

tie_native_serial = row
  "a native tie ref that answers any open tie"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_ref_that_answers_any_open_tie")
  release

tie_native_depth = row
  "a native tie stack that stops at 256"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_native_tie_stack_that_stops_at_256")
  release

tie_fixes = [tie_interp_resolves tie_serial tie_native_serial tie_native_depth]

rows_d1zzzzzzza = list/concat rows_d1zzzzzzzc tie_fixes

# The release link unswitches a loop on a test of a value the loop does not
# change, such as the overflow flag of `k * 31` in the escape loop
# (2026-10-07). The mutation takes the pass out of the link's pipeline.
loop_unswitch = row
  "a release link that tests an invariant inside its loop"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_that_tests_an_invariant_inside_its_loop")
  benchmarks

rows_d1zzzzzzz9 = list/concat rows_d1zzzzzzza [loop_unswitch]

# The release link runs correlated propagation after each jump-threading and
# early-cse<memssa> before the first (2026-10-07). Each mutation takes its pass
# out of the link's pipeline.
link_correlated = row
  "a release link without correlated propagation"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_without_correlated_propagation")
  benchmarks

link_early_cse = row
  "a release link without early-cse"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_release_link_without_early_cse")
  benchmarks

rows_d1zzzzzzz8 = list/concat rows_d1zzzzzzz9 [link_correlated link_early_cse]

# A local reference keeps the frame and slot its binding sat in, and reads
# that place on every later run (2026-10-07). The mutation keeps plain local,
# so every reference walks the frames again.
local_place = row
  "a local found by walking the frames"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_local_found_by_walking")
  release

rows_d1zzzzzzz7 = list/concat rows_d1zzzzzzz8 [local_place]

# The tab's compiler keeps a free list for each size of small block and hands
# blocks out again before dlmalloc is asked (2026-10-08). The mutation sends
# every block to dlmalloc, so the browser compile row is the witness.
small_blocks = row
  "small blocks left to dlmalloc"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "small_blocks_left_to_dlmalloc")
  release

rows_d1zzzzzzz6 = list/concat rows_d1zzzzzzz7 [small_blocks]

# The emitter writes each body line with three pushes rather than through
# `writeln!` (2026-10-08). The mutation sends the line through the formatter
# again, so the emit row is the witness.
emitted_lines = row
  "emitted lines written through the formatter"
  true
  emit_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "emitted_lines_through_fmt")
  release

rows_d1zzzzzzz5 = list/concat rows_d1zzzzzzz6 [emitted_lines]

# A dispatch lets go of what is left in its argument vector through
# `release`, which skips `Value`'s drop for the variants that own nothing
# (2026-10-08). The mutation drops every one again, so the interpreted row is
# the witness.
arguments_released = row
  "argument placeholders dropped one by one"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "arguments_dropped_one_by_one")
  release

rows_d1zzzzzzz4 = list/concat rows_d1zzzzzzz5 [arguments_released]

# The tab emits only the groups its entry reaches, by the names the bodies
# mention, and emits again with nothing skipped when the module names a group
# it left out (2026-10-08). The mutation emits every group, so the browser
# compile row is the witness.
reached_groups = row
  "the tab emitting every group"
  true
  (gating "browser_cost")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_tab_emits_every_group")
  release

# The tab's walk leaves groups out of the program before any analysis reads
# it, and the emitter asks about some groups by name rather than calling them.
# A question about a left-out group has to send the program back whole. The
# mutation stops noting the question, and the unit spec that leaves a `+` arm
# out says nothing saw it.
left_out_asked = row
  "a question about a group the tab left out, answered unseen"
  true
  "cargo test --release --lib a_question_about_a_left_out_operator_is_noticed"
  "specs (unit, golden, differential)"
  (breaking "a_question_about_a_left_out_group_goes_unseen")
  no_setup

rows_d1zzzzzzz2 = list/concat rows_d1zzzzzzz3 [left_out_asked]

# A dispatch ranks its candidates into two `Score`s held on the stack, twelve
# ranks inline each (2026-10-08). The mutation gives each a heap buffer at the
# start of every dispatch again, and the interpreted row is the witness.
scores_inline = row
  "a dispatch that allocates its score"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_dispatch_allocates_its_score")
  release

rows_d1zzzzzzz1 = list/concat rows_d1zzzzzzz2 [scores_inline]

# A dispatch that tries a second candidate keeps the losers' bindings buffer
# for the next dispatch instead of freeing it. The mutation frees it again, and
# the interpreted row counts the allocations that come back.
spare_binds = row
  "a dispatch that frees its losers' bindings"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_dispatch_frees_its_spare_binds")
  release

rows_d1zzzzzzz0 = list/concat rows_d1zzzzzzz1 [spare_binds]

# A string value of up to fifteen bytes is held inside the value, which stays
# 32 bytes. The mutation sends every string to the heap again, and the
# interpreted row counts the allocations and copies that come back.
short_strings = row
  "a short string that allocates"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_string_allocates")
  release

rows_d1zzzzzzy9 = list/concat rows_d1zzzzzzz0 [short_strings]

# A local whose place is kept is answered before the interpreter builds the
# frame every other expression needs (2026-10-08). The mutation sends every
# name through that frame again, and the interpreted row is the witness.
front_door = row
  "a name read through the whole node"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_name_read_through_the_whole_node")
  release

rows_d1zzzzzzy8 = list/concat rows_d1zzzzzzy9 [front_door]

# A global name whose slot holds a function reference is answered from a table
# of fixed values before `eval_node` builds its frame (2026-10-08). The
# mutation leaves the table without its function references, and the
# interpreted row is the witness.
fixed_globals = row
  "a fixed global read through the whole node"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_fixed_global_read_through_the_whole_node")
  release

rows_d1zzzzzzy7 = list/concat rows_d1zzzzzzy8 [fixed_globals]

rows_d1zzzzzzz3 = list/concat rows_d1zzzzzzz4 [reached_groups]

# A line's tokens are moved into a vector of their exact length, from a
# buffer kept between lines (2026-10-08). The mutation hands the buffer itself
# over, so every line grows from empty by doubling; the allocation vein is the
# witness.
line_exact = row
  "a line of tokens grown by doubling"
  false
  "sh scripts/gates/compile_allocs.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_line_of_tokens_grown_by_doubling")
  release

# The alias pass indexes only the sites a synthetic declaration stands at
# (2026-10-08). The mutation indexes every declaration again, which changes no
# alias. The witness is the allocation count: once the syntax tree shrank, the
# front end's peak is set where the index is no longer alive, and a shard on
# CI found the peak blind to it.
alias_sites = row
  "every declaration indexed for its alias"
  false
  "sh scripts/gates/compile_allocs.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "every_declaration_indexed_for_its_alias")
  release

# A guard's statements sit behind a box, so `Guard` is no longer the variant
# that sets the size of every `Expr` (2026-10-08). The mutation holds them
# inline again; every expression grows by eight bytes and the front end's peak
# is the witness.
guard_rest = row
  "a guard's statements held in every expression"
  false
  "sh scripts/gates/compile_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_guards_statements_held_in_every_expression")
  release

rows_d1zzzzzzy5 = list/concat rows_d1zzzzzzy7 [line_exact alias_sites]

# On a 64-bit target `Expr` keeps its tag in a byte of its own (2026-10-08).
# The mutation leaves the tag to the compiler, which hides it in a field of a
# 48-byte enum; every walk over the program decodes it, and the entry row is
# the witness.
expr_tag = row
  "an expression's tag hidden in its fields"
  false
  "sh scripts/gates/entry_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_expressions_tag_hidden_in_its_fields")
  release

rows_d1zzzzzzy6 = list/concat rows_d1zzzzzzy5 [guard_rest expr_tag]

# The interpreter's callee and frame tables hold 256 slots each, sized by the
# run's peak as well as its speed (2026-10-08). The mutation gives the callees
# 1,024 again, and the interpreted run's peak is the witness.
callee_slots = row
  "the callee cache sized for speed"
  false
  "sh scripts/gates/interp_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_callee_cache_sized_for_speed")
  release

rows_d1zzzzzzy4 = list/concat rows_d1zzzzzzy6 [callee_slots]

# A group of one arm whose parameters are bare names is bound without a
# candidate loop: it wins whenever no argument is a failure, and nothing reads
# its score (2026-10-09). The mutation scores it like a crowd again, and the
# interpreted run's instruction count is the witness.
lone_arm = row
  "a lone arm scored like its rivals"
  false
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_lone_arm_scored_like_its_rivals")
  release

# A candidate that takes the lead swaps two fixed slots of buffers, where it
# used to move an 80-byte tuple through an `Option` (2026-10-09). The
# mutation chooses the score's slot at run time, which is what an index
# between the slots cost, and the same witness counts it.
leader_slots = row
  "a leader's slot chosen at run time"
  false
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_leaders_slot_chosen_at_run_time")
  release

rows_d1zzzzzzy3 = list/concat rows_d1zzzzzzye [lone_arm leader_slots]

# A built binary run directly reports a recursion deeper than its stack the
# way the interpreter does (2026-10-12). The mutation leaves the stack
# unwatched, and the binary dies by the bare signal.
stack_watch = row
  "a binary that does not watch its stack"
  true
  "cargo test --release --test a_built_binary_names_its_stack_overflow"
  "specs (unit, golden, differential)"
  (breaking "a_binary_that_does_not_watch_its_stack")
  release

rows_d1zzzzzzye = list/concat rows_d1zzzzzzy4 [stack_watch]

# A push, put or append the analysis proved in place writes through the
# container's pointer and hands back the `Rc` it was given, where it used to
# take the contents out and box them afresh (2026-10-09). The mutation boxes
# the pushed list again, and the shared-seed spec's per-lap allocation count
# is the witness.
kept_box = row
  "a write in place that boxes its container afresh"
  true
  "cargo test --release --test a_shared_seed_is_copied_once"
  "specs (unit, golden, differential)"
  (breaking "a_write_in_place_boxes_afresh")
  no_setup

rows_d1zzzzzzy2 = list/concat rows_d1zzzzzzy3 [kept_box]

# A runtime diagnostic names an err it was handed (2026-10-12). The mutation
# renders it the way a program does, which hands the err back unrendered,
# and native crashes and reports running out of stack.
err_shown = row
  "a diagnostic handed an unrendered err"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_diagnostic_handed_an_unrendered_err")
  release

rows_d1zzzzzzyd = list/concat rows_d1zzzzzzy2 [err_shown]

# A native build emits only the groups its entry reaches, the walk the tab
# has made since 2026-10-08 (2026-10-09). The mutation empties the walk's
# answer, every imported group is emitted and pruned afterwards, and the emit
# row is the witness.
native_reached = row
  "a native build emitting every group"
  true
  emit_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_native_build_emits_every_group")
  release

rows_d1zzzzzzy1 = list/concat rows_d1zzzzzzyd [native_reached]

# kanso test runs its tests on the deep thread `run --interp` uses, so a test
# that recurses too far fails with the depth diagnostic and the rest still
# report (2026-10-12). The mutation gives the thread 8 MiB, and Rust's own
# overflow aborts the run.
test_stack = row
  "a test run on the main stack"
  true
  "cargo test --release --test test_verb"
  "specs (unit, golden, differential)"
  (breaking "a_test_run_on_the_main_stack")
  no_setup

rows_d1zzzzzzy0 = list/concat rows_d1zzzzzzy1 [test_stack]

# A record goes back to its caller in two words only when every arm of its
# group answers that record or a failure (2026-10-09). The mutation skips the
# check, and the two micro fixtures built from `list/take` print the wrong
# thing or fail.
parsed_arms = row
  "a group answering other values by value"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_group_answering_other_values_goes_by_value")
  no_setup

rows_d1zzzzzzx9 = list/concat rows_d1zzzzzzy0 [parsed_arms]

# A record on either side of an operator goes to the program's own arms, so
# inference adds what they answer (2026-10-12). The mutation reads the
# operator as arithmetic alone, release assumes a float where a record comes
# back, and the micro fixture prints its record through the number arm.
op_arms_answer = row
  "an operator answering arithmetic alone"
  true
  "cargo test --release --test golden micro_corpus_survives_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "an_operator_answering_arithmetic_alone")
  release

rows_d1zzzzzzx8 = list/concat rows_d1zzzzzzx9 [op_arms_answer]

# An operator's arms stay boxed now that inference widens their parameters
# (2026-10-12). The mutation lets a proven-int parameter go unboxed, and the
# wasm translator refuses four operator fixtures.
op_arms_boxed = row
  "an operator arm given an unboxed int"
  true
  "cargo test --release --test ir_to_wasm"
  "specs (unit, golden, differential)"
  (breaking "an_operator_arm_given_an_unboxed_int")
  release

rows_d1zzzzzzx7 = list/concat rows_d1zzzzzzx8 [op_arms_boxed]

# A file of a several-file module names only what the module declares and
# what its own imports bring. The mutation lets every file see every
# sibling's imports, and a file calling `fold` with no import of std/list
# checks clean.
sibling_import = row
  "a sibling's import seen from every file"
  true
  "cargo test --release --test errors_module"
  "specs (unit, golden, differential)"
  (breaking "a_sibling_import_seen_from_every_file")
  no_setup

rows_d1zzzzzzw9 = list/concat rows_d1zzzzzzx7 [sibling_import]

# A reader that stops early ends every engine by SIGPIPE, quietly
# (2026-10-12). The mutation leaves the signal ignored, and the interpreter
# panics on the closed pipe.
pipe_quiet = row
  "a closed pipe met as an error"
  true
  "cargo test --release --test a_closed_pipe_stops_every_engine_quietly"
  "specs (unit, golden, differential)"
  (breaking "a_closed_pipe_met_as_an_error")
  release

rows_d1zzzzzzx6 = list/concat rows_d1zzzzzzw9 [pipe_quiet]

# A native program's stdout reaches its reader before it writes to stderr,
# waits or stops (2026-10-12). The mutation leaves stdout in its buffer.
stdout_settled = row
  "stdout left in its buffer"
  true
  "cargo test --release --test stdout_reaches_its_reader"
  "specs (unit, golden, differential)"
  (breaking "stdout_left_in_its_buffer")
  release

rows_d1zzzzzzx5 = list/concat rows_d1zzzzzzx6 [stdout_settled]

# A lambda called in tail position costs no stack on any engine
# (2026-10-12). The first mutation has the interpreter call it as a nested
# call, the second has native call it without the jump; either way the
# continuation-passing fixture runs out of stack.
lambda_nested = row
  "a lambda called as a nested call"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_lambda_called_as_a_nested_call")
  no_setup

rows_d1zzzzzzx4 = list/concat rows_d1zzzzzzx5 [lambda_nested]

lambda_jump = row
  "a lambda called without a jump"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_lambda_called_without_a_jump")
  no_setup

rows_d1zzzzzzx3 = list/concat rows_d1zzzzzzx4 [lambda_jump]

# A value carries the arms its owner wrote into a library that never imported
# the owner. The mutation lets no call travel, and the library's `area c` is
# an unknown name again.
arm_travels = row
  "an arm left behind by its value"
  true
  "cargo test --release --test arms_travel"
  "specs (unit, golden, differential)"
  (breaking "an_arm_left_behind_by_its_value")
  no_setup

rows_d1zzzzzzw8 = list/concat rows_d1zzzzzzx3 [arm_travels]

# A module that writes a name for its own type keeps that arm and takes the
# owners' arms of every other shape. The mutation keeps its calls off the
# traveling path, and a circle handed to it finds no arm.
local_shade = row
  "a local arm that shadows every shape"
  true
  "cargo test --release --test arms_travel"
  "specs (unit, golden, differential)"
  (breaking "a_local_arm_shadows_every_shape")
  no_setup

rows_d1zzzzzzw7 = list/concat rows_d1zzzzzzw8 [local_shade]

# A list held in a record and pushed onto through the record is written in
# place once the record is handed over whole and the field is alone. The
# mutation refuses every field read, and the mem corpus's record fixture goes
# from 73 allocations to tens of thousands.
field_in_place = row
  "a record field copied on every push"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_record_field_copied_every_push")
  no_setup

rows_d1zzzzzzv3bb = list/concat rows_d1zzzzzzw7 [field_in_place]

# A lazy sequence handed where a builtin takes a list is refused at check
# (2026-10-13). The mutation deletes the one call that asks, and the error
# fixture's two refusals go missing.
lazy_as_list = row
  "a lazy sequence where a list goes checks clean"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_lazy_sequence_where_a_list_goes_checks_clean")
  no_setup

rows_dq1 = list/concat rows_d1zzzzzzv3bb [lazy_as_list]

# A type the program declares shadows a builtin of that name (2026-10-12).
# The mutation drops the checker's arity guard, and `type run` built with
# `run 1 2 3` is refused with the builtin's count.
own_type_count = row
  "a builtin count over a declared type"
  true
  "cargo test --release --test play_verb"
  "specs (unit, golden, differential)"
  (breaking "a_builtin_count_over_a_declared_type")
  no_setup

rows_dq2 = list/concat rows_dq1 [own_type_count]

# The checker's literal check lets a declared type shadow a builtin too. The
# mutation drops it, and `run 1 2 3` is refused for not starting with a string.
own_type_demand = row
  "a builtin demand over a declared type"
  true
  "cargo test --release --test play_verb"
  "specs (unit, golden, differential)"
  (breaking "a_builtin_demand_over_a_declared_type")
  no_setup

rows_dq3 = list/concat rows_dq2 [own_type_demand]

# Native code lets a declared type shadow a builtin. The mutation drops it,
# and the play file's build stops on the builtin's count.
own_type_native = row
  "a native builtin over a declared type"
  true
  "cargo test --release --test play_verb"
  "specs (unit, golden, differential)"
  (breaking "a_native_builtin_over_a_declared_type")
  no_setup

rows_dq4 = list/concat rows_dq3 [own_type_native]

# The interpreter calls a declared group before an imported type of the same
