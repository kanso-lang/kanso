# ONE ROW, ONE VALUE, ruled 2026-09-05. The compile row was keyed by silicon
# and could pin a pair; both are retired, and the shape they can come back in
# is a second number appended to the golden's line by a run that disagreed.
# That is the reproduction failure this vein now halts on rather than records,
# so it is the thing to watch. It cannot be watched on the gate itself — the
# gate's own answer costs a callgrind run over the whole front end and refuses
# outright on a container's toolchain — so the spec reads the golden.
compile_ir_one_value = row
  "a second value pinned beside the row, until it admits anything counted"
  false
  "cargo test --test the_compile_row_holds_one_value"
  "specs (unit, golden, differential)"
  (breaking "the_compile_row_pins_a_second_value")
  no_setup

# THE MAPS PARSE IS EXTERNAL STATE, ruled 2026-09-15. Rust's startup parses
# /proc/self/maps to place the stack guard, and the parse costs whatever the
# binary's layout makes the file: a 64 KiB .bss nothing reaches moved the
# whole-process count 2,128 with the compiler's own frame identical to the
# instruction. The three compile gates read their rows as `kanso::main`
# inclusive, which leaves the parse above the count. The cheap regression is a
# gate going back to callgrind's summary line, which is one grep shorter and
# is the whole process again; the spec reads the three gates for the anchor.
compile_ir_from_main = row
  "a compile row read from process entry, so the maps parse is in it again"
  false
  "cargo test --test the_compile_rows_start_at_the_compilers_main"
  "specs (unit, golden, differential)"
  (breaking "a_compile_row_that_counts_from_process_entry")
  no_setup

# A BUILD IS A TREE, and the codegen rows count all of it. `kanso check` stops
# before codegen, so the emitter, the clang driver, `clang -cc1`, ld and the
# linker's own child were uncounted by every other row, and they are the larger
# half of what a build costs. `--trace-children=yes` is the whole of how the
# tree is reached. The first measurement of this row was taken on a build that
# had been REFUSED after emitting its IR -- two processes, both tiers within
# 0.006% of each other -- so a short tree is the shape of a build that never
# wrote anything, and the gate refuses one.
codegen_one_process = row
  "a codegen row counted on the compiler's process alone, not the build tree"
  false
  "sh scripts/gates/codegen_instructions.sh dev"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_codegen_row_that_counts_one_process")
  no_setup

# A refusal is only as good as what it leaves a reader able to do. This one
# told CI to copy rows out of a job log that could not contain them, because
# the gate stopped before it measured. The row watches the two answers stay
# separate: a container may not measure, CI must.
host_measures = row
  "a refusal that sends a reader to rows the gate never printed"
  false
  "cargo test --test a_host_that_may_not_be_compared_may_still_be_measured"
  "specs (unit, golden, differential)"
  (breaking "a_refusal_that_tells_you_to_read_rows_it_never_printed")
  no_setup

# The welfare column is written over the stored rows under the current formula
# — ruled 2026-08-31, restated 2026-09-03 as one line rewritten in place — so
# the rule is written twice: scripts/welfare scores the goldens and
# scripts/welfare_rescore scores a row. Two statements of one rule drift, and
# this one drifts where nobody looks, because a wrong column still draws a
# line. The spec runs both tools on one set of readings and requires the same
# answer.
chart_replay = row
  "a written column that no longer agrees with the formula being ruled on"
  false
  "cargo test --test the_score_says_what_it_was_made_of"
  "specs (unit, golden, differential)"
  (breaking "a_chart_that_replays_a_different_formula")
  no_setup

