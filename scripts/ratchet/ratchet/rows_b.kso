import "std/list"

rows_b1a = [decode_counters escape_counters pend_counters digest_counters]

rows_b1y = [thunk_walk scan_counters read_counters compile_libraries]

rows_b1z = list/concat rows_b1y [oneshot_counters]

rows_b1 = list/concat rows_b1a (list/concat rows_b1z [live_counters clean_run])

rows_b1r0 = list/concat rows_b1 [emitted_code emitted_others remainder]

rows_b1r1 = list/concat rows_b1r0 [short_float leading_zeros int_cold_tail]

rows_b1r2 = list/concat rows_b1r1 [cold_registers index_cold_arms]

rows_b1r3 = list/concat rows_b1r2 [cold_copy rare_door]

rows_b1r4 = list/concat rows_b1r3 [sweep_helpers slice_walk closure_caps]

rows_b1r5 = list/concat rows_b1r4 [empty_room scan_inline scan_tail]

rows_b1r = list/concat rows_b1r5 [counters_out capture_load]

rows_b1b = list/concat rows_b1r [machine_code]

rows_b1c = list/concat rows_b1b [instructions_host text_host]

rows_b1d = list/concat rows_b1c [compile_allocs compile_allocs_host]

rows_b1d2 = list/concat rows_b1d [compile_ir compile_ir_host entry_ir]

rows_b1d3 = list/concat rows_b1d2 [library_ir]

rows_b1e0a = list/concat rows_b1d3 [compile_ir_one_value box_check_hoist]

rows_b1e0m = list/concat rows_b1e0a [compile_ir_from_main]

rows_b1e0 = list/concat rows_b1e0m [qualified_name_join]

rows_b1e1 = list/concat rows_b1e0 [host_measures]

rows_b1e2 = list/concat rows_b1e1 [inline_pin chart_replay objective_row]

rows_b1e3 = list/concat rows_b1e2 [one_char_memo length_memo chain_index]

rows_b1e4 = list/concat rows_b1e3 [length_fold ten_open ten_where seek_kept]

rows_b1e = list/concat rows_b1e4 [pop_fast push_walk]

rows_b1f = list/concat rows_b1e [scalar_words render_words]

rows_b1f2 = list/concat rows_b1f [render_trip int_bound]

rows_b1g = list/concat rows_b1f2 [map_lit_copy buf_class_loop]

rows_b1h = list/concat rows_b1g [walk_once data_beside]

rows_b1i = list/concat rows_b1h [freeze_all mark_block_first]

rows_b1j = list/concat rows_b1i [wide_char_cache ascii_four_blocks]

rows_b1k = list/concat rows_b1j [slice_count_words]

rows_b1l = list/concat rows_b1k [size_walk chain_drift thunk_set failure_set]

rows_b1m = list/concat rows_b1l [pop_deep str_words ryu_words rewritten_twice]

rows_b1n = list/concat rows_b1m [shared_path entry_rewritten_twice]

# The one-module collapse's dedup keys. compile_ir's own mutation stops the
# vein being read; this one leaves the vein alone and asks whether it can see a
# key clone a name the program already holds. The keep mask stays under the
# mutation, so the row watches the borrow rather than the shape around it, and
# all three compile rows rise together on it -- module +234,146 (+0.5107%),
# entry +860,245 (+0.5650%), library +848,228 (+0.5559%) in the box.
dedup_key_owned = row
  "a dedup key that clones a name the program is holding open beside it"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_dedup_keys_own_their_names")
  release

# The fusion pass's name set, the same question about a different table: it is
# asked `contains` and dropped, so nothing needs owned names in it. A separate
# row from `dedup_key_owned` because a separate table can regress on its own --
# module +104,581 (+0.2281%), entry +339,005 (+0.2227%), library +369,885
# (+0.2424%) in the box, compile_allocs +296.
fused_names_owned = row
  "a set asked one question, holding copies of names it could have borrowed"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_fused_name_set_owns_its_names")
  release

# A byte view a function only reads while its frame stands keeps its header in
# that frame. The mutation sends every view back to the arena, and the fixture
# a_view_read_where_it_was_made_allocates_no_header reads allocs=1002 against
# its 2.
framed_view = row
  "a view read in its frame given an arena header"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_view_read_in_its_frame_given_an_arena_header")
  release

rows_b1oa = list/concat rows_b1n [append_rendered arm_narrowed arms_apart]

rows_b1o = list/concat rows_b1oa [dedup_key_owned fused_names_owned]

# A map whose pairs are already in order is its own sorted view. The mutation
# copies them into a view again, and the fixture
# a_map_whose_keys_arrived_in_order_is_its_own_view reads view_allocs=1 and
# held_peak_bytes=32016 against its 0 and 0.
ordered_view = row
  "ordered pairs copied into a view"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "ordered_pairs_copied_into_a_view")
  release

# A builder only one function holds grows by realloc. The mutation sends the
# grow back through malloc, copy and free, and the fixture
# a_builder_that_outgrows_its_buffer_is_never_held_twice reads
# held_peak_bytes=202780 against its 135182.
regrow = row
  "a unique builder copied to grow"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_unique_builder_copied_to_grow")
  release

# A greedy run of one character is counted, then backed off in order. The
# mutation drops the count's ceiling, and the micro fixture
# a_greedy_run_of_one_character_backs_off_in_order reads a five-character match
# where `x\{2,3}x` takes four.
counted_run = row
  "a counted run that ignores its ceiling"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_counted_run_that_ignores_its_ceiling")
  release

rows_b1q = list/concat rows_b1o [list_test_first framed_view]

rows_b1p = list/concat rows_b1q [ordered_view regrow counted_run]

# A slice of a long string shares the string's bytes. The mutation makes every
# slice a copy again, and the fixture a_long_slice_shares_its_text reads
# alloc_bytes=128464 against its 16464.
slice_view = row
  "a long slice copied out of its string"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_long_slice_copied_out_of_its_string")
  release

# A view reaches the C library through `k_cstr`, which terminates it. The
# mutation hands over the parent's bytes, and the runtime fixture
# a_long_slice_ends_where_it_was_cut prints the rest of the parent's line.
view_cstr = row
  "a view handed to the c library unterminated"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_view_handed_to_the_c_library_unterminated")
  release

# An oversize allocation leaves the block before it open for what follows. The
# mutation strands that block's tail, and the fixture
# an_oversize_string_leaves_its_neighbour_open reads a second 1 MiB block.
oversize_tail = row
  "an oversize block that strands its neighbour"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_oversize_block_that_strands_its_neighbour")
  release

rows_b1v = list/concat rows_b1p [slice_view view_cstr oversize_tail]

# An arm no value can reach is not emitted. The mutation keeps every arm, and
# the spec's mapping program defines next_skipped again.
unbuilt_arm = row
  "an arm no value reaches emitted"
  true
  "cargo test --release --test an_arm_no_value_reaches_is_not_emitted"
  "specs (unit, golden, differential)"
  (breaking "an_arm_no_value_reaches_emitted")
  release

rows_b1u = list/concat rows_b1v [unbuilt_arm]

# A cycle nothing reaches is not emitted. The mutation starts every definition
# marked, and the spec's fused-call program defines std/text's to_float again.
dead_cycle = row
  "a cycle nothing reaches emitted"
  true
  "cargo test --release --test a_cycle_nothing_reaches_is_not_emitted"
  "specs (unit, golden, differential)"
  (breaking "a_cycle_nothing_reaches_emitted")
  release

rows_b1cy = list/concat rows_b1u [dead_cycle]

# A string nothing names is not emitted. The mutation wants every interned
# string, and the spec's module carries strings nothing names again.
dead_string = row
  "a string nothing names emitted"
  true
  "cargo test --release --test a_string_nothing_names_is_not_emitted"
  "specs (unit, golden, differential)"
  (breaking "a_string_nothing_names_emitted")
  release

rows_b1st = list/concat rows_b1cy [dead_string]

# A block nothing branches to is not emitted. The mutation keeps every block,
# and the spec's module carries failure paths nothing reaches again.
dead_block = row
  "a block nothing branches to emitted"
  true
  "cargo test --release --test a_block_nothing_branches_to_is_not_emitted"
  "specs (unit, golden, differential)"
  (breaking "a_block_nothing_branches_to_emitted")
  release

rows_b1bk = list/concat rows_b1st [dead_block]

# An unboxed parameter is read as its word. The mutation records nothing, and
# the spec's module takes its parameters back apart again.
unboxed_word = row
  "an unboxed parameter taken apart"
  true
  "cargo test --release --test an_unboxed_parameter_is_read_as_its_word"
  "specs (unit, golden, differential)"
  (breaking "an_unboxed_parameter_taken_apart")
  release

rows_b1uw = list/concat rows_b1bk [unboxed_word]

# A switch writes `nomatch` only when a case falls to it. The mutation always
# writes it, and the spec's JSON decode carries failure paths nothing reaches.
dead_nomatch = row
  "a nomatch nothing falls to emitted"
  true
  "cargo test --release --test a_block_nothing_branches_to_is_not_emitted"
  "specs (unit, golden, differential)"
  (breaking "a_nomatch_nothing_falls_to_emitted")
  release

rows_b1nm = list/concat rows_b1uw [dead_nomatch]

# A tag known to be the int tag is not compared. The mutation compares every
# tag, and the spec's module compares 0 with 0 again.
known_tag = row
  "a known int tag compared"
  true
  "cargo test --release --test a_tag_known_to_be_int_is_not_compared"
  "specs (unit, golden, differential)"
  (breaking "a_known_int_tag_compared")
  release

rows_b1kt = list/concat rows_b1nm [known_tag]

# A release build hands clang every `musttail` the emitter wrote, however
# wide the arm. The mutation takes it off every call into an arm that stays
# on `tailcc`, and a self call through a thirteen-word arm runs out of stack.
nine_words = row
  "a wide arm called without musttail"
  true
  "cargo test --release --test a_big_object_decodes_in_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "a_wide_arm_called_without_musttail")
  release

rows_b1nw = list/concat rows_b1kt [nine_words]

# A tail cycle takes one flat signature under preserve_nonecc in a release
# build on x86-64. The first mutation skips the rewrite, which only the work
# vein can see; the second rebuilds a two-word parameter with its words
# reversed, and a cycle four million hops deep stops on the wrong overload.
flat_tails = row
  "a tail cycle kept on tailcc"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_tail_cycle_kept_on_tailcc")
  benchmarks

flat_order = row
  "a flat parameter put back reversed"
  true
  "cargo test --release --test a_tail_cycle_crosses_arities_in_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "a_flat_parameter_put_back_reversed")
  release

# Every function the program calls only directly takes preserve_nonecc on
# the same builds. The mutation keeps them all on the C convention.
plain_calls = row
  "a direct call kept on the C convention"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_direct_call_kept_on_c")
  benchmarks

# Four runtime doors take preserve_nonecc on both sides. The mutation takes
# one off the emitter's list, and the spec comparing the lists goes red.
doors = row
  "a door called on the other convention"
  true
  "cargo test --release --test the_doors_the_program_calls_agree"
  "specs (unit, golden, differential)"
  (breaking "a_door_called_on_the_other_convention")
  release

rows_b1ft = list/concat rows_b1nw [flat_tails flat_order plain_calls doors]

# An append onto a bufferless bytes value tests for the grow inline, before
# the fitting path's frame. The mutation drops the test.
grow_first = row
  "a growing append paying the fitting path's frame"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_growing_append_pays_the_fit_s_frame")
  benchmarks

rows_b1gf = list/concat rows_b1ft [grow_first]

# A parameter that is a name binds its argument by moving it once an arm has
# won. The mutation clones it at every candidate again.
moved_binds = row
  "a bound name cloned for every candidate"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_bound_name_cloned_for_every_candidate")
  release

rows_b1mb = list/concat rows_b1gf [moved_binds]

# A list growing out of four slots takes eight before sixteen. The mutation
# doubles every time again, and the fixture's buffers double with it.
fifth_push = row
  "a fifth push taking sixteen slots"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_fifth_push_takes_sixteen")
  release

rows_b1fp = list/concat rows_b1mb [fifth_push]

# An accumulator out of the arena grows by realloc. The mutation mallocs,
# copies and frees again, and the fixture's permanent peak holds two buffers.
perm_regrow = row
  "an accumulator grown by malloc and free"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_accumulator_grown_by_malloc_and_free")
  release

rows_b1rg = list/concat rows_b1fp [perm_regrow]

# A call through a function reference finds its callee by the reference's
# address. The mutation hashes the name again.
callee_by_ref = row
  "a call that hashes its callee's name"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_call_hashes_its_callee_s_name")
  release

rows_b1cr = list/concat rows_b1rg [callee_by_ref]

# A conjunction of byte compares is one range test and plain reads. One
# mutation reads each byte one late and the micro fixture disagrees with the
# interpreter; the other turns the fusion off and the work vein sees it.
byte_run_late = row
  "a byte run read one byte late"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_byte_run_read_one_byte_late")
  release

byte_run_apart = row
  "a byte run read one byte at a time"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_byte_run_read_one_byte_at_a_time")
  benchmarks

rows_b1br = list/concat rows_b1cr [byte_run_late byte_run_apart]

# A rewind whose arena pointer stands at the mark returns before asking for
# the block. The mutation asks for the block first again.
unmoved_arena = row
  "an unmoved arena asked for its block"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_unmoved_arena_asked_for_its_block")
  benchmarks

rows_b1ua = list/concat rows_b1br [unmoved_arena]

# Two byte appends in a row are one call that asks for room once. One
# mutation stores the bytes back to front and the micro fixture disagrees with
# the interpreter; the other skips the merge and the work vein sees it.
byte_pair_swapped = row
  "a byte pair written back to front"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_byte_pair_written_back_to_front")
  release

byte_pair_apart = row
  "a byte pair appended one at a time"
  true
  "cargo test --release --test perf_ratchet two_byte_appends_are_one_call"
  "specs (unit, golden, differential)"
  (breaking "a_byte_pair_appended_one_at_a_time")
  release

rows_b1bp = list/concat rows_b1ua [byte_pair_swapped byte_pair_apart]

# A proven list is measured and indexed in place. One mutation reads each
# slot one late and the micro fixture disagrees with the interpreter; the
# other two send the index and the length back through the twin, and the
# work vein sees each.
list_read_late = row
  "a proven list read one slot late"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_proven_list_read_one_slot_late")
  release

list_index_twin = row
  "a proven list indexed through the twin"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_proven_list_indexed_through_the_twin")
  benchmarks

list_length_twin = row
  "a proven list measured through the twin"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_proven_list_measured_through_the_twin")
  benchmarks

rows_b1pr = list/concat rows_b1bp [list_read_late list_index_twin]

rows_b1pl = list/concat rows_b1pr [list_length_twin]

# The interpreter asks whether a push writes in place against its frame's
# own sites. The mutation hashes the file's path on every call again.
in_place_site = row
  "an in-place site hashed by its path"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_in_place_site_hashed_by_its_path")
  release

# A call through a reference asks a direct-mapped table before the map. The
# mutation never takes the table's answer.
recent_callee = row
  "a reference's callee probed in the map"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_reference_s_callee_probed_in_the_map")
  release

# Entering a declaration asks a direct-mapped table before the map. The
# mutation never takes the table's answer.
recent_frame = row
  "a declaration's frame probed in the map"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_declaration_s_frame_probed_in_the_map")
  release

# Whether a value is a cell is asked inline. The mutation sends every value
# through the out-of-line loop.
inline_force = row
  "a plain value forced through a call"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_plain_value_forced_through_a_call")
  release

rows_b1is = list/concat rows_b1pl [in_place_site recent_callee recent_frame]

# A hit in the recent-frame table is answered at the caller. The mutation
# keeps the lookup out of line.
frame_hit_inline = row
  "a recent frame hit paying for a call"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_recent_frame_hit_paying_the_miss_s_frame")
  release

rows_b1if = list/concat rows_b1is [inline_force frame_hit_inline]

# A regexp scan first asks the subject for the literal every match must hold.
# Carrying the literal run across a class asks for a literal the subject does
# not hold, and the micro fixture finds nothing where it found a match; never
# asking costs the run program's split phase its quadratic scan again.
literal_run = row
  "a regexp literal run carried across a class"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_literal_run_carried_across_a_class")
  release

literal_asked = row
  "a regexp scan made without asking for its literal"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_scan_made_without_asking_for_the_literal")
  benches

rows_b1rl = list/concat rows_b1if [literal_run literal_asked]

# A split whose scan finds nothing ends, rather than scanning again from the
# next position; the mem fixture's scan count goes quadratic without it.
split_stops = row
  "a split that scans again after finding nothing"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_split_that_rescans_after_finding_nothing")
  release

rows_b1ss = list/concat rows_b1rl [split_stops]

# A map of up to eight entries is a sorted vector and a larger one a B-tree.
# Growing into the tree without the key that made it grow loses that key on
# the interpreter, and the micro corpus sees the engines disagree.
map_grow = row
  "a map that loses its ninth key when it grows"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_ninth_key_lost_when_a_map_grows")
  release

rows_b1mg = list/concat rows_b1ss [map_grow]

# An interpreted int that overflows a machine word takes a BigInt, and one that
# comes back into range must come back into the word: equality compares the
# two forms as different values otherwise, and `max + 1 - 1` is not `max`.
int_word = row
  "a number that stays big when it fits a word"
  true
  "cargo test --release --test an_interpreted_int_crosses_the_word"
  "specs (unit, golden, differential)"
  (breaking "a_number_that_stays_big_when_it_fits")
  release

rows_b1iw = list/concat rows_b1mg [int_word]

# A walk by index steps its cursor one character on, and a join of counted
# pieces writes the sum. Closing the step leaves every character right and
# `seek_resumes` where it was, so `seek_steps` is what goes red; dropping the
# seed makes the index phase scan every doubled subject again; and a seed
# without its separator gives the micro fixture a length two short.
seek_step = row
  "an index that seeks where it could step"
  true
  (gating "run_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_walk_by_index_that_seeks_every_character")
  benchmarks

join_seed = row
  "a join of counted pieces that leaves its count unknown"
  true
  (gating "run_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_join_that_leaves_its_count_unknown")
  benchmarks

join_sep = row
  "a join count that leaves its separator out"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_join_count_that_drops_its_separator")
  release

rows_b1ix = list/concat rows_b1iw [seek_step join_seed join_sep]

# Under clang 19 the emitter writes the preserve_none convention in front of
# every declare of and call to a door, in one pass over the module. Matching a
# door by prefix hands the ordinary `k_b_utf8_...` functions the door's
# convention, and a program reads its arguments from the wrong registers.
door_prefix = row
  "a door matched by the prefix of its name"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_door_found_by_its_prefix")
  release

rows_b1dp = list/concat rows_b1ix [door_prefix]

# A literal of one to eight bytes appended in place is stored as one word.
# A length moved by the word's eight bytes prints the bytes past the literal;
# a slow arm that claims a new header leaves a carried builder holding one a
# rewind reclaims; and without the word the json encoder's literals go back
# through their cells, which the work vein prices.
word_length = row
  "a literal word that moves the length by eight"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_literal_word_that_moves_the_length_by_eight")
  release

word_slow = row
  "a literal word's slow arm that claims a new header"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_literal_word_slow_arm_that_claims_a_new_header")
  release

word_used = row
  "a short literal appended through its cell"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_literal_appended_through_its_cell")
  benches

rows_b1lw = list/concat rows_b1dp [word_length word_slow word_used]

# A second `kanso play` of a file finds its binary by the file's text and does
# not emit. Leaving the text out of that key runs an edited file's old binary;
# a loader that stops saying a module came from disk keys a file whose module
# changed under it by the file alone.
play_text = row
  "a play key that leaves out the file's text"
  true
  "cargo test --release --test a_play_file_is_keyed_by_its_text"
  "specs (unit, golden, differential)"
  (breaking "a_play_key_that_leaves_out_the_text")
  release

play_disk = row
  "a play key that trusts a module read from disk"
  true
  "cargo test --release --test a_play_file_is_keyed_by_its_text"
  "specs (unit, golden, differential)"
  (breaking "a_play_key_that_trusts_a_module_from_disk")
  release

# A warm play words a death by signal without compiling the file.
play_signal = row
  "a warm play that dies in silence"
  true
  "cargo test --release --test a_play_file_is_keyed_by_its_text"
  "specs (unit, golden, differential)"
  (breaking "a_warm_play_that_dies_in_silence")
  release

rows_b1pk = list/concat rows_b1lw [play_text play_disk play_signal]

# An application's arguments leave the shared stack as a vector of exactly
# their number. Four slots apiece, which is what growing one from nothing
# left, puts about 60,000 bytes back on the front end's peak.
args_exact = row
  "an application that grows its own argument vector"
  true
  "sh scripts/gates/compile_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_application_that_grows_its_own_arguments")
  release

rows_b1ae = list/concat rows_b1pk [args_exact]

# A dev link goes to gold, without a build ID, wherever gold links. Handing it
# back to lld raises the dev codegen row by what the dynamic loader spends on
# libLLVM and by the SHA-1 gold no longer computes.
dev_gold = row
  "a dev build linked by lld with a build ID, where gold links"
  true
  "sh scripts/gates/codegen_instructions.sh dev"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_dev_link_left_to_lld")
  no_setup

rows_b1dg = list/concat rows_b1ae [dev_gold]

# A key named through `{:016x}` costs more when its value has a leading zero
# nibble, and the values hash tools' modification times.
key_hex = row
  "a key whose name costs what its value makes it cost"
  true
  "cargo test --release --test every_temp_path_pads_its_pid"
  "specs (unit, golden, differential)"
  (breaking "a_key_named_through_padding")
  release

rows_b1hx = list/concat rows_b1dg [key_hex]

# The short-decimal search starts where the last float's ended. Starting it at
# zero again renders the same digits and costs runbench the tries the guess
# saves.
ryu_guess = row
  "a float search that starts at zero places every time"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_float_search_that_starts_at_zero")
  benches

rows_b1fs = list/concat rows_b1hx [ryu_guess]

# A list that leaves the arena takes 256 slots, so a thousand-element
# accumulator grows by realloc twice rather than four times.
perm_wide = row
  "a permanent list that starts narrow and grows through every step"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_permanent_list_that_starts_narrow")
  release

rows_b1pw = list/concat rows_b1fs [perm_wide]

# `{}` opens with room for five pairs, so a five-key object is built without
# a grow.
map_seed = row
  "an empty map seeded with four pairs, so every fifth key grows it"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_empty_map_seeded_with_four_pairs")
  release

rows_b1ms = list/concat rows_b1pw [map_seed]

# `[]` opens with room for six, so an array of five or six is built without
# a grow.
list_seed = row
  "an empty list seeded with four slots, so every fifth push grows it"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_empty_list_seeded_with_four")
  release

rows_b1ls = list/concat rows_b1ms [list_seed]

# `bytes ""` is a builder with 64 bytes of room, so the append after it lands
# in place instead of growing from nothing.
bytes_seed = row
  "an empty builder with no room, so its first append grows from nothing"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_empty_builder_with_no_room")
  release

rows_b1bs = list/concat rows_b1ls [bytes_seed]

# A malloc'd builder past 16 kb grows by half, so it finishes with less
# empty room than a doubled one.
half_grow = row
  "a large builder that doubles, so it finishes up to half empty"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_large_builder_that_doubles")
  release

rows_b1hg = list/concat rows_b1bs [half_grow]

# A token of four to seven bytes comes back from a cache of permanent strings
# instead of being built on every read.
token_cache = row
  "a short token built every time, so each read allocates and copies it"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_short_token_built_every_time")
  release

rows_b1tc = list/concat rows_b1hg [token_cache]

# A map key reaches append_key through a parameter typed as a string.
key_typed = row
  "a key written as any value, so every key pays the untyped escape"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_key_written_as_any_value")
  benches

rows_b1ky = list/concat rows_b1tc [key_typed]

# A tail call carries its callee's group to the dispatcher, which no longer
# hashes the name to find it.
tail_group = row
  "a tail that hashes its group's name"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_tail_that_hashes_its_group")
  release

rows_b1tg = list/concat rows_b1ky [tail_group]

# A literal is read out of its BigInt by a direct digit read, inlined.
word_read = row
  "a literal read through the digit walk"
  true
  interp_gate
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_literal_read_through_the_digit_walk")
  release

rows_b1wr = list/concat rows_b1tg [word_read]

# A division by a nonzero literal adds no err to what inference knows.
literal_divisor = row
  "a literal divisor that might fail"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_literal_divisor_that_might_fail")
  benchmarks

rows_b1ld = list/concat rows_b1wr [literal_divisor]

# A lambda applied to a box may not read the box as a value.
box_param = row
  "a lambda handed a box through the plain dot reads it as a value unrefused"
  true
  "cargo test --release --test golden {box_error_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_box_a_lambda_may_read")
  release

box_error_golden = "error_corpus_reports_each_golden_diagnostic"

rows_b1bx = list/concat rows_b1ld [box_param]

# A boxed parameter proven to be one kind of heap value carries an assume.
tag_assumed = row
  "a proven tag left unsaid"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_proven_tag_left_unsaid")
  benches

rows_b1ta = list/concat rows_b1bx [tag_assumed]

# `>>` is refused where it is written, with the spelling that replaced it.
wall_refused = row
  "a `>>` that lexes as two comparisons instead of being refused"
  true
  "cargo test --release --test golden {error_golden}"
  "specs (unit, golden, differential)"
  (breaking "the_wall_lexes_again")
  release

# `--plan` renders the step after `_ ->`, which ignores the value it is handed.
plan_ignoring = row
  "a plan that stops at every bind, even one whose callback ignores its value"
  true
  "cargo test --release --test golden {plan_golden}"
  "specs (unit, golden, differential)"
  (breaking "a_plan_that_stops_at_every_bind")
  release

plan_golden = "plan_prints_the_description_without_executing_it"

error_golden = "error_corpus_reports_each_golden_diagnostic"

rows_b1wg = list/concat rows_b1ta [wall_refused plan_ignoring]

# A builtin sees a subtype's value as its parent's on every engine.
subtype_unwrapped = row
  "a subtype handed to a builtin whole"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_subtype_handed_to_a_builtin_whole")
  release

rows_b1su = list/concat rows_b1wg [subtype_unwrapped]

# A call whose result is proven one kind of value carries an assume.
result_assumed = row
  "a proven result left unsaid"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_proven_result_left_unsaid")
  benches

rows_b1ra = list/concat rows_b1su [result_assumed]

# A region gives back what it allocated when the call's result lies outside it.
# The witness is the mem fixture a_descent_gives_back_the_keys_it_built.
region_given_back = row
  "a region that keeps what it made"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_region_that_keeps_what_it_made")
  release

rows_b1gb = list/concat rows_b1ra [region_given_back]

# A guard's condition branches on its comparisons instead of being asked.
guard_asked = row
  "a guard that asks its condition for a value"
  true
  "cargo test --release --test perf_ratchet {guard_spec}"
  "specs (unit, golden, differential)"
  (breaking "a_guard_that_asks_its_condition_for_a_value")
  release

guard_spec = "an_or_under_a_guard_is_asked_in_pieces"

rows_b1ga = list/concat rows_b1gb [guard_asked]

# A list buffer's capacity is doubled with its regime in bit 0.
capacity_doubled = row
  "a malloc'd buffer whose capacity reads back short"
  true
  "cargo test --release --test {capacity_spec}"
  "specs (unit, golden, differential)"
  (breaking "a_malloced_buffer_read_back_short")
  release

capacity_spec = "a_buffer_capacity_reads_back_whole_in_either_regime"

rows_b1cd = list/concat rows_b1ga [capacity_doubled]

# Past the beat stack the cached top is a mark that stands in for none.
beat_none = row
  "a beat past the stack rewound to a mark that stands for none"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_beat_past_the_stack_rewound_to_nothing")
  release

rows_b1bn = list/concat rows_b1cd [beat_none]

# A carried record is asked about failure once, on its value field.
carried_once = row
  "a carried record asked about failure twice"
  true
  "cargo test --release --test perf_ratchet {carried_spec}"
  "specs (unit, golden, differential)"
  (breaking "a_carried_record_asked_about_failure_twice")
  release

carried_spec = "a_carried_record_is_asked_about_failure_once"

rows_b1co = list/concat rows_b1bn [carried_once]

# An index read tells LLVM its container's length is not negative.
length_assumed = row
  "an index that assumes nothing of its length"
  true
  "cargo test --release --test perf_ratchet {length_spec}"
  "specs (unit, golden, differential)"
  (breaking "an_index_that_assumes_nothing_of_its_length")
  release

length_spec = "an_index_assumes_its_length_is_not_negative"

rows_b1la = list/concat rows_b1co [length_assumed]

# A span is asked in two unsigned compares.
span_unsigned = row
  "a span that lets from equal to past the end"
  true
  "cargo test --release --test {span_spec}"
  "specs (unit, golden, differential)"
  (breaking "a_span_that_lets_from_equal_to_past_the_end")
  release

span_spec = "a_span_is_asked_in_two_unsigned_compares"

rows_b1sp = list/concat rows_b1la [span_unsigned]

# A room test asks its two questions with two branches.
room_split = row
  "a push that joins its room questions"
  true
  "cargo test --release --test {room_spec}"
  "specs (unit, golden, differential)"
  (breaking "a_push_that_joins_its_room_questions")
  release

room_spec = "a_room_test_branches_on_each_question"

rows_b1rs = list/concat rows_b1sp [room_split]

# An index loads its length between its two bounds.
index_split = row
  "an index that loads its length first"
  true
  "cargo test --release --test perf_ratchet {index_split_spec}"
  "specs (unit, golden, differential)"
  (breaking "an_index_that_loads_its_length_first")
  release

index_split_spec = "an_index_loads_its_length_after_its_lower_bound"

rows_b1ib = list/concat rows_b1rs [index_split]

# An empty run returns the builder between its two bounds tests.
empty_run = row
  "an empty run that loads its length first"
  true
  "cargo test --release --test {empty_run_spec}"
  "specs (unit, golden, differential)"
  (breaking "an_empty_run_that_loads_its_length_first")
  release

empty_run_spec = "an_empty_run_appends_nothing"

rows_b1er = list/concat rows_b1ib [empty_run]

rows_b = list/concat rows_b1er [compile_mem compile_mem_host]
