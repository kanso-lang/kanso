trend = row
  "a counter worsening with nothing traded and nothing attributed"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_counter_worsens_for_nothing")
  release

# The same refusal in the other vein. Two rows, because the two goldens are
# read by different code: one is `name=value` and the gate has always parsed
# it, the other is `name value` and the gate saw nothing in it at all.
trend_runtime = row
  "the decoder's retired instructions rising with nothing traded for them"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_runtime_counter_worsens_for_nothing")
  release

# The half of the trend gate's refusal that a joining sample could hide. The
# gate sums a golden's fields across its samples, so adding a benchmark raises
# every sum at once; comparing over the samples both sides have is what keeps
# that from reading as a regression, and this row is what keeps the fix from
# being written the lazy way. Its first draft skipped the whole golden for the
# run, and skipped a real rise sitting beside the new sample.
trend_joined = row
  "a counter worsening in a sample that was already there, while one joins"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_worsening_hidden_behind_a_joining_sample")
  release

# The half of the refusal an unclassified counter could pay for. `worsened?`
# answers false for a name no direction table knows, and the listing called
# every not-worsened move an improvement, so one of those landed in `better`
# and no worsening was ever alone.
trend_adrift = row
  "a worsening whose only trade is a counter no direction table names"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_worsening_paid_for_by_an_unclassified_counter")
  release

