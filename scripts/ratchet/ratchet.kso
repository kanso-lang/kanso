itself = row
  "a gating job nobody said how to prove"
  true
  "./target/release/kanso run scripts/ratchet"
  "the ratchet (every gate has a mutation that turns it red)"
  (breaking "unrowed_ci_job")
  release

# The one vein whose headline row is a high water mark. Every other
# benchmark's peak is bounded by the size of its own text, so a change that
# moves what a program HOLDS and not what it allocates is invisible to them.
digest_counters = row
  "an arena block size raised without the peak it moves being measured"
  true
  (gating "digest_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_arena_block_that_grew_unmeasured")
  benchmarks

rows_a0 = [formatting linting python_free goldens scan_leak]

rows_a = text/concat rows_a0 [mem_shapes release_profile]

rows_b1a = [decode_counters escape_counters pend_counters digest_counters]

rows_b1z = [thunk_walk scan_counters read_counters compile_libraries]

rows_b1 = text/concat rows_b1a (text/concat rows_b1z [live_counters clean_run])

rows_b1r0 = text/concat rows_b1 [emitted_code emitted_others remainder]

rows_b1r1 = text/concat rows_b1r0 [short_float leading_zeros int_cold_tail]

rows_b1r2 = text/concat rows_b1r1 [cold_registers index_cold_arms]

rows_b1r3 = text/concat rows_b1r2 [cold_copy rare_door]

rows_b1r4 = text/concat rows_b1r3 [sweep_helpers slice_walk closure_caps]

rows_b1r5 = text/concat rows_b1r4 [empty_room scan_inline scan_tail]

rows_b1r = text/concat rows_b1r5 [counters_out capture_load]

rows_b1b = text/concat rows_b1r [machine_code]

rows_b1c = text/concat rows_b1b [instructions_host text_host]

rows_b1d = text/concat rows_b1c [compile_allocs compile_allocs_host]

rows_b1d2 = text/concat rows_b1d [compile_ir compile_ir_host entry_ir]

rows_b1d3 = text/concat rows_b1d2 [library_ir]

rows_b1e0a = text/concat rows_b1d3 [compile_ir_one_value box_check_hoist]

rows_b1e0m = text/concat rows_b1e0a [compile_ir_from_main]

rows_b1e0 = text/concat rows_b1e0m [qualified_name_join]

rows_b1e1 = text/concat rows_b1e0 [host_measures]

rows_b1e2 = text/concat rows_b1e1 [inline_pin chart_replay objective_row]

rows_b1e3 = text/concat rows_b1e2 [one_char_memo length_memo]

rows_b1e4 = text/concat rows_b1e3 [length_fold ten_open ten_where seek_kept]

rows_b1e = text/concat rows_b1e4 [pop_fast push_walk]

rows_b1f = text/concat rows_b1e [scalar_words slice_words render_words]

rows_b1f2 = text/concat rows_b1f [render_trip int_bound]

rows_b1g = text/concat rows_b1f2 [map_lit_copy buf_class_loop]

rows_b1h = text/concat rows_b1g [walk_once data_beside]

rows_b1i = text/concat rows_b1h [freeze_all mark_block_first]

rows_b1j = text/concat rows_b1i [wide_char_cache ascii_four_blocks]

rows_b1k = text/concat rows_b1j [slice_count_words]

rows_b1l = text/concat rows_b1k [size_walk chain_drift thunk_set failure_set]

rows_b1m = text/concat rows_b1l [pop_deep str_words ryu_words rewritten_twice]

rows_b1n = text/concat rows_b1m [shared_path entry_rewritten_twice]

# The one-module collapse's dedup keys. compile_ir's own mutation stops the
# vein being read; this one leaves the vein alone and asks whether it can see a
# key clone a name the program already holds. The keep mask stays under the
# mutation, so the row watches the borrow rather than the shape around it, and
# all three compile rows rise together on it -- module +234,146 (+0.5107%),
# entry +860,245 (+0.5650%), library +848,228 (+0.5559%) in the box.
dedup_key_owned = row
  "a dedup key that clones a name the program is holding open beside it"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_dedup_keys_own_their_names")
  release

# The fusion pass's name set, the same question about a different table: it is
# asked `contains` and dropped, so nothing needs owned names in it. A separate
# row from `dedup_key_owned` because a separate table can regress on its own --
# module +104,581 (+0.2281%), entry +339,005 (+0.2227%), library +369,885
# (+0.2424%) in the box, compile_allocs +296.
fused_names_owned = row
  "a set asked one question, holding copies of names it could have borrowed"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_fused_name_set_owns_its_names")
  release

# A byte view a function only reads while its frame stands keeps its header in
# that frame. The mutation sends every view back to the arena, and the fixture
# a_view_read_where_it_was_made_allocates_no_header reads allocs=1002 against
# its 2.
framed_view = row
  "a view read in its frame given an arena header"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_view_read_in_its_frame_given_an_arena_header")
  release

rows_b1oa = text/concat rows_b1n [append_rendered arm_narrowed arms_apart]

rows_b1o = text/concat rows_b1oa [dedup_key_owned fused_names_owned]

# A map whose pairs are already in order is its own sorted view. The mutation
# copies them into a view again, and the fixture
# a_map_whose_keys_arrived_in_order_is_its_own_view reads view_allocs=1 and
# held_peak_bytes=32016 against its 0 and 0.
ordered_view = row
  "ordered pairs copied into a view"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "ordered_pairs_copied_into_a_view")
  release

# A builder only one function holds grows by realloc. The mutation sends the
# grow back through malloc, copy and free, and the fixture
# a_builder_that_outgrows_its_buffer_is_never_held_twice reads
# held_peak_bytes=202780 against its 135182.
regrow = row
  "a unique builder copied to grow"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_unique_builder_copied_to_grow")
  release

# A greedy run of one character is counted, then backed off in order. The
# mutation drops the count's ceiling, and the micro fixture
# a_greedy_run_of_one_character_backs_off_in_order reads a five-character match
# where `x\{2,3}x` takes four.
counted_run = row
  "a counted run that ignores its ceiling"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_counted_run_that_ignores_its_ceiling")
  release

rows_b1q = text/concat rows_b1o [list_test_first framed_view]

rows_b1p = text/concat rows_b1q [ordered_view regrow counted_run]

# A slice of a long string shares the string's bytes. The mutation makes every
# slice a copy again, and the fixture a_long_slice_shares_its_text reads
# alloc_bytes=128464 against its 16464.
slice_view = row
  "a long slice copied out of its string"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_long_slice_copied_out_of_its_string")
  release

# A view reaches the C library through `k_cstr`, which terminates it. The
# mutation hands over the parent's bytes, and the runtime fixture
# a_long_slice_ends_where_it_was_cut prints the rest of the parent's line.
view_cstr = row
  "a view handed to the c library unterminated"
  true
  "cargo test --release --test golden runtime_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_view_handed_to_the_c_library_unterminated")
  release

# An oversize allocation leaves the block before it open for what follows. The
# mutation strands that block's tail, and the fixture
# an_oversize_string_leaves_its_neighbour_open reads a second 1 MiB block.
oversize_tail = row
  "an oversize block that strands its neighbour"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_oversize_block_that_strands_its_neighbour")
  release

rows_b1v = text/concat rows_b1p [slice_view view_cstr oversize_tail]

# An arm no value can reach is not emitted. The mutation keeps every arm, and
