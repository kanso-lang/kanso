  (whose "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "instructions_host_unpinned")
  no_setup

text_host = row
  "the machine-code vein read under a toolchain that did not emit it"
  false
  (whose "text")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "text_host_unpinned")
  no_setup

compile_allocs = row
  "a front-end pass that owns the program's names instead of borrowing them"
  false
  "sh scripts/gates/compile_allocs.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_allocs_unwatched")
  release

compile_allocs_host = row
  "the allocation vein read under a toolchain that did not count it"
  false
  (whose "compile_allocs")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_allocs_host_unpinned")
  no_setup

compile_ir = row
  "front-end work that costs instructions and moves no other counter"
  false
  "sh scripts/gates/compile_instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_ir_unwatched")
  release

compile_ir_host = row
  "the instruction vein read under a toolchain that did not retire it"
  false
  (whose "compile_instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_ir_host_unpinned")
  no_setup

# The compile row is keyed by silicon now, and the answer that keying exists to
# forbid is the cheap one: an unrecorded chip waved through. That cannot be
# watched on the gate itself — the gate's own answer costs a callgrind run over
# the whole front end, and it refuses on any host whose toolchain is not the
# recorded one, so on a container it is red before it reads a row at all. The
# refusals live in scripts/gates/compile_ir_row.sh, which is two files and four
# strings, and this row watches them there.
compile_ir_keyed = row
  "a chip nobody counted this row on, waved through instead of refused"
  false
  "cargo test --test a_compile_row_is_read_against_its_own_chip"
  "specs (unit, golden, differential)"
  (breaking "an_unrecorded_chip_is_waved_through")
  no_setup

# The same file, a different way to be wrong, and this one came from a mistake
# rather than a design: a chip's row was corrected in place AND appended in one
# edit. The lookup takes the first match and stops, so the appended line said
# nothing while sitting where the newest sitting goes, and every gate in the
# tree was green over it.
compile_ir_doubled = row
  "a second row for one chip, read by nobody and trusted by everybody"
  false
  "cargo test --test a_compile_row_is_read_against_its_own_chip"
  "specs (unit, golden, differential)"
  (breaking "a_second_row_for_one_chip_is_read_by_nobody")
  no_setup

# The same file again, and the newest way to be wrong. A row may pin two values
# now — two CI runs printed one binary sha and one cpu key and counted
# 41,831,767 and 41,832,275, and neither the loader's directory order nor
# address randomization was the term. Two is a ruled fallback; three is a band
# being built a reading at a time, and a band that wide swallows changes the
# size of kanso#1226's -5,621.
compile_ir_pair = row
  "a third value appended beside a pinned pair, until the row admits anything"
  false
  "cargo test --test a_compile_row_is_read_against_its_own_chip"
  "specs (unit, golden, differential)"
  (breaking "a_pinned_pair_grows_into_a_band")
  no_setup

# A refusal is only as good as what it leaves a reader able to do. This one
# told CI to copy rows out of a job log that could not contain them, because
# the gate stopped before it measured. The row watches the two answers stay
# separate: a container may not measure, CI must.
host_measures = row
  "a refusal that sends a reader to rows the gate never printed"
  false
  "cargo test --test a_host_that_may_not_be_compared_may_still_be_measured"
  "specs (unit, golden, differential)"
  (breaking "a_refusal_that_tells_you_to_read_rows_it_never_printed")
  no_setup

# The welfare column is written over the stored rows under the current formula
# — ruled 2026-08-31, restated 2026-09-03 as one line rewritten in place — so
# the rule is written twice: scripts/welfare scores the goldens and
# scripts/welfare_rescore scores a row. Two statements of one rule drift, and
# this one drifts where nobody looks, because a wrong column still draws a
# line. The spec runs both tools on one set of readings and requires the same
# answer.
chart_replay = row
  "a written column that no longer agrees with the formula being ruled on"
  false
  "cargo test --test the_score_says_what_it_was_made_of"
  "specs (unit, golden, differential)"
  (breaking "a_chart_that_replays_a_different_formula")
  no_setup

inline_pin = row
  "an inline pin the inliner undoes, and a hot wrapper going out of line"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_inline_pin_the_inliner_undoes")
  benches

compile_mem = row
  "a front end holding bytes the golden does not claim it holds"
  false
  "sh scripts/gates/compile_memory.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_memory_banded")
  release

compile_mem_host = row
  "the peak vein read under a toolchain that did not allocate it"
  false
  (whose "compile_memory")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "compile_memory_host_unpinned")
  no_setup

perf_row = row
  "a history row that loses a counter it extracted"
  false
  "./target/release/kanso run scripts/perf_record"
  "perf history (appended to the history branch)"
  (breaking "perf_row_loses_a_group")
  release

# The row assembles and the row is COMPLETE are two properties, and perf_row
# above only watches the first. A row is scored on the counters it carries, so
# a row whose counters are spelled some other way is scored on less of the
# objective than every other point on the line while looking like all of them
# — which is what the newest row was doing when it held 12 of 24.
objective_row = row
  "a row whose counters are spelled where the objective cannot find them"
  false
  "sh scripts/gates/row_carries_the_objective.sh"
  "perf history (appended to the history branch)"
  (breaking "a_row_loses_a_counter_the_objective_weighs")
  release

trend = row
  "a counter worsening with nothing traded and nothing attributed"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_counter_worsens_for_nothing")
  release

# The same refusal in the other vein. Two rows, because the two goldens are
# read by different code: one is `name=value` and the gate has always parsed
# it, the other is `name value` and the gate saw nothing in it at all.
trend_runtime = row
  "the decoder's retired instructions rising with nothing traded for them"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_runtime_counter_worsens_for_nothing")
  release

# The half of the trend gate's refusal that a joining sample could hide. The
# gate sums a golden's fields across its samples, so adding a benchmark raises
# every sum at once; comparing over the samples both sides have is what keeps
# that from reading as a regression, and this row is what keeps the fix from
# being written the lazy way. Its first draft skipped the whole golden for the
# run, and skipped a real rise sitting beside the new sample.
trend_joined = row
  "a counter worsening in a sample that was already there, while one joins"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_worsening_hidden_behind_a_joining_sample")
  release

# The half of the refusal an unclassified counter could pay for. `worsened?`
# answers false for a name no direction table knows, and the listing called
# every not-worsened move an improvement, so one of those landed in `better`
# and no worsening was ever alone.
trend_adrift = row
  "a worsening whose only trade is a counter no direction table names"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_worsening_paid_for_by_an_unclassified_counter")
  release

# The half of the refusal a DEFINITION CHANGE could pay for. A counter whose
# golden and whose welfare baseline move together is not a win — the two
# readings are of different quantities — and the gate counted it as one and
# let it stand in for the trade a worsening needs. kanso#1241 is the fixture:
# `improved: compile_instructions 41,845,704 -> 41,379,840` is in the record
# of that merge and nothing in the compiler got faster.
# The vein the list was short by. readbench joined the objective on the day
# before this row and `bench/cost_golden_read.txt` was never listed, so two
# welfare terms had no watcher at all — the same failure kanso#1046 fixed for
# three other cost goldens, one benchmark later.
trend_read = row
  "the read vein's peak rising with nothing traded for it"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_read_counter_worsens_for_nothing")
  release

trend_rebased = row
  "a definition change standing in for the win a regression needs"
  true
  "./target/release/kanso run scripts/trend_gate -- origin/main"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_re_basing_that_pays_for_a_regression")
  release

welfare_floor = row
  "a run-speed term falling below the ratcheted floor"
  true
  "./target/release/kanso run scripts/welfare"
  "welfare (one number over runtime and compile cost, ratcheted)"
  (breaking "welfare_term_worsens")
  release

# The other step in that job. `welfare_floor` above satisfied `cover` for both
# of them, so this one had never been watched fail — and it had a live failure
# to be watched at: a number stated as a fact about the present went stale
# three times over with the gate reporting no drift.
published_numbers = row
  "a number the page states about the present drifting from its golden"
  true
  "./target/release/kanso run scripts/golden_prose"
  "welfare (one number over runtime and compile cost, ratcheted)"
  (breaking "a_published_number_drifts")
  release

grammar = row
  "an editor grammar that stops naming a string a string"
  true
  "./target/release/kanso run scripts/grammar_check"
  "editor grammar (types, strings, comments, operators)"
  (breaking "grammar_stops_painting")
  release

book_outputs = row
  "a recorded sample output the sample no longer produces"
  true
  "sh scripts/book_check.sh"
  "book samples (every panel executed, outputs verified)"
  (breaking "drifted_book_output")
  release

# book_check.sh runs two harnesses, and they fail for different reasons. The
# first regenerates a panel from the sample it renders; the second reads the
# panels that harness cannot resolve — a title naming a file this repository
# owns, or a directory module — against what those files declare and can name.
# One row per harness, because a mutation that reddens one leaves the other
# green, which is the whole point of asking.
book_quotes = row
  "a panel quoting a library the library no longer matches"
  true
  "./target/release/kanso run scripts/book_quotes"
  "book samples (every panel executed, outputs verified)"
  (breaking "a_quoting_panel_stops_matching_its_file")
  release

diagnostics = row
  "one engine wording a failure the other does not"
  true
  "./target/release/kanso run scripts/diagnostic_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "one_engine_reworded")
  release

accumulator = row
  "the accumulator rewrite deleted, which no counter and no golden can see"
  true
  "./target/release/kanso run scripts/trmc_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "accumulator_rewrite_deleted")
  release

rendering = row
  "the two renderers disagreeing on a value nobody thought to print"
  true
  "./target/release/kanso run scripts/render_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "native_renders_a_float_wider")
  release

# The row above covers the INTEGRAL fast path, which is the cast that renders a
# whole number under 1e15, and stops there. A value with a fraction or a wide
# exponent takes the shortest-round-trip branch instead, where the sign and the
# digits are placed by two different pieces of code that have to agree on an
# offset: the caller writes the minus and render_ryu is handed the magnitude
# and writes one byte past it. Seventy-three mutations and not one of them was
# a sign.
negative_sign = row
  "a negative rendering placed one byte off, so the sign is overwritten"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "native_drops_a_negative_sign")
  release

# A record of four fields or fewer copies them one at a time now, and a loop
# can be wrong about a count where the memcpy it replaced could not be: the
# count was that call's argument. A record that quietly loses its last field
# answers differently everywhere, which is what the corpus is for.
small_record = row
  "a small record's copy loop dropping a field"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_small_record_drops_its_last_field")
  release

# Sixteen bytes or fewer are appended by a pair of overlapping loads now, and
# the two stores in that pair differ in one character. Writing the head word
# where the tail word belongs corrupts every append of nine to sixteen bytes
# and nothing else, which is the size of an ordinary object key.
short_append = row
  "a short append writing its head word twice"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_short_append_copies_its_head_twice")
  release

# The mark's sanity check moved from the rewind to the push, where the mark is
# written, and the move is only sound if the check still runs. Nothing else
# would notice it going missing -- it is a diagnostic, and one that never fires
# reads exactly like one that was deleted. Inverting it kills every program
# with a beat loop at its first push.
beat_mark = row
  "the beat mark's sanity check reaching no program"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "the_beat_mark_check_fires_at_every_push")
  release

behaviour = row
  "a legal call answered differently at an edge, with nothing complaining"
  true
  "./target/release/kanso run scripts/behaviour_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "native_rounds_a_half_to_even")
  release

beat_cursor = row
  "a character read remembering a position into a string a beat has freed"
  true
  "./target/release/kanso run scripts/beat_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_cursor_that_outlives_its_string")
  release

dispatch = row
  "the two engines taking different arms for the same call"
  true
  "./target/release/kanso run scripts/dispatch_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_literal_arm_ranks_below_a_wildcard")
  release

numeric = row
  "the two engines answering one arithmetic operator differently"
  true
  "./target/release/kanso run scripts/numeric_differential -- 0"
  "diagnostics differential (both engines say the same thing)"
  (breaking "native_floors_a_negative_modulo")
  release

effects = row
  "two effects running in the wrong order on one engine"
  true
  "./target/release/kanso run scripts/effects_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "native_sequences_two_effects_backwards")
  release

modules = row
  "a name a module keeps private crossing an import anyway"
  true
  "./target/release/kanso run scripts/module_differential"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_private_name_crosses_an_import")
  release

coverage = row
  "a diagnostic arriving with no golden pinning its text"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_diagnostic_arrives_without_a_golden")
  release

decoder = row
  "a json decoder that reads something other than the document"
  true
  "sh scripts/gates/native_checksum.sh"
  "json decoder end-to-end (native, 150 decodes)"
  (breaking "a_decoder_that_answers_a_wrong_checksum")
  release

validator = row
  "a utf-8 validator the independent reference disagrees with"
  true
  "./target/release/kanso run scripts/utf8_differential"
  "utf-8 validator (differential vs an independent reference)"
  (breaking "a_validator_the_reference_disagrees_with")
  release

# A second row over the same sweep, because the sweep once could not see this
# one. Its sampled band stopped at eight bytes, and a validator that never
# reads past byte eight of a longer run passed 45,189,025 cases with nothing
# to say. The band reaches twenty-four now; this row is what keeps it there.
#
# Its gate read `whose "validator"` until 2026-09-03, which is
# `measured_on.sh bench/validator_golden.txt` — and there is no validator
# vein, so the file has never existed and the gate was red on every host
# before any mutation ran. The row therefore reported `red` and proved
# nothing from the day it was written. `prove`'s baseline pass found it on
# the first runtime-touching pull request after that pass landed, which is
# the whole reason the pass exists. The gate is the sweep the claim is about,
# the same one the row above it uses.
validator_tail = row
  "a utf-8 validator that never looks at the end of a long run"
  true
  "./target/release/kanso run scripts/utf8_differential"
  "utf-8 validator (differential vs an independent reference)"
  (breaking "a_validator_that_skips_its_tail")
  release

landing = row
  "a landing sample and the output the page prints under it disagreeing"
  true
  "./target/release/kanso run scripts/site_smoke"
  "site (landing sample and playground run in a browser)"
  (breaking "a_landing_sample_that_breaks_its_promise")
  release

in_the_page = row
  "the engine in the page answering what no other engine answers"
  true
  "bash scripts/browser_differential.sh"
  "browser differential (three engines, byte-identical, headless chrome)"
  (breaking "the_wasm_engine_answers_something_else")
  release

shop_window = row
  "a playground example the language will not run"
  true
  "cargo test --test playground"
  "playground examples (every engine)"
  (breaking "a_playground_example_the_engine_refuses")
  release

coverage_floor = row
  "a diagnostic whose literal run is the shortest the scan will keep"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_ten_character_diagnostic_arrives_without_a_golden")
  release

coverage_driver = row
  "a refusal the driver prints as plain text, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_driver_refusal_arrives_without_a_golden")
  release

itself = row
  "a gating job nobody said how to prove"
  true
  "./target/release/kanso run scripts/ratchet"
  "the ratchet (every gate has a mutation that turns it red)"
  (breaking "unrowed_ci_job")
  release

# The one vein whose headline row is a high water mark. Every other
# benchmark's peak is bounded by the size of its own text, so a change that
# moves what a program HOLDS and not what it allocates is invisible to them.
digest_counters = row
  "an arena block size raised without the peak it moves being measured"
  true
  (gating "digest_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_arena_block_that_grew_unmeasured")
  benchmarks

rows_a = [formatting linting python_free goldens mem_shapes release_profile]

rows_b1a = [decode_counters escape_counters pend_counters digest_counters]

rows_b1z = [thunk_walk scan_counters read_counters compile_libraries]

rows_b1 = text/concat rows_b1a rows_b1z

rows_b1b = text/concat rows_b1 [emitted_code emitted_others machine_code]

rows_b1c = text/concat rows_b1b [instructions_host text_host]

rows_b1d = text/concat rows_b1c [compile_allocs compile_allocs_host]

rows_b1d2 = text/concat rows_b1d [compile_ir compile_ir_host]

rows_b1e0 = text/concat rows_b1d2 [compile_ir_keyed compile_ir_doubled]

rows_b1e1 = text/concat rows_b1e0 [host_measures]

rows_b1e = text/concat rows_b1e1 [inline_pin chart_replay objective_row]

rows_b = text/concat rows_b1e [compile_mem compile_mem_host]

rows_c1 = [welfare_floor grammar book_outputs book_quotes error_corpus trend]

rows_c1a = text/concat rows_c1 [perf_row trend_runtime trend_joined]

rows_c1t = text/concat rows_c1a [trend_adrift trend_rebased trend_read]

rows_c1p = text/concat rows_c1t [published_numbers]

rows_c1b = text/concat rows_c1p [diagnostics accumulator]

rows_c1c0 = text/concat rows_c1b [rendering negative_sign small_record]

rows_c1c1 = text/concat rows_c1c0 [short_append beat_mark]

rows_c1c = text/concat rows_c1c1 [behaviour]

rows_c1d = text/concat rows_c1c [numeric effects]

rows_c1e = text/concat rows_c1d [modules coverage]

rows_c1f0 = text/concat rows_c1e [coverage_floor decoder]

rows_c1f = text/concat rows_c1f0 [validator validator_tail]

rows_c1g = text/concat rows_c1f [landing in_the_page shop_window]

# kq is a real program with its own JSON, and its own text goes through
# `text/append` seventy times, so a runtime that corrupts an in-place append
# reaches it. That is the row's mutation, and the shape ci.yml names as the
# reason this job gates at all.
#
# The gate clones kq the way the job does rather than expecting one beside the
# checkout, which is what the excuse this replaces claimed it needed. The clone
# directory must be named `kq`: `kanso build <dir>` names the binary for the
# directory and spec.sh invokes `./kq`.
asset_digests = row
  "a page that keeps its undigested reference while every asset is digested"
  true
  "{ag_gate}"
  "asset digests (every reference rewritten, site still runs)"
  (breaking "a_page_keeps_its_undigested_reference")
  release

kq_specs = row
  "a byte builder that writes the right length and the wrong bytes"
  true
  "{kq_gate}"
  "kq specs (a real program, gating)"
  (breaking "a_string_the_builder_corrupted_in_place")
  release

coverage_printed = row
  "an `error[kind]:` refusal printed as plain text, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_printed_error_kind_arrives_without_a_golden")
  release

rows_c1h = text/concat rows_c1g [dispatch coverage_driver]

# A FOURTH opener, and the file the scan could not see. `source?` took `.rs`
# only, so src/runtime.c — where a compiled binary gets its runtime messages —
# had never been read. Thirty-three of its sixty-six k_die texts were pinned by
# nothing.
coverage_native = row
  "a refusal the native runtime dies with, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_native_runtime_refusal_arrives_without_a_golden")
  release

# A FIFTH opener, on the engine the differential law calls the truth. eval.rs
# raises `RuntimeError { message: ... }` — a bare struct field none of the four
# above match — so all 97 of the oracle's refusals were rewordable in silence.
#
# Two rows because the extraction differs: `message: "` carries its own opening
# quote and the literal is the first piece of a split on it, where
# `message: format!(` may put the string on the next line and the literal is
# the second. One mutation would leave the other path untested.
coverage_oracle = row
  "a refusal the interpreter raises, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_refusal_arrives_without_a_golden")
  release

coverage_oracle_format = row
  "a refusal the interpreter formats, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_format_refusal_arrives_without_a_golden")
  release

rows_c1i = text/concat rows_c1h [coverage_printed kq_specs asset_digests]

rows_c1j = text/concat rows_c1i [coverage_native]

# A SIXTH opener, on the engine a reader meets FIRST — the website's playground
# runs `docs/kanso.wasm`, and until the scan learned bare `die(` none of
# wasm_rt.rs's 36 sites was read by any gate. Three of those sentences turned
# out to be saying the wrong thing on 2026-08-28, and a fourth was a wrong
# ANSWER rather than a wrong sentence.
#
# Two rows for the same reason as the oracle's two: `die("` carries its own
# opening quote and the literal is the first piece of a split on it, where
# `die(format!(` may put the string on the next line and the literal is the
# second.
coverage_page = row
  "a refusal only the page writes, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_page_refusal_arrives_without_a_golden")
  release

coverage_page_format = row
  "a page refusal built with format!, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_page_format_refusal_arrives_without_a_golden")
  release

rows_c1k = text/concat rows_c1j [coverage_oracle coverage_oracle_format]

rows_c1l = text/concat rows_c1k [coverage_page coverage_page_format]

rows_c1m = text/concat rows_c1l [beat_cursor]

rows_c = text/concat rows_c1m [itself]

rows = text/concat rows_a (text/concat rows_b rows_c)

# A job with no row and no reason is the thing this refuses. A reason is a
# sentence, not a flag: it has to say what would prove the job, so the debt is
# readable rather than a name on a list.
# The one job that keeps a reason, and the reason is not the one it had.
#
# It read "the mutations are `specs`'s; what this adds is a second machine".
# The second half holds. The first half stopped holding on 2026-08-27, when
# this job caught a defect `specs` passed on linux: a fixture interpolated its
# own absolute path into generated kanso source, so the source line's length
# became a property of the host's temp directory. Eighty characters is the
# limit; macOS's `/var/folders/...` took it to ninety-nine, and the run died on
# a formatting refusal before reaching what it meant to test. A defect class
# only the second machine can see is not `specs`'s mutation.
#
# What keeps the job unproven is the harness rather than the mutations. `prove`
# is authoritative on linux — this file says so in its own header — and it
# cannot run a macOS gate at all.
no_row_a = unproven
  "the other host (macos, arm)"
  "prove runs on linux and cannot reach a second machine's gate at all"

unproven_jobs = [no_row_a]

workflow = ".github/workflows/ci.yml"

# A job's display name sits at four spaces; a step's at six behind a dash, so
# the two cannot be confused by their indentation.
fn job_line? l
  text/slice l 1 10 == "    name: "

fn job_name l
  text/slice l 11 (length l)

fn jobs_in text
  lines = list/select (text/split text "\n") job_line?
  list/to_list (list/map lines job_name)

fn job_of r
  r.job

fn named? name group
  list/any? group (g -> g == name)

fn covered? name
  rowed = list/to_list (list/map rows job_of)
  excused = list/to_list (list/map unproven_jobs job_of)
  named? name rowed or named? name excused

fn known? declared name
  named? name declared

fn missing declared
  list/to_list (list/select declared (n -> not covered? n))

fn stale declared
  claimed = list/to_list (list/map rows job_of)
  excused = list/to_list (list/map unproven_jobs job_of)
  both = text/concat claimed excused
  list/to_list (list/select both (n -> not known? declared n))

cover = os/read_file! workflow . (text -> against (jobs_in text))

fn against declared
  gaps = missing declared
  ghosts = stale declared
  verdict gaps ghosts (length gaps == 0 and length ghosts == 0)

fn verdict _ _ true
  io/write "ratchet: every ci job carries a mutation or a stated reason\n"
    . (_ -> applies_all)

fn verdict gaps ghosts false
  said = list/to_list (list/map gaps (n -> "  no row and no reason: {n}\n"))
  gone = list/to_list (list/map ghosts (n -> "  no such ci job: {n}\n"))
  body = text/join (text/concat said gone) ""
  saying = "ratchet: the table and ci.yml disagree\n{body}"
  io/write_err saying . (_ -> os/exit 1)

# APPLYING a mutation costs a sed; proving it reddens its gate costs a build.
# Those are different prices, and only the second one needs the nightly. So the
# cheap half runs here, on every change: a mutation that no longer matches the
# source it patches is a row that has quietly stopped proving anything.
#
# This exists because pending_cells_proven_strict anchored on a line #1015
# rewrote, and the nightly said so the next morning — correctly, precisely, and
# to nobody. Fifteen hours later it was still red. A per-PR signal gets answered
# because it blocks a merge, so the check that would have caught #1015 belongs
# in #1015's own pull request.
#
# Like `prove`, this reads a worktree of HEAD rather than the working tree, so
# it answers for what a pull request carries rather than for what is still
# unsaved beside it.
applies_all = borrowed "/tmp/kanso-ratchet-applies"

fn borrowed dir
  os/run "git" ["worktree" "add" "--detach" "--force" dir "HEAD"]
    . (_ -> applying dir rows 1 [])

fn applying dir list at acc
  applied dir list at acc (at > length list)

fn applied dir _ _ acc true
  os/run "git" ["worktree" "remove" "--force" dir] . (_ -> intact acc)

fn applied dir list at acc false
  r = list[at]!
  shell dir r.mutation . (m -> after_try dir list at acc r m.status)

# The worktree is restored between rows so one stale mutation cannot make the
# next one look stale too.
fn after_try dir list at acc _ 0
  restored dir . (_ -> applying dir list (at + 1) acc)

fn after_try dir list at acc r _
  restored dir . (_ -> applying dir list (at + 1) (push acc r))

fn restored dir
  shell dir "git checkout -- . && git clean -fdq"

fn intact acc
  standing acc (length acc == 0)

fn standing _ true
  io/write "ratchet: every mutation still matches the source it patches\n"

fn standing acc false
  said = list/to_list (list/map acc (r -> "  STALE {r.job} — {r.claim}\n"))
  body = text/join said ""
  saying = "ratchet: {length acc} mutations no longer apply\n{body}"
  io/write_err saying . (_ -> os/exit 1)

# Each row runs in a worktree of HEAD, so a mutation cannot reach the tree the
# author is working in and two rows cannot see each other's damage.
fn shell dir cmd
  os/run "sh" ["-c" "cd {dir} && {cmd}"]

# A mutation that still applies can still prove nothing. kanso#1157 put an
# early return above the line compile_allocs_unwatched.sh patches, and the
# patch went on applying — to a line eleven thousand of lib/json's twelve
# thousand occurrences never reach. The counter moved by zero and the row was
# blind. `applies_all` cannot see that, because applying is not proving, and
# only proving costs a build. The nightly saw it the next morning, twice, and
# said so to nobody.
#
# Both rows that went blind on 2026-08-30 were killed by a change to the very
# file their own mutation patches, and which files a change touches is
# something a pull request knows about itself:
#
#   kanso run scripts/ratchet -- touched origin/main
#
# keeps the rows whose mutation GUARDS on a file the branch changed and proves
# that handful. `read_it` below says why the guard rather than the mention.
#
# HOW BIG THE HANDFUL IS depends on what the branch touched, and the honest
# answer is a range rather than a number. A branch touching one source file
# selects the rows guarding on it: #1171 touched src/runtime.c and #1157 and
# #1188 touched src/lib.rs, and all three would have been answered on the pull
# request that broke them. But src/runtime.c alone is guarded on by thirteen
# mutations, so a runtime branch selects a large block however the rule is
# written, and the saving here does not reach that case. That number said
# twenty and counted GUARD LINES rather than rows, which is not what the rule
# selects: twelve mutations guarded on the file across twenty-one lines, and
# the row this change adds makes it thirteen across twenty-three. Measured on
# three real diffs:
#
#     kanso#1249, 45 changed files    naming 32 rows -> guard 14
#     kanso#1252, 21 changed files    naming  7 rows -> guard  1
#     kanso#1253, 10 changed files    naming  8 rows -> guard  1
#
# Those are a reading of a corpus that moves: taken against 73 mutations, and
# there are 74 on disk now. An earlier reading of the first two, at 72
# mutations, put them at 33 -> 12 and 8 -> 1. So the figures are an order of
# magnitude rather than a pin, and the specs beside this deliberately assert no
# count for that reason.
#
# The comment this replaces said "usually empty and occasionally one to three",
# which was true of the branches it cited and wrong by an order of magnitude on
# a goldens-heavy one.
#
# It is a middle, not a replacement. `cover` still runs on every change and
# the nightly still proves the whole table, because a row can also go blind
# from a distance — the guard #1157 added is in the file, but a change to what
# a gate READS could hollow a row without touching a line any sed matches.
fn touched base mode
  os/run "git" ["diff" "--name-only" "{base}...HEAD"] . (d -> diffed d mode)

fn diffed d mode
  branch_files d mode (d.status == 0)

# Carrying git's own words, because the first thing this refusal caught was a
# shallow checkout with no merge base to diff against, and "would not run" sent
# a reader to the ratchet rather than to the workflow's fetch-depth.
fn branch_files d _ false
  said = "ratchet: git could not name this branch's files\n"
  io/write_err "{said}{d.stderr}" . (_ -> os/exit 1)

fn branch_files d mode true
  named = list/select (text/split d.stdout "\n") (f -> length f > 0)
  winnowing mode (list/to_list named) rows 1 []

fn winnowing mode files list at acc
  winnowed mode files list at acc (at > length list)

fn winnowed mode _ _ _ acc true
  handful mode acc

fn winnowed mode files list at acc false
  r = list[at]!
  os/read_file! (script_of r) . (s -> read_it mode files list at acc r s)

# A row's mutation is a shell command and its script is the word after `sh `.
fn script_of r
  text/slice r.mutation 4 (length r.mutation)

# WHAT A ROW DEPENDS ON is its guard, not every path its script mentions.
#
# A mutation carries `grep -q '<literal>' <file>` precisely so it refuses
# rather than silently applying when the text it patches has moved. That guard
# IS the dependency: a change can only make a mutation inert by moving what the
# guard matches. Reading the whole script instead selects every row that
# mentions a file for any reason, which on a goldens-heavy branch is most of
# the table — measured against kanso#1249's 45 changed files, naming selected
# 33 rows where 12 were at risk.
#
# GOLDENS COME OUT, checked rather than assumed. Over all the mutations on
# disk, exactly two golden guards carry a value-shaped number and both are
# POST-conditions checking what the mutation itself just wrote. Every other
# golden guard matches a key name and a digit class — `^jsonbench [0-9]`,
# `^defines=999999` — so a regeneration moves the digits and the guard still
# matches. Regenerating a golden cannot make any of them inert, so a row whose
# only touched guard is a golden has nothing to prove.
fn read_it mode files list at acc r s
  guards = guarding s
  hit = list/any? files (f -> at_risk? guards f)
  reaches mode files list at acc r hit

fn guarding s
  list/select (text/split s "\n") (l -> spells? l "grep -q")

fn at_risk? guards f
  source? f and list/any? guards (l -> spells? l f)

fn source? f
  not under? f "bench/" and not under? f "tests/golden/"

fn under? f dir
  length f > length dir and text/slice f 1 (length dir) == dir

fn spells? text path
  length (text/split text path) > 1

fn reaches mode files list at acc _ false
  winnowing mode files list (at + 1) acc

fn reaches mode files list at acc r true
  winnowing mode files list (at + 1) (push acc r)

fn handful mode acc
  chose mode acc (length acc == 0)

fn chose _ _ true
  io/write "ratchet: this branch touches no file any mutation patches\n"

fn chose mode acc false
  said = "ratchet: {length acc} rows patch a file this branch changed\n"
  listed = list/to_list (list/map acc (r -> "  {r.job} — {r.claim}\n"))
  body = text/join listed ""
  io/write "{said}{body}" . (_ -> onto mode acc)

# `list` names the handful and stops, the way somebody about to spend six
# minutes of runner wants to know what they are spending it on. Anything else
# proves them.
fn onto "list" _
  io/write ""

fn onto _ acc
  baselined acc

fn prove_all scope
  picked = list/to_list (list/select rows (r -> asked? scope r))
  chose_rows scope picked (length picked == 0)

# A scope naming no row would otherwise prove nothing and report that every
# row turned its gate red, which is the same false green in miniature.
fn chose_rows scope _ true
  io/write_err "ratchet: no row is named by `{scope}`\n" . (_ -> os/exit 1)

fn chose_rows _ picked false
  baselined picked

fn asked? "all" _
  true

fn asked? "cheap" r
  not r.dear

# Any other word selects by job name, so a spec — or somebody debugging one
# row — can prove a single gate without paying for sixty.
fn asked? scope r
  spells? r.job scope

# A row is proof only if the gate it reddened was green to begin with, and
# nothing checked that. `after_gate` read a non-zero exit as the mutation's
# doing, so a gate already red on HEAD would have been credited to every
# mutation that shares it: the rows would pass while proving nothing, which is
# the exact defect this table exists to catch, sitting inside the table's own
# harness. It is not a hypothetical shape: `prove` builds in a worktree with a
# shared target directory and stub scratch dirs that ci.yml does not use, and a
# gate red for one of those reasons looks identical to a gate red for the
# mutation.
#
# So every gate is read once on an unmutated worktree first, and a baseline
# that is not green stops the run rather than colouring it. Deduplicated
# because the 62 rows name 50 distinct (gate, setup) pairs — nine rows share
# the diagnostic-coverage gate and four share the trend gate — so the baseline
# costs 50 gate runs beside the 62 the proving already pays. One worktree
# serves the whole pass: nothing mutates it, so there is nothing to restore
# between pairs and only the first setup's build is cold.
#
# It reads HEAD before any row runs, so it answers for the tree and not for
# what a row leaves behind: a mutation that dirties a shared scratch path and
# reddens a LATER row's gate is still counted as that row's proof. Rows do not
# share scratch paths today, and the fix if one ever does is to re-read that
# gate rather than to widen this pass.
base_dir = "/tmp/kanso-ratchet-base"

fn pairs_in list at acc
  pair_seen list at acc (at > length list)

fn pair_seen _ _ acc true
  acc

fn pair_seen list at acc false
  r = list[at]!
  same? = (p -> p.gate == r.gate and p.setup == r.setup)
  kept list at acc r (list/any? acc same?)

fn kept list at acc _ true
  pairs_in list (at + 1) acc

fn kept list at acc r false
  pairs_in list (at + 1) (push acc (pair r.gate r.job r.setup))

fn baselined picked
  made = ["worktree" "add" "--detach" "--force" base_dir "HEAD"]
  os/run "git" made . (_ -> base_linked picked)

fn base_linked picked
  linking = "mkdir -p {shared_target} && ln -s {shared_target} target"
  pairs = pairs_in picked 1 []
  shell base_dir linking . (_ -> greening picked pairs 1 [])

fn greening picked pairs at acc
  greened picked pairs at acc (at > length pairs)

fn greened picked pairs _ acc true
  os/run "git" ["worktree" "remove" "--force" base_dir]
    . (_ -> unmutated picked pairs acc)

fn greened picked pairs at acc false
  p = pairs[at]!
  shell base_dir p.setup . (s -> base_setup picked pairs at acc p s.status)

fn base_setup picked pairs at acc p 0
  shell base_dir p.gate . (g -> base_gate picked pairs at acc p g)

fn base_setup picked pairs at acc p s
  greening picked pairs (at + 1) (push acc (unmade p s))

fn base_gate picked pairs at acc p g
  read_gate picked pairs at acc p g (g.status == 0)

fn read_gate picked pairs at acc _ _ true
  greening picked pairs (at + 1) acc

fn read_gate picked pairs at acc p g false
  greening picked pairs (at + 1) (push acc (presumed p g))

# The last two dozen lines of what the gate said, indented under the finding.
#
# Naming the gate was the previous shape of this, and it answered the question
# it was built for on its first run: `sh scripts/gates/instructions.sh`, red
# because valgrind was not on the ratchet's box. It could not answer the SECOND
# one. With valgrind installed the same gate was still red, and a report that
# says only which gate leaves the reader with a list of hypotheses and no way
# to choose — which is the shape of reasoning this repo keeps catching. A gate
# writes down why it failed; the ratchet was throwing that away.
#
# TWENTY-FOUR because eight was not enough on the first run that used it. The
# instructions gate prints the cpu it is about to count on, then eleven rows,
# then its diff, then six lines of advice — and eight lines caught the advice
# and one row. The row it caught was the useful part (`digestbench 81252330`
# against the cost-goldens job's 81252316 on the same commit), so the next one
# should carry the whole diff and the cpu line rather than needing a second run
# to ask again.
fn spoke r
  said = "{r.stdout}{r.stderr}"
  lines = text/split said "\n"
  over = length lines - 24
  tail = list/to_list (list/drop lines (chose_drop over (over > 0)))
  text/join (list/to_list (list/map tail (l -> "      {l}\n"))) ""

fn chose_drop over true
  over

fn chose_drop _ false
  0

fn unmade p r
  said = "  UNBUILT {p.job}\n    gate: {p.gate}\n"
  finding "{said}    the baseline would not build\n{spoke r}" false

fn presumed p r
  told p r (host_bound? p.gate)

fn told p r true
  said = "  UNPROVEN THIS RUN {p.job}\n    gate: {p.gate}\n"
  why = "{why_bound p.gate}, so this run cannot prove a row sharing it"
  finding "{said}    {why}\n{spoke r}" true

fn told p r false
  said = "  ALREADY RED {p.job}\n    gate: {p.gate}\n"
  why = "red before any mutation, so no row sharing it is proof"
  finding "{said}    {why}\n{spoke r}" false

fn unmutated picked pairs acc
  bad = list/to_list (list/select acc (f -> not f.ok))
  settled_base picked pairs acc (length bad == 0)

# A note is printed and then the run carries on; only a finding nobody excused
# stops it. Both go to stderr, because a row that went unproven is news.
fn settled_base picked pairs acc true
  said = green_line pairs acc (length acc == 0)
  io/write_err (said_with acc said) . (_ -> proving (kept_provable picked) 1 [])

# Two numbers when any gate went unproven, because "green" would be a claim
# about gates this runner never answered. One number when none did, which is
# the ordinary run and the wording the spec has pinned since kanso#1228.
fn green_line pairs _ true
  "ratchet: {length pairs} gates green before any mutation\n"

fn green_line pairs acc false
  read = length pairs
  "ratchet: {read} gates read, {length acc} unproven on this runner\n"

fn settled_base _ _ acc false
  said = "ratchet: the baseline is not green\n"
  io/write_err (said_with acc said) . (_ -> os/exit 1)

fn said_with acc said
  lines = list/to_list (list/map acc (f -> f.line))
  body = text/join lines ""
  "{said}{body}"

# A row whose gate this run cannot answer is not run under mutation either:
# applying a mutation to an already-red gate and reading red is the credit the
# baseline exists to refuse.
fn kept_provable picked
  list/to_list (list/select picked (r -> not host_bound? r.gate))

fn proving list at acc
  proven list at acc (at > length list)

fn proven list _ acc true
  reported list acc

fn proven list at acc false
  r = list[at]!
  dir = "/tmp/kanso-ratchet-{at}"
  made = ["worktree" "add" "--detach" "--force" dir "HEAD"]
  os/run "git" made . (_ -> after_worktree list at acc r dir)

# Every row's build lands in one directory, so the first is cold and the rest
# are incremental. A dozen rows each paying a full release build is an hour
# that buys nothing: cargo already rebuilds exactly what the mutation touched.
# Created here rather than assumed: nothing else makes this directory, so on a
# fresh machine the symlink dangled, `cargo build` failed with "Not a
# directory", and every row carrying `release` as setup was counted red without
# its gate ever running.
shared_target = "/tmp/kanso-ratchet-target"

fn after_worktree list at acc r dir
  linking = "mkdir -p {shared_target} && ln -s {shared_target} target"
  shell dir linking . (_ -> after_target list at acc r dir)

fn after_target list at acc r dir
  shell dir r.mutation . (m -> after_mutation list at acc r dir m.status)

fn after_mutation list at acc r dir 0
  shell dir r.setup . (s -> after_setup list at acc r dir s.status)

fn after_mutation list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (broke r)))

fn after_setup list at acc r dir 0
  shell dir r.gate . (g -> after_gate list at acc r dir g.status)

fn after_setup list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (unbuilt r)))

fn after_gate list at acc r dir 0
  cleaned dir . (_ -> proving list (at + 1) (push acc (blind r)))

fn after_gate list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (red r)))

fn cleaned dir
  os/run "git" ["worktree" "remove" "--force" dir]

fn red r
  finding "  red   {r.job} — {r.claim}\n" true

fn blind r
  finding "  BLIND {r.job} — {r.claim}: the gate stayed green\n" false

fn broke r
  finding "  BROKE {r.job} — {r.claim}: the mutation would not apply\n" false

fn unbuilt r
  finding "  UNBUILT {r.job} — {r.claim}: it would not build\n" false

fn reported list acc
  lines = list/to_list (list/map acc (f -> f.line))
  body = text/join lines ""
  bad = list/to_list (list/select acc (f -> not f.ok))
  io/write "ratchet: {length list} rows\n{body}" . (_ -> settled list bad)

fn settled list bad
  closed list bad (length bad == 0)

# An empty list here is not success. When every row a branch selected shares a
# host-bound gate, `kept_provable` drops them all and the loop has nothing to
# run — and the old wording congratulated it, which is the false green this
# whole pass exists to refuse. Nothing was proved, the run says so, and it does
# not fail, because no diff could have proved them on this runner.
fn closed list _ true
  none_left (length list == 0)

fn none_left true
  said = "ratchet: no row on this runner could be proved; none was claimed\n"
  io/write_err said

fn none_left false
  io/write "ratchet: every row turned its gate red\n"

fn closed _ bad false
  io/write_err "ratchet: {length bad} rows proved nothing\n" . (_ -> os/exit 1)

fn asked given
  verb given (length given > 0)

fn verb given true
  chosen given[1]! given

fn verb _ false
  cover

fn chosen "prove" given
  prove_all (second given "all")

fn chosen "touched" given
  touched (second given "origin/main") (third given "prove")

# The selection rule, driven by a file list written on the command line rather
# than asked of git:
#
#   kanso run scripts/ratchet -- select src/runtime.c bench/cost_golden.txt
#
# `touched` gets its files from `git diff` against a base, which makes the rule
# it applies impossible to check without a repository shaped for the check.
# This is the same rule with the same code and the list handed in, so a spec can
# ask what a diff of one source file selects, what a goldens-only diff selects,
# and what the two together select, on inputs it wrote down. It lists and stops;
# proving is `touched`'s job.
fn chosen "select" given
  winnowing "list" (list/to_list (list/drop given 1)) rows 1 []

fn chosen _ _
  cover

fn second given fallback
  beyond given fallback (length given > 1)

fn beyond given _ true
  given[2]!

fn beyond _ fallback false
  fallback

fn third given fallback
  past given fallback (length given > 2)

fn past given _ true
  given[3]!

fn past _ fallback false
  fallback

pub play = os/args . (given -> asked given)
