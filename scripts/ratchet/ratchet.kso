# render_ryu's plain branches copied ryu's digits with `k_copy_short`, and a
# row guarded those copies until 2026-09-24, when every benchmark float began
# taking the direct writer instead and the copies went unreached. This row
# guards the direct writer: closing it sends the floats back through the
# digit buffer, and the work vein is the only thing that can see that.
ryu_words = row
  "a short float written through the digit buffer again"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_float_written_through_the_digit_buffer")
  benches

size_walk = row
  "a sizing walk that calls on every immediate"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_sizing_walk_that_calls_on_every_immediate")
  benches

chain_drift = row
  "a chain step that sizes its continuation every step"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_chain_step_that_sizes_its_continuation_every_step")
  benches

# The emitted-code vein is the one that sees this, because what the set
# removes is a call: `k_force_fast` in front of every `if` over a comparison.
# The allocation counters cannot -- forcing a value that is not a thunk
# allocates nothing -- and that is the dimension #1064 built this gate for.
thunk_set = row
  "a comparison the emitter could not prove is not a thunk"
  false
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_comparison_that_might_be_a_thunk")
  benches

# The same vein, one bit apart. ERR is outside BOOL, so putting it back stops
# `inline_not_failure` proving the value is a boolean and the tag test is
# written again -- 51 of them in runbench. Two rows rather than one because
# the thunk row mutates to TOP, which takes out both facts at once and could
# not tell a reader which of them had gone.
failure_set = row
  "a comparison the emitter could not prove is not a failure"
  false
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_comparison_that_might_be_a_failure")
  benches

pop_deep = row
  "a carried pop that prunes at a survivor"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_carried_pop_that_prunes_at_a_survivor")
  release

compile_mem = row
