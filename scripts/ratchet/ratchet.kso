import "std/io"
import "std/list"
import "std/os"
import "std/text"

# A gate nobody has watched fail has no evidence it works. Five checks went
# green in one day while checking nothing: a book gate whose writer was never
# run, a fusion that fired zero times, a corpus that crossed no err-provenance
# seam, an instruction count measuring the length of a run id. Each of them
# passed, and each of them was blind.
#
# So every job in .github/workflows/ci.yml carries at least one row here: a
# defect to introduce and the command that must then go red. `cover` checks
# that correspondence and costs nothing, so it runs on every change and a new
# job cannot land without its row. `prove` reads every gate once on an
# unmutated worktree, then applies each mutation in a scratch worktree of its
# own and refuses a gate that stayed green.
#
#   kanso run scripts/ratchet                 every job has a row
#   kanso run scripts/ratchet -- prove        every row turns its gate red
#   kanso run scripts/ratchet -- prove cheap  the rows that need no build
#   kanso run scripts/ratchet -- prove utf-8  the rows whose job name says so
#
# `prove` is authoritative on linux, where every gate can run. A gate needing
# a tool the host lacks says so and exits non-zero, which reads here as red
# and is not evidence: the nightly runs where ci does.
#
# `setup` prepares what the gate reads and MUST succeed. It used to be allowed
# to fail, on the reading that a build the mutation broke is the gate going red
# early; that reading credits a row whose gate never ran. The ten rows that
# carry `release` as setup all have gates that read a counter or a golden, and
# a tree that will not compile never reaches one, so a broken build there is
# UNBUILT rather than red. The rows whose defect IS a build or lint failure —
# clippy bait, misformatted source, a given-up tail call — carry `no_setup` and
# do the building inside the gate, where it still counts. `dear` marks a row
# that builds the compiler.
type row
  claim
  dear
  gate
  job
  mutation
  setup

type unproven
  job
  why

# A finding names the gate it is about, not only the line it prints. The
# proving pass reads that back: a host-bound row is skipped when the BASELINE
# could not answer its gate, and proved normally when it could, which is what
# `type bound` below has always said should happen.
type finding
  line
  ok
  gate

# A gate whose answer is only meaningful where its golden was measured.
#
# `bench/instructions_golden.txt` pins eleven exact counts and the runner pool
# is not one machine. On 2026-09-03 the cost-goldens job and the ratchet job,
# on ONE commit, read `digestbench 81252316` and `81252330` — fourteen apart,
# two runners, one image, one glibc. A row whose gate diffs those counts is red
# on any runner but the golden's, whatever the mutation did.
#
# That is not the branch's failure and no diff fixes it, so the baseline reports
# such a gate and does not fail on it. The row is NOT credited either: the
# proving pass skips every row sharing that gate and says so. The distinction
# is the whole point — before kanso#1228 a red gate was counted as proof, which
# is the blindness; saying out loud that a row went unproven this run is the
# opposite of that, and on a run that lands on the golden's silicon the row is
# proved normally.
type bound
  gate
  why

# One (gate, setup) pair the baseline reads once, named by the first row that
# carries it.
type pair
  gate
  job
  setup

no_setup = "true"

release = "cargo build --release"

# The work vein reads the eleven binaries, so they have to exist and be
# rebuilt from the mutated runtime before the gate can see anything.
benches = "cargo build --release && sh scripts/gates/build_benchmarks.sh"

# One line because a gate is a shell string. `$PWD` is read before the `cd`,
# so KANSO names the worktree's own binary rather than anything on the host.
kq_clone = "rm -rf /tmp/kq && sh .github/clone-sibling.sh kq /tmp/kq"

kq_run = "KANSO=$K KQ_STORED=report sh spec.sh"

kq_gate = "{kq_clone} && K=$PWD/target/release/kanso && cd /tmp/kq && {kq_run}"

# The asset-digests job builds the site with a jekyll ACTION, which a shell gate
# cannot run — which is what the excuse this replaces said, and it was reading
# the job rather than the assertion. What the job asserts is
# `scripts/gates/undigested_references.sh`, two greps over a built `_site`, and
# a plain copy of `docs/` reproduces both states: green once fingerprint has
# rewritten the references, red before it has. Measured both ways.
#
# `kanso.wasm` is stood in for. The assertion counts surviving references and
# says nothing about any digest, so the size of one asset cannot change the
# answer — and the real blob costs about fourteen gigabytes of live arena to
# hash, which is filed as a blocking decision in design/pending-gavels.md. A
# second CI job holding that much every run is not a cost to add while the
# question is open.
ag_dir = "rm -rf /tmp/agsite && mkdir -p /tmp/agsite"

ag_site = "{ag_dir} && cp -r docs /tmp/agsite/_site"

ag_stub = "printf 'stand-in\\n' > /tmp/agsite/_site/kanso.wasm"

ag_run = "$W/target/release/kanso run $W/scripts/fingerprint -- ./_site"

ag_check = "sh $W/scripts/gates/undigested_references.sh"

ag_made = "{ag_site} && {ag_stub} && W=$PWD"

ag_gate = "{ag_made} && cd /tmp/agsite && {ag_run} && {ag_check}"

benchmarks = "sh scripts/gates/build_benchmarks.sh"

# scripts/site_smoke reads docs/kanso.wasm, and kanso#1350 stopped committing
# the blob. ci.yml's site job rebuilds it in the step before the gate; the
# landing row set its worktree up with `release` alone, so from that day the
# gate answered `cannot read docs/kanso.wasm: no such file` on the baseline
# before any mutation was applied, and the ratchet reads a red gate as proof.
# Read off ratchet run 33, 2026-09-13.
#
# The wasm32 TARGET was already on the box and is not the same thing:
# scripts/ratchet/toolchain.sh installs it and says the browser rows' gates
# rebuild the blob with it, which is true of browser_differential.sh -- that
# script runs build_wasm.sh itself at line 9 -- and was never true of this one.
# tests/the_ratchet_carries_what_its_gates_need.rs pins the difference, which
# its install-line reader could not see.
with_blob = "sh scripts/build_wasm.sh && cargo build --release"

fn breaking name
  "sh scripts/ratchet/mutations/{name}.sh"

fn gating name
  "sh scripts/gates/{name}.sh"

# The host check is one script over two goldens, so its rows name the vein
# rather than a script of their own.
fn whose vein
  "sh scripts/gates/measured_on.sh bench/{vein}_golden.txt"

why_exact = "its golden is exact counts and the pool is not one machine"

work_gate = "sh scripts/gates/instructions.sh"

front_gate = "sh scripts/gates/compile_instructions.sh"

# The entry path's own row. It counts under callgrind exactly as the two above
# do, so a runner the golden does not name refuses it the same way, and a
# refusal reported as a regression is the failure this list prevents.
entry_gate = "sh scripts/gates/entry_instructions.sh"

# The library path's row, the third of the three `kanso check` takes. It counts
# under callgrind like the rest, so it belongs on this list for the same reason:
# a runner the golden does not name refuses it, and a refusal read as a
# regression fails a job over the machine it ran on.
library_gate = "sh scripts/gates/library_instructions.sh"

# The interpreted run's own row, and the first on this list that counts a
# program EXECUTING rather than a program being compiled. It counts under
# callgrind like the four above, so a runner the golden does not name refuses
# it the same way, and a refusal read as a regression fails a job over the
# machine it ran on.
interp_gate = "sh scripts/gates/interp_instructions.sh"

# Start-up, the fourth callgrind row and the only one that reaches codegen: the
# three above run `kanso check`, which stops before it. It counts the same way
# they do, so a runner the golden does not name refuses it the same way, and a
# refusal read as a regression fails a job over the machine it ran on.
startup_gate = "sh scripts/gates/startup_instructions.sh"

# The two codegen rows. They count a whole `kanso build` tree under
# callgrind with --trace-children, so they are host-bound for the same reason
# the four above are: a runner the golden does not name refuses the
# comparison, and a refusal read as a regression fails a job over the machine
# it ran on. One script serves both tiers, so one entry covers them.
codegen_gate = "sh scripts/gates/codegen_instructions.sh"

emit_gate = "sh scripts/gates/emit_instructions.sh"

bound_a = bound work_gate why_exact

bound_b = bound front_gate why_exact

bound_c = bound entry_gate why_exact

bound_d = bound library_gate why_exact

bound_e = bound interp_gate why_exact

bound_f = bound startup_gate why_exact

bound_g = bound codegen_gate why_exact

bound_h = bound emit_gate why_exact

host_bound = [bound_a bound_b bound_c bound_d bound_e bound_f bound_g bound_h]

fn host_bound? gate
  list/any? host_bound (e -> e.gate == gate)

fn why_bound gate
  found = list/to_list (list/select host_bound (e -> e.gate == gate))
  found[1].why

formatting = row
  "a file rustfmt would rewrite"
  false
  "cargo fmt --check"
  "format (rustfmt, checked not applied)"
  (breaking "misformatted_source")
  no_setup

linting = row
  "a borrow clippy refuses"
  true
  "cargo clippy --all-targets -- -D warnings"
  "lint (clippy, all targets)"
  (breaking "clippy_bait")
  no_setup

python_free = row
  "a python call creeping back into a harness"
  false
  (gating "python_free")
  "python-free (the harnesses stay kanso)"
  (breaking "python_creeps_back")
  no_setup

goldens = row
  "a micro sample answering something else"
  true
  "cargo test --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "drifted_micro_golden")
  no_setup

# The foreign-only rescue licence, at the word: a `.?` written in the package
# that raised the failure hands it on without entering its callback. The
# mutation deletes the interpreter's licence arm, and the micro fixture that
# pins the licence prints the callback's answer where the golden says the
# failure went by.
rescue_licence = row
  "a rescue that enters the callback on its own package's failure"
  true
  "cargo test --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_rescue_that_enters_its_own_packages_callback")
  no_setup

# A measured decision that goes to Clay must have an entry in the ledger to
# go to. Two sends were found sitting in the log with none, two days apart,
# so the spec reads the log for the family. The mutation takes the ledger's
# name out of the paragraph that files the `.rodata` page pin, and the spec
# names that send as unanswered.
clay_send_filed = row
  "a measured decision sent to Clay with no ledger entry to go to"
  true
  "cargo test --release --test a_question_sent_to_clay_has_a_ledger_entry"
  "specs (unit, golden, differential)"
  (breaking "a_send_to_clay_with_no_ledger_entry")
  no_setup

# The 2026-09-15 ruling's third part: a raised err arriving where a value is
# wanted does not compile. The mutation deletes the one call that asks, and
# the three error fixtures that pin the refusal then compile clean, which the
# error corpus reports as a golden holding a diagnostic nobody raised.
raised_err = row
  "a raised err reaching a value site that compiles"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_raised_err_reaching_a_value_site_compiles")
  no_setup

# A failure crossing a beat carry in the two-word record convention was boxed
# as a record and read back out of one; the mutation puts the read back and
# the mem fixture a_failure_crosses_a_beat_carry_in_two_words dies on native
# where the interpreter answers.
carry_failure = row
  "a failure read as a record on the far side of a carry"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "a_failure_read_as_a_record_at_a_carry_take")
  release

# An `e@(err _)` arm at a carried slot needs no record, and the mutation makes
# it ask for one: the fixture an_err_as_pattern_keeps_a_carried_slot_unboxed
# reads sh_rec=64000 against its 0.
err_as_pattern = row
  "an err as-pattern that boxes a carried slot"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "an_err_as_pattern_boxes_a_carried_slot")
  release

# A cell can evaluate to a cell: `rest = names_any? ...` deferred in every
# arm of a recursion and handed back through `either? _ answer`. The runtime
# forced one level and the dispatcher tested a cell's tag against `true`;
# the browser differential harness died in `put_unless` on every corpus
# directory. The force walks the chain now, on native and on the page.
force_chain = row
  "a cell whose answer is a cell, forced one level"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_deferred_answer_is_forced_one_level")
  release

# `effect v` is the box built by hand, ruled 2026-09-15. The interpreter is
# the oracle for what it settles to, and native is compared with it on the
# fixture that starts every chain shape from one. The mutation makes the
# interpreter hand the value over unboxed.
hand_box = row
  "the box built by hand answering its value bare on one engine"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "the_hand_built_box_answers_its_value_bare")
  release

# A rescue or annotate callback is entered with the failure itself. The
# emitter trusts inference for a group's entry guard, so a callback lambda
# whose parameter is seeded as never failing costs native the guard on the
# group it hands the err to, and the interpreter is the oracle that refuses.
callback_err = row
  "a chain callback's parameter seeded as never failing"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_chain_callbacks_parameter_never_fails")
  release

# `xs[i]!` answers a box, the element or the missing-index err bubbling
# through it, and the words are what open it (ruled 2026-09-16, reversing
# the same morning's reading). The site walk refuses the box at an operator,
# a field read and a builtin the way it refuses any other effect there; this
# row is the arm of `yields_box` that says a strict index is one.
bang_box = row
  "a strict index the words cannot open"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_strict_index_the_words_cannot_open")
  release

# The plain read is the element or a none, and the bound written where the
# read is discharges the none: a guard returning before an out-of-range read
# leaves the element as the only answer. Two rows because the prover has two
# doors, the facts an `if` pushes and the length a literal list spells out.
guard_bound = row
  "a bound the guard never discharges"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_bound_the_guard_never_discharges")
  release

literal_bound = row
  "a literal list of unknown length"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_literal_list_of_unknown_length")
  release

# A type name inside a shell is several names: `<g/cell>effect` holds one
# qualified name and one bare one, and the import check has to see the
# qualified one. Splitting the whole spelling at its first slash answered
# `<g`, which no import matches, so a file was refused for borrowing an
# import it wrote and that import read as unused in the same run.
qualified_yield = row
  "a type name split at its first slash"
  true
  "cargo test --release --test a_qualified_yield_inside_an_effect_type"
  "specs (unit, golden, differential)"
  (breaking "a_type_name_split_at_its_first_slash")
  release

# The lines below a `return x if c` guard are the guard's untaken arm, and a
# name bound there is a binding of the same body. Two analyses follow an
# accumulator through the names it is bound to, and until 2026-09-16 both
# read the top level only; the mem fixture pins the beat and the flat
# allocation count a loop keeps when its accumulator passes through such a
# name. One row per reader: the linearity analysis, whose lookup decides the
# in-place appends, and the beat's chain test, whose decides the bracket.
guard_bind_linear = row
  "a binding under a guard the linearity analysis cannot see"
  true
  "cargo test --release --test golden mem_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_binding_under_a_guard_the_linearity_analysis_cannot_see")
  release

guard_bind_chain = row
  "a binding under a guard the chain cannot pass through"
  true
  "cargo test --release --test golden mem_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_binding_under_a_guard_the_chain_cannot_pass_through")
  release

# The boundary rule lets a byte builder cross a rewind when the self-call's
# argument chains from the builder that arrived, and it reads the builder at
# the position under test as well as the first parameter; builder_transient
# carries its builder third and pins the beat (beat_iters 1,360).
bytes_acc_position = row
  "a byte builder carried anywhere but first"
  true
  "cargo test --release --test golden mem_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_byte_builder_carried_anywhere_but_first")
  release

# A tail call under `return x if c` is the shape the library's folds took on
# 2026-09-16, and the oracle nested a frame for every turn of it: a fold over
# ten thousand elements ran out of stack on the interpreter where native
# looped. The mutation evaluates a guard's rest as a nested block again.
guard_tail_oracle = row
  "a guard's rest evaluated as a nested block on the oracle"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "a_guard_that_nests_a_frame_on_the_oracle")
  release

# A build hole is spelled `_` and fills exactly once, ruled 2026-08-24. The
# seven rows below each disarm one of the checker's refusals, and the error
# corpus reads a program compiling, or a different sentence, where its golden
# holds the refusal.
hole_unfilled = row
  "a hole nobody filled freezing quietly"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_hole_nobody_filled_freezes_quietly")
  no_setup

hole_twice = row
  "a hole filled a second time"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_hole_filled_a_second_time")
  no_setup

hole_placeholder = row
  "a none standing in for a hole"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_none_standing_in_for_a_hole")
  no_setup

hole_in_arm = row
  "a hole filled inside an if arm that may not run"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_hole_filled_inside_an_if_arm")
  no_setup

hole_chosen = row
  "a hole filled through a record an if or a list chose"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_hole_filled_through_a_chosen_record")
  no_setup

hole_outside = row
  "a hole standing outside a build block"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_hole_outside_a_build_block")
  no_setup

hole_type_lacks = row
  "a field the type lacks written as a hole"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_field_the_type_lacks_written_as_a_hole")
  no_setup

# The four `cargo test --test golden` rows above and below all point at the
# micro corpus or the mem corpus. The error corpus — 161 fixtures pinning
# every diagnostic the language emits — had no row at all, so nothing had
# ever watched it fail, which is the exact shape this file exists to refuse.
error_corpus = row
  "a check that quietly stops firing"
  true
  "cargo test --release --test golden error_corpus"
  "specs (unit, golden, differential)"
  (breaking "a_diagnostic_stops_being_raised")
  release

release_profile = row
  "a release build that gives up the guaranteed tail call"
  true
  "cargo test --test golden micro_corpus_survives_a_release_build"
  "specs (unit, golden, differential)"
  (breaking "tail_call_given_up")
  no_setup

decode_counters = row
  "a decode allocation the golden does not know about"
  true
  (gating "decode_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "decode_allocation")
  benchmarks

escape_counters = row
  "escaped accumulator storage that nobody frees"
  true
  (gating "escape_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "escaped_storage_kept")
  benchmarks

thunk_walk = row
  "a thunk's captures unsized by the walk that evacuates survivors"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "thunk_capture_shared")
  release

pend_counters = row
  "the pending-cell shape erased from the corpus by a strictness change"
  true
  (gating "pend_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "pending_cells_proven_strict")
  benchmarks

# The leak is caught by the micro corpus, not by a counter, and the row said
# otherwise for months. A lazy verdict is per (group, arity, index) and codegen
# consults it with no arm to disambiguate, so a leaked verdict makes the
# emitter build a thunk in one arm and release it at the group's merged tail,
# which the other arm reaches -- IR whose release does not dominate its thunk.
# clang runs with -disable-llvm-verifier and so takes the broken module and
# SIGSEGVs in the Register Coalescer rather than rejecting it, which read here
# as UNBUILT: the tree would not compile, the counter gate never ran, and the
# row proved nothing on main from whenever the library grew the shape until
# 2026-09-16. `no_setup` and a gate that builds is what the header above
# prescribes for a defect that IS a build failure.
scan_leak = row
  "a lazy verdict leaking from one arm of a group to another"
  true
  "cargo test --release --test golden micro_corpus_agrees_across_engines"
  "specs (unit, golden, differential)"
  (breaking "lazy_verdict_leaks_between_arms")
  no_setup

# And scan_counters, left with no row when the one above moved off it, gets
# one aimed at what it is for.
scan_counters = row
  "a library loop admitted to the carry tier"
  true
  (gating "scan_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_carry_tier_admits_library_loops")
  benchmarks

# readbench joined on 2026-09-04 and this row with it, in the same pull request,
# because a gate CI runs and the ratchet cannot break is a gate nobody has
# proved can fail. scan_counters above is the other half of the same lesson from
# the same day: it had this row from the first and no CI step ran the gate at
# all, so the ratchet could break something the normal path never checked.
read_counters = row
  "a chain head that names a declaration, answered by the top set"
  true
  (gating "read_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_bang_read_loses_its_beat")
  benchmarks

# livebench joined on 2026-09-05 and this row with it, for the reason the
# paragraph above gives. Its defect is a library one on purpose: the frozen
# copy in bench/encodebench would not move by an instruction, which is both why
# that control is worth keeping and why this vein had to exist beside it.
live_counters = row
  "an encoder that hands a clean string to the escape path anyway"
  true
  (gating "live_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_encoder_that_walks_a_clean_string")
  benchmarks

# The skip in front of a string's first escape landed on 2026-09-07 as a
# library change, and this row is what keeps it: the same vein reads the run
# being walked again, because the fold's own counter moves by exactly the
# bytes it walks.
clean_run = row
  "the proved-clean run walked byte by byte again"
  true
  (gating "live_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_clean_run_walked_byte_by_byte")
  benchmarks

# The compile row stopped counting process startup on 2026-09-04, because that
# half moves with binary layout and not with the compiler. What it can still
# hide is a new dependency, whose startup cost was measured at 32,090, so this
# row watches the list that would catch one.
compile_libraries = row
  "a shared object the compiler grew and the instruction row cannot see"
  true
  (gating "compile_libraries")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_library_the_row_cannot_see")
  no_setup

mem_shapes = row
  "a memory shape the fixture's counters no longer describe"
  true
  "cargo test --release --test golden mem_corpus_pins_native_allocator_counters"
  "specs (unit, golden, differential)"
  (breaking "cluster_entry_not_demoted")
  release

emitted_code = row
  "the decoder's emitted line count moving"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "emitted_lines_moved")
  benchmarks

# The same gate, the other file. One mutation per golden, because a gate that
# reads two files and is only ever proved against one is proved for one.
emitted_others = row
  "another benchmark's emitted line count moving"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "emitted_others_moved")
  benchmarks

# The integer remainder inlines for a proven pair since 2026-09-07; the
# mutation sends every remainder back to the runtime, and the emitted goldens
# read the calls that come back.
remainder = row
  "every remainder a call to the runtime again"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_remainder_calls_the_runtime_again")
  benchmarks

# ryu_d2d settles a short float by scaling and dividing back since 2026-09-24,
# and every float the benchmarks render takes that road. The row this replaced
# guarded ryu's general digit-removal loop through the work vein, and with no
# benchmark float reaching the loop that vein could no longer see it. The
# mutation closes the short road; the digits are identical, so the presence
# counter is what goes red.
short_float = row
  "a short float rendered by ryu's multiplies again"
  true
  (gating "run_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_float_takes_ryu_s_road")
  benchmarks

# k_b_to_float skips leading zeros before its digit loops since 2026-09-15,
# so the loops count significant digits unconditionally; the mutation puts
# `if (w) digits++` back on every digit. The (w, q) handed to eisel-lemire is
# identical either way, so the work vein is the only thing that can see it.
leading_zeros = row
  "every digit asking whether the first nonzero has landed"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "every_digit_asks_whether_the_first_nonzero_has_landed")
  benchmarks

# k_b_to_int's strtoll fallthrough is a separate cold function since
# 2026-09-15, so the fast path carries no frame; the mutation inlines it back
# and the five pushes and five pops return to every call. The value out is
# identical either way, so the work vein is the only thing that can see it.
int_cold_tail = row
  "the int parser's cold tail sharing its frame"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_int_parser_s_cold_tail_shares_its_frame")
  benchmarks

# Six cold helpers carry preserve_most since 2026-09-15 -- the arena refill,
# the permanent allocator, the int parser's strtoll tail, the ascii cache's
# fill and the two arms of an index that allocate or refuse -- so a hot
# function whose only calls are cold ones opens with no pushes. The mutation
# strips the attribute from all six and the pushes return. Every value out is
# identical either way, so the work vein is the only thing that can see it.
cold_registers = row
  "the cold helpers clobbering their callers' registers"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_cold_helpers_clobber_their_callers_registers")
  benchmarks

# k_b_at's two arms that allocate or refuse are separate cold functions since
# 2026-09-15, so the arm every runbench index takes carries no frame; the
# mutation inlines both back and the six pushes return to every index. The
# value out is identical either way, so the work vein is the only thing that
# can see it.
index_cold_arms = row
  "the index's allocating arms sharing its frame"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_index_s_allocating_arms_share_its_frame")
  benchmarks

# A copy long enough to be libc's goes through a preserve_most wrapper since
# 2026-09-15, so a function whose short copies are inline words keeps no frame
# for the long case; the mutation inlines the wrapper back and the pushes
# return. Every byte copied is the same, so the work vein is the only thing
# that can see it.
cold_copy = row
  "the long copy sharing its caller's frame"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_long_copy_shares_its_callers_frame")
  benchmarks

# k_b_utf8_slice_raw validates through a door whose two validators sit behind
# preserve_most wrappers since 2026-09-15, so its 861,498 calls a run open
# with no pushes; the mutation sends it through the plain door again. The
# answer is identical either way, so the work vein is the only thing that can
# see it.
rare_door = row
  "the slice door calling the validators directly"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_slice_door_calls_the_validators_directly")
  benchmarks

# The third cold-frame sweep, 2026-09-15: nine rare arms of hot runtime
# functions are preserve_most helpers, so k_b_at, k_b_entries, k_b_push_grow,
# k_b_append_grow, k_closure and k_copy_alloc open with one push or none. The
# mutation strips the attribute from the nine and leaves kanso#1429's six.
# Every value out is identical, so the work vein is the only thing that can
# see it.
sweep_helpers = row
  "the third sweep's helpers clobbering their callers' registers"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_third_sweep_s_helpers_clobber_their_callers_registers")
  benchmarks

# k_b_slice's multibyte walk is its own function in tail position, so the
# ascii and list arms open with no pushes where the inline walk cost seven;
# the mutation inlines it back. Every slice is the same bytes, so the work
# vein is the only thing that can see it.
slice_walk = row
  "the slice's walk sharing the door's frame"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_slice_s_walk_shares_the_door_s_frame")
  benchmarks

# k_closure copies up to eight captures as inline words and hands a longer
# environment to k_copy_cold; the mutation puts memcpy back above four, a
# plain call the closure kept five pushes for. Every environment holds the
# same values, so the work vein is the only thing that can see it.
scan_inline = row
  "the two byte scanners called out of line with their constants"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_byte_scanners_rebuild_their_constants_on_every_call")
  benchmarks

# A tail shorter than a vector is one masked load when the sixteen bytes stay
# inside the page; the mutation makes the window test answer no, so every
# short tail walks a byte at a time again, 8,042,860 bytes a run at eight
# instructions each. Every scan answers the same position either way, so the
# work vein is the only thing that can see it.
scan_tail = row
  "a scan's short tail walked one byte at a time"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_short_scan_tail_walks_a_byte_at_a_time")
  benchmarks

# Every counter increment sits behind K_COUNTING, so a shipped binary carries
# none of them; the mutation puts the beat iteration counter's two sites back
# unguarded, 2,692,767 increments a run on the run program. A counted binary
# counts the same either way, so the work vein is the only thing that can see
# it.
counters_out = row
  "a counter increment left in a shipped binary"
  true
  (gating "instructions")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "the_beat_iteration_counter_is_counted_in_a_shipped_binary")
  benchmarks

# A lambda reads its captures out of the environment on entry. Until
# 2026-09-15 each read was a call to k_env_get, three instructions behind a
# call and a return, once per capture on every entry: 1,279,648 calls a run
# on the run program. The read is a getelementptr and a load now, so the
# emitted vein sees one `call` fewer per capture per lambda, which is what
# this row asserts. The mutation puts the call back through the same slot
# pointer, so the twin the emitter writes is otherwise unchanged.
capture_load = row
  "a captured value read through a call on every lambda entry"
  true
  (gating "emitted_code")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_capture_is_read_through_a_call")
  benches

