# The one vein whose headline row is a high water mark. Every other
# benchmark's peak is bounded by the size of its own text, so a change that
# moves what a program HOLDS and not what it allocates is invisible to them.
digest_counters = row
  "an arena block size raised without the peak it moves being measured"
  true
  (gating "digest_counters")
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "an_arena_block_that_grew_unmeasured")
  benchmarks

rows_a = [formatting linting python_free goldens mem_shapes release_profile]

rows_b1a = [decode_counters escape_counters pend_counters digest_counters]

rows_b1 = text/concat rows_b1a [thunk_walk scan_counters]

rows_b1b = text/concat rows_b1 [emitted_code emitted_others machine_code]

rows_b1c = text/concat rows_b1b [instructions_host text_host]

rows_b1d = text/concat rows_b1c [compile_allocs compile_allocs_host]

rows_b1d2 = text/concat rows_b1d [compile_ir compile_ir_host]

rows_b1e = text/concat rows_b1d2 [compile_ir_keyed inline_pin]

rows_b = text/concat rows_b1e [compile_mem compile_mem_host]

rows_c1 = [welfare_floor grammar book_outputs error_corpus trend]

rows_c1a = text/concat rows_c1 [perf_row trend_runtime trend_joined]

rows_c1t = text/concat rows_c1a [trend_adrift]

rows_c1p = text/concat rows_c1t [published_numbers]

rows_c1b = text/concat rows_c1p [diagnostics accumulator]

rows_c1c = text/concat rows_c1b [rendering behaviour]

rows_c1d = text/concat rows_c1c [numeric effects]

rows_c1e = text/concat rows_c1d [modules coverage]

rows_c1f0 = text/concat rows_c1e [coverage_floor decoder]

rows_c1f = text/concat rows_c1f0 [validator validator_tail]

rows_c1g = text/concat rows_c1f [landing in_the_page shop_window]

# kq is a real program with its own JSON, and its own text goes through
# `text/append` seventy times, so a runtime that corrupts an in-place append
# reaches it. That is the row's mutation, and the shape ci.yml names as the
# reason this job gates at all.
#
# The gate clones kq the way the job does rather than expecting one beside the
# checkout, which is what the excuse this replaces claimed it needed. The clone
# directory must be named `kq`: `kanso build <dir>` names the binary for the
# directory and spec.sh invokes `./kq`.
asset_digests = row
  "a page that keeps its undigested reference while every asset is digested"
  true
  "{ag_gate}"
  "asset digests (every reference rewritten, site still runs)"
  (breaking "a_page_keeps_its_undigested_reference")
  release

kq_specs = row
  "a byte builder that writes the right length and the wrong bytes"
  true
  "{kq_gate}"
  "kq specs (a real program, gating)"
  (breaking "a_string_the_builder_corrupted_in_place")
  release

coverage_printed = row
  "an `error[kind]:` refusal printed as plain text, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_printed_error_kind_arrives_without_a_golden")
  release

rows_c1h = text/concat rows_c1g [dispatch coverage_driver]

# A FOURTH opener, and the file the scan could not see. `source?` took `.rs`
# only, so src/runtime.c — where a compiled binary gets its runtime messages —
# had never been read. Thirty-three of its sixty-six k_die texts were pinned by
# nothing.
coverage_native = row
  "a refusal the native runtime dies with, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_native_runtime_refusal_arrives_without_a_golden")
  release

# A FIFTH opener, on the engine the differential law calls the truth. eval.rs
# raises `RuntimeError { message: ... }` — a bare struct field none of the four
# above match — so all 97 of the oracle's refusals were rewordable in silence.
#
# Two rows because the extraction differs: `message: "` carries its own opening
# quote and the literal is the first piece of a split on it, where
# `message: format!(` may put the string on the next line and the literal is
# the second. One mutation would leave the other path untested.
coverage_oracle = row
  "a refusal the interpreter raises, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_refusal_arrives_without_a_golden")
  release

coverage_oracle_format = row
  "a refusal the interpreter formats, and no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "an_oracle_format_refusal_arrives_without_a_golden")
  release

rows_c1i = text/concat rows_c1h [coverage_printed kq_specs asset_digests]

rows_c1j = text/concat rows_c1i [coverage_native]

# A SIXTH opener, on the engine a reader meets FIRST — the website's playground
# runs `docs/kanso.wasm`, and until the scan learned bare `die(` none of
# wasm_rt.rs's 36 sites was read by any gate. Three of those sentences turned
# out to be saying the wrong thing on 2026-08-28, and a fourth was a wrong
# ANSWER rather than a wrong sentence.
#
# Two rows for the same reason as the oracle's two: `die("` carries its own
# opening quote and the literal is the first piece of a split on it, where
# `die(format!(` may put the string on the next line and the literal is the
# second.
coverage_page = row
  "a refusal only the page writes, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_page_refusal_arrives_without_a_golden")
  release

coverage_page_format = row
  "a page refusal built with format!, with no golden"
  true
  "./target/release/kanso run scripts/diagnostic_coverage"
  "diagnostics differential (both engines say the same thing)"
  (breaking "a_page_format_refusal_arrives_without_a_golden")
  release

rows_c1k = text/concat rows_c1j [coverage_oracle coverage_oracle_format]

rows_c1l = text/concat rows_c1k [coverage_page coverage_page_format]

rows_c1m = text/concat rows_c1l [beat_cursor]

rows_c = text/concat rows_c1m [itself]

rows = text/concat rows_a (text/concat rows_b rows_c)

# A job with no row and no reason is the thing this refuses. A reason is a
# sentence, not a flag: it has to say what would prove the job, so the debt is
# readable rather than a name on a list.
# The one job that keeps a reason, and the reason is not the one it had.
#
# It read "the mutations are `specs`'s; what this adds is a second machine".
# The second half holds. The first half stopped holding on 2026-08-27, when
# this job caught a defect `specs` passed on linux: a fixture interpolated its
# own absolute path into generated kanso source, so the source line's length
# became a property of the host's temp directory. Eighty characters is the
# limit; macOS's `/var/folders/...` took it to ninety-nine, and the run died on
# a formatting refusal before reaching what it meant to test. A defect class
# only the second machine can see is not `specs`'s mutation.
#
# What keeps the job unproven is the harness rather than the mutations. `prove`
# is authoritative on linux — this file says so in its own header — and it
# cannot run a macOS gate at all.
no_row_a = unproven
  "the other host (macos, arm)"
  "prove runs on linux and cannot reach a second machine's gate at all"

unproven_jobs = [no_row_a]

workflow = ".github/workflows/ci.yml"

# A job's display name sits at four spaces; a step's at six behind a dash, so
# the two cannot be confused by their indentation.
fn job_line? l
  text/slice l 1 10 == "    name: "

fn job_name l
  text/slice l 11 (length l)

fn jobs_in text
  lines = list/select (text/split text "\n") job_line?
  list/to_list (list/map lines job_name)

fn job_of r
  r.job

fn named? name group
  list/any? group (g -> g == name)

fn covered? name
  rowed = list/to_list (list/map rows job_of)
  excused = list/to_list (list/map unproven_jobs job_of)
  named? name rowed or named? name excused

fn known? declared name
  named? name declared

fn missing declared
  list/to_list (list/select declared (n -> not covered? n))

fn stale declared
  claimed = list/to_list (list/map rows job_of)
  excused = list/to_list (list/map unproven_jobs job_of)
  both = text/concat claimed excused
  list/to_list (list/select both (n -> not known? declared n))

cover = os/read_file workflow . (text -> against (jobs_in text))

fn against declared
  gaps = missing declared
  ghosts = stale declared
  verdict gaps ghosts (length gaps == 0 and length ghosts == 0)

fn verdict _ _ true
  io/write "ratchet: every ci job carries a mutation or a stated reason\n"
    . (_ -> applies_all)

fn verdict gaps ghosts false
  said = list/to_list (list/map gaps (n -> "  no row and no reason: {n}\n"))
  gone = list/to_list (list/map ghosts (n -> "  no such ci job: {n}\n"))
  body = text/join (text/concat said gone) ""
  saying = "ratchet: the table and ci.yml disagree\n{body}"
  io/write_err saying . (_ -> os/exit 1)

# APPLYING a mutation costs a sed; proving it reddens its gate costs a build.
# Those are different prices, and only the second one needs the nightly. So the
# cheap half runs here, on every change: a mutation that no longer matches the
# source it patches is a row that has quietly stopped proving anything.
#
# This exists because pending_cells_proven_strict anchored on a line #1015
# rewrote, and the nightly said so the next morning — correctly, precisely, and
# to nobody. Fifteen hours later it was still red. A per-PR signal gets answered
# because it blocks a merge, so the check that would have caught #1015 belongs
# in #1015's own pull request.
#
# Like `prove`, this reads a worktree of HEAD rather than the working tree, so
# it answers for what a pull request carries rather than for what is still
# unsaved beside it.
applies_all = borrowed "/tmp/kanso-ratchet-applies"

fn borrowed dir
  os/run "git" ["worktree" "add" "--detach" "--force" dir "HEAD"]
    . (_ -> applying dir rows 1 [])

fn applying dir list at acc
  applied dir list at acc (at > length list)

fn applied dir _ _ acc true
  os/run "git" ["worktree" "remove" "--force" dir] . (_ -> intact acc)

fn applied dir list at acc false
  r = list[at]!
  shell dir r.mutation . (m -> after_try dir list at acc r m.status)

# The worktree is restored between rows so one stale mutation cannot make the
# next one look stale too.
fn after_try dir list at acc _ 0
  restored dir . (_ -> applying dir list (at + 1) acc)

fn after_try dir list at acc r _
  restored dir . (_ -> applying dir list (at + 1) (push acc r))

fn restored dir
  shell dir "git checkout -- . && git clean -fdq"

fn intact acc
  standing acc (length acc == 0)

fn standing _ true
  io/write "ratchet: every mutation still matches the source it patches\n"

fn standing acc false
  said = list/to_list (list/map acc (r -> "  STALE {r.job} — {r.claim}\n"))
  body = text/join said ""
  saying = "ratchet: {length acc} mutations no longer apply\n{body}"
  io/write_err saying . (_ -> os/exit 1)

# Each row runs in a worktree of HEAD, so a mutation cannot reach the tree the
# author is working in and two rows cannot see each other's damage.
fn shell dir cmd
  os/run "sh" ["-c" "cd {dir} && {cmd}"]

# A mutation that still applies can still prove nothing. kanso#1157 put an
# early return above the line compile_allocs_unwatched.sh patches, and the
# patch went on applying — to a line eleven thousand of lib/json's twelve
# thousand occurrences never reach. The counter moved by zero and the row was
# blind. `applies_all` cannot see that, because applying is not proving, and
# only proving costs a build. The nightly saw it the next morning, twice, and
# said so to nobody.
#
# Both rows that went blind on 2026-08-30 were killed by a change to the very
# file their own mutation patches, and which files a change touches is
# something a pull request knows about itself:
#
#   kanso run scripts/ratchet -- touched origin/main
#
# keeps the rows whose mutation names a file the branch changed and proves that
# handful. Naming is the test because a mutation patches what it writes down,
# so a row naming nothing the branch touched cannot have been made inert by it.
# The intersection is usually empty and occasionally one to three rows: #1171
# touched src/runtime.c and #1157 and #1188 touched src/lib.rs, so all three
# would have been answered on the pull request that broke them, for one to
# three builds, and nothing on the rest.
#
# It is a middle, not a replacement. `cover` still runs on every change and
# the nightly still proves the whole table, because a row can also go blind
# from a distance — the guard #1157 added is in the file, but a change to what
# a gate READS could hollow a row without touching a line any sed matches.
fn touched base mode
  os/run "git" ["diff" "--name-only" "{base}...HEAD"] . (d -> diffed d mode)

fn diffed d mode
  branch_files d mode (d.status == 0)

# Carrying git's own words, because the first thing this refusal caught was a
# shallow checkout with no merge base to diff against, and "would not run" sent
# a reader to the ratchet rather than to the workflow's fetch-depth.
fn branch_files d _ false
  said = "ratchet: git could not name this branch's files\n"
  io/write_err "{said}{d.stderr}" . (_ -> os/exit 1)

fn branch_files d mode true
  named = list/select (text/split d.stdout "\n") (f -> length f > 0)
  winnowing mode (list/to_list named) rows 1 []

fn winnowing mode files list at acc
  winnowed mode files list at acc (at > length list)

fn winnowed mode _ _ _ acc true
  handful mode acc

fn winnowed mode files list at acc false
  r = list[at]!
  os/read_file (script_of r) . (s -> read_it mode files list at acc r s)

# A row's mutation is a shell command and its script is the word after `sh `.
fn script_of r
  text/slice r.mutation 4 (length r.mutation)

fn read_it mode files list at acc r s
  reaches mode files list at acc r (list/any? files (f -> spells? s f))

fn spells? text path
  length (text/split text path) > 1

fn reaches mode files list at acc _ false
  winnowing mode files list (at + 1) acc

fn reaches mode files list at acc r true
  winnowing mode files list (at + 1) (push acc r)

fn handful mode acc
  chose mode acc (length acc == 0)

fn chose _ _ true
  io/write "ratchet: this branch touches no file any mutation patches\n"

fn chose mode acc false
  said = "ratchet: {length acc} rows patch a file this branch changed\n"
  listed = list/to_list (list/map acc (r -> "  {r.job} — {r.claim}\n"))
  body = text/join listed ""
  io/write "{said}{body}" . (_ -> onto mode acc)

# `list` names the handful and stops, the way somebody about to spend six
# minutes of runner wants to know what they are spending it on. Anything else
# proves them.
fn onto "list" _
  io/write ""

fn onto _ acc
  baselined acc

fn prove_all scope
  picked = list/to_list (list/select rows (r -> asked? scope r))
  chose_rows scope picked (length picked == 0)

# A scope naming no row would otherwise prove nothing and report that every
# row turned its gate red, which is the same false green in miniature.
fn chose_rows scope _ true
  io/write_err "ratchet: no row is named by `{scope}`\n" . (_ -> os/exit 1)

fn chose_rows _ picked false
  baselined picked

fn asked? "all" _
  true

fn asked? "cheap" r
  not r.dear

# Any other word selects by job name, so a spec — or somebody debugging one
# row — can prove a single gate without paying for sixty.
fn asked? scope r
  spells? r.job scope

# A row is proof only if the gate it reddened was green to begin with, and
# nothing checked that. `after_gate` read a non-zero exit as the mutation's
# doing, so a gate already red on HEAD would have been credited to every
# mutation that shares it: the rows would pass while proving nothing, which is
# the exact defect this table exists to catch, sitting inside the table's own
# harness. It is not a hypothetical shape: `prove` builds in a worktree with a
# shared target directory and stub scratch dirs that ci.yml does not use, and a
# gate red for one of those reasons looks identical to a gate red for the
# mutation.
#
# So every gate is read once on an unmutated worktree first, and a baseline
# that is not green stops the run rather than colouring it. Deduplicated
# because the 62 rows name 50 distinct (gate, setup) pairs — nine rows share
# the diagnostic-coverage gate and four share the trend gate — so the baseline
# costs 50 gate runs beside the 62 the proving already pays. One worktree
# serves the whole pass: nothing mutates it, so there is nothing to restore
# between pairs and only the first setup's build is cold.
#
# It reads HEAD before any row runs, so it answers for the tree and not for
# what a row leaves behind: a mutation that dirties a shared scratch path and
# reddens a LATER row's gate is still counted as that row's proof. Rows do not
# share scratch paths today, and the fix if one ever does is to re-read that
# gate rather than to widen this pass.
base_dir = "/tmp/kanso-ratchet-base"

fn pairs_in list at acc
  pair_seen list at acc (at > length list)

fn pair_seen _ _ acc true
  acc

fn pair_seen list at acc false
  r = list[at]!
  same? = (p -> p.gate == r.gate and p.setup == r.setup)
  kept list at acc r (list/any? acc same?)

fn kept list at acc _ true
  pairs_in list (at + 1) acc

fn kept list at acc r false
  pairs_in list (at + 1) (push acc (pair r.gate r.job r.setup))

fn baselined picked
  made = ["worktree" "add" "--detach" "--force" base_dir "HEAD"]
  os/run "git" made . (_ -> base_linked picked)

fn base_linked picked
  linking = "mkdir -p {shared_target} && ln -s {shared_target} target"
  pairs = pairs_in picked 1 []
  shell base_dir linking . (_ -> greening picked pairs 1 [])

fn greening picked pairs at acc
  greened picked pairs at acc (at > length pairs)

fn greened picked pairs _ acc true
  os/run "git" ["worktree" "remove" "--force" base_dir]
    . (_ -> unmutated picked pairs acc)

fn greened picked pairs at acc false
  p = pairs[at]!
  shell base_dir p.setup . (s -> base_setup picked pairs at acc p s.status)

fn base_setup picked pairs at acc p 0
  shell base_dir p.gate . (g -> base_gate picked pairs at acc p g)

fn base_setup picked pairs at acc p s
  greening picked pairs (at + 1) (push acc (unmade p s))

fn base_gate picked pairs at acc p g
  read_gate picked pairs at acc p g (g.status == 0)

fn read_gate picked pairs at acc _ _ true
  greening picked pairs (at + 1) acc

fn read_gate picked pairs at acc p g false
  greening picked pairs (at + 1) (push acc (presumed p g))

# The last two dozen lines of what the gate said, indented under the finding.
#
# Naming the gate was the previous shape of this, and it answered the question
# it was built for on its first run: `sh scripts/gates/instructions.sh`, red
# because valgrind was not on the ratchet's box. It could not answer the SECOND
# one. With valgrind installed the same gate was still red, and a report that
# says only which gate leaves the reader with a list of hypotheses and no way
# to choose — which is the shape of reasoning this repo keeps catching. A gate
# writes down why it failed; the ratchet was throwing that away.
#
# TWENTY-FOUR because eight was not enough on the first run that used it. The
# instructions gate prints the cpu it is about to count on, then eleven rows,
# then its diff, then six lines of advice — and eight lines caught the advice
# and one row. The row it caught was the useful part (`digestbench 81252330`
# against the cost-goldens job's 81252316 on the same commit), so the next one
# should carry the whole diff and the cpu line rather than needing a second run
# to ask again.
fn spoke r
  said = "{r.stdout}{r.stderr}"
  lines = text/split said "\n"
  over = length lines - 24
  tail = list/to_list (list/drop lines (chose_drop over (over > 0)))
  text/join (list/to_list (list/map tail (l -> "      {l}\n"))) ""

fn chose_drop over true
  over

fn chose_drop _ false
  0

fn unmade p r
  said = "  UNBUILT {p.job}\n    gate: {p.gate}\n"
  finding "{said}    the baseline would not build\n{spoke r}" false

fn presumed p r
  told p r (host_bound? p.gate)

fn told p r true
  said = "  UNPROVEN THIS RUN {p.job}\n    gate: {p.gate}\n"
  why = "{why_bound p.gate}, so this run cannot prove a row sharing it"
  finding "{said}    {why}\n{spoke r}" true

fn told p r false
  said = "  ALREADY RED {p.job}\n    gate: {p.gate}\n"
  why = "red before any mutation, so no row sharing it is proof"
  finding "{said}    {why}\n{spoke r}" false

fn unmutated picked pairs acc
  bad = list/to_list (list/select acc (f -> not f.ok))
  settled_base picked pairs acc (length bad == 0)

# A note is printed and then the run carries on; only a finding nobody excused
# stops it. Both go to stderr, because a row that went unproven is news.
fn settled_base picked pairs acc true
  said = "ratchet: {length pairs} gates read before any mutation\n"
  io/write_err (said_with acc said) . (_ -> proving (kept_provable picked) 1 [])

fn settled_base _ _ acc false
  said = "ratchet: the baseline is not green\n"
  io/write_err (said_with acc said) . (_ -> os/exit 1)

fn said_with acc said
  lines = list/to_list (list/map acc (f -> f.line))
  body = text/join lines ""
  "{said}{body}"

# A row whose gate this run cannot answer is not run under mutation either:
# applying a mutation to an already-red gate and reading red is the credit the
# baseline exists to refuse.
fn kept_provable picked
  list/to_list (list/select picked (r -> not host_bound? r.gate))

fn proving list at acc
  proven list at acc (at > length list)

fn proven list _ acc true
  reported list acc

fn proven list at acc false
  r = list[at]!
  dir = "/tmp/kanso-ratchet-{at}"
  made = ["worktree" "add" "--detach" "--force" dir "HEAD"]
  os/run "git" made . (_ -> after_worktree list at acc r dir)

# Every row's build lands in one directory, so the first is cold and the rest
# are incremental. A dozen rows each paying a full release build is an hour
# that buys nothing: cargo already rebuilds exactly what the mutation touched.
# Created here rather than assumed: nothing else makes this directory, so on a
# fresh machine the symlink dangled, `cargo build` failed with "Not a
# directory", and every row carrying `release` as setup was counted red without
# its gate ever running.
shared_target = "/tmp/kanso-ratchet-target"

fn after_worktree list at acc r dir
  linking = "mkdir -p {shared_target} && ln -s {shared_target} target"
  shell dir linking . (_ -> after_target list at acc r dir)

fn after_target list at acc r dir
  shell dir r.mutation . (m -> after_mutation list at acc r dir m.status)

fn after_mutation list at acc r dir 0
  shell dir r.setup . (s -> after_setup list at acc r dir s.status)

fn after_mutation list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (broke r)))

fn after_setup list at acc r dir 0
  shell dir r.gate . (g -> after_gate list at acc r dir g.status)

fn after_setup list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (unbuilt r)))

fn after_gate list at acc r dir 0
  cleaned dir . (_ -> proving list (at + 1) (push acc (blind r)))

fn after_gate list at acc r dir _
  cleaned dir . (_ -> proving list (at + 1) (push acc (red r)))

fn cleaned dir
  os/run "git" ["worktree" "remove" "--force" dir]

fn red r
  finding "  red   {r.job} — {r.claim}\n" true

fn blind r
  finding "  BLIND {r.job} — {r.claim}: the gate stayed green\n" false

fn broke r
  finding "  BROKE {r.job} — {r.claim}: the mutation would not apply\n" false

fn unbuilt r
  finding "  UNBUILT {r.job} — {r.claim}: it would not build\n" false

fn reported list acc
  lines = list/to_list (list/map acc (f -> f.line))
  body = text/join lines ""
  bad = list/to_list (list/select acc (f -> not f.ok))
  io/write "ratchet: {length list} rows\n{body}" . (_ -> settled bad)

fn settled bad
  told bad (length bad == 0)

fn told _ true
  io/write "ratchet: every row turned its gate red\n"

fn told bad false
  io/write_err "ratchet: {length bad} rows proved nothing\n" . (_ -> os/exit 1)

fn asked given
  verb given (length given > 0)

fn verb given true
  chosen given[1]! given

fn verb _ false
  cover

fn chosen "prove" given
  prove_all (second given "all")

fn chosen "touched" given
  touched (second given "origin/main") (third given "prove")

fn chosen _ _
  cover

fn second given fallback
  beyond given fallback (length given > 1)

fn beyond given _ true
  given[2]!

fn beyond _ fallback false
  fallback

fn third given fallback
  past given fallback (length given > 2)

fn past given _ true
  given[3]!

fn past _ fallback false
  fallback

pub play = os/args . (given -> asked given)
