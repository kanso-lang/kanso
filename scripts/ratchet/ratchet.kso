  (breaking "four_ascii_blocks_validated_one_at_a_time")
  benches

slice_count_words = row
  "a slice stepped a character at a time between its positions"
  false
  "sh scripts/gates/instructions.sh"
  "cost goldens (deterministic ratchet, no clocks)"
  (breaking "a_slice_stepped_a_character_at_a_time_between_its_positions")
