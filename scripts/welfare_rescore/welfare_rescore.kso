# Rewrite history.jsonl's welfare column, in place, under the current formula.
#
# Directive of 2026-09-03. Clay, looking at the chart: "i don't need anything
# 'replayed' vs 'recorded', i'm just talking about re-doing it for those
# historical commits based on the numbers we already have, one time."
#
# The reason he gave for the chart drawing no replayed line was that model.txt
# had never reached the perf-history branch. That was true when he first
# looked and had already been fixed: the file landed with row 499. The actual
# reason is worse and is why the two-line design could not be rescued. The
# replay refused any row missing a counter, and eighteen of the objective's
# twenty-four counters exist in the last two rows of five hundred — so the
# line it could draw was two points long.
#
# ONE COLUMN, ONE LINE. Every row is scored by the formula in scripts/welfare,
# on the counters that row already carries. Nothing is invented, and nothing is
# fetched at view time.
#
# WHAT A ROW THAT PREDATES A COUNTER GETS. A term averages over the counters
# present in the row; a term with none present is dropped and the remaining
# weights renormalized, so a row scoring perfectly on what it has reads the
# same as a full row scoring perfectly. Two fields say what scored the row:
# `scored_by` names the formula, and `scored_weight` says how much of that
# formula's weight the row carried counters for.
#
# scored_weight is what a reader needs to not be fooled. Eighteen of the
# objective's twenty-four counters were first recorded on 2026-09-02, so the
# older rows are scored on six or fewer, and the score steps where the
# RECORDING changed rather than where the compiler did. The three such steps
# in the file as it stands are 2026-08-10 (-11.25, three instruction counters
# arrive at ratios near one while the mature counters sit far above), the
# same day plus three (-25.59, the compile counters leave the row entirely
# and 0.44 of weight renormalizes onto the run terms) and 2026-09-02 (-0.88,
# the other eighteen arrive). Every other fall in the file is a counter that
# genuinely got worse.
#
# THE WEIGHTS ARE NOT RETYPED HERE. They arrive on stdin from
# `kanso run scripts/welfare -- --model`, which is the one place they live:
#
#   kanso run scripts/welfare -- --model \
#     | kanso run scripts/welfare_rescore -- history.jsonl > rescored.jsonl
#
# A weight copied into a second file is a weight that keeps its old value
# through the next gavel, which is what the model emitter exists to prevent.
#
# Run it again whenever the formula or the baseline moves, in the same PR.
import "std/io"
import "std/json"
import "std/list"
import "std/math"
import "std/os"
import "std/text"

pub type term
  name
  weight
  satiation
  counters

pub type scoring
  terms
  base
  formula

pub type splice
  counters
  target

pub play = io/stdin . (model -> with_model model)

fn with_model model
  os/args . (given -> over_rows (read model) given)

# The model in one value, so the walk below takes an argument rather than
# three that have to stay in step.
fn read model
  scoring (parsed_terms model) (parsed_base model) (parsed_formula model)

# --- the model, as `scripts/welfare -- --model` writes it -------------------
fn model_lines model
  list/select (text/split model "\n") (l -> length l > 0)

fn parsed_terms model
  rows = list/select (model_lines model) (l -> text/slice l 1 5 == "term ")
  list/to_list (list/map rows one_term)

fn one_term line
  parts = text/split (text/slice line 6 (length line)) "|"
  term parts[1]! (text/to_float parts[2]!) (text/to_float parts[3]!)
    (text/split parts[4]! ",")

# Which definition scored these rows, as the model states it. Holding a copy
# here would keep its old value through the gavel that moved the formula, and
# every row would then claim to have been scored by a definition that no
# longer exists.
fn parsed_formula model
  rows = list/to_list (list/select (model_lines model) formula_line?)
  named rows (length rows == 0)

fn formula_line? l
  text/slice l 1 8 == "formula "

# Refused rather than defaulted. A model with no formula line is an older
# welfare than this tool, and guessing a date would tag five hundred rows with
# a definition nobody can check them against.
fn named _ true
  err "the model has no formula line; it wants welfare -- --model"

fn named rows false
  text/slice rows[1]! 9 (length rows[1]!)

fn parsed_base model
  rows = list/select (model_lines model) (l -> text/slice l 1 5 == "base ")
  list/to_h (list/to_list (list/map rows one_base))

fn one_base line
  halves = text/split (text/slice line 6 (length line)) "="
  [halves[1]! (text/to_int halves[2]!)]

# --- the run term for a row measured before runbench existed ----------------
# Ruling of 2026-09-07, "the welfare history's baseline" (kanso#1313): each
# phase's ratio to the anchor, weighted by runbench's own measured shares,
# calibrated to equal runbench at the changeover, with a row's shares
# renormalised over the phases it carries and no phase extrapolated from
# another.
#
# ONLY ROWS CARRYING EVERY PHASE ARE REBUILT, and that is narrower than the
# ruling as written. The ruling read the old rows as carrying four run-side
# counters. Two of the four map to no phase -- bench/runbench_phases.txt says
# in its own header that oneshot and basket have none, because runbench does
# not do their work -- so the rows below 2026-09-03 carry decode and encode
# alone, 68.97% of the mix, and renormalising over two phases IS extrapolating
# from them onto the missing 31%. That is measurable, because the rows from
# 2026-09-06 carry decode and encode AND the real run_instructions: over those
# 61 rows the two-phase reconstruction recovers 4.42% of 27.24% of movement,
# 14.88% mean error. The same six phases dropped where all eight are present
# costs 2.78%. The error tracks how much the unrepresented phases moved, which
# no row records, so those rows stay unscored and the question is Clay's.
# design/pending-gavels.md carries it.
#
# THE SPLICE IS CHECKED, NOT ASSUMED. The last all-phase row and the first row
# carrying run_instructions are different commits, and the reconstruction is
# only continuous across them if they do the same runtime work. Every phase
# counter the two share must agree exactly or this refuses: a reconstruction
# spliced onto a row that moved would slide all forty-eight by that move, and
# it would look like history rather than like a bug.
#
# ON TODAY'S HISTORY THAT IS ONE COUNTER, and saying so is the point of writing
# it down. The phase map names the PRE-GAVEL row spellings, and of those eight
# a modern row carries only `encode_instructions` -- `decode_instructions` stops
# at 2026-09-06 with the other six. So the check that runs is encode's alone.
# The bare `instructions` key, which the ruling identifies as the decode row,
# also agrees across the splice (1,526,907,200 either side, read off
# origin/perf-history), and the two commits are 4a5253d and d106a74, the second
# of which moved the objective and not the runtime. That is a hand check, not
# one this tool makes, and a future row pair could agree on encode and diverge
# elsewhere. tests/the_reconstruction_refuses_a_splice_that_moved.rs holds the
# refusal red.
fn phase_map raw
  rows = list/select (text/split raw "\n") phase_line?
  list/to_list (list/map rows one_phase)

fn phase_line? l
  length l > 0 and text/slice l 1 1 != "#"

fn one_phase line
  parts = text/split line " "
  [parts[2]! (text/to_float parts[3]!)]

fn carries_all? row phases
  here = list/to_list (list/select phases (p -> row[p[1]!] != none))
  length here == length phases

fn anchor rows phases
  eights = list/to_list (list/select rows (r -> carries_all? r phases))
  runs = list/to_list (list/select rows (r -> r["run_instructions"] != none))
  calibrated eights runs phases (length eights == 0 or length runs == 0)

# No all-phase row, or no measured row to calibrate against. Nothing to
# reconstruct and nothing wrong: every row keeps what it carries.
fn calibrated _ _ _ true
  none

fn calibrated eights runs phases false
  last = eights[length eights]!
  first = runs[1]!
  both = list/to_list (list/select phases (p -> first[p[1]!] != none))
  agreed = list/to_list (list/select both (p -> last[p[1]!] == first[p[1]!]))
  checked last first (length agreed == length both)

fn checked _ _ false
  err "the splice rows disagree on a phase they share"

fn checked last first true
  splice last first["run_instructions"]!

fn wants_run? row a phases
  a != none and row["run_instructions"] == none and carries_all? row phases

fn reconstructed row a phases
  rebuilt row a phases (wants_run? row a phases)

fn rebuilt row _ _ false
  row

fn rebuilt row a phases true
  factor = moved row a.counters phases
  put row "run_instructions" (math/round (1.0 * a.target * factor))

# The share-weighted ratio to the anchor. Renormalised over the phases the row
# carries, which for every row this reaches is all of them.
fn weighed_ratio p tot row anchored
  p[2]! / tot * (1.0 * row[p[1]!] / anchored[p[1]!])

fn moved row anchored phases
  tot = list/sum (list/to_list (list/map phases (p -> p[2]!)))
  each = list/map phases (p -> weighed_ratio p tot row anchored)
  list/sum (list/to_list each)

# --- the compile term's epochs ----------------------------------------------
# bench/compile_epochs.txt names each commit that changed HOW the compile
# counters are measured, and by how much. Scoring divides the baseline by every
# factor from a row's own epoch forward, so a row measured on a smaller
# workload is asked about a smaller baseline.
#
# WITHOUT IT the welfare column steps at three commits where nothing about the
# compiler moved. The largest of the three multiplies the compile term by 4.36
# and the file's own header says where each factor was read.
#
# KEYED BY COMMIT, NOT BY POSITION OR DATE. The rows are chronological and
# their dates are not -- six adjacent pairs go backwards, because the branch
# records some commits in UTC and some at an offset -- so position is the only
# ordering the file has, and a commit is the only name a row gives a position.
fn epoch_map raw
  rows = list/select (text/split raw "\n") phase_line?
  list/to_list (list/map rows one_epoch)

fn one_epoch line
  parts = text/split line " "
  [parts[1]! parts[2]! (text/to_float parts[3]!)]

# The divisor the OLDEST epoch carries: every boundary's factor multiplied,
# per counter.
fn oldest_divisor epochs
  fold epochs {} (acc e -> multiplied acc e[2]! e[3]!)

fn multiplied acc key f
  seeded acc key f (acc[key] == none)

fn seeded acc key f true
  put acc key f

fn seeded acc key f false
  put acc key (acc[key]! * f)

# A table that names three boundaries and finds two is stale, and the failure
# it causes looks like a working answer: the rows past the missing boundary
# stay on the wrong divisor and every number stays plausible. So a PARTIAL
# match refuses.
#
# All-or-nothing rather than all-or-refuse, because a history that carries
# none of the boundaries is not the history this table describes — a staged
# fixture, which every spec over this tool writes — and scaling it by the
# whole product would be inventing a re-basing it never had. Those get no
# epochs at all.
#
# THE HOLE THIS LEAVES, said out loud: a rewrite that dropped EVERY boundary
# commit at once would take the no-epochs arm silently. Nothing here can tell
# that from a fixture, and the partial case is the one staleness actually
# produces.
fn absent? rows e
  length (list/to_list (list/select rows (r -> r["commit"] == e[1]!))) == 0

fn epoch_divisors rows epochs
  gone = length (list/to_list (list/select epochs (e -> absent? rows e)))
  divisors rows epochs (gone == 0) (gone == length epochs)

fn divisors rows epochs true false
  start = [(oldest_divisor epochs) {}]
  list/fold rows start (a r -> crossed a r epochs)

fn divisors rows _ false true
  [{} (no_epochs rows)]

fn divisors rows _ true true
  [{} (no_epochs rows)]

fn divisors _ _ false false
  err "a compile epoch names a commit no history row carries"

# Every row on an empty divisor map, which `epoch_value` reads as the identity.
fn no_epochs rows
  list/fold rows {} (m r -> put m r["commit"] {})

# The divisor drops by a boundary's factor at the first row measured the new
# way and holds until the next boundary.
fn crossed a row epochs
  here = list/to_list (list/select epochs (e -> e[1]! == row["commit"]))
  now = list/fold here a[1]! (m e -> put m e[2]! (m[e[2]!]! / e[3]!))
  [now (put a[2]! row["commit"] now)]

# The baseline as a row's own epoch would have measured it.
fn rebased base d
  fold (entries base) {} (acc e -> at_epoch acc e d)

fn at_epoch acc (entry k v) d
  put acc k (epoch_value v d[k] (d[k] == none))

fn epoch_value v _ true
  v

fn epoch_value v f false
  math/round (1.0 * v / f)

fn at_row m divs row
  scoring m.terms (rebased m.base divs[row["commit"]]!) m.formula

# --- the rewrite ------------------------------------------------------------
fn over_rows m given
  path = where given
  phases = "bench/runbench_phases.txt"
  os/read_file! phases . (t -> with_phases m (phase_map t) path)

fn with_phases m phases path
  epochs = "bench/compile_epochs.txt"
  os/read_file! epochs . (t -> with_epochs m phases (epoch_map t) path)

fn with_epochs m phases epochs path
  os/read_file! path . (raw -> written m phases epochs raw)

fn where given
  chosen given (length given == 0)

fn chosen _ true
  "history.jsonl"

fn chosen given false
  given[1]!

fn written m phases epochs raw
  lines = list/select (text/split raw "\n") (l -> length l > 0)
  decoded = list/to_list (list/map lines json/decode)
  a = anchor decoded phases
  divs = (epoch_divisors decoded epochs)[2]!
  built = list/map decoded (r -> scored_row m divs r a phases)
  rows = list/to_list built
  io/write "{text/join rows "\n"}\n"

fn scored_row m divs r a phases
  rescored (at_row m divs r) (reconstructed r a phases)

fn rescored m row
  weight = covered row m.terms m.base
  told = columned row m.terms m.base (weight == 0.0)
  by = put told "scored_by" m.formula
  json/encode (put by "scored_weight" (fixed weight 2))

# A row carrying no counter ANY term reads gets no welfare column. There is no
# denominator left to renormalize onto, so there is no arithmetic that could
# answer; the chart reads a missing column as a gap and `scored_weight` reads
# 0.00 beside it.
#
# The case could not arise while the objective read twenty-eight counters over
# thirteen benchmarks, because every row of the five hundred carried at least
# one of them. The 2026-09-06 gavel made the run terms read one program that no
# historical row was measured against, and 151 rows then carried none of the
# five that remain. Until this arm existed the tool died on the first of them
# with "`*` is not defined for these values" -- an empty denominator surfacing
# three functions later, in the rounding.
#
# The stale column goes rather than staying. A number the previous formula
# produced, sitting under a `scored_by` naming the new one, is the one outright
# lie this tool can tell.
fn columned row _ _ true
  without row "welfare"

fn columned row ts base false
  put row "welfare" (fixed (score row ts base) 4)

fn without m key
  fold (entries m) {} (acc e -> unless_named acc e key)

fn unless_named acc (entry k v) key
  kept acc k v (k == key)

fn kept acc _ _ true
  acc

fn kept acc k v false
  put acc k v

# --- the formula, on the counters a row carries -----------------------------
# The counters a term can be scored on here: present in the row AND known to
# the baseline. A term with none is dropped, and its weight leaves with it.
fn present row base t
  list/select t.counters (c -> row[c] != none and base[c] != none)

fn score row ts base
  shares = list/to_list (list/map ts (t -> share row base t))
  weights = list/to_list (list/map ts (t -> carried_weight row base t))
  100.0 * list/sum shares / list/sum weights

# How much of the formula this row's counters cover: each term's weight times
# the share of its counters the row carries. One means the row was scored on
# everything the objective weighs.
#
# This is not the renormalizing weight below, and the difference is the whole
# reason it is worth a field. Renormalization asks whether a term can be
# scored at all, so a term keeps its full weight on one counter of ten and a
# row scored on six counters of twenty-four still reads 1.00. Coverage asks
# how much of the term that one counter is, and answers 0.41 for the same
# row. A reader watching the line needs the second question answered.
fn covered row ts base
  list/sum (list/to_list (list/map ts (t -> coverage row base t)))

fn coverage row base t
  here = length (list/to_list (present row base t))
  t.weight * here / length t.counters

fn carried_weight row base t
  weighed t (length (list/to_list (present row base t)) == 0)

fn weighed _ true
  0.0

fn weighed t false
  t.weight

fn share row base t
  here = list/to_list (present row base t)
  shared row base t here (length here == 0)

fn shared _ _ _ _ true
  0.0

fn shared row base t here false
  sat = t.satiation
  each = list/map here (c -> satisfaction (ratio_of row base c) sat)
  sats = list/to_list each
  list/sum sats / (1.0 * length sats) * t.weight

fn ratio_of row base c
  as_ratio (live base[c]!) (live row[c]!)

fn as_ratio a b
  1.0 * a / b

fn satisfaction ratio satiation
  ratio / (ratio + satiation)

fn live n
  nonzero n (n == 0)

fn nonzero _ true
  0.5

fn nonzero n false
  n

# --- a fixed column, as the report renders one ------------------------------
fn pow10 0
  1

fn pow10 n
  10 * pow10 (n - 1)

fn zeroed s width
  wider s width (length s >= width)

fn wider s _ true
  s

fn wider s width false
  zeroed "0{s}" width

fn fixed_of units scale places
  whole = units / scale
  frac = units - whole * scale
  "{whole}.{zeroed "{frac}" places}"

fn fixed x places
  scale = pow10 places
  units = math/round (x * scale)
  fixed_of units scale places
