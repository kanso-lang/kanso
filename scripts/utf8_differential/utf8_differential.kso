import "std/io"
import "std/list"
import "std/os"
import "std/text"

# Differential check of the utf-8 validator against an independent reference.
#
# The validator's text is extracted from src/runtime.c at run time rather than
# copied, so this cannot drift from the function it checks. The reference in
# scripts/utf8/harness.c is a plain scalar decoder written straight from the
# grammar, so agreement between them is evidence rather than a tautology.
#
# Exhaustive over every string of three bytes or fewer, then sampled over the
# lengths that straddle the sixteen-byte vector boundary.
#
# The character counter travels with it. It reads eight bytes at a time, so
# its edges are the lengths either side of a word and the characters that
# straddle one, and the harness walks every arrangement of character widths
# that fits in twenty-four bytes.
sig_tail = " const char* origin) \{"

# The validator is two functions. `k_utf8_bad` is the front door: it counts the
# bytes, asks the ascii predicate, and answers without touching the wide pass
# for every token a json document holds. `k_utf8_bad_wide` is the pass itself,
# reached only by a run carrying a byte with the high bit set. Both travel here
# under their own names, and the door keeps calling the pass, so what this
# checks is the composition rather than either half on its own.
door_head = "KValue k_utf8_bad(const char* data, long long len,"

signature = "{door_head}{sig_tail}"

harness_sig = "static int harness_utf8_ok(const char* data, long long len) \{"

wide_head = "static KValue k_utf8_bad_wide(const char* data, long long len,"

wide_sig = "{wide_head}{sig_tail}"

wide_out = "static int harness_utf8_wide(const char* data,"

harness_wide_sig = "{wide_out} long long len) \{"

wide_call = "return k_utf8_bad_wide(data, len, origin);"

harness_wide_call = "return harness_utf8_wide(data, len);"

# The character counter, extracted the same way and for the same reason. It
# reaches the harness under a name of its own so the reference beside it can
# be a different function rather than the same one twice.
sig_chars_head = "static long long k_utf8_chars(const unsigned char* p,"

chars_sig = "{sig_chars_head} long long len) \{"

chars_head = "static long long harness_utf8_chars(const unsigned char* p,"

harness_chars_sig = "{chars_head} long long len) \{"

# The ascii predicate the validator asks first. It reads whole words and, for
# a run under eight bytes, two narrower loads that overlap in the middle — so
# it is the piece where a width bug would show as a read outside the run, and
# it travels under its own name because the body above calls it by that name.
ascii_sig = "static int k_all_ascii(const char* data, long long len) \{"

extracted_path = "target/extracted.h"

binary_path = "target/utf8_harness"

header = """
  #include <stdint.h>
  #if defined(__aarch64__)
  #include <arm_neon.h>
  #elif defined(__x86_64__)
  #include <tmmintrin.h>
  #endif
"""

fn body_of src sig
  parts = text/split src sig
  start = "{sig}{parts[2]!}"
  text/slice start 1 (closing_brace start 0 1)

# The function ends at the brace that closes the one its signature opens.
fn closing_brace src depth i
  at_brace src depth i (text/slice src i i)

fn at_brace _ 1 i "}"
  i

fn at_brace src depth i "\{"
  closing_brace src (depth + 1) (i + 1)

fn at_brace src depth i "}"
  closing_brace src (depth - 1) (i + 1)

fn at_brace src depth i _
  closing_brace src depth (i + 1)

# `return k_err(...)` reports which byte was bad; the harness only compares a
# yes or no, so every failure arm answers the same 0. The argument list holds
# no semicolon, so the statement ends at the first one.
fn no_err body
  parts = text/split body "return k_err("
  list/fold (list/to_list (list/drop parts 1)) parts[1]! rejoined

fn rejoined acc chunk
  tail = text/split chunk ";"
  rest = text/join (list/to_list (list/drop tail 1)) ";"
  "{acc}return 0;{rest}"

fn swapped src from to
  text/join (text/split src from) to

fn as_harness src
  ascii = body_of src ascii_sig
  wide = as_wide (no_err (body_of src wide_sig))
  door = as_door (body_of src signature)
  chars = swapped (body_of src chars_sig) chars_sig harness_chars_sig
  "{header}{ascii}\n{wide}\n{door}\n{chars}\n"

fn as_wide body
  named = swapped body wide_sig harness_wide_sig
  swapped named "return k_none();" "return 1;"

fn as_door body
  named = swapped body signature harness_sig
  ok = swapped named "return k_none();" "return 1;"
  counted = swapped ok "k_stat_utf8_bytes += len;" ""
  swapped counted wide_call harness_wide_call

# The validator's x86 path is written in ssse3 intrinsics, which clang refuses
# to compile unless the target is told it has them.
fn flags_for "x86_64"
  ["-mssse3"]

fn flags_for _
  []

fn built flags
  head = text/concat ["-O2"] flags
  tail = ["-o" binary_path "scripts/utf8/harness.c" "-Itarget"]
  os/run "clang" (text/concat head tail)

fn trimmed ""
  ""

fn trimmed s
  dropped s (text/slice s (length s) (length s))

fn dropped s "\n"
  trimmed (text/slice s 1 (length s - 1))

fn dropped s _
  s

fn written source
  os/write_file extracted_path source . (_ -> os/run "uname" ["-m"])
    . (u -> compiled (trimmed u.stdout))

fn compiled arch
  built (flags_for arch) . checked

fn checked b
  ran (b.status == 0) b.stderr

fn ran false trouble
  io/write_err trouble . (_ -> os/exit 1)

fn ran true _
  os/run binary_path [] . reported

fn reported r
  io/write "{trimmed r.stdout}\n" . (_ -> verdict r.status)

fn verdict 0
  io/write "PASS  both agree with their references everywhere checked\n"

fn verdict _
  io/write_err "FAIL  a function and its reference disagree\n"
    . (_ -> os/exit 1)

pub play = os/read_file! "src/runtime.c" . (src -> written (as_harness src))
