import "std/io"
import "std/json"
import "std/list"
import "std/math"
import "std/text"

# The long view: every merged commit, on one chart, five lines — and every
# number on it deterministic, so any runner can extend it and none can smear
# it. RULED (Clay, 2026-08-03): the graph is the four core metrics plus the
# welfare aggregate, nothing else. Wall clock appears nowhere here; the one
# wall-clock surface left anywhere is the cross-language board, which is
# published as a relative metric because a competitor's cost cannot be
# counted by kanso's counters.
#
# The data is bench/history_series.jsonl — a copy of the perf-history
# branch's history.jsonl, one JSON row per merged commit, staged by CI (or a
# person) before this runs. CI appends the commit under test as the last row,
# so a pull request's chart ends at the pull request.
#
# Each line is scaled to its own range, because the units have nothing to do
# with each other. What the chart shows is shape: which way each number went,
# and when it stepped. The x axis is row order rather than time — commits are
# what the ratchet acts on, and evenly spacing them keeps every step visible.
#
# A series starts where its counters start. The schema grew over the
# project's life, so the compile lines reach back to the first row while the
# welfare line begins where the score was first recorded; a row missing any
# counter a series needs is skipped for that series and no other.
type series
  colour
  label
  reading

width = 1200

height = 560

pad = 64

s_run_speed = series "#4fd1ff" "run speed" run_speed

s_run_memory = series "#a78bfa" "run memory" run_memory

s_comp_speed = series "#ffd166" "compile speed" compile_speed

s_comp_memory = series "#f472b6" "compile memory" compile_memory

s_welfare = series "#4ade80" "welfare" welfare_of

lines = [s_run_speed s_run_memory s_comp_speed s_comp_memory s_welfare]

series_path = "bench/history_series.jsonl"

# Run speed is the codec's two allocation counts. The basket is deliberately
# absent even though welfare's run-speed dimension reads it: no history row
# recorded it until now, and adding it mid-line would draw a step no change
# made — the same reason the renamed held-malloc peak is absent from run
# memory. The welfare line carries the basket's effects, because the recorded
# score always included them.
fn run_speed r
  a = r["allocs"]
  b = r["encode_allocs"]
  sum2 a b (a == none or b == none)

fn sum2 _ _ true
  none

fn sum2 a b false
  a + b

# The one-shot peak represents run memory because it has meant one thing for
# its whole life: decode, hold, print — the peak the rewinds cannot hide. The
# held-malloc peak is deliberately absent; it was renamed when its meaning
# widened, and a line that changes meaning mid-chart would draw a step no
# change made.
fn run_memory r
  r["oneshot_arena_peak_bytes"]

fn compile_speed r
  a = r["compile_rounds"]
  b = r["compile_visits"]
  c = r["emitted_lines"]
  two = sum2 a b (a == none or b == none)
  sum2 two c (two == none or c == none)

fn compile_memory r
  r["compile_peak_bytes"]

# The recorded score, in hundredths so integer scaling never rounds a real
# move away. Recorded rather than recomputed: the score a commit shipped with
# is a fact about that commit, and recomputing history against today's
# baseline would rewrite it.
fn welfare_of r
  w = r["welfare"]
  scored w (w == none)

fn scored _ true
  none

fn scored w false
  math/round (text/to_float w * 100.0)

fn decoded text
  raw = list/select (text/split text "\n") (l -> length l > 2)
  rows = list/to_list (list/map raw json/decode)
  charted rows (length rows)

fn charted _ 0
  io/write_err "no rows — {series_path} is empty\n" . (_ -> io/exit 1)

fn charted rows n
  io/read_file "docs/compiler.html" . (page -> spliced page rows n)

fn spliced page rows n
  body = svg rows n
  before = (text/split page "<!--long-view-->")[1]!
  rest = (text/split page "<!--/long-view-->")[2]!
  open = "{before}<!--long-view-->"
  close = "<!--/long-view-->{rest}"
  io/write_file "docs/compiler.html" "{open}\n{body}\n{close}"
    >> io/write "long view: {n} commits, {length lines} lines\n"

fn svg rows n
  drawn_lines = list/map lines (s -> path s rows n)
  body = text/join (list/to_list drawn_lines) "\n"
  keys = text/join (list/to_list (list/map lines legend)) "\n"
  frame body keys n

# One series: keep the (index, value) pairs where the value exists, scale to
# this series' own range, emit one polyline.
fn path s rows n
  pairs = kept s rows 1 n []
  drawn s pairs (length pairs) n

fn kept s rows at n acc
  walking s rows at n acc (at > n)

fn walking _ _ _ _ acc true
  acc

fn walking s rows at n acc false
  v = s.reading rows[at]!
  grown = extended acc at v (v == none)
  kept s rows (at + 1) n grown

fn extended acc _ _ true
  acc

fn extended acc at v false
  push acc [at v]

fn drawn _ _ 0 _
  ""

# A near-flat series draws flat. Scaling every line to its own range makes
# a fifteen-byte wiggle on an 819-kilobyte peak fill the whole plot, and a
# reader is right to read that as a cliff. The span a line is drawn against
# is therefore never smaller than two percent of the series' magnitude:
# real moves keep their shape, and noise draws as the flat line it is.
fn drawn s pairs n total
  values = list/to_list (list/map pairs (p -> p[2]!))
  low = list/min values
  high = list/max values
  floor_span = magnitude low high / 50
  span = widened (high - low) floor_span (high - low < floor_span)
  mid = (low + high) / 2
  coords = stepped pairs (mid - span / 2) (mid + span / 2) total 1 n ""
  open = "<polyline fill=\"none\" stroke=\"{s.colour}\""
  "{open} stroke-width=\"2\" points=\"{coords}\"/>"

fn magnitude low high
  grown_mag (low + high) / 2

fn grown_mag m
  flipped m (m < 0)

fn flipped m true
  0 - m

fn flipped m false
  m

fn widened _ floor_span true
  floor_span

fn widened span _ false
  span

fn stepped pairs low high total at n acc
  placing pairs low high total at n acc (at > n)

fn placing _ _ _ _ _ _ acc true
  acc

fn placing pairs low high total at n acc false
  pair = pairs[at]!
  x = across pair[1]! total
  y = up pair[2]! low high
  stepped pairs low high total (at + 1) n "{acc} {x},{y}"

fn across at total
  pad + (at - 1) * (width - 2 * pad) / span_of (total - 1)

fn span_of 0
  1

fn span_of n
  n

fn up v low high
  scaled v low (high - low)

# A flat line draws along the middle rather than dividing by zero.
fn scaled _ _ 0
  height / 2

fn scaled v low span
  top = pad / 2
  usable = height - pad - top
  top + usable - (v - low) * usable / span

fn legend s
  at = index_of s 1
  x = pad + (at - 1) * 210
  y = height - 16
  swatch = "<rect x=\"{x}\" y=\"{y - 9}\" width=\"22\" height=\"3\""
  dot = "{swatch} fill=\"{s.colour}\"/>"
  key = "class=\"trend-key\""
  said = "<text x=\"{x + 30}\" y=\"{y}\" {key}>{s.label}</text>"
  "{dot}{said}"

fn index_of s at
  placed s at (lines[at]!.label == s.label)

fn placed _ at true
  at

fn placed s at false
  index_of s (at + 1)

fn frame body keys n
  open = "<svg class=\"trend\" viewBox=\"0 0 {width} {height}\" role=\"img\""
  said = "five measures across {n} commits"
  titled = "{open} aria-label=\"{said}\">"
  "{titled}\n{body}\n{keys}\n</svg>"

pub play = io/read_file series_path . decoded
