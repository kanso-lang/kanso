import "std/io"
import "std/json"
import { find:list_find } "std/list"
import "std/os"
import "std/regexp"
import "std/text"

# What a reader sees when the editor grammar paints a kanso file.
#
# The website's tokenizer and this grammar are two implementations of one
# answer, and they drift silently: nothing fails when a rule stops matching,
# the colour just quietly goes away, and the person who notices is whoever
# opens a file weeks later.
#
# So this asserts the painting rather than the rules — for each line, which
# words come out as types. A rule can be rewritten however it likes as long as
# the reader's answer is unchanged.
type rule
  pattern
  paints
  captures
  ends

type painted
  text
  scope

type expectation
  line
  wanted
  scope

grammar_path = "editors/kanso/syntaxes/kanso.tmLanguage.json"

comment_scope = "comment.line"

operator_scope = "keyword.operator"

string_scope = "string.quoted.double"

type_scope = "entity.name.type"

e1 = expectation "type person" ["person"] type_scope

e2 = expectation "  name:string" ["string"] type_scope

e3 = expectation "  partner:person" ["person"] type_scope

e4 = expectation "  peers:person[]" ["person[]"] type_scope

e5 = expectation "fn shout s:string" ["string"] type_scope

e6 = expectation "type post_body:string" ["post_body" "string"] type_scope

e7 = expectation "# who they are" ["# who they are"] comment_scope

# Two strings, so a closer that stops working swallows the gap between them
# and paints one run where a reader sees two.
e8 = expectation "x = \"hi\" \"yo\"" ["\"hi\"" "\"yo\""] string_scope

e9 = expectation "  shout s . print" ["."] operator_scope

expectations = [e1 e2 e3 e4 e5 e6 e7 e8 e9]

fn read_grammar raw
  checked (json/decode raw)

fn checked (err reason)
  io/write "the grammar does not parse: {reason}\n" . (_ -> os/exit 1)

fn checked grammar
  rules = rules_of grammar
  faults = over_lines rules 1 []
  reported faults

# The repository entries the top-level pattern list names, in that order.
# Three shapes reach a reader: a rule that matches text, a rule that opens and
# closes around it, and a rule that is only a list of the other two.
fn rules_of grammar
  named = grammar["patterns"]!
  repo = grammar["repository"]!
  gathered named repo 1 []

fn gathered named repo at acc
  gathering named repo at acc (at > length named)

fn gathering _ _ _ acc true
  acc

fn gathering named repo at acc false
  one = named[at]!
  carried named repo at acc one (one["include"] == none)

fn carried named repo at acc _ true
  gathered named repo (at + 1) acc

fn carried named repo at acc one false
  found = repo[without_hash one["include"]!]!
  gathered named repo (at + 1) (kept acc found)

fn kept acc found
  as_match acc found (found["match"] == none)

fn as_match acc found false
  push acc (rule found["match"]! found["name"] found["captures"] none)

fn as_match acc found true
  as_span acc found (found["begin"] == none)

fn as_span acc found false
  push acc (rule found["begin"]! found["name"] none found["end"]!)

fn as_span acc found true
  as_group acc found (found["patterns"] == none)

fn as_group acc _ true
  acc

fn as_group acc found false
  each_sub acc found["patterns"]! 1

fn each_sub acc subs at
  subbing acc subs at (at > length subs)

fn subbing acc _ _ true
  acc

fn subbing acc subs at false
  each_sub (kept acc subs[at]!) subs (at + 1)

fn without_hash name
  bare name (text/slice name 1 1 == "#")

fn bare name true
  text/slice name 2 (length name)

fn bare name false
  name

# First match wins, the way a tmLanguage scan works: at each position the
# earliest rule that matches exactly here paints, and the walk resumes past
# what it painted.
fn paint line rules at acc
  painting line rules at acc (at > length line)

fn painting _ _ _ acc true
  acc

fn painting line rules at acc false
  tried line rules 1 at acc

fn tried line rules i at acc
  trying line rules i at acc (i > length rules)

fn trying line rules _ at acc true
  paint line rules (at + 1) acc

fn trying line rules i at acc false
  one = rules[i]!
  m = regexp/match_at one.pattern line at
  landed line rules i at acc one m

fn landed line rules i at acc _ none
  tried line rules (i + 1) at acc

fn landed line rules _ at acc one m
  spanned line rules at acc one m (one.ends == none)

fn spanned line rules at acc one m true
  whole = text/slice line at (m.to - 1)
  grown = with_captures (with_whole acc one whole) one m
  paint line rules (past at m) grown

# A span paints from its opener through its closer, which is what a reader
# sees. Where the closer never arrives the line ends the run.
fn spanned line rules at acc one m false
  stop = closing one.ends line m.to
  whole = text/slice line at (stop - 1)
  paint line rules stop (push acc (painted whole one.paints))

fn closing ends line at
  seeking ends line at (at > length line)

fn seeking _ _ at true
  at

fn seeking ends line at false
  reached ends line at (regexp/match_at ends line at)

fn reached ends line at none
  closing ends line (at + 1)

fn reached _ _ _ m
  m.to

fn past at m
  bigger m.to (at + 1)

fn bigger a b
  taller a b (a > b)

fn taller a _ true
  a

fn taller _ b false
  b

fn with_whole acc one whole
  named_scope acc whole one.paints (one.paints == none)

fn named_scope acc _ _ true
  acc

fn named_scope acc whole scope false
  push acc (painted whole scope)

# A rule's captures are keyed by group number, so slot one is "1".
fn with_captures acc one m
  no_captures acc one m (one.captures == none)

fn no_captures acc _ _ true
  acc

fn no_captures acc one m false
  each_capture acc one.captures m.groups 1

fn each_capture acc caps groups at
  capturing acc caps groups at (at > length groups)

fn capturing acc _ _ _ true
  acc

fn capturing acc caps groups at false
  text = groups[at]!
  found = caps["{at}"]
  named_capture acc caps groups at text found (text == "" or found == none)

fn named_capture acc caps groups at _ _ true
  each_capture acc caps groups (at + 1)

fn named_capture acc caps groups at text found false
  grown = push acc (painted text found["name"]!)
  each_capture grown caps groups (at + 1)

fn over_lines rules at acc
  walking rules at acc (at > length expectations)

fn walking _ _ acc true
  acc

fn walking rules at acc false
  one = expectations[at]!
  out = paint one.line rules 1 []
  seen = list/to_list (list/map (in_scope out one.scope) (p -> p.text))
  gaps = missing one seen 1 []
  over_lines rules (at + 1) (list/to_list (text/concat acc gaps))

fn in_scope out scope
  list/to_list (list/select out (p -> in? p.scope scope))

fn in? hay needle
  length (text/split hay needle) > 1

fn missing one seen at acc
  checking one seen at acc (at > length one.wanted)

fn checking _ _ _ acc true
  acc

fn checking one seen at acc false
  want = one.wanted[at]!
  missing one seen (at + 1) (noted acc one want seen (has? seen want))

fn has? seen want
  length (list/to_list (list/select seen (t -> t == want))) > 0

fn noted acc _ _ _ true
  acc

fn noted acc one want seen false
  said = "'{one.line}': '{want}' is not painted {one.scope}"
  push acc "{said} (painted: {seen})"

fn reported faults
  clean faults (length faults == 0)

fn clean _ true
  io/write "PASS  {length expectations} lines paint the way a reader expects\n"

fn clean faults false
  io/write (spelled faults 1 "") . (_ -> os/exit 1)

fn spelled faults at acc
  telling faults at acc (at > length faults)

fn telling _ _ acc true
  acc

fn telling faults at acc false
  spelled faults (at + 1) "{acc}FAIL  {faults[at]!}\n"

pub play = os/read_file grammar_path . (raw -> read_grammar raw)
