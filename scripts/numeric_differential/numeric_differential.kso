import "std/io"
import "std/list"
import "std/text"

# Differential check of integer arithmetic between the two engines.
#
# The interpreter is the oracle, so agreement is the requirement and any
# disagreement is a finding. This generates whole programs and runs each
# through both engines, because that is the boundary the differential law
# actually governs — what a program prints, not what a function returns.
#
# Ranges are chosen to straddle the places arithmetic changes character:
# around zero, around the i32 and i64 boundaries, and well past 2^63 where the
# native build's ceiling lives. A known divergence there is recorded below, so
# this reports it once rather than drowning in it, and fails if the set of
# divergences grows — or shrinks without the entry being removed.
#
# Every operand is carried as text. Half of them do not fit an int64, which is
# the point: the generator may not hold a value the program under test is
# being asked about.
#
# Narrowing walks the suspects one at a time and each step nests inside the
# last, so a few hundred of them exhaust the stack. That is a loud failure
# rather than a quiet one, and it takes a regression across a whole batch to
# reach: a handful of real disagreements reports them and stops.
#
# What one engine answered.
type answer
  code
  err
  out

probe = "target/numeric_probe.kso"

# The divergence this project has accepted and pinned (task #46): above the
# native ceiling the oracle is exact and the native build refuses. It refuses
# in two voices — a literal too wide is caught while compiling, an operation
# that overflows while running — and matching only the second counted the
# first as four hundred bugs. Every other disagreement is a bug.
ceiling_a = "integer overflow"

ceiling_b = "does not fit this build's 64-bit int"

small = ["0" "1" "-1" "2" "-2" "7" "-7" "10" "255" "256" "-256"]

word32 = ["2147483647" "2147483648" "-2147483648" "4294967296" "-4294967296"]

word64 = ["4611686018427387904" "9223372036854775807" "-9223372036854775808"]

above = ["9223372036854775808" "18446744073709551616"]

narrow = text/concat small word32

wide = text/concat word64 above

edges = list/to_list (text/concat narrow wide)

batch_size = 200

# A Lehmer generator on the 31-bit Mersenne prime: every product stays under
# 2^47, so nothing here can reach the ceiling the programs it writes are about.
# It answers the same stream on every engine and every run, which the host's
# own generator does not.
seed = 2685821657

fn stepped s
  s * 48271 % 2147483647

fn digits s 0 acc
  answered_digits s acc

fn digits s n acc
  next = stepped s
  digits next (n - 1) "{acc}{next % 10}"

fn answered_digits s acc
  [s acc]

fn signed s
  negative s (s % 2 == 0)

fn negative _ true
  "-"

fn negative _ false
  ""

fn random_case s
  drawn = digits s 20 ""
  after = drawn[1]!
  left = "{signed after}{drawn[2]!}"
  second = digits (stepped after) 20 ""
  right = "{signed second[1]!}{second[2]!}"
  [(stepped second[1]!) left (op_for second[1]!) right]

fn op_for s
  chosen (s % 3)

fn chosen 0
  "+"

fn chosen 1
  "-"

fn chosen _
  "*"

fn rounds_of _ 0 acc
  acc

fn rounds_of s n acc
  drawn = random_case s
  rounds_of drawn[1]! (n - 1) (push acc [drawn[2]! drawn[3]! drawn[4]!])

fn pairs_for a
  list/fold edges [] (acc b -> joined acc (ops_for a b))

fn joined acc more
  list/to_list (text/concat acc more)

fn ops_for a "0"
  [[a "+" "0"] [a "-" "0"] [a "*" "0"]]

fn ops_for a b
  [[a "+" b] [a "-" b] [a "*" b] [a "/" b] [a "%" b]]

every_edge_case = list/fold edges [] (acc a -> joined acc (pairs_for a))

fn line_for c
  "print ({c[1]!} {c[2]!} {c[3]!})\n"

fn program cases
  text/join (list/to_list (list/map cases line_for)) ""

fn asked argv
  io/run "target/release/kanso" argv

fn ran source
  io/write_file probe source . (_ -> asked ["run" probe]) . (n -> against n)

fn against n
  asked ["run" probe "--interp"] . (i -> both (told n) (told i))

fn told r
  answer r.status r.stderr r.stdout

fn both n i
  [n i]

fn agree? n i
  n.code == i.code and n.out == i.out and n.err == i.err

fn holds? hay needle
  length (text/split hay needle) > 1

fn at_ceiling? n i
  said = "{n.err}{i.err}"
  holds? said ceiling_a or holds? said ceiling_b

fn chunked cases at acc
  more_chunks cases at acc (at > length cases)

fn more_chunks _ _ acc true
  acc

fn more_chunks cases at acc false
  rest = list/to_list (list/drop cases (at - 1))
  taken = list/to_list (list/take rest batch_size)
  chunked cases (at + batch_size) (push acc taken)

fn rounds_from given
  asked_for given (length given == 0)

fn asked_for _ true
  200

fn asked_for given false
  text/to_int given[1]!

fn started rounds
  fixed = every_edge_case
  everything = joined fixed (rounds_of seed rounds [])
  batches = chunked everything 1 []
  over_batches batches 1 [] . (suspect -> narrowed everything batches suspect)

fn over_batches batches at suspect
  onward_batch batches at suspect (at > length batches)

fn onward_batch _ _ suspect true
  suspect

fn onward_batch batches at suspect false
  here = batches[at]!
  ran (program here) . (r -> kept batches at suspect here r)

fn kept batches at suspect here r
  over_batches batches (at + 1) (widened suspect here (agree? r[1]! r[2]!))

fn widened suspect _ true
  suspect

fn widened suspect here false
  joined suspect here

fn narrowed everything batches suspect
  alone suspect 1 [] 0 . (found -> reported everything batches found)

fn alone suspect at bad known
  onward_one suspect at bad known (at > length suspect)

fn onward_one _ _ bad known true
  [bad known]

fn onward_one suspect at bad known false
  c = suspect[at]!
  ran (program [c]) . (r -> judged suspect at bad known c r)

fn judged suspect at bad known c r
  settled suspect at bad known c r (agree? r[1]! r[2]!)

fn settled suspect at bad known _ _ true
  alone suspect (at + 1) bad known

fn settled suspect at bad known c r false
  counted suspect at bad known c r (at_ceiling? r[1]! r[2]!)

fn counted suspect at bad known _ _ true
  alone suspect (at + 1) bad (known + 1)

fn counted suspect at bad known c r false
  alone suspect (at + 1) (push bad [c r[1]! r[2]!]) known

fn reported everything batches found
  bad = found[1]!
  known = found[2]!
  head = "{length everything} programs in {length batches} batches"
  tail = "{known} at the known ceiling, {length bad} disagreements"
  io/write "{head}, {tail}\n" . (_ -> io/write (findings bad))
    . (_ -> closed (length bad) known)

# Ten of them, by index. Ten is what a reader can hold; the count above says
# how many there really were.
fn findings bad
  gathered bad 1 (fewer 10 (length bad)) ""

fn fewer a b
  smaller a b (a < b)

fn smaller a _ true
  a

fn smaller _ b false
  b

fn gathered bad at upto acc
  more_findings bad at upto acc (at > upto)

fn more_findings _ _ _ acc true
  acc

fn more_findings bad at upto acc false
  gathered bad (at + 1) upto "{acc}{finding bad[at]!}"

fn finding b
  c = b[1]!
  n = b[2]!
  i = b[3]!
  said = "  print ({c[1]!} {c[2]!} {c[3]!})\n"
  "{said}{engine "native" n}{engine "interp" i}"

fn engine name r
  "    {name}: code={r.code} out={trimmed r.out} err={trimmed r.err}\n"

fn trimmed ""
  ""

fn trimmed s
  dropped s (text/slice s (length s) (length s))

fn dropped s "\n"
  trimmed (text/slice s 1 (length s - 1))

fn dropped s _
  s

fn closed 0 0
  io/write "\nnothing reached the native ceiling — either the gap closed,\n"
    . (_ -> io/write "or the ranges above stopped straddling it.\n")
    . (_ -> io/exit 1)

fn closed 0 _
  io/write ""

fn closed _ _
  io/write "\nthe interpreter is the oracle: these are native's to fix.\n"
    . (_ -> io/exit 1)

pub play = io/args . (given -> started (rounds_from given))
