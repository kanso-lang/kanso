import "std/io"
import "std/json"
import "std/list"
import "std/math"
import "std/os"
import "std/text"

# One number for the whole project, and a ratchet under it.
#
# The cost goldens each pin one counter, which catches a regression in that
# counter and nothing about the trade a change made across counters. A feature
# that spends compile work to buy runtime work passes every golden while
# leaving the project better or worse, and nobody can say which without an
# argument.
#
# So: combine what running costs and what compiling costs into a single scalar,
# and hold a floor under it. Every term is deterministic — allocation counts,
# arena blocks, fixpoint rounds, emitted lines — so the number moves only when
# somebody changes the compiler, never because the box was busy. Wall clock is
# deliberately absent for that reason.
#
#     welfare = 100 * (baseline_cost / current_cost)
#
# Cost is a weighted sum of normalised terms, so a hundred is the reference
# point and higher is better. The weights say what the project is buying:
# runtime speed and footprint dominate, compile cost matters and matters less.
#
#     welfare                    print the current score against the floor
#     welfare -- --set "why"     record the score as the new floor, with the
#                                reason it moved?
#
# The sum is the objective. A term getting worse while the sum rises is the
# trade the weights exist to license, so the per-term breakdown below the score
# says where a move came from and never excuses one. A sum that falls means the
# change is worse by the weights as written — the argument to have is whether
# the weights are right, not whether this term deserves a pass.
#
# WITH ONE EXCEPTION, AND IT IS NOT A TERM. A change that makes the engines
# agree is not weighed here at all. Correctness comes first and this number
# comes second: an incorrect calculation is not worth having at any performance
# benefit, so a fix for a differential-law violation ships and the floor moves
# to whatever it costs. Nothing in the sum can veto it, and there is no weight
# that would express it — a term would imply a price, and there is none.
#
# The gate cannot tell such a change from any other, so this is a rule for
# whoever reads a red run, not something the script enforces. It exists because
# the model spent a day looking like it could refuse a fix that cost the
# decoder four hundredths of a per cent to make native and the oracle answer
# the same thing.
#
# Each term carries two numbers, because weight alone cannot say what a second
# is worth here. `weight` is how much the dimension matters at all: runtime
# carries two thirds because that is the claim the front page makes, and
# compile cost a third, because a language nobody can iterate in is not fast
# either. `satiation` is how fast further improvement stops mattering, which
# differs by dimension and is not a matter of importance — a compiler that
# already finishes in six milliseconds gains almost nothing from three, while a
# decoder in a hot loop that gets eight times faster is eight times faster.
type dimension
  counters
  name
  satiation
  weight

floor_path = "bench/welfare_floor.json"

# WHAT THE SCORE WEIGHS. Four dimensions, not a list of counters: memory and
# performance, for compiling and for running. A counter is an input to one of
# them, never a term in its own right — which is how compile memory came to be
# weighted at zero while it more than doubled, because a list has no empty
# slots to notice.
#
# The weights come from what teams shipping software pay for, recorded with
# their sources in design/compiler-log.md. Runtime carries 0.60 because it
# recurs per request forever. Compile carries 0.40 rather than the third it
# looks like from inside, because 45% of people who stopped using rust named
# long compile times among their reasons — that is whether anyone stays, not
# whether they are comfortable. Inside compile, speed outweighs memory better
# than two to one: the complaint that dominates every survey is waiting for an
# incremental rebuild, not footprint.
#
# Satiation is a different question from weight — it says how long a dimension
# keeps paying for improvement. Runtime at 2.0: a decoder eight times faster is
# eight times faster. Compile at 0.5: a front end already answering in six
# milliseconds gains almost nothing from three.
# RUN SPEED IS ONE TERM OVER ONE PROGRAM. Ruled by Clay 2026-09-06.
#
# It was two halves of 0.30 -- the advertised workloads against the shape
# guards -- over twenty-five counters across thirteen programs, each normalised
# against its own baseline and averaged. Two things were wrong with that. A
# guard and a real workload were priced the same per counter, so which SHELF a
# benchmark sat on decided how much it was worth, and the shelving was an
# argument rather than a measurement. And a program nobody runs got a vote: the
# corpus grew by adding benchmarks, and every addition diluted every other row
# by a fraction nobody chose.
#
# One program answers both. bench/runbench does what a program using this
# language does -- decodes and encodes for two thirds of its work, meets the
# stress shapes for the rest -- and its proportions are stated in its own
# header, measured phase by phase rather than asserted. Its retired
# instructions are run speed and its peak is run memory. What used to be a
# question about shelves is now a question about the mix, which is written
# down in one place and can be argued with by re-measuring.
#
# The thirteen per-phase benchmarks all survive, with every golden they had.
# They say WHERE a move came from, which one number cannot; the objective says
# whether the project came out ahead, which thirteen numbers could not.
d_run_speed = dimension run_speed_counters "run speed" 2.0 0.30

# Compile speed rises and run memory funds it. Ruled 2026-09-02, from the
# objective restated: "the core thing we're attempting to optimize for here is
# ultimately developer happiness. performance should be insane, but if a
# language doesn't compile wickedly fast, like go, devs may choose not to use it
# in the first place." A developer feels compile latency on every edit and feels
# peak memory only when something falls over. The memory model is the identity;
# the order the objective punishes regressions in is the order developers
# notice them.
d_run_memory = dimension run_memory_counters "run memory" 2.0 0.26

d_compile_speed = dimension compile_speed_counters "compile speed" 0.5 0.32

# Unchanged at 0.12: the compiler's own footprint is a CI-container guard
# rather than something a developer perceives.
d_compile_memory = dimension compile_memory_counters "compile memory" 0.5 0.12

# Retired instructions, which is what a run costs. Laziness is priced here and
# nowhere else: a thunk is an implementation detail, so no thunk counter carries
# a weight, and the pending shape earns its place by what its work costs like
# every other phase of the program.
#
# What this row cannot see, stated rather than left implicit: a thunk is a cell
# allocated now and chased later, so much of its cost is locality, and an
# instruction count is close to blind to that. The memory term does not cover
# it either -- it prices RETENTION, and a thunk allocated and freed inside a
# beat moves neither while costing real traffic. Whether simulated cache misses
# close that gap is a measurement nobody has taken.
#
# Allocation counts sat here until a decode regression of eight and a half per
# cent scored zero: the allocator was called exactly as often and the work rose
# anyway, because a guard that runs per element allocates nothing. An
# allocation executes instructions, so this sees what the counts saw and the
# rest besides.
run_speed_counters = ["run_instructions"]

# The arena, the held pool and the permanent pool, summed by `peak_of`. One
# program, so one peak: a change that gives the arena back per position and a
# change that never grows it are the same thing to this row, and the run
# program's own phases are what make it possible for either to show.
run_memory_counters = ["run_peak_bytes"]

# What compiling COSTS, not what it counts. Rounds, visits and emitted lines
# are the compiler's own bookkeeping — how many times a fixpoint went round,
# how many expressions a pass looked at, how many lines came out. They are
# proxies, and on 2026-08-24 a change took `kanso check lib/json` from 90.9
# million retired instructions to 67.2 million with all three byte-identical.
# A quarter of the work went away and the dimension measuring compile speed
# scored the change at zero.
#
# So the measured veins carry it now: retired instructions and allocation
# traffic, both counted rather than inferred. The three proxies keep their
# goldens and keep failing CI when they move — a dropped fixpoint round is
# still news — they simply stop being the thing the score is made of. A
# tripwire and a term are different jobs, and the proxies were only ever good
# at the first.
#
# Ruled by Clay 2026-08-25: "welfare measures what compiling costs, not what
# it counts."
compile_speed_counters = ["compile_instructions" "compile_allocs"]

compile_memory_counters = ["compile_peak_bytes"]

run_terms = [d_run_speed d_run_memory]

compile_terms = [d_compile_speed d_compile_memory]

terms = text/concat run_terms compile_terms

# WHICH DEFINITION SCORED A ROW. It moves in the same commit as anything that
# changes what the number means — a weight, a satiation, a term's counters,
# the saturation rule — and it is emitted with the model so the one thing that
# rewrites history.jsonl's welfare column does not keep its own copy to go
# stale. The date is the day of the gavel that last moved the formula.
formula = "2026-09-06"

# The baseline and the per-counter breakdown are keyed by counter, because a
# counter is what is measured; a dimension is what it is measured FOR.
run_counters = text/concat run_speed_counters run_memory_counters

compile_counters = text/concat compile_speed_counters compile_memory_counters

counter_names = text/concat run_counters compile_counters

# A comment is not a counter, and one of them carries an `=`: the
# compile-memory golden names its host as `# measured-on rustc=1.98.0`,
# which parsed as a counter and died asking for the integer in "1.98.0".
# Every golden here is commented, so the guard belongs on the shared
# reader rather than on the one file that grew the line.
fn pair? l
  length (text/split l "=") == 2 and text/slice l 1 1 != "#"

fn named l
  (text/split l "=")[1]!

fn amount l
  text/to_int (text/split l "=")[2]!

# The cost goldens are one `name=value` to a line.
fn counters text
  lines = list/to_list (list/select (text/split text "\n") pair?)
  pairs = list/map lines counted
  list/to_h (list/to_list pairs)

fn counted l
  [(named l) (amount l)]

fn body? l
  text/slice l 1 1 != "#" and length l > 0

fn fields_of l
  list/to_list (list/select (text/split l " ") pair?)

fn value_in fields key
  found = list/to_list (list/select fields (f -> named f == key))
  first_or_zero found

fn first_or_zero fs
  taken fs (length fs == 0)

fn taken _ true
  0

fn taken fs false
  amount fs[1]!

fn total_for lines key
  amounts = list/map lines (l -> value_in (fields_of l) key)
  list/sum (list/to_list amounts)

# The compile golden is many fields to a line, one line per sample, and the
# term is the total across them.
fn work_pair l
  parts = text/split l " "
  [parts[1]! (text/to_int parts[2]!)]

fn work_of text
  lines = list/to_list (list/select (text/split text "\n") body?)
  list/to_h (list/to_list (list/map lines work_pair))

fn compile_totals text
  lines = list/to_list (list/select (text/split text "\n") body?)
  rounds = total_for lines "rounds"
  visits = total_for lines "visits"
  emitted = total_for lines "lines"
  list/to_h [["rounds" rounds] ["visits" visits] ["lines" emitted]]

# Three pools, and a peak that names two of them is not a peak. The arena is
# the one the beat design is about; `held` is string chunks, added when the
# same gap was found the first time; `perm` is accumulator storage pushed
# outside the arena, which had no owner at all until #912 and which every
# memory term here was blind to while a real program went from 3.88 GB to
# 3.88 MB. Any pool added after this belongs in this sum on the day it gets a
# counter, not on the day something big enough to notice moves it.
fn peak_of m
  m["arena_peak_bytes"]! + m["held_peak_bytes"]! + m["perm_peak_bytes"]!

fn measured run work veins
  rp = [["run_peak_bytes" (peak_of run)]]
  ir = veins[1]!
  traffic = veins[2]!
  held = veins[3]!
  ent = veins[4]!
  both = ir["compile_instructions"]! + ent["entry_instructions"]!
  ci = [["compile_instructions" both]]
  ca = [["compile_allocs" traffic["compile_allocs"]!]]
  cm = [["compile_peak_bytes" held["compile_peak_bytes"]!]]
  compile = text/concat ci (text/concat ca cm)
  list/to_h (text/concat (text/concat rp (worked work)) compile)

# ONE ROW OUT OF FOURTEEN. bench/instructions_golden.txt carries a row for
# every benchmark the gate counts, and since the 2026-09-06 gavel the objective
# reads exactly one of them: the consolidated run program's. The thirteen
# beside it are diagnostics -- they still fail CI when they move, and they say
# WHERE a move came from, which one number cannot.
#
# The `!` is the pin. A golden that lost this row would otherwise score as
# nothing rather than refusing, which is the shape of failure that put three
# benchmarks in the model at zero weight for weeks.
fn worked work
  [["run_instructions" work["runbench"]!]]

# How much a term being `ratio` times better than baseline is worth. A straight
# ratio says the tenth halving is worth as much as the first, which is false:
# past a point a program is fast enough that making it twice as fast again buys
# almost nothing. A logarithm is the usual reach and still pays every doubling
# equally. This saturates instead, at a rate the term chooses, so a dimension
# that stops mattering early can say so. Both curves are asymmetric around the
# baseline — halving a term's performance costs more than doubling it gains —
# which is the right shape for a ratchet.
fn satisfaction ratio satiation
  ratio / (ratio + satiation)

# a term that reached zero is better than any baseline, and dividing by it
# would say infinity rather than "as good as this gets"
fn live n
  nonzero n (n == 0)

fn nonzero _ true
  0.5

fn nonzero n false
  n

# `/` on two integers truncates, and every number here is a ratio, so the
# numerator enters as a float.
fn as_ratio a b
  1.0 * a / b

# A dimension improves when its counters improve on average, and the curve
# reaches each counter before the average is taken. Ruled 2026-08-29: "you do
# the log or whatever function it is on each term before averaging."
#
# Saturating the mean instead let one counter carry a whole term. A ratio
# enters a mean linearly and unbounded, so a benchmark 138 times better than
# its baseline contributed 138 where a benchmark twice as good contributed 2,
# and the run-speed term became 68% one benchmark — the pretty-printer — while
# the decode and encode rows the front page makes claims about were 1% between
# them. Saturating first bounds every counter at one, so no counter can
# dominate by raw magnitude and successive doublings of any single benchmark
# pay less, which is what the satiation curve is for.
#
# One counter halving while another doubles is still close to a wash. It is no
# longer exactly one, because the curve is asymmetric: the halving loses more
# than the doubling gains, which is the shape the ratchet wants.
fn share now base t
  sat = t.satiation
  each = list/map t.counters (c -> satisfaction (ratio_of now base c) sat)
  sats = list/to_list each
  list/sum sats / (1.0 * length sats) * t.weight

fn ratio_of now base c
  as_ratio (live base[c]!) (live now[c]!)

# The one number: a weighted sum of per-term satisfaction, on a scale whose
# ceiling is a hundred and whose origin is arbitrary. Not a percentage of
# anything — what the number is for is its direction and the size of its moves.
fn score now base
  100.0 * list/sum (list/to_list (list/map terms (t -> share now base t)))

fn pow10 0
  1

fn pow10 n
  10 * pow10 (n - 1)

fn zeroed s width
  wider s width (length s >= width)

fn wider s _ true
  s

fn wider s width false
  zeroed "0{s}" width

fn fixed_of units scale places
  whole = units / scale
  frac = units - whole * scale
  "{whole}.{zeroed "{frac}" places}"

fn negated units scale places true
  "-{fixed_of (0 - units) scale places}"

fn negated units scale places false
  fixed_of units scale places

# A fixed-point rendering. Kanso renders a float with as many digits as it
# needs; a report wants a column.
fn fixed x places
  scale = pow10 places
  units = math/round (x * scale)
  negated units scale places (units < 0)

fn grouped s
  short s (length s <= 3)

fn short s true
  s

fn short s false
  head = text/slice s 1 (length s - 3)
  tail = text/slice s (length s - 2) (length s)
  "{grouped head},{tail}"

fn commas n
  grouped "{n}"

fn spaced s width
  padded s width (length s >= width)

fn padded s _ true
  s

fn padded s width false
  spaced " {s}" width

fn left s width
  filled s width (length s >= width)

fn filled s _ true
  s

fn filled s width false
  left "{s} " width

fn asked path
  os/read_file! path

fn gauge run w ir ca held ent
  veins = [(counters ir) (counters ca) (counters held) (counters ent)]
  now = measured (counters run) (work_of w) veins
  os/read_file! floor_path .> (f -> against now (json/decode f))

# Every counter the objective weighs stands on a measurement of its own.
#
# One used to be granted a baseline instead: `entering` gave a counter new to
# the model a reading of `now * standing`, the ratio whose satisfaction equalled
# its dimension's current mean, so that landing day cost the floor nothing. The
# rule existed because benchmarks joined the run side one at a time -- nine of
# twenty-one counters stood on it -- and each arrival at parity would otherwise
# have scored as a free win for measuring something.
#
# It was never neutral after landing day. Saturation is concave, so a counter
# granted a high standing has almost no headroom left and one entered at parity
# has a great deal, and that difference decided at least one verdict: the
# carry-tier arms of 2026-09-01 scored 74.31 -> 73.75 with the digest baselines
# at their dimension's standing and 70.14 -> 72.99 with them at parity, a
# decline and an acceptance of the same two arms.
#
# Clay's gavel of 2026-09-06 put the run side on one consolidated program, so
# nothing joins one benchmark at a time any more and the rule has nobody left
# to grant a baseline to. What is left of it would only ever fire by accident,
# on a counter somebody added to the model and forgot to measure -- which is
# the thing to catch rather than to paper over.
# The refusal is taken HERE, in the arm that decides whether to score at all,
# rather than in a function returning either a baseline or a complaint. An
# effect is a value in kanso: a `baseline_of` whose failing arm answered
# `io/write_err ... . os/exit` handed that chain back to its caller as the
# baseline, and `score` indexed it and died saying "indexing takes a list or
# string with a 1-based position, or a map with a key" -- a true sentence about
# the wrong thing, three functions from the missing key.
fn unbaselined base
  list/to_list (list/select counter_names (c -> base[c] == none))

unmeasured = """
  the objective weighs a counter the floor file has no baseline for, so there
  is nothing to score it against. Until the 2026-09-06 gavel a missing baseline
  was granted automatically, at the ratio that left its dimension's score
  untouched; the run side is one program now and nothing joins it a benchmark
  at a time, so a counter with no measurement behind it is a mistake. Measure
  it and write the reading into bench/welfare_floor.json's baseline.
"""

fn against now held
  base = held["baseline"]!
  missing = unbaselined base
  scored now held base missing (length missing == 0)

fn scored now held base _ true
  value = score now base
  os/args .> (a -> either now base held value a)

fn scored _ _ _ missing false
  listed = text/join missing ", "
  io/write_err "{unmeasured}  no baseline for: {listed}\n" .> (_ -> os/exit 2)

# THE COUNTER SET THE SCORE WAS MADE OF, one `name=value` a line.
#
# perf_record writes a history row per merged commit and the chart reads those
# rows. Until 2026-09-03 the row carried a hand-picked dozen counters and the
# score as a recorded number: on that day the newest row held 12 of the 24 the
# formula reads, `compile_instructions` among the missing, so most of the
# objective was unrecoverable from the row.
#
# Printing the set HERE rather than assembling it again in perf_record is the
# point. The two would drift the first time a counter joined the model, and a
# row scored on a counter set that no longer matches the formula is a chart
# that lies quietly. This prints exactly what `score` was given.
fn either now base held value args
  setting = length args > 0 and args[1]! == "--set"
  counting = length args > 0 and args[1]! == "--counters"
  modelling = length args > 0 and args[1]! == "--model"
  scoring = length args > 0 and args[1]! == "--score"
  told now base held value args setting counting modelling scoring

# THE SCORE AT THE COLUMN'S OWN PRECISION. The banner carries two places and
# the history column four, so a reader comparing them has to round the column
# to the banner -- and rounding a number that is already rounded is wrong at a
# boundary. 67.54499292290286 is 67.5450 in four places and 67.54 in two, and
# rounding the 67.5450 gives 67.55: two implementations that agree exactly,
# reported as disagreeing. Anything in [67.5445, 67.5450) reads that way, and
# kanso#1372 landed in it. This prints what the column holds, so the two are
# compared as they are written.
fn told _ _ _ value _ _ _ _ true
  io/write "{fixed value 4}\n"

fn told now base held value args setting counting modelling _
  picked now base held value args setting counting modelling

fn picked _ base _ _ _ _ _ true
  model_of base

fn picked now base held value args setting counting _
  routed now base held value args setting counting

fn routed now _ _ _ _ _ true
  counters_of now

fn routed now base held value args setting _
  chosen now base held value args setting

# THE MODEL ITSELF: every term with its weight, satiation and counters, and the
# baseline each counter is measured against.
#
# The stored rows are scored under the current formula — ruled 2026-08-31,
# restated 2026-09-03 as one column rewritten in place — by a second tool,
# scripts/welfare_rescore, which reads a row where this one reads the goldens.
# That leaves two things that could be copied into it and go stale: the
# arithmetic, and the numbers it uses.
#
# The numbers are the dangerous half and they come from here. A weight retyped
# into the rescorer is a weight that keeps its old value through the next
# gavel, and the column would then show a formula nobody ruled while looking
# exactly as authoritative. The arithmetic is four lines and fixed by ruling —
# saturate each counter, mean within a term, weight, sum — so the rescorer
# restates that and a spec runs both tools on one set of readings.
#
# One line a term and one a baseline, the shape every other vein in this tree
# uses. json was the first attempt and it was the wrong reach: a reader then
# needs a parser, and the two readers that matter — a spec here and the chart's
# javascript — would each grow their own.
#
#   formula <date>
#   term <name>|<weight>|<satiation>|<counter,counter,...>
#   base <counter>=<value>
fn term_line t
  listed_counters = text/join t.counters ","
  "term {t.name}|{t.weight}|{t.satiation}|{listed_counters}\n"

fn model_of base
  shaped = list/to_list (list/map terms term_line)
  kept = list/select counter_names (c -> base[c] != none)
  held = list/to_list (list/map kept (c -> "base {c}={base[c]!}\n"))
  io/write "formula {formula}\n{text/join shaped ""}{text/join held ""}"

fn counters_of now
  kept = list/to_list (list/select counter_names (c -> now[c] != none))
  lines = list/to_list (list/map kept (c -> "{c}={now[c]!}\n"))
  io/write (text/join lines "")

fn chosen _ base held value args true
  reason = text/join (list/to_list (list/drop args 1)) " "
  banked base held value reason

fn chosen now base held value _ false
  reported now base held value

# The floor moves only when somebody says why, and the reason is recorded
# beside the number so the history of the objective reads next to the history
# of the code.
unsaid = "--set records why the objective moved: welfare --set \"reason\"\n"

# RULED (Clay, 2026-08-03): welfare cannot fall, full stop. Not with a
# reason, not with a named trade. If a change would lower it, the change is
# optimized until it does not, and if that is genuinely impossible the work
# stops and the question goes to Clay in conversation. The tool therefore
# never lowers the floor; the only override is a human editing
# bench/welfare_floor.json directly, which a reviewer then sees in the diff.
#
# The earlier version accepted a fall whose reason named a compensating
# gain. That was already the second version of this gate — the first took
# any sentence at all, and a twenty-three point drop banked with the word
# "whatever". Each loosening looked reasonable and each was an escape.
unbought = """
  --set is lowering the objective, and --set cannot do that.

  A fall means the change is worse by the project's stated preferences.
  Optimize until the number holds. If that is truly impossible, this is
  Clay's call to make, in conversation — not a flag's. (The floor file
  itself can be edited by hand, where a reviewer will see it.)
"""

fn banked _ _ _ ""
  io/write_err unsaid .> (_ -> os/exit 2)

fn banked base held value reason
  fall = held["floor"]! - value
  paid base held value reason (fall > 0.01)

fn paid _ _ _ _ true
  io/write_err unbought .> (_ -> os/exit 2)

fn paid base held value reason false
  units = math/round (value * 100)
  rounded = 1.0 * units / 100.0
  note = list/to_h [["floor" rounded] ["why" reason]]
  grown_history = push (history_of held) note
  keys = [["baseline" base] ["floor" value] ["history" grown_history]]
  written (list/to_h keys) value reason

fn written held value reason
  os/write_file floor_path "{json/encode held}\n"
    .> (_ -> io/write "floor moved to {fixed value 2}: {reason}\n")

fn era_of held
  length (history_of held) + 1

fn history_of held
  told held["history"]

fn told none
  []

fn told h
  h

fn last_why held
  h = history_of held
  why h (length h == 0)

fn why _ true
  "initial model"

fn why h false
  latest = h[length h]!
  latest["why"]!

fn reported now base held value
  floor = held["floor"]!
  head = "welfare {fixed value 2}   floor {fixed floor 2}"
  reason = text/slice (last_why held) 1 52
  tail = "(ceiling 100, ratchet {era_of held}: {reason}…)"
  io/write "{head}   {tail}\n"
    .> (_ -> detailed now base .> (_ -> verdict value floor))

fn moved? now base c
  base[c]! != now[c]!

fn line_for now base name
  b = base[name]!
  c = now[name]!
  pct = 100.0 * (as_ratio b (live c) - 1)
  cols = "{spaced (commas b) 12} -> {spaced (commas c) 12}"
  "  {left name 22} {cols}   {signed pct}\n"

fn signed pct
  marked pct (pct < 0)

fn marked pct true
  spaced "{fixed pct 1}%" 7

fn marked pct false
  spaced "+{fixed pct 1}%" 7

fn detailed now base
  changed = list/to_list (list/select counter_names (c -> moved? now base c))
  worse = list/to_list (list/select counter_names (c -> now[c]! > base[c]!))
  lines = list/to_list (list/map changed (t -> line_for now base t))
  io/write (text/join lines "") .> (_ -> traded now base worse)

# the sum is the gate, but a term that went backwards under the cover of
# another term's gain is a trade, and a trade has to be said out loud
fn traded now base worse
  spoken now base worse (length worse == 0)

fn spoken _ _ _ true
  io/write ""

fn spoken now base worse false
  io/write "\nTERMS THAT GOT WORSE — say why each one was worth it:\n"
    .> (_ -> costed now base worse)

fn costed now base worse
  lines = list/to_list (list/map worse (t -> cost_line now base t))
  io/write (text/join lines "")

# A counter costs whatever its dimension's weight and satiation say it does,
# divided by how many counters share that dimension — the mean is what the
# dimension actually reads, so one counter carries its share of the move.
fn cost_line now base name
  d = dimension_of name
  b = base[name]!
  c = now[name]!
  gap = satisfaction 1.0 d.satiation - satisfaction (as_ratio b c) d.satiation
  lost = 100.0 * d.weight * gap / (1.0 * length d.counters)
  cols = "{spaced (commas b) 12} -> {spaced (commas c) 12}"
  "  {left name 22} {cols}   costs {fixed lost 3} points\n"

fn dimension_of name
  found = list/select terms (d -> list/any? d.counters (c -> c == name))
  list/first (list/to_list found)

# the band covers only what two hosts disagree about — compile peak bytes
# wobbles 56 bytes between linux and macos, worth under a ten-thousandth of a
# point. every other term is deterministic, so a three-thousandths fall is a
# real regression and fails
fn verdict value floor
  ruling value floor (value < floor - 0.001) (value > floor + 0.001)

fn ruling value floor true true
  fell (floor - value) .> (_ -> os/exit 1)

fn ruling value floor true _
  fell (floor - value) .> (_ -> os/exit 1)

fn ruling value floor _ true
  rose (value - floor) .> (_ -> os/exit 1)

fn ruling _ _ _ _
  io/write ""

fn nothing _
  io/write ""

fn fell gap
  io/write "\nFAIL  welfare fell {fixed gap 2} below the floor.\n"
  >> io/write "The sum is the objective, so this change is worse by\n"
  >> io/write "the weights as written. Either it goes, or the argument\n"
  >> io/write "is that the weights are wrong — make that argument, then\n"
  >> io/write "welfare --set \"the reason\".\n"

fn rose gap
  io/write "\nFAIL  welfare is {fixed gap 2} above the floor and the\n"
  >> io/write "gain is not held. A rise nobody ratchets is a rise the\n"
  >> io/write "next change is free to spend. Bank it in this same PR:\n"
  >> io/write "welfare --set \"what improved and why\".\n"

# SIX GOLDENS, where there were eleven. The run program's cost golden and its
# row in the instruction golden are the whole runtime side now; the three
# compile files are unchanged. The seven per-phase cost goldens this chain used
# to read are still written, still compared by their own gates, and no longer
# inputs to the number.
fn with_run run
  asked "bench/instructions_golden.txt" .> (w -> with_work run w)

fn with_work run w
  asked "bench/compile_instructions_golden.txt" .> (ir -> with_ir run w ir)

fn with_ir run w ir
  asked "bench/compile_allocs_golden.txt" .> (ca -> with_traffic run w ir ca)

fn with_traffic run w ir ca
  asked "bench/compile_memory_golden.txt"
    .> (held -> with_held run w ir ca held)

fn with_held run w ir ca held
  entry_golden = "bench/entry_instructions_golden.txt"
  asked entry_golden .> (e -> gauge run w ir ca held e)

pub play = asked "bench/cost_golden_run.txt" .> (r -> with_run r)
