import "std/io"
import "std/json"
import "std/list"
import "std/math"
import "std/text"

# One number for the whole project, and a ratchet under it.
#
# The cost goldens each pin one counter, which catches a regression in that
# counter and nothing about the trade a change made across counters. A feature
# that spends compile work to buy runtime work passes every golden while
# leaving the project better or worse, and nobody can say which without an
# argument.
#
# So: combine what running costs and what compiling costs into a single scalar,
# and hold a floor under it. Every term is deterministic — allocation counts,
# arena blocks, fixpoint rounds, emitted lines — so the number moves only when
# somebody changes the compiler, never because the box was busy. Wall clock is
# deliberately absent for that reason.
#
#     welfare = 100 * (baseline_cost / current_cost)
#
# Cost is a weighted sum of normalised terms, so a hundred is the reference
# point and higher is better. The weights say what the project is buying:
# runtime speed and footprint dominate, compile cost matters and matters less.
#
#     welfare                    print the current score against the floor
#     welfare -- --set "why"     record the score as the new floor, with the
#                                reason it moved?
#
# The sum is the objective. A term getting worse while the sum rises is the
# trade the weights exist to license, so the per-term breakdown below the score
# says where a move came from and never excuses one. A sum that falls means the
# change is worse by the weights as written — the argument to have is whether
# the weights are right, not whether this term deserves a pass.
#
# Each term carries two numbers, because weight alone cannot say what a second
# is worth here. `weight` is how much the dimension matters at all: runtime
# carries two thirds because that is the claim the front page makes, and
# compile cost a third, because a language nobody can iterate in is not fast
# either. `satiation` is how fast further improvement stops mattering, which
# differs by dimension and is not a matter of importance — a compiler that
# already finishes in six milliseconds gains almost nothing from three, while a
# decoder in a hot loop that gets eight times faster is eight times faster.
type dimension
  counters
  name
  satiation
  weight

floor_path = "bench/welfare_floor.json"

# WHAT THE SCORE WEIGHS. Four dimensions, not a list of counters: memory and
# performance, for compiling and for running. A counter is an input to one of
# them, never a term in its own right — which is how compile memory came to be
# weighted at zero while it more than doubled, because a list has no empty
# slots to notice.
#
# The weights come from what teams shipping software pay for, recorded with
# their sources in design/compiler-log.md. Runtime carries 0.60 because it
# recurs per request forever. Compile carries 0.40 rather than the third it
# looks like from inside, because 45% of people who stopped using rust named
# long compile times among their reasons — that is whether anyone stays, not
# whether they are comfortable. Inside compile, speed outweighs memory better
# than two to one: the complaint that dominates every survey is waiting for an
# incremental rebuild, not footprint.
#
# Satiation is a different question from weight — it says how long a dimension
# keeps paying for improvement. Runtime at 2.0: a decoder eight times faster is
# eight times faster. Compile at 0.5: a front end already answering in six
# milliseconds gains almost nothing from three.
d_run_speed = dimension run_speed_counters "run speed" 2.0 0.30

d_run_memory = dimension run_memory_counters "run memory" 2.0 0.30

d_compile_speed = dimension compile_speed_counters "compile speed" 0.5 0.28

d_compile_memory = dimension compile_memory_counters "compile memory" 0.5 0.12

run_speed_counters = ["decode_allocs" "encode_allocs" "basket_allocs"]

decode_memory = ["decode_peak_bytes" "decode_arena_blocks"]

encode_memory = ["encode_peak_bytes" "encode_arena_blocks"]

held_memory = ["oneshot_peak_bytes" "basket_peak_bytes"]

codec_memory = text/concat decode_memory encode_memory

run_memory_counters = text/concat codec_memory held_memory

compile_speed_counters = ["front_end_rounds" "front_end_visits" "emitted_lines"]

compile_memory_counters = ["compile_peak_bytes"]

terms = [d_run_speed d_run_memory d_compile_speed d_compile_memory]

# The baseline and the per-counter breakdown are keyed by counter, because a
# counter is what is measured; a dimension is what it is measured FOR.
run_counters = text/concat run_speed_counters run_memory_counters

compile_counters = text/concat compile_speed_counters compile_memory_counters

counter_names = text/concat run_counters compile_counters

fn pair? l
  length (text/split l "=") == 2

fn named l
  (text/split l "=")[1]!

fn amount l
  text/to_int (text/split l "=")[2]!

# The cost goldens are one `name=value` to a line.
fn counters text
  lines = list/to_list (list/select (text/split text "\n") pair?)
  pairs = list/map lines counted
  list/to_h (list/to_list pairs)

fn counted l
  [(named l) (amount l)]

fn body? l
  text/slice l 1 1 != "#" and length l > 0

fn fields_of l
  list/to_list (list/select (text/split l " ") pair?)

fn value_in fields key
  found = list/to_list (list/select fields (f -> named f == key))
  first_or_zero found

fn first_or_zero fs
  taken fs (length fs == 0)

fn taken _ true
  0

fn taken fs false
  amount fs[1]!

fn total_for lines key
  amounts = list/map lines (l -> value_in (fields_of l) key)
  list/sum (list/to_list amounts)

# The compile golden is many fields to a line, one line per sample, and the
# term is the total across them.
fn compile_totals text
  lines = list/to_list (list/select (text/split text "\n") body?)
  rounds = total_for lines "rounds"
  visits = total_for lines "visits"
  emitted = total_for lines "lines"
  list/to_h [["rounds" rounds] ["visits" visits] ["lines" emitted]]

fn peak_of m
  m["arena_peak_bytes"]! + m["bytes_peak"]!

fn measured decode encode oneshot basket comp held
  d = [["decode_allocs" decode["allocs"]!]]
  db = [["decode_arena_blocks" decode["arena_blocks"]!]]
  dp = [["decode_peak_bytes" (peak_of decode)]]
  e = [["encode_allocs" encode["allocs"]!]]
  eb = [["encode_arena_blocks" encode["arena_blocks"]!]]
  ep = [["encode_peak_bytes" (peak_of encode)]]
  o = [["oneshot_peak_bytes" (peak_of oneshot)]]
  b = [["basket_allocs" basket["allocs"]!]]
  bp = [["basket_peak_bytes" (peak_of basket)]]
  c = [["front_end_rounds" held["front_end_rounds"]!]]
  v = [["front_end_visits" held["front_end_visits"]!]]
  l = [["emitted_lines" comp["lines"]!]]
  cm = [["compile_peak_bytes" held["compile_peak_bytes"]!]]
  gathered d db dp e eb ep o b bp c v (text/concat l cm)

fn gathered d db dp e eb ep o b bp c v l
  head = text/concat (text/concat d db) (text/concat dp e)
  mid = text/concat (text/concat eb ep) (text/concat o b)
  tail = text/concat (text/concat bp c) (text/concat v l)
  list/to_h (text/concat head (text/concat mid tail))

# How much a term being `ratio` times better than baseline is worth. A straight
# ratio says the tenth halving is worth as much as the first, which is false:
# past a point a program is fast enough that making it twice as fast again buys
# almost nothing. A logarithm is the usual reach and still pays every doubling
# equally. This saturates instead, at a rate the term chooses, so a dimension
# that stops mattering early can say so. Both curves are asymmetric around the
# baseline — halving a term's performance costs more than doubling it gains —
# which is the right shape for a ratchet.
fn satisfaction ratio satiation
  ratio / (ratio + satiation)

# a term that reached zero is better than any baseline, and dividing by it
# would say infinity rather than "as good as this gets"
fn live n
  nonzero n (n == 0)

fn nonzero _ true
  0.5

fn nonzero n false
  n

# `/` on two integers truncates, and every number here is a ratio, so the
# numerator enters as a float.
fn as_ratio a b
  1.0 * a / b

# A dimension improves when its counters improve on average, so its ratio is
# the mean of theirs. One counter halving while another doubles is a wash,
# which is what it should be: the counters are how a dimension is observed,
# not four separate things to defend.
fn share now base t
  ratios = list/to_list (list/map t.counters (c -> ratio_of now base c))
  mean = list/sum ratios / (1.0 * length ratios)
  satisfaction mean t.satiation * t.weight

fn ratio_of now base c
  as_ratio (live base[c]!) (live now[c]!)

# The one number: a weighted sum of per-term satisfaction, on a scale whose
# ceiling is a hundred and whose origin is arbitrary. Not a percentage of
# anything — what the number is for is its direction and the size of its moves.
fn score now base
  100.0 * list/sum (list/to_list (list/map terms (t -> share now base t)))

fn pow10 0
  1

fn pow10 n
  10 * pow10 (n - 1)

fn zeroed s width
  wider s width (length s >= width)

fn wider s _ true
  s

fn wider s width false
  zeroed "0{s}" width

fn fixed_of units scale places
  whole = units / scale
  frac = units - whole * scale
  "{whole}.{zeroed "{frac}" places}"

fn negated units scale places true
  "-{fixed_of (0 - units) scale places}"

fn negated units scale places false
  fixed_of units scale places

# A fixed-point rendering. Kanso renders a float with as many digits as it
# needs; a report wants a column.
fn fixed x places
  scale = pow10 places
  units = math/round (x * scale)
  negated units scale places (units < 0)

fn grouped s
  short s (length s <= 3)

fn short s true
  s

fn short s false
  head = text/slice s 1 (length s - 3)
  tail = text/slice s (length s - 2) (length s)
  "{grouped head},{tail}"

fn commas n
  grouped "{n}"

fn spaced s width
  padded s width (length s >= width)

fn padded s _ true
  s

fn padded s width false
  spaced " {s}" width

fn left s width
  filled s width (length s >= width)

fn filled s _ true
  s

fn filled s width false
  left "{s} " width

fn asked path
  io/read_file path

fn gauge d e o b c held
  comp = compile_totals c
  cm = counters held
  now = measured (counters d) (counters e) (counters o) (counters b) comp cm
  io/read_file floor_path . (held -> against now (json/decode held))

# A term new to the model enters at ratio one: its own introduction is never a
# score move, and only improvement from here pays.
fn baseline_of held now
  base = held["baseline"]!
  missing = list/select counter_names (c -> base[c] == none)
  fresh = list/map (list/to_list missing) (c -> [c now[c]!])
  merged base (list/to_list fresh)

fn merged base fresh
  carried base fresh (length fresh == 0)

fn carried base _ true
  base

fn carried base fresh false
  list/to_h (text/concat (pairs_of base) fresh)

# What the baseline already holds, rather than what the model expects: a
# counter new to the model has no entry here yet, and adding one is the job of
# the fresh list this is concatenated with.
fn pairs_of base
  kept = list/select counter_names (c -> base[c] != none)
  list/to_list (list/map kept (c -> [c base[c]!]))

fn against now held
  base = baseline_of held now
  value = score now base
  io/args . (a -> either now base held value a)

fn either now base held value args
  asked_to_set = length args > 0 and args[1]! == "--set"
  chosen now base held value args asked_to_set

fn chosen _ base held value args true
  reason = text/join (list/to_list (list/drop args 1)) " "
  banked base held value reason

fn chosen now base held value _ false
  reported now base held value

# The floor moves only when somebody says why, and the reason is recorded
# beside the number so the history of the objective reads next to the history
# of the code.
unsaid = "--set records why the objective moved: welfare --set \"reason\"\n"

# A fall is a trade, and a trade has two sides. Refusing the floor while
# accepting any sentence at all let a drop be banked with the word "whatever" —
# the gate said "argue the weights" and nothing made the argument happen.
#
# The words are the ones .github/goldens-move-licenses.sh asks for, so the
# habit that satisfies one gate satisfies the other.
unbought = """
  --set is lowering the objective, and the reason names nothing it buys.

  A fall means the change is worse by the weights as written. Either it goes,
  or the claim is that the weights are wrong — and that is an argument about
  the weights, made in the reason, not a number quietly moved past.

  Say what got better, in those words: better, buys, gain, in exchange.
"""

gain_words = ["better" "buys" "gain" "in exchange"]

fn names_a_gain? reason
  said = lowered reason
  list/any? gain_words (w -> length (text/split said w) > 1)

fn lowered s
  parts = list/map (text/chars s) lower_char
  text/join (list/to_list parts) ""

fn lower_char c
  shifted (text/char_code c)

fn shifted code
  text/from_code (dropped code (code >= 65 and code <= 90))

fn dropped code true
  code + 32

fn dropped code false
  code

fn banked _ _ _ ""
  io/write_err unsaid . (_ -> io/exit 2)

fn banked base held value reason
  fall = held["floor"]! - value
  bought = names_a_gain? reason
  paid base held value reason (fall > 0.01 and not bought)

fn paid _ _ _ _ true
  io/write_err unbought . (_ -> io/exit 2)

fn paid base held value reason false
  units = math/round (value * 100)
  rounded = 1.0 * units / 100.0
  note = list/to_h [["floor" rounded] ["why" reason]]
  grown_history = push (history_of held) note
  out = [["baseline" base] ["floor" value] ["history" grown_history]]
  written (list/to_h out) value reason

fn written held value reason
  io/write_file floor_path "{json/encode held}\n"
    . (_ -> io/write "floor moved to {fixed value 2}: {reason}\n")

fn era_of held
  length (history_of held) + 1

fn history_of held
  told held["history"]

fn told none
  []

fn told h
  h

fn last_why held
  h = history_of held
  why h (length h == 0)

fn why _ true
  "initial model"

fn why h false
  latest = h[length h]!
  latest["why"]!

fn reported now base held value
  floor = held["floor"]!
  head = "welfare {fixed value 2}   floor {fixed floor 2}"
  reason = text/slice (last_why held) 1 52
  tail = "(ceiling 100, ratchet {era_of held}: {reason}…)"
  io/write "{head}   {tail}\n"
    . (_ -> detailed now base . (_ -> verdict value floor))

fn moved? now base c
  base[c]! != now[c]!

fn line_for now base name
  b = base[name]!
  c = now[name]!
  pct = 100.0 * (as_ratio b (live c) - 1)
  cols = "{spaced (commas b) 12} -> {spaced (commas c) 12}"
  "  {left name 22} {cols}   {signed pct}\n"

fn signed pct
  marked pct (pct < 0)

fn marked pct true
  spaced "{fixed pct 1}%" 7

fn marked pct false
  spaced "+{fixed pct 1}%" 7

fn detailed now base
  changed = list/to_list (list/select counter_names (c -> moved? now base c))
  worse = list/to_list (list/select counter_names (c -> now[c]! > base[c]!))
  lines = list/to_list (list/map changed (t -> line_for now base t))
  io/write (text/join lines "") . (_ -> traded now base worse)

# the sum is the gate, but a term that went backwards under the cover of
# another term's gain is a trade, and a trade has to be said out loud
fn traded now base worse
  spoken now base worse (length worse == 0)

fn spoken _ _ _ true
  io/write ""

fn spoken now base worse false
  io/write "\nTERMS THAT GOT WORSE — say why each one was worth it:\n"
    . (_ -> costed now base worse)

fn costed now base worse
  lines = list/to_list (list/map worse (t -> cost_line now base t))
  io/write (text/join lines "")

# A counter costs whatever its dimension's weight and satiation say it does,
# divided by how many counters share that dimension — the mean is what the
# dimension actually reads, so one counter carries its share of the move.
fn cost_line now base name
  d = dimension_of name
  b = base[name]!
  c = now[name]!
  gap = satisfaction 1.0 d.satiation - satisfaction (as_ratio b c) d.satiation
  lost = 100.0 * d.weight * gap / (1.0 * length d.counters)
  cols = "{spaced (commas b) 12} -> {spaced (commas c) 12}"
  "  {left name 22} {cols}   costs {fixed lost 3} points\n"

fn dimension_of name
  found = list/select terms (d -> list/any? d.counters (c -> c == name))
  list/first (list/to_list found)

# a hundredth of a point is below anything a real change moves, and leaves room
# for a term that rounds
fn verdict value floor
  ruling value floor (value < floor - 0.01) (value > floor + 0.01)

fn ruling value floor true _
  fell (floor - value) . (_ -> io/exit 1)

fn ruling value floor _ true
  rose (value - floor) . (_ -> io/exit 1)

fn ruling _ _ _ _
  io/write ""

fn nothing _
  io/write ""

fn fell gap
  io/write "\nFAIL  welfare fell {fixed gap 2} below the floor.\n"
  >> io/write "The sum is the objective, so this change is worse by\n"
  >> io/write "the weights as written. Either it goes, or the argument\n"
  >> io/write "is that the weights are wrong — make that argument, then\n"
  >> io/write "welfare --set \"the reason\".\n"

fn rose gap
  io/write "\nFAIL  welfare is {fixed gap 2} above the floor and the\n"
  >> io/write "gain is not held. A rise nobody ratchets is a rise the\n"
  >> io/write "next change is free to spend. Bank it in this same PR:\n"
  >> io/write "welfare --set \"what improved and why\".\n"

pub play = asked "bench/cost_golden.txt" . (d -> with_decode d)

fn with_decode d
  asked "bench/cost_golden_encode.txt" . (e -> with_encode d e)

fn with_encode d e
  asked "bench/cost_golden_oneshot.txt" . (o -> with_oneshot d e o)

fn with_oneshot d e o
  asked "bench/cost_golden_basket.txt" . (b -> with_basket d e o b)

fn with_basket d e o b
  asked "bench/compile_golden.txt" . (c -> with_compile d e o b c)

fn with_compile d e o b c
  asked "bench/compile_memory_golden.txt" . (held -> gauge d e o b c held)
