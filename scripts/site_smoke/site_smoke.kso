# A stub answering in a microtask is no stand-in for the network: it resolves
# before the parser reaches the element the chart draws into, and drawTrend
# returns silently on a host that is not there yet. Waiting for the document
# puts the stub back behind parsing, where a real fetch is.
stub = """
  window.__chart = \{stub: 0, err: ''};
  window.__chart.ready = document.readyState === 'complete'
    ? Promise.resolve()
    : new Promise((go) => window.addEventListener('load', () => go()));
  window.addEventListener('error', (e) =>
    \{ window.__chart.err = window.__chart.err || String(e.message); });
  window.addEventListener('unhandledrejection', (e) =>
    \{ window.__chart.err = window.__chart.err || 'rejected: ' + e.reason; });
  const REAL = window.fetch.bind(window);
  window.fetch = (url, opts) => \{
    if (String(url).includes('history.jsonl')) \{
      window.__chart.stub += 1;
      const r = new Response(HISTORY_TEXT, \{status: 200});
      return window.__chart.ready.then(() => r);
    }
    return REAL(url, opts);
  };
"""

# A count, never a presence check: an empty canvas has a host and no points.
trend = """
  <script>
  window.PAGE_PROBE = async () => \{
    const counts = async () => \{
      const host = document.getElementById('trend-chart');
      if (!host) return null;
      const lines = [...host.querySelectorAll('polyline')];
      if (!lines.length) return null;
      return lines
        .map((l) => (l.getAttribute('points') || '').trim()
                      .split(' ').filter(Boolean).length)
        .sort((a, b) => a - b);
    };
    // The panel under the chart is what makes the chart legal on the light
    // page: three of the seven lines sit under 3:1 against it, and the relief
    // for that is the reader being able to look the number up. So the panel's
    // first rows ARE the chart's lines, in the chart's order, and this reads
    // both sides off the rendered page rather than off the source.
    // A panel label is the text node after the caret span, so it is read off
    // the node rather than by stripping a character out of the cell.
    const chart = () => [...document.querySelectorAll('#trend-chart .trend-key')]
      .map((t) => t.textContent.trim());
    // The scoring-coverage boundaries. The stub's four older rows predate the
    // run counters and carry coverage 0.44, the way every row before
    // 2026-09-06 does; the last two carry 1.00. So the chart owes exactly one
    // rule, labelled with the coverage to its right, and the welfare line owes
    // two segments where the other six are single strokes.
    const bounds = () => [...document.querySelectorAll('#trend-chart .trend-bound-key')]
      .map((t) => t.textContent.trim());
    const panel = () => [...document.querySelectorAll('#perf-panel .perf-row')]
      .map((tr) => tr.querySelector('td').lastChild.textContent.trim());
    for (let i = 0; i < 600; i++) \{
      const got = await counts();
      const keys = chart();
      const rows = panel();
      if (got && keys.length && rows.length) \{
        return \{series: got, keys: keys, panel_head: rows.slice(0, keys.length),
                marks: bounds()};
      }
      await new Promise((r) => setTimeout(r, 250));
    }
    return \{series: [], keys: [], panel_head: ['the page never finished drawing'],
            marks: [], stubbed: window.__chart.stub,
            why: window.__chart.err || 'the chart never drew'};
  };
  </script>
"""

engine_tag = "<script src=\"/kanso-engine.js\"></script>"

# The site's tokenizer is the second implementation of what the grammar check
# asks of the editor grammar, and the two drift silently: a rule stops matching,
# the colour goes away, and the reader weeks later is who finds out. These are
# the grammar check's own lines, asked of the site. `highlight` is a plain
# function that does not wait on the wasm module, so this probe needs no ready
# handshake.
paint = """
  <script>
  window.PAGE_PROBE = async () => \{
    const lines = ['type person', '  name:string', 'type post_body:string',
                   '# who they are', 'x = "hi" "yo"', '  shout s . print'];
    return \{painted: lines.map((l) => window.KansoEngine.highlight(l))};
  };
  </script>
"""

t_person = "<span class=\"t\">person</span>"

t_string = "<span class=\"t\">string</span>"

t_subtype = "<span class=\"t\">post_body</span>"

s_hi = "<span class=\"s\">\"hi\"</span>"

s_yo = "<span class=\"s\">\"yo\"</span>"

w1 = paint_want 1 t_person "the site did not paint a type name"

w2 = paint_want 2 t_string "the site did not paint an ascribed type"

w3 = paint_want 3 t_subtype "the site did not paint a subtype's name"

w4 = paint_want 3 t_string "the site did not paint a subtype's parent"

w5 = paint_want 4 "<span class=\"c\">" "the site did not paint a comment"

w6 = paint_want 5 s_hi "the site did not paint the first string"

w7 = paint_want 5 s_yo "the site did not paint the second string"

w8 = paint_want 6 "<span class=\"o\">.</span>" "the site did not paint a pipe"

paint_wants = [w1 w2 w3 w4 w5 w6 w7 w8]

fn replaced text from to
  text/join (text/split text from) to

# Front matter is a leading `---` line and everything up to the next one. A
# page without it is left alone, which is why this asks before it cuts.
fn without_front_matter text
  cut text (text/slice text 1 4 == "---\n")

fn cut text false
  text

fn cut text true
  parts = text/split text "---\n"
  text/join (list/to_list (list/drop parts 2)) "---\n"

fn kind path
  parts = text/split path "."
  named parts[length parts]!

fn named "js"
  "content-type: text/javascript; charset=utf-8"

fn named "wasm"
  "content-type: application/wasm"

fn named _
  "content-type: text/html; charset=utf-8"

fn handled req served
  answered req.path req served

fn answered "/report" req _
  http/reply (http/ok "thanks") (http/stop req.body)

fn answered path _ set
  body = body_for path set
  http/reply (found body path) set

fn found none _
  http/not_found

fn found body path
  http/page [(kind path)] body

# `tail` is appended after the rewrite above, because a chapter is served by a
# layout and its scripts are absolute: rewriting them would point them at the
# chapter's own directory, where nothing answers.
fn document top header page tail extra
  body = replaced (without_front_matter page) "src=\"/" "src=\""
  opened = "<!doctype html><html><head><meta charset=utf-8>"
  head = "{opened}<script>{top}</script></head><body>"
  "{head}{header}{body}{tail}{extra}{probe}</body></html>"

# A profile per visit. Chrome is killed rather than asked to leave, so the
# directory it leaves behind is not one a later chrome can open: the fourth
# visit hung on a profile three earlier browsers had been killed out of, while
# the same visit run alone passed in seconds.
fn flags at url
  where = "--user-data-dir=/tmp/kanso-smoke-profile-{at}"
  ["--headless=new" "--disable-gpu" "--no-sandbox" where url]

fn browsing chrome at path
  url = flags at "http://127.0.0.1:{at}{path}"
  os/start chrome url

# The server listens before `accept` yields, and only then does the browser
# start, which is what keeps chrome from meeting a closed door.
fn visiting set chrome at path on
  http/serve_until at handled set .> on
  browsing chrome at path

# Headless chrome does not exit on its own, and the process handle is born in
# the statement that starts it while the report arrives in the statement that
# serves — nothing carries a value between them. The profile name is unique to
# this harness, so it is what identifies the browser to stop.
fn stopping on
  os/run "pkill" ["-f" "kanso-smoke-profile"] .> on

fn saw? text needle
  length (text/split text needle) > 1

fn said_in? report key needle
  read_out? report[key] needle

fn read_out? none _
  false

fn read_out? text needle
  saw? text needle

fn noted acc _ true
  acc

fn noted acc why false
  text/concat acc [why]

fn running set chrome
  on = (report -> landed set chrome report)
  visiting set chrome landing_port "/index.html" on

fn landed set chrome report
  on = (_ -> after_landing set chrome report)
  stopping on

fn after_landing set chrome report
  why = "the landing sample did not run: {report}"
  told = noted [] why (saw? report "hello, kanso")
  visiting_paint set chrome told

fn visiting_paint set chrome failures
  on = (report -> painted_page set chrome failures report)
  visiting set chrome paint_port "/paint.html" on

fn painted_page set chrome failures report
  on = (_ -> read_paint set chrome failures report)
  stopping on

fn read_paint set chrome failures report
  read = json/decode report
  visiting_board set chrome (missing_paint read failures)

fn visiting_board set chrome failures
  on = (report -> boarded set chrome failures report)
  visiting set chrome board_port "/playground.html" on

fn boarded set chrome failures report
  on = (_ -> judged set chrome failures report)
  stopping on

fn judged set chrome failures report
  read = json/decode report
  a = missing_first read failures
  b = missing_fanout read a
  c = missing_repl read b
  e = missing_edit read c
  visiting_book set chrome (missing_keys read e)

fn visiting_book set chrome failures
  on = (report -> booked set chrome failures report)
  visiting set chrome book_port "/book/ch04.html" on

fn booked set chrome failures report
  on = (_ -> read_book set chrome failures report)
  stopping on

fn read_book set chrome failures report
  read = json/decode report
  a = missing_panels read failures
  b = missing_run read a
  visiting_chart set chrome (missing_reader read b)

fn visiting_chart set chrome failures
  on = (report -> charted failures report)
  visiting set chrome chart_port "/numbers.html" on

fn charted failures report
  on = (_ -> read_chart failures report)
  stopping on

fn read_chart failures report
  read = json/decode report
  a = missing_series read failures
  b = missing_panel_rows read a
  finished (missing_bounds read b) report

# Eight strokes for seven series, because the stub carries the shape the real
# history has. Its four older rows predate the run counters and carry coverage
# 0.44; the last two carry all five and 1.00. So the two run lines draw two
# points each, the four counters that go back to the first row draw six, and
# welfare draws TWO strokes -- five points to the boundary and two after it,
# the segment reaching one point into the next run so the step itself is drawn
# rather than left as a gap the eye closes by guessing.
#
# A presence check would pass on an empty canvas, which is the failure this
# exists to catch, and the earlier flat [6 6 6 6 6 6 6] could not have caught
# a welfare line drawn as one stroke across a coverage change -- which is what
# it was until 2026-09-09, and what made the page read a change in what was
# recorded as thirty-two points off the compiler.
fn missing_series read acc
  why = "the chart did not draw the seven series at their recorded lengths"
  noted acc why (drew? read["series"])

fn drew? none
  false

fn drew? series
  series == [2 2 2 5 6 6 6 6]

# One coverage change in the stub is one rule on the chart, labelled with the
# share the rows to its right are scored on. `scored_weight` arrives as TEXT in
# every row of the real history -- "0.00", "0.28", "0.44", "1.00" -- and a
# `typeof === 'number'` guard read every row as unscored and drew no rule at
# all. This is the check that would have caught it: a silent no-op leaves the
# list empty.
fn missing_bounds read acc
  why = "the chart did not mark the coverage change, or labelled it wrong"
  noted acc why (read["marks"] == ["coverage 1.00"])

# The panel leads with the chart's own lines, in the chart's own order, because
# it is built from the same list rather than from a second one written by hand.
# Asserting equality rather than containment is what makes that true: a panel
# that merely mentions every line would still let the two orders drift, and a
# reader matching a faint line to its number reads down the panel in the order
# the key gave them.
fn missing_panel_rows read acc
  why = "the panel does not lead with the chart's own lines, in order"
  noted acc why (read["keys"] == read["panel_head"])

fn missing_panels read acc
  why = "no panel in chapter 04 became runnable"
  noted acc why (any_live? read["live"])

fn any_live? none
  false

fn any_live? live
  live > 0

fn missing_run read acc
  why = "the chapter's first panel did not run"
  noted acc why (said_in? read "ran" "is not an integer")

fn missing_reader read acc
  why = "a book panel did not run edited source"
  noted acc why (said_in? read "edited" "the reader edited this: 42")

fn missing_paint read acc
  paint_faults read["painted"] acc 1

fn paint_faults none acc _
  text/concat acc ["the paint page reported no painting at all"]

fn paint_faults painted acc at
  paint_step painted acc at (at > length paint_wants)

fn paint_step _ acc _ true
  acc

fn paint_step painted acc at false
  one = paint_wants[at]!
  grown = noted acc one.why (saw? painted[one.at]! one.needle)
  paint_faults painted grown (at + 1)

fn missing_first read acc
  why = "the playground's first example did not run"
  noted acc why (said_in? read "out" "hello, kanso")

# fanout puts a closure in a record field, which the browser engine could not
# do until Value::TableFn — the regression this page must never take again.
fn missing_fanout read acc
  why = "fanout did not run in the playground"
  noted acc why (said_in? read "fanout" "650 yen")

fn missing_repl read acc
  why = "the repl did not answer"
  noted acc why (said_in? read "repl" "5")

fn missing_edit read acc
  why = "the run button did not run edited source"
  noted acc why (said_in? read "edited" "edited then run 42")

fn missing_keys read acc
  why = "the keyboard shortcut did not run edited source"
  noted acc why (said_in? read "keyed" "keys then run 5")

fn finished failures report
  ended failures report (length failures == 0)

fn ended _ _ true
  io/write "PASS  every page the site smoke test watches still runs\n"

fn ended failures report false
  said = "FAIL  {text/join failures "; "}\n  the page said: {report}\n"
  io/write said .> (_ -> os/exit 1)

# The history is embedded as a JS string, and declared after the stub that
# reads it: the page's own scripts run once this one has finished, so nothing
# can fetch before the constant exists.
encoded = json/encode history

chart_head = "{stub}\nconst HISTORY_TEXT = {encoded};\n"

engine_files = ["docs/kanso-engine.js" "docs/kanso.wasm"]

hero_files = ["docs/landing-play.js" "docs/play.js"]

page_files = ["docs/_includes/site-header.html" "docs/index.html"]

more_pages = ["docs/playground.html" "docs/book-play.js"]

last_pages = ["docs/book/ch04.html" "docs/numbers.html"]

early_files = text/concat engine_files hero_files

middle_files = text/concat page_files more_pages

opening_files = text/concat early_files middle_files

wanted_files = text/concat opening_files last_pages

pub play = read_each wanted_files 1 []

fn read_each paths at acc
  gathered paths at acc (at > length paths)

fn gathered _ _ acc true
  with_all acc

fn gathered paths at acc false
  on = (body -> read_each paths (at + 1) (text/concat acc [body]))
  read_one paths[at]! .> on

# The engine is bytes and everything else is text; read_file refuses bytes
# that are not text, on every engine, so the module is read as what it is.
fn read_one "docs/kanso.wasm"
  os/read_bytes! "docs/kanso.wasm"

fn read_one path
  os/read_file! path

fn with_all bodies
  header = bodies[5]!
  index = document "" header bodies[6]! "" landing
  shown = document "" header bodies[7]! "" board
  read = document "" header bodies[9]! chapter_scripts story
  drawn = document chart_head header bodies[10]! "" trend
  assembled bodies shown read drawn index

fn assembled bodies shown read drawn index
  engine = bodies[1]!
  wasm = bodies[2]!
  hero = bodies[3]!
  js = bodies[4]!
  book = bodies[8]!
  painted = document "" "" "" engine_tag paint
  set = pages shown book read drawn engine hero index painted js wasm
  wanted set

fn wanted set
  os/env "KANSO_CHROME" .> (told_where -> chosen set told_where)

fn chosen set none
  first_chrome set chrome_paths 1

# A browser that never starts is a server that waits forever, so a name given
# by hand is checked before it is trusted.
fn chosen set where
  os/exists where .> (there -> told_of set where there)

fn told_of set where true
  running set where

fn told_of _ where false
  said = "KANSO_CHROME names {where}, which is not there\n"
  io/write said .> (_ -> os/exit 1)

fn first_chrome set paths at
  searched set paths at (at > length paths)

fn searched _ _ _ true
  io/write "no chrome found: set KANSO_CHROME\n" .> (_ -> os/exit 1)

fn searched set paths at false
  on = (there -> found_at set paths at there)
  os/exists paths[at]! .> on

fn found_at set paths at true
  running set paths[at]!

fn found_at set paths at false
  first_chrome set paths (at + 1)
