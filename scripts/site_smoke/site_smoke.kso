import "std/io"
import "std/json"
import "std/list"
import "std/net/http"
import "std/text"

# The landing page and the playground share one engine module, so a change to
# either can break both, and neither failure shows up in a Rust test. This
# loads the page in headless chrome against a local copy of docs/ and requires
# the output the page promises.
#
# Jekyll is not involved: the pages are fragments with front matter, so the
# harness strips it and splices the header include, which is all these need.
type pages
  board
  book
  chapter
  engine
  hero
  index
  play_js
  wasm

# Each visit gets its own port: a listener closed a moment ago is not
# immediately available again, and the second visit met "cannot listen on
# that port" when both shared one.
# A chapter is served by a layout, which is where its scripts live.
chapter_scripts = """
  <script src="/kanso-engine.js"></script>
  <script src="/book-play.js"></script>
"""

landing_port = 8749

board_port = 8750

book_port = 8751

assets = ["kanso-engine.js" "kanso.wasm" "landing-play.js" "play.js"]

# The page reports by posting to /report, which is the only path the server
# treats as anything but a file.
probe = """
  <script>
  (async () => \{
    const post = (r) => fetch('/report', \{method: 'POST',
                                          body: JSON.stringify(r)});
    const settled = async (id, reject) => \{
      for (let i = 0; i < 200; i++) \{
        await new Promise(r => setTimeout(r, 250));
        const text = document.getElementById(id).textContent;
        if (text && !reject(text)) return text;
      }
      return document.getElementById(id).textContent;
    };
    try \{
      await post(await PAGE_PROBE(settled));
    } catch (e) \{ await post(\{err: String(e)}); }
  })();
  </script>
"""

# The panel loads the engine lazily, so the probe waits for it rather than
# racing the click against a megabyte of wasm.
landing = """
  <script>
  window.PAGE_PROBE = async (settled) => \{
    for (let i = 0; i < 60 && !window.KansoEngine; i++)
      await new Promise(r => setTimeout(r, 100));
    await window.KansoEngine.ready();
    document.getElementById('hero-run').click();
    return \{out: await settled('hero-output', t => t === 'running…')};
  };
  </script>
"""

fn body_for "/" set
  set.index

fn body_for "/index.html" set
  set.index

fn body_for "/kanso-engine.js" set
  set.engine

fn body_for "/kanso.wasm" set
  set.wasm

fn body_for "/landing-play.js" set
  set.hero

fn body_for "/playground.html" set
  set.board

fn body_for "/book-play.js" set
  set.book

fn body_for "/book/ch04.html" set
  set.chapter

fn body_for "/play.js" set
  set.play_js

fn body_for _ _
  none

# The repl reaches into the wasm module directly rather than through runSource,
# so it is the one surface a load-order slip can silently break. The run button
# is probed against edited source too: switching examples runs its own code, so
# the picker path can pass while a plain edit-then-run is broken.
board = """
  <script>
  window.PAGE_PROBE = async (settled) => \{
    const ready = (t) => t.startsWith('ready') || t === 'running…';
    const first = await settled('output', ready);
    const picker = document.getElementById('examples');
    picker.value = 'fanout';
    picker.dispatchEvent(new Event('change'));
    await new Promise(r => setTimeout(r, 300));
    document.getElementById('run').click();
    const second = await settled('output',
      t => t === first || t === 'running…');
    const log = document.getElementById('repl-log');
    document.getElementById('repl-input').value = '2 + 3';
    document.getElementById('repl-form').dispatchEvent(
      new Event('submit', \{cancelable: true, bubbles: true}));
    for (let i = 0; i < 80 && !log.querySelector('.repl-out'); i++)
      await new Promise(r => setTimeout(r, 100));
    const answer = log.querySelector('.repl-out');
    const editor = document.getElementById('editor');
    editor.value = 'print "edited then run \{6 * 7}"\\n';
    editor.dispatchEvent(new Event('input'));
    const was = document.getElementById('output').textContent;
    document.getElementById('run').click();
    const edited = await settled('output',
      t => t === was || t === 'running…');
    editor.value = 'print "keys then run \{2 + 3}"\\n';
    editor.dispatchEvent(new Event('input'));
    editor.dispatchEvent(new KeyboardEvent('keydown',
      \{key: 'Enter', metaKey: true, bubbles: true}));
    const keyed = await settled('output',
      t => t === edited || t === 'running…');
    return \{out: first, fanout: second, edited, keyed,
            repl: answer ? answer.textContent : ''};
  };
  </script>
"""

# A chapter's panels: the ones that can run here grew an editor and a button,
# and the ones that need a filesystem stayed as the book recorded them. The
# first live panel is run as it shipped, then again against source a reader
# typed into it.
story = """
  <script>
  window.PAGE_PROBE = async () => \{
    for (let i = 0; i < 60 && !window.KansoEngine; i++)
      await new Promise(r => setTimeout(r, 100));
    await window.KansoEngine.ready();
    const panels = [...document.querySelectorAll('.code-panel')];
    const live = panels.filter(p => p.querySelector('.book-run'));
    const first = live[0];
    const out = first.querySelector('.code-output pre code');
    const before = out.textContent;
    first.querySelector('.book-run').click();
    for (let i = 0; i < 120 && out.textContent === before; i++)
      await new Promise(r => setTimeout(r, 100));
    const editor = first.querySelector('textarea');
    editor.value = 'print "the reader edited this: \{6 * 7}"\\n';
    editor.dispatchEvent(new Event('input'));
    const ran = out.textContent;
    first.querySelector('.book-run').click();
    for (let i = 0; i < 120 && out.textContent === ran; i++)
      await new Promise(r => setTimeout(r, 100));
    return \{panels: panels.length, live: live.length, ran,
            edited: out.textContent};
  };
  </script>
"""

fn replaced text from to
  text/join (text/split text from) to

# Front matter is a leading `---` line and everything up to the next one. A
# page without it is left alone, which is why this asks before it cuts.
fn without_front_matter text
  cut text (text/slice text 1 4 == "---\n")

fn cut text false
  text

fn cut text true
  parts = text/split text "---\n"
  text/join (list/to_list (list/drop parts 2)) "---\n"

fn kind path
  parts = text/split path "."
  named parts[length parts]!

fn named "js"
  "content-type: text/javascript; charset=utf-8"

fn named "wasm"
  "content-type: application/wasm"

fn named _
  "content-type: text/html; charset=utf-8"

fn handled req served
  answered req.path req served

fn answered "/report" req _
  http/turn (http/ok "thanks") (http/done req.body)

fn answered path _ set
  body = body_for path set
  http/turn (found body path) set

fn found none _
  http/not_found

fn found body path
  http/response 200 "OK" [(kind path)] body

# `tail` is appended after the rewrite above, because a chapter is served by a
# layout and its scripts are absolute: rewriting them would point them at the
# chapter's own directory, where nothing answers.
fn document header page tail extra
  body = replaced (without_front_matter page) "src=\"/" "src=\""
  head = "<!doctype html><html><head><meta charset=utf-8></head><body>"
  "{head}{header}{body}{tail}{extra}{probe}</body></html>"

fn flags url
  where = "--user-data-dir=/tmp/kanso-smoke-profile"
  ["--headless=new" "--disable-gpu" where url]

fn browsing chrome at path
  url = flags "http://127.0.0.1:{at}{path}"
  io/start chrome url

# The server listens before `accept` yields, and only then does the browser
# start, which is what keeps chrome from meeting a closed door.
fn visiting set chrome at path on
  http/serve_until at handled set . on
  browsing chrome at path

# Headless chrome does not exit on its own, and the process handle is born in
# the statement that starts it while the report arrives in the statement that
# serves — nothing carries a value between them. The profile name is unique to
# this harness, so it is what identifies the browser to stop.
fn stopping on
  io/run "pkill" ["-f" "kanso-smoke-profile"] . on

fn saw? text needle
  length (text/split text needle) > 1

fn said_in? report key needle
  read_out? report[key] needle

fn read_out? none _
  false

fn read_out? text needle
  saw? text needle

fn noted acc _ true
  acc

fn noted acc why false
  text/concat acc [why]

fn running set chrome
  on = (report -> landed set chrome report)
  visiting set chrome landing_port "/index.html" on

fn landed set chrome report
  on = (_ -> after_landing set chrome report)
  stopping on

fn after_landing set chrome report
  why = "the landing sample did not run: {report}"
  told = noted [] why (saw? report "hello, kanso")
  visiting_board set chrome told

fn visiting_board set chrome failures
  on = (report -> boarded set chrome failures report)
  visiting set chrome board_port "/playground.html" on

fn boarded set chrome failures report
  on = (_ -> judged set chrome failures report)
  stopping on

fn judged set chrome failures report
  read = json/decode report
  a = missing_first read failures
  b = missing_fanout read a
  c = missing_repl read b
  e = missing_edit read c
  visiting_book set chrome (missing_keys read e)

fn visiting_book set chrome failures
  on = (report -> booked failures report)
  visiting set chrome book_port "/book/ch04.html" on

fn booked failures report
  on = (_ -> read_book failures report)
  stopping on

fn read_book failures report
  read = json/decode report
  a = missing_panels read failures
  b = missing_run read a
  finished (missing_reader read b) report

fn missing_panels read acc
  why = "no panel in chapter 04 became runnable"
  noted acc why (any_live? read["live"])

fn any_live? none
  false

fn any_live? live
  live > 0

fn missing_run read acc
  why = "the chapter's first panel did not run"
  noted acc why (said_in? read "ran" "division by zero")

fn missing_reader read acc
  why = "a book panel did not run edited source"
  noted acc why (said_in? read "edited" "the reader edited this: 42")

fn missing_first read acc
  why = "the playground's first example did not run"
  noted acc why (said_in? read "out" "hello, kanso")

# fanout puts a closure in a record field, which the browser engine could not
# do until Value::TableFn — the regression this page must never take again.
fn missing_fanout read acc
  why = "fanout did not run in the playground"
  noted acc why (said_in? read "fanout" "650 yen")

fn missing_repl read acc
  why = "the repl did not answer"
  noted acc why (said_in? read "repl" "5")

fn missing_edit read acc
  why = "the run button did not run edited source"
  noted acc why (said_in? read "edited" "edited then run 42")

fn missing_keys read acc
  why = "the keyboard shortcut did not run edited source"
  noted acc why (said_in? read "keyed" "keys then run 5")

fn finished failures report
  ended failures report (length failures == 0)

fn ended _ _ true
  io/write "PASS  the landing page, the playground and the book run\n"

fn ended failures report false
  said = "FAIL  {text/join failures "; "}\n  the page said: {report}\n"
  io/write said . (_ -> io/exit 1)

pub play = io/read_file "docs/kanso-engine.js" . with_engine

fn with_engine engine
  on = (wasm -> with_wasm engine wasm)
  io/read_file "docs/kanso.wasm" . on

fn with_wasm engine wasm
  on = (hero -> with_hero engine wasm hero)
  io/read_file "docs/landing-play.js" . on

fn with_hero engine wasm hero
  on = (js -> with_play engine wasm hero js)
  io/read_file "docs/play.js" . on

fn with_play engine wasm hero js
  on = (header -> with_header engine wasm hero js header)
  io/read_file "docs/_includes/site-header.html" . on

fn with_header engine wasm hero js header
  on = (page -> with_index engine wasm hero js header page)
  io/read_file "docs/index.html" . on

fn with_index engine wasm hero js header page
  on = (raw -> with_board engine wasm hero js header page raw)
  io/read_file "docs/playground.html" . on

fn with_board engine wasm hero js header page raw
  on = (b -> with_book engine wasm hero js header page raw b)
  io/read_file "docs/book-play.js" . on

fn with_book engine wasm hero js header page raw b
  on = (ch -> with_chapter engine wasm hero js header page raw b ch)
  io/read_file "docs/book/ch04.html" . on

fn with_chapter engine wasm hero js header page raw b ch
  index = document header page "" landing
  shown = document header raw "" board
  read = document header ch chapter_scripts story
  wanted (pages shown b read engine hero index js wasm)

fn wanted set
  io/env "KANSO_CHROME" . (told_where -> chosen set told_where)

fn chosen set none
  mac = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
  io/exists mac . (there -> either set mac there)

fn chosen set where
  running set where

fn either set mac true
  running set mac

fn either set _ false
  running set "/usr/bin/google-chrome"
