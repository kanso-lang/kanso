import "std/io"
import "std/json"
import "std/list"
import "std/net/http"
import "std/text"

# The landing page and the playground share one engine module, so a change to
# either can break both, and neither failure shows up in a Rust test. This
# loads the page in headless chrome against a local copy of docs/ and requires
# the output the page promises.
#
# Jekyll is not involved: the pages are fragments with front matter, so the
# harness strips it and splices the header include, which is all these need.
type pages
  board
  book
  chapter
  chart
  engine
  hero
  index
  play_js
  wasm

# Each visit gets its own port: a listener closed a moment ago is not
# immediately available again, and the second visit met "cannot listen on
# that port" when both shared one.
# A chapter is served by a layout, which is where its scripts live.
chapter_scripts = """
  <script src="/kanso-engine.js"></script>
  <script src="/book-play.js"></script>
"""

mac_chrome = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

linux_chrome = ["/usr/bin/google-chrome" "/usr/bin/chromium-browser"]

other_chrome = ["/usr/bin/chromium" "/usr/bin/google-chrome-stable"]

rest_chrome = text/concat linux_chrome other_chrome

chrome_paths = text/concat [mac_chrome] rest_chrome

landing_port = 8749

board_port = 8750

book_port = 8751

chart_port = 8752

assets = ["kanso-engine.js" "kanso.wasm" "landing-play.js" "play.js"]

# The page reports by posting to /report, which is the only path the server
# treats as anything but a file.
probe = """
  <script>
  (async () => \{
    const post = (r) => fetch('/report', \{method: 'POST',
                                          body: JSON.stringify(r)});
    const settled = async (id, reject) => \{
      for (let i = 0; i < 200; i++) \{
        await new Promise(r => setTimeout(r, 250));
        const text = document.getElementById(id).textContent;
        if (text && !reject(text)) return text;
      }
      return document.getElementById(id).textContent;
    };
    try \{
      await post(await PAGE_PROBE(settled));
    } catch (e) \{ await post(\{err: String(e)}); }
  })();
  </script>
"""

# The panel loads the engine lazily, so the probe waits for it rather than
# racing the click against a megabyte of wasm.
landing = """
  <script>
  window.PAGE_PROBE = async (settled) => \{
    for (let i = 0; i < 60 && !window.KansoEngine; i++)
      await new Promise(r => setTimeout(r, 100));
    await window.KansoEngine.ready();
    document.getElementById('hero-run').click();
    return \{out: await settled('hero-output', t => t === 'running…')};
  };
  </script>
"""

fn body_for "/" set
  set.index

fn body_for "/index.html" set
  set.index

fn body_for "/kanso-engine.js" set
  set.engine

fn body_for "/kanso.wasm" set
  set.wasm

fn body_for "/landing-play.js" set
  set.hero

fn body_for "/playground.html" set
  set.board

fn body_for "/book-play.js" set
  set.book

fn body_for "/book/ch04.html" set
  set.chapter

fn body_for "/compiler.html" set
  set.chart

fn body_for "/play.js" set
  set.play_js

fn body_for _ _
  none

# The repl reaches into the wasm module directly rather than through runSource,
# so it is the one surface a load-order slip can silently break. The run button
# is probed against edited source too: switching examples runs its own code, so
# the picker path can pass while a plain edit-then-run is broken.
board = """
  <script>
  window.PAGE_PROBE = async (settled) => \{
    const ready = (t) => t.startsWith('ready') || t === 'running…';
    const first = await settled('output', ready);
    const picker = document.getElementById('examples');
    picker.value = 'fanout';
    picker.dispatchEvent(new Event('change'));
    await new Promise(r => setTimeout(r, 300));
    document.getElementById('run').click();
    const second = await settled('output',
      t => t === first || t === 'running…');
    const log = document.getElementById('repl-log');
    document.getElementById('repl-input').value = '2 + 3';
    document.getElementById('repl-form').dispatchEvent(
      new Event('submit', \{cancelable: true, bubbles: true}));
    for (let i = 0; i < 80 && !log.querySelector('.repl-out'); i++)
      await new Promise(r => setTimeout(r, 100));
    const answer = log.querySelector('.repl-out');
    const editor = document.getElementById('editor');
    editor.value = 'print "edited then run \{6 * 7}"\\n';
    editor.dispatchEvent(new Event('input'));
    const was = document.getElementById('output').textContent;
    document.getElementById('run').click();
    const edited = await settled('output',
      t => t === was || t === 'running…');
    editor.value = 'print "keys then run \{2 + 3}"\\n';
    editor.dispatchEvent(new Event('input'));
    editor.dispatchEvent(new KeyboardEvent('keydown',
      \{key: 'Enter', metaKey: true, bubbles: true}));
    const keyed = await settled('output',
      t => t === edited || t === 'running…');
    return \{out: first, fanout: second, edited, keyed,
            repl: answer ? answer.textContent : ''};
  };
  </script>
"""

# A chapter's panels: the ones that can run here grew an editor and a button,
# and the ones that need a filesystem stayed as the book recorded them. The
# first live panel is run as it shipped, then again against source a reader
# typed into it.
story = """
  <script>
  window.PAGE_PROBE = async () => \{
    for (let i = 0; i < 60 && !window.KansoEngine; i++)
      await new Promise(r => setTimeout(r, 100));
    await window.KansoEngine.ready();
    const panels = [...document.querySelectorAll('.code-panel')];
    const live = panels.filter(p => p.querySelector('.book-run'));
    const first = live[0];
    const out = first.querySelector('.code-output pre code');
    const before = out.textContent;
    first.querySelector('.book-run').click();
    for (let i = 0; i < 120 && out.textContent === before; i++)
      await new Promise(r => setTimeout(r, 100));
    const editor = first.querySelector('textarea');
    editor.value = 'print "the reader edited this: \{6 * 7}"\\n';
    editor.dispatchEvent(new Event('input'));
    const ran = out.textContent;
    first.querySelector('.book-run').click();
    for (let i = 0; i < 120 && out.textContent === ran; i++)
      await new Promise(r => setTimeout(r, 100));
    return \{panels: panels.length, live: live.length, ran,
            edited: out.textContent};
  };
  </script>
"""

# The chart reads its rows from the history branch over the network. Letting it
# would tie this test to a branch's contents and to the network being there,
# and would pin no number. So the fetch is stubbed with a history of known
# length and the assertion is that every series draws exactly that many points:
# a presence check would pass on an empty canvas, which is the failure this
# exists to catch.
#
# Shaped from a real row rather than invented. The first stub omitted `date`
# and the page threw RangeError: Invalid time value before it drew anything —
# a fixture the pipeline would never produce, asserting a fiction. The values
# vary so a flat series cannot pass for a drawn one.
history = """
  \{"commit": "c0ffee0", "subject": "a change that moved something (0)", "date": "2026-08-01T12:00:00-07:00", "allocs": 7577414, "alloc_bytes": 334437312, "arena_blocks": 3, "beat_iters": 151, "encode_allocs": 16259950, "oneshot_arena_peak_bytes": 7340032, "compile_rounds": 40, "compile_visits": 9000, "compile_peak_bytes": 819173, "emitted_lines": 1500, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1024, "perm_allocs": 9, "welfare": 75.6}
  \{"commit": "c0ffee1", "subject": "a change that moved something (1)", "date": "2026-08-02T12:00:00-07:00", "allocs": 7578414, "alloc_bytes": 334441408, "arena_blocks": 3, "beat_iters": 152, "encode_allocs": 16261950, "oneshot_arena_peak_bytes": 7344128, "compile_rounds": 41, "compile_visits": 9010, "compile_peak_bytes": 819685, "emitted_lines": 1501, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1025, "perm_allocs": 9, "welfare": 75.61}
  \{"commit": "c0ffee2", "subject": "a change that moved something (2)", "date": "2026-08-03T12:00:00-07:00", "allocs": 7579414, "alloc_bytes": 334445504, "arena_blocks": 3, "beat_iters": 153, "encode_allocs": 16263950, "oneshot_arena_peak_bytes": 7348224, "compile_rounds": 42, "compile_visits": 9020, "compile_peak_bytes": 820197, "emitted_lines": 1502, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1026, "perm_allocs": 9, "welfare": 75.62}
  \{"commit": "c0ffee3", "subject": "a change that moved something (3)", "date": "2026-08-04T12:00:00-07:00", "allocs": 7580414, "alloc_bytes": 334449600, "arena_blocks": 3, "beat_iters": 154, "encode_allocs": 16265950, "oneshot_arena_peak_bytes": 7352320, "compile_rounds": 43, "compile_visits": 9030, "compile_peak_bytes": 820709, "emitted_lines": 1503, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1027, "perm_allocs": 9, "welfare": 75.63}
  \{"commit": "c0ffee4", "subject": "a change that moved something (4)", "date": "2026-08-05T12:00:00-07:00", "allocs": 7581414, "alloc_bytes": 334453696, "arena_blocks": 3, "beat_iters": 155, "encode_allocs": 16267950, "oneshot_arena_peak_bytes": 7356416, "compile_rounds": 44, "compile_visits": 9040, "compile_peak_bytes": 821221, "emitted_lines": 1504, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1028, "perm_allocs": 9, "welfare": 75.64}
  \{"commit": "c0ffee5", "subject": "a change that moved something (5)", "date": "2026-08-06T12:00:00-07:00", "allocs": 7582414, "alloc_bytes": 334457792, "arena_blocks": 3, "beat_iters": 156, "encode_allocs": 16269950, "oneshot_arena_peak_bytes": 7360512, "compile_rounds": 45, "compile_visits": 9050, "compile_peak_bytes": 821733, "emitted_lines": 1505, "el_parses": 0, "utf8_bytes": 0, "held_peak_bytes": 1029, "perm_allocs": 9, "welfare": 75.65}
"""

# A stub answering in a microtask is no stand-in for the network: it resolves
# before the parser reaches the element the chart draws into, and drawTrend
# returns silently on a host that is not there yet. Waiting for the document
# puts the stub back behind parsing, where a real fetch is.
stub = """
  window.__chart = \{stub: 0, err: ''};
  window.__chart.ready = document.readyState === 'complete'
    ? Promise.resolve()
    : new Promise((go) => window.addEventListener('load', () => go()));
  window.addEventListener('error', (e) =>
    \{ window.__chart.err = window.__chart.err || String(e.message); });
  window.addEventListener('unhandledrejection', (e) =>
    \{ window.__chart.err = window.__chart.err || 'rejected: ' + e.reason; });
  const REAL = window.fetch.bind(window);
  window.fetch = (url, opts) => \{
    if (String(url).includes('history.jsonl')) \{
      window.__chart.stub += 1;
      const r = new Response(HISTORY_TEXT, \{status: 200});
      return window.__chart.ready.then(() => r);
    }
    return REAL(url, opts);
  };
"""

# A count, never a presence check: an empty canvas has a host and no points.
trend = """
  <script>
  window.PAGE_PROBE = async () => \{
    const counts = async () => \{
      const host = document.getElementById('trend-chart');
      if (!host) return null;
      const lines = [...host.querySelectorAll('polyline')];
      if (!lines.length) return null;
      return lines
        .map((l) => (l.getAttribute('points') || '').trim()
                      .split(' ').filter(Boolean).length)
        .sort((a, b) => a - b);
    };
    for (let i = 0; i < 600; i++) \{
      const got = await counts();
      if (got) return \{series: got};
      await new Promise((r) => setTimeout(r, 250));
    }
    return \{series: [], stubbed: window.__chart.stub,
            why: window.__chart.err || 'the chart never drew'};
  };
  </script>
"""

fn replaced text from to
  text/join (text/split text from) to

# Front matter is a leading `---` line and everything up to the next one. A
# page without it is left alone, which is why this asks before it cuts.
fn without_front_matter text
  cut text (text/slice text 1 4 == "---\n")

fn cut text false
  text

fn cut text true
  parts = text/split text "---\n"
  text/join (list/to_list (list/drop parts 2)) "---\n"

fn kind path
  parts = text/split path "."
  named parts[length parts]!

fn named "js"
  "content-type: text/javascript; charset=utf-8"

fn named "wasm"
  "content-type: application/wasm"

fn named _
  "content-type: text/html; charset=utf-8"

fn handled req served
  answered req.path req served

fn answered "/report" req _
  http/turn (http/ok "thanks") (http/done req.body)

fn answered path _ set
  body = body_for path set
  http/turn (found body path) set

fn found none _
  http/not_found

fn found body path
  http/response 200 "OK" [(kind path)] body

# `tail` is appended after the rewrite above, because a chapter is served by a
# layout and its scripts are absolute: rewriting them would point them at the
# chapter's own directory, where nothing answers.
fn document top header page tail extra
  body = replaced (without_front_matter page) "src=\"/" "src=\""
  opened = "<!doctype html><html><head><meta charset=utf-8>"
  head = "{opened}<script>{top}</script></head><body>"
  "{head}{header}{body}{tail}{extra}{probe}</body></html>"

# A profile per visit. Chrome is killed rather than asked to leave, so the
# directory it leaves behind is not one a later chrome can open: the fourth
# visit hung on a profile three earlier browsers had been killed out of, while
# the same visit run alone passed in seconds.
fn flags at url
  where = "--user-data-dir=/tmp/kanso-smoke-profile-{at}"
  ["--headless=new" "--disable-gpu" where url]

fn browsing chrome at path
  url = flags at "http://127.0.0.1:{at}{path}"
  io/start chrome url

# The server listens before `accept` yields, and only then does the browser
# start, which is what keeps chrome from meeting a closed door.
fn visiting set chrome at path on
  http/serve_until at handled set . on
  browsing chrome at path

# Headless chrome does not exit on its own, and the process handle is born in
# the statement that starts it while the report arrives in the statement that
# serves — nothing carries a value between them. The profile name is unique to
# this harness, so it is what identifies the browser to stop.
fn stopping on
  io/run "pkill" ["-f" "kanso-smoke-profile"] . on

fn saw? text needle
  length (text/split text needle) > 1

fn said_in? report key needle
  read_out? report[key] needle

fn read_out? none _
  false

fn read_out? text needle
  saw? text needle

fn noted acc _ true
  acc

fn noted acc why false
  text/concat acc [why]

fn running set chrome
  on = (report -> landed set chrome report)
  visiting set chrome landing_port "/index.html" on

fn landed set chrome report
  on = (_ -> after_landing set chrome report)
  stopping on

fn after_landing set chrome report
  why = "the landing sample did not run: {report}"
  told = noted [] why (saw? report "hello, kanso")
  visiting_board set chrome told

fn visiting_board set chrome failures
  on = (report -> boarded set chrome failures report)
  visiting set chrome board_port "/playground.html" on

fn boarded set chrome failures report
  on = (_ -> judged set chrome failures report)
  stopping on

fn judged set chrome failures report
  read = json/decode report
  a = missing_first read failures
  b = missing_fanout read a
  c = missing_repl read b
  e = missing_edit read c
  visiting_book set chrome (missing_keys read e)

fn visiting_book set chrome failures
  on = (report -> booked set chrome failures report)
  visiting set chrome book_port "/book/ch04.html" on

fn booked set chrome failures report
  on = (_ -> read_book set chrome failures report)
  stopping on

fn read_book set chrome failures report
  read = json/decode report
  a = missing_panels read failures
  b = missing_run read a
  visiting_chart set chrome (missing_reader read b)

fn visiting_chart set chrome failures
  on = (report -> charted failures report)
  visiting set chrome chart_port "/compiler.html" on

fn charted failures report
  on = (_ -> read_chart failures report)
  stopping on

fn read_chart failures report
  read = json/decode report
  finished (missing_series read failures) report

# Five series, six points each, because six rows were fed to it. A presence
# check would pass on an empty canvas, which is the failure this exists to
# catch.
fn missing_series read acc
  why = "the chart did not draw five series of six points"
  noted acc why (drew? read["series"])

fn drew? none
  false

fn drew? series
  series == [6 6 6 6 6]

fn missing_panels read acc
  why = "no panel in chapter 04 became runnable"
  noted acc why (any_live? read["live"])

fn any_live? none
  false

fn any_live? live
  live > 0

fn missing_run read acc
  why = "the chapter's first panel did not run"
  noted acc why (said_in? read "ran" "division by zero")

fn missing_reader read acc
  why = "a book panel did not run edited source"
  noted acc why (said_in? read "edited" "the reader edited this: 42")

fn missing_first read acc
  why = "the playground's first example did not run"
  noted acc why (said_in? read "out" "hello, kanso")

# fanout puts a closure in a record field, which the browser engine could not
# do until Value::TableFn — the regression this page must never take again.
fn missing_fanout read acc
  why = "fanout did not run in the playground"
  noted acc why (said_in? read "fanout" "650 yen")

fn missing_repl read acc
  why = "the repl did not answer"
  noted acc why (said_in? read "repl" "5")

fn missing_edit read acc
  why = "the run button did not run edited source"
  noted acc why (said_in? read "edited" "edited then run 42")

fn missing_keys read acc
  why = "the keyboard shortcut did not run edited source"
  noted acc why (said_in? read "keyed" "keys then run 5")

fn finished failures report
  ended failures report (length failures == 0)

fn ended _ _ true
  io/write "PASS  every page the site smoke test watches still runs\n"

fn ended failures report false
  said = "FAIL  {text/join failures "; "}\n  the page said: {report}\n"
  io/write said . (_ -> io/exit 1)

# The history is embedded as a JS string, and declared after the stub that
# reads it: the page's own scripts run once this one has finished, so nothing
# can fetch before the constant exists.
encoded = json/encode history

chart_head = "{stub}\nconst HISTORY_TEXT = {encoded};\n"

engine_files = ["docs/kanso-engine.js" "docs/kanso.wasm"]

hero_files = ["docs/landing-play.js" "docs/play.js"]

page_files = ["docs/_includes/site-header.html" "docs/index.html"]

more_pages = ["docs/playground.html" "docs/book-play.js"]

last_pages = ["docs/book/ch04.html" "docs/compiler.html"]

early_files = text/concat engine_files hero_files

middle_files = text/concat page_files more_pages

opening_files = text/concat early_files middle_files

wanted_files = text/concat opening_files last_pages

pub play = read_each wanted_files 1 []

fn read_each paths at acc
  gathered paths at acc (at > length paths)

fn gathered _ _ acc true
  with_all acc

fn gathered paths at acc false
  on = (body -> read_each paths (at + 1) (text/concat acc [body]))
  io/read_file paths[at]! . on

fn with_all bodies
  header = bodies[5]!
  index = document "" header bodies[6]! "" landing
  shown = document "" header bodies[7]! "" board
  read = document "" header bodies[9]! chapter_scripts story
  drawn = document chart_head header bodies[10]! "" trend
  assembled bodies shown read drawn index

fn assembled bodies shown read drawn index
  hero = bodies[3]!
  js = bodies[4]!
  set = pages shown bodies[8]! read drawn bodies[1]! hero index js bodies[2]!
  wanted set

fn wanted set
  io/env "KANSO_CHROME" . (told_where -> chosen set told_where)

fn chosen set none
  first_chrome set chrome_paths 1

# A browser that never starts is a server that waits forever, so a name given
# by hand is checked before it is trusted.
fn chosen set where
  io/exists where . (there -> told_of set where there)

fn told_of set where true
  running set where

fn told_of _ where false
  said = "KANSO_CHROME names {where}, which is not there\n"
  io/write said . (_ -> io/exit 1)

fn first_chrome set paths at
  searched set paths at (at > length paths)

fn searched _ _ _ true
  io/write "no chrome found: set KANSO_CHROME\n" . (_ -> io/exit 1)

fn searched set paths at false
  on = (there -> found_at set paths at there)
  io/exists paths[at]! . on

fn found_at set paths at true
  running set paths[at]!

fn found_at set paths at false
  first_chrome set paths (at + 1)
