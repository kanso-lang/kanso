import "std/io"
import "std/list"
import "std/os"
import "std/text"

# The welfare gate already forces a sentence when one of its seven terms
# regresses, and the cost goldens already refuse silent movement. The seam
# between them: a PR can regenerate a golden, bank a welfare rise, and still
# worsen a counter the chart shows — permanent slots, emitted lines — with no
# written trade. The literal-interning entry did exactly that, and the rise sat
# unexplained until somebody read the chart.
#
# So: diff every golden counter this branch changed against main's copy,
# classify each move by the direction tables below, and look for each worsened?
# counter's name in the branch's compiler-log delta. The reflection is the
# sentence; this only refuses silence.
#
# What is enforced, per Clay's rule: nothing may get worse unless at least one
# other thing got better — a pure regression fails outright. A genuine trade
# (worsened? here, improved there) passes this gate and is arbitrated by the
# welfare scalar, which weighs the sides. The name-each-worsening listing stays
# advisory: the sentence is reflection, not enforcement.
#
# One branch escapes the refusal, added 2026-08-26 under the gavel of the day
# before — the floor is absolute against refactorings and permeable to the
# language. A feature or a doctrine-compelled change is never rejected for the
# score: it lands, the floor moves, and the fall is recorded against the change
# that spent it. So a pure regression passes when this branch adds an entry to
# the history in bench/welfare_floor.json, which is where that record is kept.
# The gate checks that the attribution exists, the way the listing below checks
# that a sentence exists; whether the change earns it is Clay's to say.
#
# gavel 24 cost lib/json four counters and improved none of them, and this gate
# refused it while the ruling in the log said it must land. That is the fixture:
# a branch obeying a gavel could not merge.
#
# A finding is the counter's name, which way it went, and the line to print.
# `minted` marks a counter the baseline does not carry at all, which is neither
# a rise nor a fall — see `unmeasured`. `rebased` marks one whose reading is
# not comparable at all — see `shifted?`.
type move
  key
  minted
  ruled
  say
  worse
  after
  rebased

# Presence counters (kernel pins) are news in either direction, but the hard
# golden diff already forces those to be deliberate; here they are
# down-is-worse so a dropped kernel reads as a worsening and wants its sentence.
lower_a = ["allocs" "alloc_bytes" "arena_blocks" "perm_allocs" "beat_iters"]

# `ten_blocks` is the tenure allocator's storage claimed, so lower is better
# like every other allocation counter. Its partner `ten_frees` is the same
# storage given back and sits in `higher` beside `bytes_freed`, for the reason
# that counter exists: with blocks held constant, a fall in frees is a leak,
# and until 2026-09-01 no counter, no golden and no spec here could see one.
lower_b = ["bytes_malloc" "thunk_allocs" "thunk_escaped" "ten_blocks"]

lower_bb = ["thunk_live_exit"]

lower_c = ["arena_peak_bytes" "held_peak_bytes" "sh_str" "sh_rec" "sh_buf"]

lower_d = ["sh_map" "sh_bytes" "lines" "calls" "branches" "defines"]

lower_e = ["rounds" "visits"]

lower_f = ["front_end_rounds" "front_end_visits" "compile_peak_bytes"]

# The two MEASURED compile veins. They became welfare's compile-speed terms on
# 2026-08-26 and this gate could not see either of them, so an instruction
# count could move by a million with the listing silent — which is exactly what
# it did while gavel 24 was being built, and only the per-golden diff caught it.
lower_g = ["compile_instructions" "compile_allocs"]

# The runtime work vein, per benchmark. Four of these are welfare's run-speed
# terms, so half the score's inputs were invisible to the gate that exists to
# watch the score's inputs — the same argument the two compile veins above
# were added on, one vein down. Named WITHOUT the file's prefix, because the
# direction lookup strips it: what is classified is the counter, wherever it
# was read from. `text` is the machine-code vein, summed over the binaries.
lower_h = ["jsonbench" "encodebench" "oneshot" "basket" "widebench"]

lower_i = ["deepbench" "escapebench" "pendbench" "indexbench" "text"]

# digestbench joined the work vein on 2026-08-31 and this list did not, so a
# rise in it read as UNCLASSIFIED drift — a 6.5x regression passed green. It is
# the row that matters most for staying honest here: every change that buys the
# digest's peak spends work, and the peak side was classified from the first day
# because `digest_arena_peak_bytes` strips to a name lower_c already held.
#
# scanbench joined the work vein on 2026-09-02 and this list at the same time,
# because the spec that caught digestbench's omission caught it in the pull
# request that added the row. Its arena and peak sides were classified from the
# first day for the same reason the digest's were.
# readbench joined on 2026-09-04, in the pull request that added the row, for
# the reason the two above give and one of its own: its work row is meant to
# stay flat. The benchmark is in the objective for its arena, and this is the
# entry that makes a rise in its instructions read as a regression rather than
# as drift the listing shrugs at.
# livebench joined on 2026-09-05, in the pull request that added the row, for
# the reason the three above give. Its own reason to be here is that it exists
# to make a library encode change visible at all: a benchmark added to see a
# fall, whose rises read as drift, would be worse than not adding it.
lower_j = ["digestbench" "scanbench" "readbench" "livebench"]

lower_ab = text/concat lower_a (text/concat lower_b lower_bb)

lower_cd = text/concat lower_c lower_d

lower_ef = text/concat lower_e (text/concat lower_f lower_g)

# emitted_golden's four counters need no entry: `lines`, `calls`, `branches`
# and `defines` are in lower_d already, for compile_golden. The prefix on the
# file keeps the two sums apart; the direction is the same question either way.
lower_run = text/concat lower_h (text/concat lower_i lower_j)

lower_efr = text/concat lower_ef lower_run

lower_all = text/concat lower_cd lower_efr

lower = text/concat lower_ab (text/concat lower_all lower_cost)

# The runtime counters that are plainly a cost, swept in on 2026-09-01. Every
# one of them had been unclassified since it was minted, so a change that
# worsened it alone printed as drift and the pure-regression rule counted it
# toward neither side. `evac_allocs` and `evac_bytes` are what a carry
# evacuation spends; `str_scans`, `str_scan_bytes`, `find2_calls` and
# `utf8_bytes` are bytes walked; `perm_live_bytes` and `perm_peak_bytes` are
# malloc-backed storage the process is still holding, which only ever leaves
# through free() — a peak that scales with iteration count is a leak by
# definition. `thunk_evals` is a lazy binding actually running, which #1197
# moved 8,256 to 129 with `thunk_forces` byte-identical.
lower_k = ["evac_allocs" "evac_bytes" "str_scans" "str_scan_bytes"]

lower_l = ["find2_calls" "utf8_bytes" "perm_live_bytes" "perm_peak_bytes"]

# The slow halves of three fast/slow pairs whose fast halves are already in
# `higher`. `append_grow` is the out-of-line growth k_b_append_grow does;
# `push_mut_slow` and `put_mut_grow` are a push and a put that could not write
# in place.
lower_m = ["append_grow" "push_mut_slow" "put_mut_grow" "thunk_evals"]

# What deciding a carry costs, beside `evac_allocs` and `evac_bytes` which are
# what the copying costs. A slot examined is an algorithm-level step, so a
# wider vector cannot move it and a second host reads the same number.
lower_n = ["survive_slots"]

lower_mn = text/concat lower_m lower_n

lower_cost = text/concat lower_k (text/concat lower_l lower_mn)

higher_a = ["el_parses" "ryu_renders" "append_fast" "utf8_zerocopy"]

higher_b = ["buf_reuse" "thunk_frees" "ten_frees"]

# The fast halves, and two reclaim counters. `bytes_freed` is malloc-backed
# storage given back, which is what `bytes_malloc` in `lower` is measured
# against; `carry_dedup` is a node the carry found already copied and reused
# rather than copying twice.
#
# The risk these carry, stated rather than left for somebody to find: a change
# that does strictly LESS of the work lowers a presence counter, and this table
# reads that as a worsening. `append_fast` and `utf8_zerocopy` have sat here
# since the table was written and it has not bitten, because a change that
# removes work almost always moves its slow twin the same way and the verdict
# comes out mixed. A pure regression that is really a pure simplification is
# the shape to watch for.
higher_c = ["push_mut_fast" "put_mut_fast" "bytes_freed" "carry_dedup"]

# What stays unclassified, and why each one is not an oversight.
#
# `cohort_frees` and `cohort_kept` are the two outcomes of the cohort dance,
# and both scale with how many cohorts ran: a change that adds a loop raises
# both while reclaiming exactly as well as before. What means something is the
# ratio, which this gate has no way to say.
#
# `view_allocs` and `view_frees` are the same shape and runtime.c says so at
# the counter: "view_allocs minus view_frees is memory the process is still
# holding". The difference is the number; either side alone is not.
#
# `thunk_forces` counts asking a thunk for its value, not computing one. #1197
# took `thunk_evals` from 8,256 to 129 on the digest with this counter
# unchanged, which is what a working memo looks like; a change that made the
# same program strict would lower it while doing identical work.
higher = text/concat higher_a (text/concat higher_b higher_c)

bench_a = [["bench/cost_golden.txt" ""]]

bench_encode = [["bench/cost_golden_encode.txt" "encode_"]]

bench_b = [["bench/cost_golden_oneshot.txt" "oneshot_"]]

bench_c = [["bench/cost_golden_basket.txt" "basket_"]]

bench_compile = [["bench/compile_golden.txt" ""]]

bench_modules = [["bench/compile_golden_modules.txt" "module_"]]

bench_memory = [["bench/compile_memory_golden.txt" ""]]

bench_ir = [["bench/compile_instructions_golden.txt" ""]]

bench_traffic = [["bench/compile_allocs_golden.txt" ""]]

bench_pend = [["bench/cost_golden_pend.txt" "pend_"]]

# The three RUNTIME veins, none of which this gate could read. `work_` and
# `emitted_` are prefixed because the names collide otherwise: every benchmark
# would clash with nothing, but `lines`, `calls`, `branches` and `defines`
# belong to bench/compile_golden.txt already, and summing the decoder's IR
# line count into a compile sample's would let a rise in one hide a fall in
# the other. text_golden's rows share the field name `text`, so it sums to one
# number across the eight binaries — the same treatment compile_golden's five
# samples already get, and the per-golden diff is what says which binary.
bench_work = [["bench/instructions_golden.txt" "work_"]]

bench_emitted = [["bench/emitted_golden.txt" "emitted_"]]

# The eight programs the emitted gate did not watch until 2026-08-27. A second
# prefix rather than a second entry under `emitted_`, so a rise in a benchmark
# cannot be hidden by a fall in the decoder — they are separate questions and
# the decoder's series is the one with eleven entries of history behind it.
bench_emitted_others = [["bench/emitted_golden_others.txt" "emitted_other_"]]

bench_text = [["bench/text_golden.txt" ""]]

# Three cost goldens that were simply never listed. They are `name=value` like
# their four listed siblings, so nothing had to be taught to read them — the
# list was short by three, which is a different failure from the one above and
# found the same way: by asking which files in bench/ this program names.
bench_escape = [["bench/cost_golden_escape.txt" "escape_"]]

bench_scan = [["bench/cost_golden_scan.txt" "scan_"]]

bench_wide = [["bench/cost_golden_wide.txt" "wide_"]]

# The digest vein, added with the benchmark on 2026-08-31. `digest_peak_bytes`
# is the row this whole benchmark exists for: it is what a streaming walk
# holds, and it is linear in the message rather than constant.
bench_digest = [["bench/cost_golden_digest.txt" "digest_"]]

# The read vein, added with readbench on 2026-09-04 (kanso#1240) and listed
# here on the same day it was found missing. Two of its rows are welfare terms
# — `read_arena_blocks` and `read_peak_bytes` — so a benchmark joined the
# OBJECTIVE while the gate that watches the objective's inputs could not see
# its golden at all, and either row could have moved by any amount in silence.
#
# Found by asking which files in bench/ this program names, the same way the
# three siblings above were, which is now the only method that has ever found
# one of these. `bench/compile_libraries_golden.txt` is the other file the list
# omits and it belongs omitted: it holds five sonames rather than counters, and
# its own gate diffs it byte for byte.
bench_read = [["bench/cost_golden_read.txt" "read_"]]

# livebench joined on 2026-09-05. It is encodebench's program against the
# library that ships rather than the frozen copy beside it, so this is the vein
# a change to lib/json's encoder moves. A benchmark whose golden the gate does
# not walk is one whose regressions arrive unpriced, which is the shape the
# three siblings above were added to close.
bench_live = [["bench/cost_golden_live.txt" "live_"]]

bench_ab = text/concat bench_a (text/concat bench_encode bench_b)

bench_cd = text/concat bench_c (text/concat bench_compile bench_modules)

bench_compiled = text/concat bench_ir bench_traffic

bench_de = text/concat bench_memory (text/concat bench_pend bench_compiled)

bench_emits = text/concat bench_emitted bench_emitted_others

bench_run = text/concat bench_work (text/concat bench_emits bench_text)

bench_rl = text/concat bench_read bench_live

bench_wd = text/concat bench_wide (text/concat bench_digest bench_rl)

bench_rest = text/concat bench_escape (text/concat bench_scan bench_wd)

bench_ce = text/concat bench_cd (text/concat bench_de bench_run)

bench_cf = text/concat bench_ce bench_rest

bench_goldens = text/concat bench_ab bench_cf

mem_dir = "tests/golden/mem"

floor_file = "bench/welfare_floor.json"

sources_file = "bench/objective_sources.txt"

# One history entry per `{"floor":` — the key opens each record and appears
# nowhere else in the file, the top-level floor being reached through a comma.
marker = "\{\"floor\":"

advice = "movement is fine; silence is not. say why in design/compiler-log.md."

fn asked argv
  os/run "git" argv

fn field? f
  length (text/split f "=") == 2

fn digit? c
  c >= "0" and c <= "9"

fn unsigned v
  minus? v (text/slice v 1 1 == "-")

fn minus? v true
  text/slice v 2 (length v)

fn minus? v false
  v

fn numeric? v
  body = unsigned v
  length body > 0 and list/all? (text/chars body) digit?

fn pair_of prefix f
  parts = text/split f "="
  ["{prefix}{parts[1]!}" parts[2]!]

fn body? l
  text/slice l 1 1 != "#" and length l > 0

fn said? t
  length t > 0

# Two shapes. Most goldens write `name=value`, one or several to a line, and a
# leading word that is not a field is a sample name the reader drops so the
# fields sum across samples. `bench/instructions_golden.txt` writes `name
# value` instead, and the reader saw nothing at all in it — three benchmarks'
# worth of a 1.81% decode regression went past this gate unnamed, because a
# line with no `=` in it produced no pairs and no pairs is indistinguishable
# from no movement.
fn on_line prefix line
  toks = list/to_list (list/select (text/split line " ") said?)
  fields = list/to_list (list/select toks field?)
  named = list/to_list (list/map fields (f -> pair_of prefix f))
  shaped prefix toks named (length named)

# The sample name `on_line` drops, recovered from the raw line. A golden that
# sums across samples cannot tell a set that GREW from a sum that rose, and
# every sum rises the moment a benchmark joins.
fn lead_of line
  toks = list/to_list (list/select (text/split line " ") said?)
  fields = list/to_list (list/select toks field?)
  leader toks (length fields > 0 and length toks > length fields)

fn leader toks true
  toks[1]!

fn leader _ false
  ""

fn sample_names text
  lines = list/select (text/split text "\n") body?
  all = list/to_list (list/map lines lead_of)
  list/to_list (list/select all said?)

fn absent? group name
  length (list/to_list (list/select group (g -> g == name))) == 0

fn new_samples base_text ours
  was = sample_names base_text
  list/to_list (list/select (sample_names ours) (n -> absent? was n))

fn without text joiners
  drop = (l -> absent? joiners (lead_of l))
  lines = list/select (text/split text "\n") drop
  text/join (list/to_list lines) "\n"

fn shaped prefix toks _ 0
  lone prefix toks (length toks == 2)

fn shaped _ _ named _
  named

fn lone prefix toks true
  [["{prefix}{toks[1]!}" toks[2]!]]

fn lone _ _ false
  []

fn joined acc more
  text/concat acc more

# Every pinned counter in one text, as [name value] pairs. Duplicate names
# across lines are summed, the way the python's dict was.
fn counted text prefix
  lines = list/select (text/split text "\n") body?
  all = list/to_list (list/map lines (l -> on_line prefix l))
  flat = list/to_list (list/fold all [] joined)
  list/to_list (list/select flat (p -> numeric? p[2]!))

fn totals pairs
  by_name = list/group_by pairs first_of
  list/transform_values by_name total_of

fn total_of ps
  list/sum (list/to_list (list/map ps (p -> text/to_int p[2]!)))

fn names_of pairs
  sorted = list/to_list (list/sort (list/to_list (list/map pairs first_of)))
  list/to_list (list/fold sorted [] once)

fn first_of p
  p[1]!

fn once acc name
  fresh acc name (length acc == 0 or acc[length acc]! != name)

fn fresh acc name true
  push acc name

fn fresh acc _ false
  acc

fn or_zero none
  0

fn or_zero n
  n

fn found? name group
  list/any? group (g -> g == name)

# A counter's direction, and `false` for one no table names — the golden diff
# already forces those to be deliberate.
fn worsened? bare before after
  ruled? (found? bare lower) (found? bare higher) before after

fn ruled? true true before after
  after > before

fn ruled? true _ before after
  after > before

fn ruled? _ true before after
  after < before

fn ruled? _ _ _ _
  false

# Thousands separators, so a counter reads the way the chart prints it.
fn commas n
  signed "{n}" (n < 0)

fn signed s true
  "-{grouped (text/slice s 2 (length s))}"

fn signed s false
  grouped s

fn grouped s
  short s (length s <= 3)

fn short s true
  s

fn short s false
  head = text/slice s 1 (length s - 3)
  tail = text/slice s (length s - 2) (length s)
  "{grouped head},{tail}"

fn from_git base path
  asked ["show" "{base}:{path}"] . (r -> answered r.status r.stdout)

fn answered 0 text
  text

fn answered _ _
  ""

fn added? l
  text/slice l 1 1 == "+"

# Did this branch record a fall against itself? An added history entry is the
# attribution gavel 2026-08-25 asks for, and its absence is what the refusal
# below is really about.
fn recorded text
  length (text/split text marker) - 1

fn attributed? base
  from_git base floor_file
    . (theirs -> os/read_file! floor_file . (ours -> grew? theirs ours))

fn grew? theirs ours
  recorded ours > recorded theirs

# A COUNTER CAN MOVE BECAUSE THE MEASUREMENT CHANGED, and the ratio the gate
# prints is then between two different things. kanso#1241 redefined the compile
# row to count the compiler's own frame rather than the whole process, which
# dropped 465,864 instructions of loader and stack guard from every reading;
# the same commit subtracted that constant from welfare's baseline so the ratio
# stayed comparable. The gate read the pair as a win and printed
# `improved: compile_instructions 41,845,704 -> 41,379,840`, and that sentence
# is in the permanent record of the merge. Nothing in the compiler got faster.
#
# The signal is welfare's baseline. `welfare --set` moves the FLOOR and leaves
# the baseline alone, so a baseline value only moves when somebody decides the
# old reading and the new one are not of the same quantity — which is the
# definition of a re-basing. A counter whose golden moved and whose baseline
# moved in the same diff is therefore neither better nor worse, and the third
# state kanso#1200 built for minted counters is the shape this one takes too.
#
# WHICH GOLDEN ROW BELONGS TO WHICH BASELINE is written down in
# bench/objective_sources.txt rather than guessed. welfare renames on the way
# in — `work_jsonbench` here is `decode_instructions` there — and for the
# memory terms it also sums three pools, so a `*_peak_bytes` baseline has no
# single row at all and a join on values cannot work. That file's own header
# carries the measurement, and a spec replays it against `welfare --counters`
# so a rename on either side turns CI red instead of unlinking a term.
#
# `orphans` is what is left over: a baseline that moved while none of its rows
# did. That is a ratio moving with no measurement behind it, which is worth a
# sentence of its own.
fn baselines text
  opened (text/split text "\"baseline\":\{")

fn opened parts
  inner parts (length parts == 1)

fn inner _ true
  ""

fn inner parts false
  rest = text/split parts[2]! "}"
  rest[1]!

# The block carries no braces, so a split on "," gives one `"name":value` pair
# a piece and the name is quoted on both sides. Quoting is what keeps
# `"instructions":` from matching inside `"basket_instructions":`.
fn pinned block name
  cut_at (text/split block "\"{name}\":")

fn cut_at parts
  taken parts (length parts == 1)

fn taken _ true
  ""

fn taken parts false
  rest = text/split parts[2]! ","
  rest[1]!

# A name the baseline carries on one side and not the other is a term joining
# or leaving the objective, which is its own kind of news and not this one.
fn moved? theirs ours name
  was = pinned theirs name
  is = pinned ours name
  present? was and present? is and was != is

fn present? ""
  false

fn present? _
  true

# `pins` is three lists of strings: the gate keys this branch re-based, the
# objective counters whose baseline moved, and the link file's own rows. The
# walk carries it whole rather than the two baselines, so the diffing happens
# once at the start instead of per counter per golden.
fn linkage theirs ours src
  rows = list/to_list (list/select (text/split src "\n") body?)
  gone = list/to_list (list/select rows (r -> moved? theirs ours (name_of r)))
  keys = list/to_list (list/map gone key_of)
  [keys (deduped (list/to_list (list/map gone name_of))) rows]

fn name_of row
  parts = text/split row " "
  parts[1]!

fn key_of row
  parts = text/split row " "
  parts[2]!

# A counter that is a sum has a row per pool, so its name comes back once a
# pool and the listing would say it three times.
fn deduped names
  list/fold names [] seen_once

fn seen_once seen n
  added_once seen n (found? n seen)

fn added_once seen _ true
  seen

fn added_once seen n false
  text/concat seen [n]

fn shifted? pins key
  found? key pins[1]!

fn log_delta base
  argv = ["diff" base "--" "design/compiler-log.md"]
  asked argv . (r -> plus_lines r.stdout)

fn plus_lines out
  kept = list/select (text/split out "\n") added?
  text/join (list/to_list (list/map kept (l -> text/slice l 2 (length l)))) "\n"

# A fixture this branch adds has nothing to be compared against, and counting
# its counters as movement would read every new pin as a regression.
fn against _ "" found _
  io/write "" . (_ -> found)

fn against golden base_text found pins
  os/read_file! golden[1]!
    . (ours -> weighed golden golden[2]! base_text ours found pins)

# The sums run over the samples BOTH sides have.
#
# These goldens sum their fields across samples on purpose — `on_line` drops
# the leading name so `lines`, `calls`, `branches` and `defines` add up across
# a file's programs. That is the right treatment for a fixed set and the wrong
# one the moment a benchmark joins: every sum rises at once and not one
# program already there emitted a line more than before. Adding a tenth
# benchmark read defines 1,163 -> 1,323, calls 12,739 -> 14,310, branches
# 7,484 -> 8,341 and lines 73,669 -> 82,751, and the four deltas were exactly
# the new program's own row. The gate called that a pure regression.
#
# `against _ ""` above already says a golden this branch CREATED has nothing
# to be compared against. This is the same sentence one level down, for a row
# added inside a golden that existed — and it drops the joining sample rather
# than the whole file, so a real rise in a program that was already there
# still shows on the run that adds one. Skipping the file instead was written
# first and measured: `scanbench calls 3,743 -> 9,999` went past it silently.
fn weighed golden prefix base_text ours found pins
  joiners = new_samples base_text ours
  mine = counted (without ours joiners) prefix
  theirs = counted base_text prefix
  named_new golden joiners (length joiners == 0)
    . (_ -> scored golden mine theirs found pins)

fn named_new _ _ true
  io/write ""

fn named_new golden joiners false
  listing = text/join joiners ", "
  said_it = "a sample joined {golden[1]!} ({listing}); the sums"
  io/write "{said_it} below are over the samples both sides have.\n"

fn scored golden mine theirs found pins
  names = names_of (text/concat mine theirs)
  mine_t = totals mine
  theirs_t = totals theirs
  moves = list/map names (n -> judged golden n mine_t theirs_t pins)
  text/concat found (list/to_list (list/select moves real?))

fn real? m
  m.key != ""

fn judged golden name mine theirs pins
  before = or_zero theirs[name]
  after = or_zero mine[name]
  unmeasured golden name before after (missing? theirs[name]) pins

# A counter the runtime did not emit at all until this branch. Every golden in
# the vein gains its row on the same commit, so `or_zero` reads the absence as
# a baseline of nought and the rise off it as a worsening in every file at
# once — which is how adding `survive_slots` printed eight worsenings, no
# improvement anywhere, and a pure regression for a change that made the
# runtime measure something it had not measured. `named_new` says the same
# sentence for a benchmark that JOINS a golden; this is the transposed case, a
# row joining every sample rather than a sample joining every row.
#
# The dumps carry every counter on every run, zeros included, so a name absent
# from the baseline was absent from the runtime and there is nothing to compare
# against. The reverse — present then gone — is a deleted kernel, and the
# hard golden diff already refuses that byte for byte.
fn missing? none
  true

fn missing? _
  false

fn unmeasured golden name _ after true _
  minted golden name after

fn unmeasured golden name before after false pins
  unchanged golden name before after (before == after) pins

# A minted counter reading nought has nothing to report; one reading anything
# else is worth a line, so a reader can see what the new counter first said.
fn minted _ _ 0
  move "" true false "" false 0 false

fn minted golden name after
  line = "minted: {name} = {commas after}  ({golden[1]!})\n"
  move name true false line false after false

fn unchanged _ _ _ _ true _
  move "" false false "" false 0 false

fn unchanged golden name before after false pins
  bare = bare_name name golden[2]!
  worse = worsened? bare before after
  # `name` and not `bare`: the link file names the gate's key, prefix and
  # all, where `bare` is what the direction tables look up. They differ for
  # every golden but the four with an empty prefix — which is why the compile
  # vein classified correctly under `bare` and the runtime vein did not.
  told golden name before after worse (named? bare) (shifted? pins name)

# Does a direction table name this counter at all? A counter neither table
# knows has no direction, and answering `improved` for it is how a change with
# nothing to show for itself satisfied the pure-regression rule: `worsened?`
# returns false for an unknown name, the listing prints everything not worsened
# as improved, and the rise counts toward `better`. Found on 2026-09-01, when
# lifting the carry-tier prefix read `evac_allocs 27 -> 33,827`,
# `evac_bytes 1,520 -> 2,705,520` and `thunk_evals 1 -> 64` as three wins.
fn named? bare
  either? (found? bare lower) (found? bare higher)

fn either? true _
  true

fn either? _ b
  b

fn bare_name name ""
  name

fn bare_name name prefix
  text/slice name (length prefix + 1) (length name)

fn told golden name before after worse ruled rebased
  arrow = arrow_when rebased worse ruled
  line = "{arrow}: {name} {commas before} -> {commas after}  ({golden[1]!})\n"
  move name false ruled line worse after rebased

# `rebased` answers first and alone: a ratio between two definitions cannot
# say which way the compiler went, so neither of the other two questions is
# worth asking about it.
fn arrow_when true _ _
  "re-based"

fn arrow_when false worse ruled
  arrow_of worse ruled

fn arrow_of true true
  "worsened"

fn arrow_of false true
  "improved"

fn arrow_of _ false
  "moved"

# The mem corpus is a counter vein like the others, and allocation shape is
# exactly the kind of thing that moves quietly: a change can worsen every .mem
# file in the tree without a sentence anywhere. Each fixture is prefixed by its
# own name so a move says which program it came from.
fn mem? name
  text/slice name (length name - 3) (length name) == ".mem"

fn mem_golden name
  stem = text/slice name 1 (length name - 4)
  ["{mem_dir}/{name}" "{stem}_"]

fn mem_goldens names
  kept = list/select names mem?
  list/to_list (list/map kept mem_golden)

fn every_golden names
  text/concat bench_goldens (mem_goldens names)

fn walked base goldens found pins
  onward base goldens found pins (length goldens == 0)

fn onward _ _ found _ true
  io/write "" . (_ -> found)

fn onward base goldens found pins false
  rest = list/to_list (list/drop goldens 1)
  g = goldens[1]!
  from_git base g[1]!
    . (base_text -> against g base_text found pins)
    . (grown -> walked base rest grown pins)

fn base_of args
  given args (length args == 0)

fn given _ true
  "origin/main"

fn given args false
  args[1]!

fn started base
  from_git base floor_file
    . (theirs -> os/read_file! floor_file . (ours -> both base theirs ours))

fn both base theirs ours
  os/read_file! sources_file
    . (src -> reading base (linkage (baselines theirs) (baselines ours) src))

fn reading base pins
  os/list_dir mem_dir . (names -> gathered base names pins)

fn gathered base names pins
  walked base (every_golden names) [] pins . (ms -> priced base ms pins)

fn priced base ms pins
  log_delta base
    . (added -> attributed? base . (att -> verdict ms added att pins))

fn verdict moves added att pins
  new_ones = list/to_list (list/select moves (m -> m.minted))
  aged = list/to_list (list/reject moves (m -> m.minted))
  shifted = list/to_list (list/select aged (m -> m.rebased))
  held = list/to_list (list/reject aged (m -> m.rebased))
  known = list/to_list (list/select held (m -> m.ruled))
  worse = list/to_list (list/select known (m -> m.worse))
  better = list/to_list (list/reject known (m -> m.worse))
  adrift = list/to_list (list/reject held (m -> m.ruled))
  orphans = unclaimed pins[2]! pins[3]! shifted
  reb = [shifted orphans]
  seen = [worse better adrift]
  said moves . (_ -> weighed_up moves seen new_ones reb added att)

# A baseline value that moved and no golden row claimed. See `baselines`: the
# runtime counters are renamed on the way into the objective, so this is where
# a runtime re-basing lands.
fn unclaimed names rows shifted
  list/to_list (list/reject names (n -> claimed? rows shifted n))

fn claimed? rows shifted n
  list/any? shifted (m -> found? "{n} {m.key}" rows)

# `adrift` counts toward neither side of the pure-regression rule. A counter
# no table classifies cannot say whether a change came out ahead, and letting
# it stand in for one is what the rule exists to stop. A minted counter is
# out for a different reason: it has a direction and no baseline to aim it.
fn weighed_up moves seen new_ones reb added att
  worse = seen[1]!
  better = seen[2]!
  adrift = seen[3]!
  shifted = reb[1]!
  orphans = reb[2]!
  owed = text/concat worse shifted
  quiet = list/to_list (list/select owed (m -> silent? added m))
  mute = list/to_list (list/reject orphans (k -> named_in? added k))
  unclassified adrift
    . (_ -> newly new_ones)
    . (_ -> rebasing shifted orphans)
    . (_ -> unstated mute)
    . (_ -> unpriced quiet)
    . (_ -> summary moves quiet . (_ -> ruling worse better att))

fn named_in? added k
  length (text/split added k) > 1

# The third state, and the reason it is not a fourth: a re-based counter is
# reported by name like a minted one and counts toward neither side of the
# pure-regression rule, because a ratio between two definitions cannot say
# which way the compiler went. It still owes a sentence — `owed` above puts it
# through the same naming check a worsening gets, since the value it landed on
# is exactly what the write-up of a re-basing states.
fn rebasing shifted orphans
  re_based shifted (length shifted == 0)
    . (_ -> unattributed orphans (length orphans == 0))

fn re_based _ true
  io/write ""

fn re_based shifted false
  io/write "\nRE-BASED — welfare's baseline for these moved in the same\n"
  >> io/write "diff as the golden, so the two readings are of different\n"
  >> io/write "quantities and neither side of the pure-regression rule can\n"
  >> io/write "have them:\n"
  >> io/write (text/join (list/to_list (list/map shifted key_line)) "")

fn unattributed _ true
  io/write ""

fn unattributed orphans false
  io/write "\nRE-BASED, unclaimed — these welfare baselines moved and not\n"
  >> io/write "one of the golden rows they are made of did, so a ratio\n"
  >> io/write "moved with no measurement behind it. That wants a sentence:\n"
  >> io/write (text/join (list/to_list (list/map orphans name_line)) "")

fn name_line k
  "  {k}\n"

fn unstated mute
  silenced mute (length mute == 0)

fn silenced _ true
  io/write ""

fn silenced mute false
  io/write "\nUNSTATED — welfare's baseline moved for these and this\n"
  >> io/write "branch's log delta does not name them. Re-basing a measurement\n"
  >> io/write "is a decision, and a decision nobody wrote down is the one\n"
  >> io/write "thing this gate exists to refuse:\n"
  >> io/write (text/join (list/to_list (list/map mute name_line)) "")
  >> io/write "{advice}\n"
  >> os/exit 1

fn newly new_ones
  minting new_ones (length new_ones == 0)

fn minting _ true
  io/write ""

fn minting new_ones false
  io/write "\nMINTED — the baseline carries no reading for these at all, so\n"
  >> io/write "the first one is a measurement rather than a move:\n"
  >> io/write (text/join (list/to_list (list/map new_ones key_line)) "")

fn unclassified adrift
  drifting adrift (length adrift == 0)

fn drifting _ true
  io/write ""

fn drifting adrift false
  io/write "\nUNCLASSIFIED — no direction table names these, so they count\n"
  >> io/write "toward neither side of the pure-regression rule:\n"
  >> io/write (text/join (list/to_list (list/map adrift key_line)) "")

# The summary only speaks when nothing went unpriced; a listing already said
# more than it would.
fn summary moves quiet
  spoken moves (length quiet == 0)

fn spoken _ false
  io/write ""

fn spoken moves true
  summarised moves

fn said moves
  io/write (text/join (list/to_list (list/map moves say_of)) "")

fn say_of m
  m.say

# A worsening wants its counter named in this branch's log delta, and the
# value it landed on quoted beside the name.
#
# The name alone is not enough, and a ratchet run said so: kanso#1205 raised
# compile_instructions by 1,630 for a layout reason and wrote a paragraph
# about it, and that paragraph then licensed `a_counter_worsens_for_nothing`
# to set the same counter to 999,999,999 — the mutation ran, the gate stayed
# green, and the row went BLIND. A substring match on a counter's name is a
# blanket permit for that counter for the whole branch. The number is not: an
# entry that explains a move states the figure it moved to, which is the
# discipline the log already keeps, and no other move lands on it.
#
# And the listing enforces now. It printed and exited 0, so
# `a_runtime_counter_worsens_for_nothing` could set jsonbench to 9,999,999,999,
# be listed as unpriced, and still leave the gate green wherever the branch
# had improvements to spend — which is every performance branch. Movement is
# fine; silence is not, and a rule that only prints is silence.
fn silent? added m
  either? (not_named? added m.key) (not_named? added (commas m.after))

fn not_named? haystack needle
  length (text/split haystack needle) == 1

fn unpriced quiet
  listed quiet (length quiet == 0)

fn listed _ true
  io/write ""

fn summarised moves
  any_moved (length moves > 0)

fn any_moved false
  io/write ""

fn any_moved true
  io/write "every changed counter is priced, improved or re-based.\n"

fn listed quiet false
  io/write "\nUNPRICED — these worsened or were re-based with no sentence\n"
  >> io/write "naming them, and the value they landed on, in the\n"
  >> io/write "compiler-log delta of this branch:\n"
  >> io/write (text/join (list/to_list (list/map quiet key_line)) "")
  >> io/write "{advice}\n"
  >> os/exit 1

fn key_line m
  "  {m.key}\n"

fn ruling worse better att
  settled (length worse > 0 and length better == 0) att

fn settled true true
  banked 0

fn settled true false
  refused 0 . (_ -> os/exit 1)

fn settled false _
  io/write ""

fn banked _
  io/write "\nA pure regression, attributed: welfare_floor.json gained a\n"
  >> io/write "history entry, so the fall is recorded against the change that\n"
  >> io/write "spent it. The floor is permeable to the language.\n"

fn refused _
  io/write "\nFAIL  a pure regression: something got worse and nothing got\n"
  >> io/write "better. that trade has no other side, and it is the one move\n"
  >> io/write "the gate refuses outright. A language change that must spend\n"
  >> io/write "the score says so in bench/welfare_floor.json's history.\n"

pub play = os/args . (a -> started (base_of a))
