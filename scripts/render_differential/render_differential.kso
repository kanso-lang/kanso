import "std/io"
import "std/list"
import "std/os"
import "std/text"

# Rendering is written twice — `render` in the interpreter and `k_render` in
# the C runtime — and every `print` goes through it, so it is the widest
# surface in the compiler where two implementations have to agree character for
# character. The project already names it divergence-prone alongside float
# formatting and utf-8; those two have harnesses and this did not.
#
# The corpus pins the values it happens to print. This asks for the ones nobody
# would think to print: a float that is an integer, a float that needs every
# digit, the boundaries of the integer range, an empty container, a container
# holding itself in miniature, a string that is nothing but escapes.
#
# Agreement is the requirement. A disagreement is a finding.
kanso = "target/release/kanso"

probe = "target/render_probe.kso"

samples = [
  # Integers, out to the edges of int64.
  "0"
  "1"
  "-1"
  "7"
  "-7"
  "255"
  "256"
  "-256"
  "2147483647"
  "2147483648"
  "-2147483648"
  "9223372036854775807"
  "4611686018427387904"
  "-9223372036854775808"
  # Floats.
  "0.0"
  "1.0"
  "-1.0"
  "0.5"
  "-0.5"
  "2.25"
  "100.0"
  "1000000.0"
  "0.1"
  "0.2"
  "3.14159265358979"
  "1.7976931348623157"
  "-0.0"
  "0.000001"
  "123456789.123456789"
  # Arithmetic, printed as its answer.
  "1 / 2"
  "10 / 4"
  "1.0 / 3.0"
  "2.0 * 3.0"
  "7 % 3"
  "-7 % 3"
  # Strings, and the three nullary values.
  "\"\""
  "\"a\""
  "\"a b\""
  "\"tab\\there\""
  "\"line\\nbreak\""
  "\"quote\\\"inside\""
  "\"back\\\\slash\""
  "\"héllo\""
  "\"日本語\""
  "\"emoji 🌱\""
  "true"
  "false"
  "none"
  # Containers.
  "[]"
  "[1]"
  "[1 2 3]"
  "[\"a\" \"b\"]"
  "[[1] [2 3]]"
  "[[]]"
  "[0.5 1.0]"
  "[1 \"a\" true none]"
  "\{ \"a\":1 }"
  "\{ \"a\":1 \"b\":2 }"
  "\{ \"b\":2 \"a\":1 }"
  "\{ \"a\":\"x\" }"
  "\{ \"n\":none }"
  "\{ \"xs\":[1 2] }"
  # Rendering a failure is the half of this surface that has actually diverged.
  # #1057 and #1058 were both `k_render` answering differently from the oracle
  # for a container holding one, and neither could have been found here: nothing
  # in this corpus was a failure. A reason is an ordinary value, so it gets the
  # same treatment the rest of the corpus gets.
  "err \"a\""
  "[(err \"a\")]"
  "[(err \"a\") 2]"
  "\{ \"k\":(err \"v\") }"
  "\{ \"a\":(err \"x\") \"b\":2 }"
  "[\{ \"in\":(err \"d\") }]"
  "[[(err \"n\")]]"
  "[(err 1)]"
  "[(err 0.5)]"
  "[(err none)]"
  "[(err true)]"
  "[(err [1 2])]"
  "[(err \{ \"a\":1 })]"
  "[(err \"quote\\\"in\")]"
  "[(err \"tab\\there\")]"
  "[(err \"\")]"
]

# A record prints through the same path and carries its type's name, so the
# same probe runs again with a type declared in front of it.
shaped = [
  "point 1 2"
  "point \"a\" \"b\""
  "point (point 1 2) 3"
  "[(point 1 2)]"
  "point none 1"
  "point 0.5 1.0"
  # A constructor MERGES its arguments' failures rather than holding them, so
  # this renders the merged failure and not a record — which is a rendering the
  # corpus should pin too.
  "[(point (err \"x\") 1)]"
  "point (err \"x\") (err \"y\")"
]

prelude = """
  type point
    x
    y

"""

fn plain expr
  "print \"\{{expr}}\"\n"

fn typed expr
  "{prelude}print \"\{{expr}}\"\n"

# A legal probe that never returns is a finding, and a louder one than a
# wording difference — so every run is under `timeout`, which answers 124 when
# it fires. A box without `timeout` cannot start it, and an err says so rather
# than the sweep quietly losing the property.
limit = "20"

fn asked argv
  os/run "timeout" (text/concat [limit kanso] argv)

fn hung? 124
  true

fn hung? _
  false

# The probe is written once and read by both engines, so a difference is the
# engines and never two different files.
fn ran source
  os/write_file probe source .> (_ -> both)

both = asked ["play" probe] .> matched

fn matched native
  asked ["play" probe "--interp"] .> (interp -> answer native interp)

fn answer n i
  stalled n i (hung? n.status or hung? i.status)

fn stalled n i true
  "  never returned: native {n.status} interp {i.status}\n"

fn stalled n i false
  same = n.status == i.status and n.stdout == i.stdout
  agreed n i (same and n.stderr == i.stderr)

fn agreed _ _ true
  ""

fn agreed n i false
  native = "  native: {n.status} {n.stdout}{n.stderr}"
  "{native}  interp: {i.status} {i.stdout}{i.stderr}\n"

# Recursion rather than a fold, because each step is an effect whose answer the
# next step needs: the list is walked by binding, one probe at a time.
fn swept shape exprs found
  onward shape exprs found (length exprs == 0)

fn onward _ _ found true
  found

fn onward shape exprs found false
  rest = list/to_list (list/drop exprs 1)
  expr = exprs[1]
  ran (shape expr) .> (verdict -> swept shape rest (noted found expr verdict))

fn noted found _ ""
  found

fn noted found expr verdict
  push found "{expr}\n{verdict}"

# A probe that lost its interpolation prints a plain string, which both
# engines render identically — so the sweep agrees with itself about nothing
# and reports every value green. That is what a first draft of this file did,
# and it is the third time this project has produced a confident number about
# nothing. So the shape of one probe is checked before any of them run.
complaint = "the probe shape changed: probes must interpolate\n"

sample = "print \"\{1}\"\n"

# And that check is not enough on its own: it compares one string to another
# and never starts an engine. When every probe stopped compiling, both engines
# refused identically and this sweep called 68 values green having run none of
# them. So the sample runs first, on both engines, and has to answer.
mute = "the probes do not run: neither engine printed 1 for the sample\n"

fn sound? r
  r.status == 0 and r.stdout == "1\n"

fn works? n i
  sound? n and sound? i

fn ready native
  asked ["play" probe "--interp"] .> (interp -> live native interp)

fn live n i
  running (works? n i)

fn running true
  swept plain samples [] .> (a -> swept typed shaped a .> reported)

fn running false
  io/write_err mute .> (_ -> os/exit 2)

fn begun false
  io/write_err complaint .> (_ -> os/exit 2)

fn begun true
  os/write_file probe sample .> (_ -> asked ["play" probe]) .> ready

fn reported found
  said found .> (_ -> os/exit (sound (length found)))

fn said found
  count = length samples + length shaped
  io/write "{count} values rendered, {length found} disagree\n"
    .> (_ -> io/write (text/join found ""))

fn sound 0
  0

fn sound _
  1

pub play = begun (plain "1" == sample)
